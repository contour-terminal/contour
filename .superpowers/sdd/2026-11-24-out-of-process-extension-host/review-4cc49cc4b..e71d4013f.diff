diff --git a/src/vtextension/wasm/remote/CopyPathMemory.cpp b/src/vtextension/wasm/remote/CopyPathMemory.cpp
new file mode 100644
index 000000000..816cd9628
--- /dev/null
+++ b/src/vtextension/wasm/remote/CopyPathMemory.cpp
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/CopyPathMemory.hpp>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace vtextension::wasm::remote
+{
+
+CopyPathMemory::CopyPathMemory(uint32_t instanceId, std::size_t capBytes, MemoryFetch fetch):
+    _instanceId { instanceId }, _capBytes { capBytes }, _fetch { std::move(fetch) }
+{
+}
+
+std::optional<std::span<std::byte>> CopyPathMemory::view(uint32_t address, uint32_t size)
+{
+    if (size == 0)
+        return std::span<std::byte> {};
+    auto const begin = uint64_t { address };
+    auto const end = begin + size;
+    if (end > uint64_t { 1 } << 32)
+        return std::nullopt;
+
+    // The latest range holding all of it: it carries every earlier range's bytes it overlaps.
+    for (auto& range: _ranges | std::views::reverse)
+        if (range.address <= begin && end <= range.address + uint64_t { range.bytes.size() })
+            return std::span { range.bytes }.subspan(address - range.address, size);
+
+    if (_heldBytes + size > _capBytes)
+        return std::nullopt;
+    auto fetched = _fetch(address, size);
+    if (!fetched || fetched->size() != size)
+        return std::nullopt;
+
+    // Earlier ranges' bytes, as written, overlaid in fetch order: what was written since they were fetched
+    // is what the instance would hold now, had it been written there.
+    for (auto const& earlier: _ranges)
+    {
+        auto const earlierBegin = uint64_t { earlier.address };
+        auto const earlierEnd = earlierBegin + earlier.bytes.size();
+        auto const overlapBegin = std::max(begin, earlierBegin);
+        auto const overlapEnd = std::min(end, earlierEnd);
+        if (overlapBegin >= overlapEnd)
+            continue;
+        auto const source =
+            std::span { earlier.bytes }.subspan(overlapBegin - earlierBegin, overlapEnd - overlapBegin);
+        std::ranges::copy(source, fetched->begin() + static_cast<std::ptrdiff_t>(overlapBegin - begin));
+    }
+
+    auto snapshot = *fetched;
+    _heldBytes += size;
+    auto& added = _ranges.emplace_back(
+        Range { .address = address, .bytes = std::move(*fetched), .snapshot = std::move(snapshot) });
+    return std::span { added.bytes };
+}
+
+std::vector<proto::MemoryWrite> CopyPathMemory::flush() const
+{
+    auto writes = std::vector<proto::MemoryWrite> {};
+    for (auto const& range: _ranges)
+    {
+        auto const emit = [&](std::size_t begin, std::size_t end) {
+            auto const run = std::span { range.bytes }.subspan(begin, end - begin);
+            writes.push_back(proto::MemoryWrite { .instanceId = _instanceId,
+                                                  .address = range.address + static_cast<uint32_t>(begin),
+                                                  .bytes = { run.begin(), run.end() } });
+        };
+        auto runBegin = std::optional<std::size_t> {};
+        for (auto const index: std::views::iota(std::size_t { 0 }, range.bytes.size()))
+        {
+            auto const changed = range.bytes[index] != range.snapshot[index];
+            if (changed && !runBegin)
+                runBegin = index;
+            else if (!changed && runBegin)
+                emit(*std::exchange(runBegin, std::nullopt), index);
+        }
+        if (runBegin)
+            emit(*runBegin, range.bytes.size());
+    }
+    return writes;
+}
+
+void CopyPathMemory::clear() noexcept
+{
+    _ranges.clear();
+    _heldBytes = 0;
+}
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/CopyPathMemory.hpp b/src/vtextension/wasm/remote/CopyPathMemory.hpp
new file mode 100644
index 000000000..98b690645
--- /dev/null
+++ b/src/vtextension/wasm/remote/CopyPathMemory.hpp
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// An instance's linear memory as the parent sees it while its host copies memory rather than sharing it: the
+/// ranges the parent read, kept until the instance next runs, and what the parent wrote into them.
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <span>
+#include <vector>
+
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+
+namespace vtextension::wasm::remote
+{
+
+/// Reads a range of an instance's memory from its host.
+/// @return The range's bytes, exactly as many as asked for; nothing if the range lies outside the memory or
+///         the host could not be reached.
+using MemoryFetch = std::function<std::optional<std::vector<std::byte>>(uint32_t address, uint32_t size)>;
+
+/// The ranges of one instance's memory the parent read since the instance last ran, as local copies it may
+/// write to. A range is fetched once, and a view inside it is served from the copy. A range fetched while an
+/// earlier one overlaps it starts out with the earlier one's bytes, written ones included, so that two views
+/// of the same bytes agree when they are taken. What was written goes back to the instance (flush()) before
+/// it next runs, after which the copies are dropped (clear()).
+///
+/// Not thread-safe: used by the thread calling into its instance.
+class CopyPathMemory
+{
+  public:
+    /// @param instanceId The instance the writes flush() returns are addressed to.
+    /// @param capBytes The most bytes the copies may hold at once; a view that would take more is refused.
+    /// @param fetch Where ranges not held yet are read from.
+    CopyPathMemory(uint32_t instanceId, std::size_t capBytes, MemoryFetch fetch);
+
+    /// A view of [@p address, @p address + @p size), served from a copy that holds all of it, or else from a
+    /// range fetched for it. Valid until clear().
+    /// @param address The guest address the view starts at.
+    /// @param size The view's size in bytes; 0 yields an empty span, fetching nothing.
+    /// @return The view; nothing if the range lies outside the memory or the 32-bit address space, could not
+    ///         be fetched, or would take the copies past their cap.
+    [[nodiscard]] std::optional<std::span<std::byte>> view(uint32_t address, uint32_t size);
+
+    /// @return One write per maximal run of bytes changed since its range was fetched, range by range in the
+    ///         order they were fetched: where two ranges overlap and both were written to, the later fetched
+    ///         one's bytes land last.
+    [[nodiscard]] std::vector<proto::MemoryWrite> flush() const;
+
+    /// Drops every copy, and with them every view handed out.
+    void clear() noexcept;
+
+  private:
+    /// One fetched range: what the parent sees and writes, and what it held when it was fetched.
+    struct Range
+    {
+        uint32_t address = 0;            ///< Where it starts.
+        std::vector<std::byte> bytes;    ///< Its bytes, as written since.
+        std::vector<std::byte> snapshot; ///< Its bytes when fetched, earlier ranges' overlaid.
+    };
+
+    uint32_t _instanceId;
+    std::size_t _capBytes;
+    MemoryFetch _fetch;
+    std::vector<Range> _ranges; ///< In the order they were fetched.
+    std::size_t _heldBytes = 0; ///< What _ranges' bytes take together.
+};
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/CopyPathMemory_test.cpp b/src/vtextension/wasm/remote/CopyPathMemory_test.cpp
new file mode 100644
index 000000000..6bd2b1933
--- /dev/null
+++ b/src/vtextension/wasm/remote/CopyPathMemory_test.cpp
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The parent's copies of an instance's memory: what is fetched, and what is written back.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <vector>
+
+#include <vtextension/wasm/remote/CopyPathMemory.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+
+using vtextension::wasm::remote::CopyPathMemory;
+
+namespace proto = vtextension::wasm::remote::proto;
+
+namespace
+{
+
+/// The instance the tests' writes are addressed to.
+constexpr auto InstanceId = uint32_t { 7 };
+
+/// An instance's memory, as its host holds it: every fetch reads it, every write lands in it.
+class FakeMemory
+{
+  public:
+    /// @param size The memory's size in bytes; byte i holds i, modulo 256.
+    explicit FakeMemory(std::size_t size)
+    {
+        for (auto const index: std::views::iota(std::size_t { 0 }, size))
+            _bytes.push_back(static_cast<std::byte>(index & 0xFF));
+    }
+
+    /// @return A CopyPathMemory over this memory, holding at most @p capBytes.
+    [[nodiscard]] CopyPathMemory copies(std::size_t capBytes)
+    {
+        return CopyPathMemory { InstanceId,
+                                capBytes,
+                                [this](uint32_t address,
+                                       uint32_t size) -> std::optional<std::vector<std::byte>> {
+                                    ++fetches;
+                                    if (std::size_t { address } + size > _bytes.size())
+                                        return std::nullopt;
+                                    auto const range = std::span { _bytes }.subspan(address, size);
+                                    return std::vector<std::byte> { range.begin(), range.end() };
+                                } };
+    }
+
+    /// Applies @p writes in order.
+    void apply(std::vector<proto::MemoryWrite> const& writes)
+    {
+        for (auto const& write: writes)
+        {
+            REQUIRE(write.instanceId == InstanceId);
+            REQUIRE(std::size_t { write.address } + write.bytes.size() <= _bytes.size());
+            std::ranges::copy(write.bytes, _bytes.begin() + write.address);
+        }
+    }
+
+    /// @return The byte at @p address.
+    [[nodiscard]] std::byte at(std::size_t address) const { return _bytes.at(address); }
+
+    int fetches = 0; ///< How often a range was fetched.
+
+  private:
+    std::vector<std::byte> _bytes;
+};
+
+} // namespace
+
+TEST_CASE("CopyPathMemory.flushEmitsOnlyChangedRuns", "[vtextension][remote]")
+{
+    auto memory = FakeMemory { 256 };
+    auto copies = memory.copies(1024);
+    auto const view = copies.view(32, 16);
+    REQUIRE(view.has_value());
+    CHECK(view->size() == 16);
+    CHECK(view->front() == std::byte { 32 });
+    CHECK(copies.flush().empty());
+
+    (*view)[3] = std::byte { 0xAA };
+    (*view)[4] = std::byte { 0xBB };
+    // A byte written back to what it held is no change.
+    (*view)[9] = std::byte { 0xCC };
+    (*view)[9] = std::byte { 32 + 9 };
+
+    CHECK(copies.flush()
+          == std::vector { proto::MemoryWrite { .instanceId = InstanceId,
+                                                .address = 35,
+                                                .bytes = { std::byte { 0xAA }, std::byte { 0xBB } } } });
+}
+
+TEST_CASE("CopyPathMemory.viewsInsideAFetchedRangeFetchNothing", "[vtextension][remote]")
+{
+    auto memory = FakeMemory { 256 };
+    auto copies = memory.copies(1024);
+    auto const whole = copies.view(0, 64);
+    REQUIRE(whole.has_value());
+    (*whole)[10] = std::byte { 0xEE };
+    auto const inner = copies.view(8, 4);
+    REQUIRE(inner.has_value());
+    CHECK((*inner)[2] == std::byte { 0xEE });
+    CHECK(memory.fetches == 1);
+
+    auto const empty = copies.view(1000, 0);
+    REQUIRE(empty.has_value());
+    CHECK(empty->empty());
+    CHECK(memory.fetches == 1);
+
+    copies.clear();
+    REQUIRE(copies.view(8, 4).has_value());
+    CHECK(memory.fetches == 2);
+}
+
+TEST_CASE("CopyPathMemory.laterViewWins", "[vtextension][remote]")
+{
+    auto memory = FakeMemory { 256 };
+    auto copies = memory.copies(1024);
+
+    // A = [0, 8) is written before B = [4, 12) is fetched: B starts out with A's write.
+    auto const a = copies.view(0, 8);
+    REQUIRE(a.has_value());
+    (*a)[5] = std::byte { 0xA5 };
+    (*a)[1] = std::byte { 0xA1 };
+    auto const b = copies.view(4, 8);
+    REQUIRE(b.has_value());
+    CHECK((*b)[1] == std::byte { 0xA5 });
+
+    // Both write the byte they share; the later fetched one's write lands last.
+    (*b)[1] = std::byte { 0xB5 };
+    (*b)[6] = std::byte { 0xBA };
+    memory.apply(copies.flush());
+    copies.clear();
+
+    CHECK(memory.at(1) == std::byte { 0xA1 });
+    CHECK(memory.at(5) == std::byte { 0xB5 });
+    CHECK(memory.at(10) == std::byte { 0xBA });
+}
+
+TEST_CASE("CopyPathMemory.refusesWhatItCannotHold", "[vtextension][remote]")
+{
+    auto memory = FakeMemory { 256 };
+    auto copies = memory.copies(64);
+
+    CHECK_FALSE(copies.view(250, 16).has_value());         // past the memory's end
+    CHECK_FALSE(copies.view(0xFFFF'FFF0, 32).has_value()); // past the address space; fetches nothing
+    CHECK(memory.fetches == 1);
+
+    REQUIRE(copies.view(0, 48).has_value());
+    CHECK_FALSE(copies.view(100, 17).has_value()); // past the cap: 48 + 17 > 64; fetches nothing
+    CHECK(memory.fetches == 2);
+    CHECK(copies.view(100, 16).has_value());
+}
diff --git a/src/vtextension/wasm/remote/HelperIncarnation.cpp b/src/vtextension/wasm/remote/HelperIncarnation.cpp
new file mode 100644
index 000000000..505651980
--- /dev/null
+++ b/src/vtextension/wasm/remote/HelperIncarnation.cpp
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/HelperIncarnation.hpp>
+
+#include <expected>
+#include <memory>
+#include <mutex>
+#include <utility>
+#include <variant>
+#include <vector>
+
+namespace vtextension::wasm::remote
+{
+
+using transport::PduStream;
+using transport::StreamError;
+
+namespace
+{
+    /// The limits the parent's ends apply: the protocol's own, which every host applies too.
+    constexpr auto ParentLimits = proto::PduLimits {};
+
+    /// @return Whether a host that said @p hello may be driven: it speaks this protocol, confined itself or
+    ///         runs where there is no confinement, and copies memory, which is how this parent reaches it.
+    [[nodiscard]] bool isAcceptable(proto::Hello const& hello) noexcept
+    {
+        return hello.version == proto::ProtocolVersion && hello.lockdown != proto::LockdownState::Failed
+               && hello.memoryMode == proto::MemoryMode::Copy;
+    }
+
+    /// @return The parent's end of @p channel as a stream of @p kind.
+    [[nodiscard]] PduStream parentEnd(transport::Channel channel, proto::ChannelKind kind)
+    {
+        return PduStream { std::move(channel), kind, proto::Direction::ToParent, ParentLimits };
+    }
+} // namespace
+
+std::expected<std::shared_ptr<HelperIncarnation>, ExtensionError> HelperIncarnation::connect(
+    IHostConnector& connector, proto::CreateRuntime const& runtime)
+{
+    auto connection = connector.connect();
+    if (!connection)
+        return std::unexpected(ExtensionError::HostUnavailable);
+    if (connection->lanes.size() != MaxLaneChannels || !connection->handle)
+    {
+        if (connection->handle)
+            connection->handle->terminate();
+        return std::unexpected(ExtensionError::HostUnavailable);
+    }
+    auto incarnation = std::make_shared<HelperIncarnation>(std::move(*connection));
+
+    // The host speaks first, unasked; a request then creates the runtime.
+    auto const handshake = [&]() -> bool {
+        auto const lock = std::scoped_lock { incarnation->_controlMutex };
+        auto const hello = incarnation->_control.receive();
+        return hello && std::holds_alternative<proto::Hello>(*hello)
+               && isAcceptable(std::get<proto::Hello>(*hello));
+    };
+    auto const created = [&]() -> bool {
+        auto request = runtime;
+        request.runtimeId = RuntimeId;
+        auto const reply = incarnation->request(request);
+        return reply
+               && *reply
+                      == proto::Pdu { proto::RuntimeCreated { .runtimeId = RuntimeId,
+                                                              .error = std::nullopt } };
+    };
+    if (!handshake() || !created())
+    {
+        incarnation->markDead();
+        return std::unexpected(ExtensionError::HostUnavailable);
+    }
+    return incarnation;
+}
+
+HelperIncarnation::HelperIncarnation(HostConnection connection):
+    _control { parentEnd(std::move(connection.control), proto::ChannelKind::Control) },
+    _handle { std::move(connection.handle) }
+{
+    _lanes.reserve(connection.lanes.size());
+    for (auto& lane: connection.lanes)
+        _lanes.push_back(parentEnd(std::move(lane), proto::ChannelKind::Lane));
+}
+
+HelperIncarnation::~HelperIncarnation() = default;
+
+std::expected<proto::Pdu, StreamError> HelperIncarnation::request(proto::Pdu const& pdu)
+{
+    auto const lock = std::scoped_lock { _controlMutex };
+    if (!isAlive())
+        return std::unexpected(StreamError::Closed);
+    if (auto const sent = _control.send(pdu); !sent)
+    {
+        // A PDU over its cap was not sent, and the stream is intact: the request fails, the host lives on.
+        if (sent.error() != StreamError::OverCap)
+            markDead();
+        return std::unexpected(sent.error());
+    }
+    auto reply = _control.receive();
+    if (!reply)
+        markDead();
+    return reply;
+}
+
+void HelperIncarnation::post(proto::Pdu const& pdu) noexcept
+{
+    auto const lock = std::scoped_lock { _controlMutex };
+    if (isAlive())
+        std::ignore = _control.send(pdu);
+}
+
+void HelperIncarnation::markDead() noexcept
+{
+    if (_state.exchange(IncarnationState::Dead) == IncarnationState::Dead)
+        return;
+    _handle->terminate();
+    // A thread blocked on one of the parent's ends returns; a host that never closes its own ends, as a
+    // hostile one may not, cannot keep it waiting.
+    _control.shutdown();
+    for (auto& lane: _lanes)
+        lane.shutdown();
+}
+
+void HelperIncarnation::interrupt(uint32_t instanceId) noexcept
+{
+    if (isAlive())
+        _handle->interrupt(instanceId);
+}
+
+} // namespace vtextension::wasm::remote
