+    CHECK(callWord(*instance, "load", Address) == 0x0403'0201);
+    CHECK(callWord(*instance, "load", Address + 4) == 0x0807'0605);
+    CHECK(callWord(*instance, "load", Address + 8) == 0x0C0B'0A09);
