+    /// The standard streams are file descriptors 0 to 2; there is no other.
+    constexpr auto StandardStreamCount = uint32_t { 3 };
+
+    /// The size of a WASI `ciovec`: a u32 buffer address, then a u32 length.
+    constexpr auto CiovecBytes = uint64_t { 8 };
+
+    /// The size of a WASI `fdstat`, and where its fields lie.
+    constexpr auto FdstatBytes = uint32_t { 24 };
+    constexpr auto FdstatRightsBaseOffset = std::size_t { 8 };
+
+    /// The `filetype` of a character device, which every standard stream is.
+    constexpr auto CharacterDevice = std::byte { 2 };
+
+    /// The `rights` of a standard stream: fd_seek (bit 2) and fd_write (bit 6), the operations the
+    /// shim implements on it.
+    constexpr auto StandardStreamRights = uint64_t { 0b0100'0100 };
+
+    /// The highest `whence` of fd_seek: set (0), cur (1) and end (2).
+    constexpr auto HighestWhence = uint64_t { 2 };
+
+    /// The resolution every provided clock reports, in nanoseconds.
+    constexpr auto ClockResolution = uint64_t { 1 };
+
+    /// Whether the shim provides a clock of preview 1.
+    enum class ClockProvision : uint8_t
+    {
+        Withheld, ///< Not provided: reading it gives Errno::Nosys.
+        Provided, ///< Read from ShimEnvironment::clock.
+    };
+
+    /// One clock of preview 1, and whether it is provided.
+    struct ClockRow
+    {
+        ClockId id;               ///< The clock.
+        ClockProvision provision; ///< Whether it is provided.
+    };
+
+    /// Every clock of preview 1. The CPU-time clocks are withheld: an instance's CPU time is the host's
+    /// business, and preview 1 lets a host answer `nosys` for a clock it does not support.
+    constexpr auto Clocks = std::to_array<ClockRow>({
+        { .id = ClockId::Realtime, .provision = ClockProvision::Provided },
+        { .id = ClockId::Monotonic, .provision = ClockProvision::Provided },
+        { .id = ClockId::ProcessCputime, .provision = ClockProvision::Withheld },
+        { .id = ClockId::ThreadCputime, .provision = ClockProvision::Withheld },
+    });
+
+    /// @return The i32 argument @p arg, as the guest passed it.
+    [[nodiscard]] constexpr uint32_t asU32(uint64_t arg) noexcept
+    {
+        return static_cast<uint32_t>(arg);
+    }
+
+    /// @return The @p size bytes of @p memory at @p address; `Fault` if they do not all lie in it.
+    [[nodiscard]] std::expected<std::span<std::byte>, Errno> range(std::span<std::byte> memory,
+                                                                   uint32_t address,
+                                                                   uint64_t size) noexcept
+    {
+        if (uint64_t { address } + size > memory.size())
+            return std::unexpected(Errno::Fault);
+        return memory.subspan(address, static_cast<std::size_t>(size));
+    }
+
+    /// Stores @p value into @p bytes, little-endian, in as many bytes as @p bytes has.
+    template <std::unsigned_integral T>
+    void storeLittleEndian(std::span<std::byte> bytes, T value) noexcept
+    {
+        for (auto& byte: bytes)
+        {
+            byte = std::byte { static_cast<uint8_t>(value) };
+            value = static_cast<T>(value >> 8U);
+        }
+    }
+
+    /// @return The little-endian u32 at the start of @p bytes, which holds at least four.
+    [[nodiscard]] uint32_t loadU32(std::span<std::byte const> bytes) noexcept
+    {
+        auto value = uint32_t { 0 };
+        for (auto const byte: bytes.first(4) | std::views::reverse)
+            value = (value << 8U) | std::to_integer<uint32_t>(byte);
+        return value;
+    }
+
+    /// Stores @p value as a little-endian u32 at @p address.
+    /// @return Nothing; `Fault` if the four bytes do not lie in @p memory.
+    [[nodiscard]] std::expected<void, Errno> storeU32(std::span<std::byte> memory,
+                                                      uint32_t address,
+                                                      uint32_t value) noexcept
+    {
+        return range(memory, address, sizeof(value)).transform([&](std::span<std::byte> bytes) {
+            storeLittleEndian(bytes, value);
+        });
+    }
+
+    /// Stores @p value as a little-endian u64 at @p address.
+    /// @return Nothing; `Fault` if the eight bytes do not lie in @p memory.
+    [[nodiscard]] std::expected<void, Errno> storeU64(std::span<std::byte> memory,
+                                                      uint32_t address,
+                                                      uint64_t value) noexcept
+    {
+        return range(memory, address, sizeof(value)).transform([&](std::span<std::byte> bytes) {
+            storeLittleEndian(bytes, value);
+        });
+    }
+
+    /// @return The result of a function that returned @p outcome's errno.
+    [[nodiscard]] ShimResult returned(std::expected<void, Errno> const& outcome) noexcept
+    {
+        return ShimResult { .outcome = ShimOutcome::Returned,
+                            .error = outcome ? Errno::Success : outcome.error() };
+    }
+
+    /// @return The standard stream @p fd names; `Badf` if it names none.
+    [[nodiscard]] std::expected<uint32_t, Errno> standardStream(uint64_t fd) noexcept
+    {
+        if (asU32(fd) >= StandardStreamCount)
+            return std::unexpected(Errno::Badf);
+        return asU32(fd);
+    }
+
+    /// @return The provided clock @p clockId names; `Nosys` if it is withheld, `Inval` if it names none.
+    [[nodiscard]] std::expected<ClockId, Errno> providedClock(uint64_t clockId) noexcept
+    {
+        auto const row = std::ranges::find(
+            Clocks, asU32(clockId), [](ClockRow const& clock) { return static_cast<uint32_t>(clock.id); });
+        if (row == Clocks.end())
+            return std::unexpected(Errno::Inval);
+        if (row->provision == ClockProvision::Withheld)
+            return std::unexpected(Errno::Nosys);
+        return row->id;
+    }
+
+    /// args_get and environ_get, of an empty list: (list, buffer) -> errno. Writes nothing.
+    ShimResult emptyListGet(ShimEnvironment const& /*environment*/,
+                            std::span<std::byte> memory,
+                            std::span<uint64_t const> args)
+    {
+        return returned(range(memory, asU32(args[0]), 0)
+                            .and_then([&](auto) { return range(memory, asU32(args[1]), 0); })
+                            .transform([](auto) {}));
+    }
+
+    /// args_sizes_get and environ_sizes_get, of an empty list: (count, size) -> errno. Stores 0 into both,
+    /// or into neither.
+    ShimResult emptyListSizesGet(ShimEnvironment const& /*environment*/,
+                                 std::span<std::byte> memory,
+                                 std::span<uint64_t const> args)
+    {
+        return returned(range(memory, asU32(args[0]), sizeof(uint32_t)).and_then([&](auto count) {
+            return range(memory, asU32(args[1]), sizeof(uint32_t)).transform([&](auto size) {
+                storeLittleEndian(count, uint32_t { 0 });
+                storeLittleEndian(size, uint32_t { 0 });
+            });
+        }));
+    }
+
+    /// clock_time_get: (clock, precision, time) -> errno. The precision is a hint, and ignored.
+    ShimResult clockTimeGet(ShimEnvironment const& environment,
+                            std::span<std::byte> memory,
+                            std::span<uint64_t const> args)
+    {
+        return returned(providedClock(args[0]).and_then([&](ClockId clock) {
+            return range(memory, asU32(args[2]), sizeof(uint64_t)).transform([&](auto bytes) {
+                storeLittleEndian(bytes, environment.clock(static_cast<uint32_t>(clock)));
+            });
+        }));
+    }
+
+    /// clock_res_get: (clock, resolution) -> errno.
+    ShimResult clockResGet(ShimEnvironment const& /*environment*/,
+                           std::span<std::byte> memory,
+                           std::span<uint64_t const> args)
+    {
+        return returned(providedClock(args[0]).and_then(
+            [&](ClockId) { return storeU64(memory, asU32(args[1]), ClockResolution); }));
+    }
+
+    /// @return The total length of the `ciovec`s @p iovs, each of whose buffers lies in @p memory;
+    ///         `Fault` if one does not, `Inval` if the total does not fit a u32.
+    [[nodiscard]] std::expected<uint32_t, Errno> totalLength(std::span<std::byte> memory,
+                                                             std::span<std::byte const> iovs) noexcept
+    {
+        auto total = uint64_t { 0 };
+        for (auto const index: std::views::iota(uint64_t { 0 }, iovs.size() / CiovecBytes))
+        {
+            auto const iov = iovs.subspan(static_cast<std::size_t>(index * CiovecBytes), CiovecBytes);
+            auto const length = loadU32(iov.subspan(4));
+            if (!range(memory, loadU32(iov), length))
+                return std::unexpected(Errno::Fault);
+            total += length;
+        }
+        if (total > std::numeric_limits<uint32_t>::max())
+            return std::unexpected(Errno::Inval);
+        return static_cast<uint32_t>(total);
+    }
+
+    /// fd_write: (fd, iovs, iovsLength, written) -> errno. Writes nowhere, and reports every byte written.
+    ShimResult fdWrite(ShimEnvironment const& /*environment*/,
+                       std::span<std::byte> memory,
+                       std::span<uint64_t const> args)
+    {
+        return returned(
+            standardStream(args[0])
+                .and_then(
+                    [&](uint32_t) { return range(memory, asU32(args[1]), asU32(args[2]) * CiovecBytes); })
+                .and_then([&](std::span<std::byte> iovs) { return totalLength(memory, iovs); })
+                .and_then([&](uint32_t total) { return storeU32(memory, asU32(args[3]), total); }));
+    }
+
+    /// fd_close: (fd) -> errno. A standard stream stays open: it never held anything to release.
+    ShimResult fdClose(ShimEnvironment const& /*environment*/,
+                       std::span<std::byte> /*memory*/,
+                       std::span<uint64_t const> args)
+    {
+        return returned(standardStream(args[0]).transform([](uint32_t) {}));
+    }
+
+    /// fd_fdstat_get: (fd, stat) -> errno. A standard stream is a character device with no flags.
+    ShimResult fdFdstatGet(ShimEnvironment const& /*environment*/,
+                           std::span<std::byte> memory,
+                           std::span<uint64_t const> args)
+    {
+        return returned(standardStream(args[0])
+                            .and_then([&](uint32_t) { return range(memory, asU32(args[1]), FdstatBytes); })
+                            .transform([](std::span<std::byte> stat) {
+                                std::ranges::fill(stat, std::byte {});
+                                stat.front() = CharacterDevice;
+                                storeLittleEndian(stat.subspan(FdstatRightsBaseOffset, sizeof(uint64_t)),
+                                                  StandardStreamRights);
+                            }));
+    }
+
+    /// fd_prestat_get and fd_prestat_dir_name: there is no preopened directory, so no descriptor has one.
+    ShimResult noPreopenedDirectory(ShimEnvironment const& /*environment*/,
+                                    std::span<std::byte> /*memory*/,
+                                    std::span<uint64_t const> /*args*/)
+    {
+        return returned(std::unexpected(Errno::Badf));
+    }
+
+    /// fd_seek: (fd, offset, whence, newOffset) -> errno. A standard stream stays at offset 0.
+    ShimResult fdSeek(ShimEnvironment const& /*environment*/,
+                      std::span<std::byte> memory,
+                      std::span<uint64_t const> args)
+    {
+        return returned(standardStream(args[0]).and_then([&](uint32_t) -> std::expected<void, Errno> {
+            if (asU32(args[2]) > HighestWhence)
+                return std::unexpected(Errno::Inval);
+            return storeU64(memory, asU32(args[3]), 0);
+        }));
+    }
+
+    /// random_get: (buffer, length) -> errno.
+    ShimResult randomGet(ShimEnvironment const& environment,
+                         std::span<std::byte> memory,
+                         std::span<uint64_t const> args)
+    {
+        return returned(
+            range(memory, asU32(args[0]), asU32(args[1])).transform([&](std::span<std::byte> bytes) {
+                environment.random(bytes);
+            }));
+    }
+
+    /// proc_exit: (code). Does not return; the exit code is not kept.
+    ShimResult procExit(ShimEnvironment const& /*environment*/,
+                        std::span<std::byte> /*memory*/,
+                        std::span<uint64_t const> /*args*/)
+    {
+        return ShimResult { .outcome = ShimOutcome::Exit, .error = Errno::Success };
+    }
+
+    /// sched_yield: () -> errno. An instance is single-threaded: there is nothing to yield to.
+    ShimResult schedYield(ShimEnvironment const& /*environment*/,
+                          std::span<std::byte> /*memory*/,
+                          std::span<uint64_t const> /*args*/)
+    {
+        return returned({});
+    }
+
+    /// @return The row implementing @p name by @p call, with its signature from Preview1Functions.
+    [[nodiscard]] consteval ShimFunction shim(std::string_view name, ShimCall call)
+    {
+        return ShimFunction { .preview1 = *findPreview1Function(name), .call = call };
+    }
+
+    constexpr auto ShimTable = std::to_array<ShimFunction>({
+        shim("args_get", &emptyListGet),
+        shim("args_sizes_get", &emptyListSizesGet),
+        shim("environ_get", &emptyListGet),
+        shim("environ_sizes_get", &emptyListSizesGet),
+        shim("clock_time_get", &clockTimeGet),
+        shim("clock_res_get", &clockResGet),
+        shim("fd_write", &fdWrite),
+        shim("fd_close", &fdClose),
+        shim("fd_fdstat_get", &fdFdstatGet),
+        shim("fd_prestat_get", &noPreopenedDirectory),
+        shim("fd_prestat_dir_name", &noPreopenedDirectory),
+        shim("fd_seek", &fdSeek),
+        shim("random_get", &randomGet),
+        shim("proc_exit", &procExit),
+        shim("sched_yield", &schedYield),
+    });
+
+    static_assert(std::ranges::equal(ShimTable | std::views::transform([](ShimFunction const& function) {
+                                         return function.preview1.name;
+                                     }),
+                                     AllowedWasiFunctions),
+                  "ShimTable implements AllowedWasiFunctions, in its order");
+} // namespace
+
+std::span<ShimFunction const> shimFunctions() noexcept
+{
+    return ShimTable;
+}
+
+ShimFunction const* findShimFunction(std::string_view name) noexcept
+{
+    auto const row = std::ranges::find_if(
+        ShimTable, [name](ShimFunction const& function) { return function.preview1.name == name; });
+    return row != ShimTable.end() ? &*row : nullptr;
+}
+
+} // namespace vtextension::wasm::wasi
diff --git a/src/vtextension/wasm/wasi/Preview1Shim.hpp b/src/vtextension/wasm/wasi/Preview1Shim.hpp
new file mode 100644
index 000000000..1f61bdf2d
--- /dev/null
+++ b/src/vtextension/wasm/wasi/Preview1Shim.hpp
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The host's own implementation of every allowed WASI preview 1 function, written against guest memory
+// and an injected environment alone, so that every engine binding it behaves the same: no arguments,
+// no environment variables, no preopened directory, and three standard streams that write nowhere.
+// Engine-independent: an engine binds each row under wasm::WasiModule and does nothing but translate.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <span>
+#include <string_view>
+
+#include <vtextension/wasm/wasi/Preview1Signatures.hpp>
+
+namespace vtextension::wasm::wasi
+{
+
+/// A WASI preview 1 clock, by its `clockid` value (a u32 on the wire; every value fits a byte).
+enum class ClockId : uint8_t
+{
+    Realtime = 0,       ///< Wall-clock time, since the Unix epoch.
+    Monotonic = 1,      ///< A clock that never goes back, from an unspecified start.
+    ProcessCputime = 2, ///< The CPU time of the process; not provided (Errno::Nosys).
+    ThreadCputime = 3,  ///< The CPU time of the thread; not provided (Errno::Nosys).
+};
+
+/// What the shim reads from outside guest memory: injected, so that tests are deterministic.
+/// Neither function may throw: an engine calls the shim from code an exception must not unwind through.
+struct ShimEnvironment
+{
+    /// @return The time of the clock @p clockId (ClockId::Realtime or ClockId::Monotonic only), in
+    ///         nanoseconds.
+    std::function<uint64_t(uint32_t clockId)> clock;
+    /// Fills its argument with random bytes.
+    std::function<void(std::span<std::byte>)> random;
+};
+
+/// A WASI preview 1 errno, by its value; only those the shim returns (a u16 on the wire; every value of
+/// preview 1 fits a byte).
+enum class Errno : uint8_t
+{
+    Success = 0, ///< The function succeeded.
+    Badf = 8,    ///< No such file descriptor.
+    Fault = 21,  ///< A pointer the guest passed lies outside its memory.
+    Inval = 28,  ///< An argument is out of range.
+    Nosys = 52,  ///< The function, or the clock asked for, is not provided.
+};
+
+/// How a shim function ended.
+enum class ShimOutcome : uint8_t
+{
+    Returned, ///< It returns its errno to the guest.
+    Exit,     ///< proc_exit: it does not return, and the engine ends the call as a trap.
+};
+
+/// What a shim function ended with.
+struct ShimResult
+{
+    ShimOutcome outcome = ShimOutcome::Returned; ///< How it ended.
+    Errno error = Errno::Success;                ///< Its errno, when it returned.
+
+    bool operator==(ShimResult const&) const = default;
+};
+
+/// Runs one shim function.
+/// @param environment Where clocks and random bytes come from.
+/// @param memory The guest's linear memory; every guest pointer is checked against it.
+/// @param args The guest's arguments, in order, each zero-extended to 64 bits (i32 and i64 alike).
+/// @return How the function ended.
+using ShimCall = ShimResult (*)(ShimEnvironment const& environment,
+                                std::span<std::byte> memory,
+                                std::span<uint64_t const> args);
+
+/// One allowed WASI preview 1 function and its implementation.
+struct ShimFunction
+{
+    Preview1Function preview1; ///< Its name and signature, the row of Preview1Functions.
+    ShimCall call = nullptr;   ///< What a call to it runs.
+};
+
+/// @return One row per entry of AllowedWasiFunctions, in its order.
+[[nodiscard]] std::span<ShimFunction const> shimFunctions() noexcept;
+
+/// @return The shim function named @p name; nullptr if it is not an allowed WASI function.
+[[nodiscard]] ShimFunction const* findShimFunction(std::string_view name) noexcept;
+
+} // namespace vtextension::wasm::wasi
diff --git a/src/vtextension/wasm/wasi/Preview1Shim_test.cpp b/src/vtextension/wasm/wasi/Preview1Shim_test.cpp
new file mode 100644
index 000000000..136f56894
--- /dev/null
+++ b/src/vtextension/wasm/wasi/Preview1Shim_test.cpp
@@ -0,0 +1,395 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The WASI preview 1 shim, function by function, against a plain 64 KiB memory and a deterministic
+// environment; and the environment a process runs it with.
+#include <catch2/catch_test_macros.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <initializer_list>
+#include <limits>
+#include <ranges>
+#include <span>
+#include <string_view>
+#include <vector>
+
+#include <vtextension/wasm/WasiAllowList.hpp>
+#include <vtextension/wasm/wasi/Preview1Shim.hpp>
+#include <vtextension/wasm/wasi/SystemEnvironment.hpp>
+
+using vtextension::wasm::AllowedWasiFunctions;
+using vtextension::wasm::wasi::ClockId;
+using vtextension::wasm::wasi::Errno;
+using vtextension::wasm::wasi::findShimFunction;
+using vtextension::wasm::wasi::ShimEnvironment;
+using vtextension::wasm::wasi::ShimFunction;
+using vtextension::wasm::wasi::shimFunctions;
+using vtextension::wasm::wasi::ShimOutcome;
+using vtextension::wasm::wasi::ShimResult;
+using vtextension::wasm::wasi::systemEnvironment;
+
+namespace
+{
+
+/// The size of the guest memory every case runs against: one WebAssembly page.
+constexpr auto MemoryBytes = uint32_t { 64 } * 1024;
+
+/// A byte the memory is filled with, so that what a function leaves alone shows.
+constexpr auto Untouched = std::byte { 0xEE };
+
+/// The first byte the test environment's random source produces; each next one is one more.
+constexpr auto FirstRandomByte = uint8_t { 0xA0 };
+
+/// @return Nanoseconds from the test environment's clock @p clockId: 1000 plus its id.
+[[nodiscard]] uint64_t testClock(uint32_t clockId)
+{
+    return 1000 + uint64_t { clockId };
+}
+
+/// Fills @p bytes with FirstRandomByte, FirstRandomByte + 1, and so on.
+void testRandom(std::span<std::byte> bytes)
+{
+    auto next = FirstRandomByte;
+    for (auto& byte: bytes)
+        byte = std::byte { next++ };
+}
+
+/// @return An environment whose clocks and random source give the same values on every run.
+[[nodiscard]] ShimEnvironment testEnvironment()
+{
+    return ShimEnvironment { .clock = &testClock, .random = &testRandom };
+}
+
+/// One guest memory, filled with Untouched, and the shim functions called on it.
+class Guest
+{
+  public:
+    /// Calls the shim function @p name with @p args.
+    /// @return What it returned.
+    [[nodiscard]] ShimResult call(std::string_view name, std::initializer_list<uint64_t> args)
+    {
+        auto const* const function = findShimFunction(name);
+        REQUIRE(function != nullptr);
+        auto const arguments = std::vector<uint64_t>(args);
+        REQUIRE(arguments.size() == function->preview1.parameterCount);
+        return function->call(_environment, _memory, arguments);
+    }
+
+    /// @return The errno of a call to @p name with @p args, which must have returned.
+    [[nodiscard]] Errno errnoOf(std::string_view name, std::initializer_list<uint64_t> args)
+    {
+        auto const result = call(name, args);
+        REQUIRE(result.outcome == ShimOutcome::Returned);
+        return result.error;
+    }
+
+    /// @return The little-endian unsigned integer of @p size bytes at @p address.
+    [[nodiscard]] uint64_t load(uint32_t address, uint32_t size) const
+    {
+        auto value = uint64_t { 0 };
+        for (auto const offset: std::views::iota(uint32_t { 0 }, size) | std::views::reverse)
+            value = (value << 8U) | std::to_integer<uint64_t>(_memory.at(address + offset));
+        return value;
+    }
+
+    /// Stores @p value as a little-endian u32 at @p address.
+    void store32(uint32_t address, uint32_t value)
+    {
+        for (auto const offset: std::views::iota(uint32_t { 0 }, uint32_t { 4 }))
+            _memory.at(address + offset) = std::byte { static_cast<uint8_t>(value >> (offset * 8U)) };
+    }
+
+    /// @return Whether the @p size bytes at @p address are all still Untouched.
+    [[nodiscard]] bool isUntouched(uint32_t address, uint32_t size) const
+    {
+        return std::ranges::all_of(std::span { _memory }.subspan(address, size),
+                                   [](std::byte byte) { return byte == Untouched; });
+    }
+
+    /// @return Whether the whole memory is still Untouched.
+    [[nodiscard]] bool isUntouched() const { return isUntouched(0, MemoryBytes); }
+
+  private:
+    ShimEnvironment _environment = testEnvironment();
+    std::vector<std::byte> _memory = std::vector<std::byte>(MemoryBytes, Untouched);
+};
+
+/// The address the last two bytes of the memory start at: no u32 or u64 fits there.
+constexpr auto NearEnd = uint64_t { MemoryBytes - 2 };
+
+/// File descriptors 0 to 2, the standard streams.
+constexpr auto StandardStreams = std::to_array<uint64_t>({ 0, 1, 2 });
+
+/// The rights a standard stream has: fd_seek (bit 2) and fd_write (bit 6), the two the shim implements.
+constexpr auto StandardStreamRights = uint64_t { 0b0100'0100 };
+
+/// The filetype of a character device.
+constexpr auto CharacterDevice = uint64_t { 2 };
+
+} // namespace
+
+TEST_CASE("Preview1Shim.tableMatchesAllowList")
+{
+    auto const functions = shimFunctions();
+    REQUIRE(functions.size() == AllowedWasiFunctions.size());
+    CHECK(std::ranges::equal(functions | std::views::transform([](ShimFunction const& function) {
+                                 return function.preview1.name;
+                             }),
+                             AllowedWasiFunctions));
+    for (auto const& function: functions)
+    {
+        INFO(function.preview1.name);
+        CHECK(function.call != nullptr);
+        CHECK(findShimFunction(function.preview1.name) == &function);
+    }
+    CHECK(findShimFunction("poll_oneoff") == nullptr);
+}
+
+TEST_CASE("Preview1Shim.args_get")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("args_get", { 100, 200 }) == Errno::Success);
+    CHECK(guest.isUntouched()); // There is no argument to write.
+}
+
+TEST_CASE("Preview1Shim.args_sizes_get")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("args_sizes_get", { 100, 104 }) == Errno::Success);
+    CHECK(guest.load(100, 4) == 0); // argc
+    CHECK(guest.load(104, 4) == 0); // the size of the argument strings
+    CHECK(guest.isUntouched(108, 4));
+}
+
+TEST_CASE("Preview1Shim.environ_get")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("environ_get", { 100, 200 }) == Errno::Success);
+    CHECK(guest.isUntouched()); // There is no variable to write.
+}
+
+TEST_CASE("Preview1Shim.environ_sizes_get")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("environ_sizes_get", { 100, 104 }) == Errno::Success);
+    CHECK(guest.load(100, 4) == 0); // the count of variables
+    CHECK(guest.load(104, 4) == 0); // the size of their strings
+    CHECK(guest.isUntouched(108, 4));
+}
+
+TEST_CASE("Preview1Shim.clock_time_get")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("clock_time_get", { 0, 1, 200 }) == Errno::Success);
+    CHECK(guest.load(200, 8) == 1000); // the environment's realtime clock
+    CHECK(guest.errnoOf("clock_time_get", { 1, 1, 208 }) == Errno::Success);
+    CHECK(guest.load(208, 8) == 1001); // its monotonic clock
+    CHECK(guest.isUntouched(216, 4));
+
+    auto fresh = Guest {};
+    // The CPU-time clocks are clocks of preview 1, but the shim keeps an instance's CPU time to itself.
+    CHECK(fresh.errnoOf("clock_time_get", { 2, 1, 200 }) == Errno::Nosys);
+    CHECK(fresh.errnoOf("clock_time_get", { 3, 1, 200 }) == Errno::Nosys);
+    CHECK(fresh.errnoOf("clock_time_get", { 4, 1, 200 }) == Errno::Inval);
+    CHECK(fresh.errnoOf("clock_time_get", { std::numeric_limits<uint32_t>::max(), 1, 200 }) == Errno::Inval);
+    CHECK(fresh.isUntouched());
+}
+
+TEST_CASE("Preview1Shim.clock_res_get")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("clock_res_get", { 0, 200 }) == Errno::Success);
+    CHECK(guest.load(200, 8) == 1);
+    CHECK(guest.errnoOf("clock_res_get", { 1, 208 }) == Errno::Success);
+    CHECK(guest.load(208, 8) == 1);
+
+    auto fresh = Guest {};
+    CHECK(fresh.errnoOf("clock_res_get", { 2, 200 }) == Errno::Nosys);
+    CHECK(fresh.errnoOf("clock_res_get", { 3, 200 }) == Errno::Nosys);
+    CHECK(fresh.errnoOf("clock_res_get", { 4, 200 }) == Errno::Inval);
+    CHECK(fresh.isUntouched());
+}
+
+TEST_CASE("Preview1Shim.fd_write")
+{
+    auto guest = Guest {};
+    // Two buffers, of 5 and 7 bytes; nothing reads what they hold.
+    guest.store32(300, 400);
+    guest.store32(304, 5);
+    guest.store32(308, 500);
+    guest.store32(312, 7);
+    for (auto const fd: StandardStreams)
+    {
+        INFO("fd " << fd);
+        CHECK(guest.errnoOf("fd_write", { fd, 300, 2, 320 }) == Errno::Success);
+        CHECK(guest.load(320, 4) == 12);
+    }
+    CHECK(guest.errnoOf("fd_write", { 1, 300, 0, 324 }) == Errno::Success);
+    CHECK(guest.load(324, 4) == 0);
+    CHECK(guest.isUntouched(400, 5));
+    CHECK(guest.isUntouched(500, 7));
+
+    CHECK(guest.errnoOf("fd_write", { 3, 300, 2, 328 }) == Errno::Badf);
+    CHECK(guest.isUntouched(328, 4));
+
+    // A buffer reaching past the end of the memory.
+    guest.store32(304, MemoryBytes);
+    CHECK(guest.errnoOf("fd_write", { 1, 300, 2, 328 }) == Errno::Fault);
+    CHECK(guest.isUntouched(328, 4));
+}
+
+TEST_CASE("Preview1Shim.fd_write.totalBeyondU32IsInval")
+{
+    // 4100 buffers, each the whole 1 MiB memory: every one lies in the memory, but their total of
+    // 4100 MiB is more than the u32 nwritten holds.
+    constexpr auto Bytes = uint32_t { 1 } << 20U;
+    constexpr auto Buffers = uint32_t { 4100 };
+    auto memory = std::vector<std::byte>(Bytes, std::byte {});
+    for (auto const index: std::views::iota(uint32_t { 0 }, Buffers))
+        for (auto const offset: std::views::iota(uint32_t { 0 }, uint32_t { 4 }))
+            memory.at((index * 8) + 4 + offset) = std::byte { static_cast<uint8_t>(Bytes >> (offset * 8U)) };
+    auto const* const function = findShimFunction("fd_write");
+    REQUIRE(function != nullptr);
+    auto const environment = testEnvironment();
+    auto const args = std::to_array<uint64_t>({ 1, 0, Buffers, Bytes - 4 });
+    CHECK(function->call(environment, memory, args) == ShimResult { ShimOutcome::Returned, Errno::Inval });
+}
+
+TEST_CASE("Preview1Shim.fd_close")
+{
+    auto guest = Guest {};
+    for (auto const fd: StandardStreams)
+        CHECK(guest.errnoOf("fd_close", { fd }) == Errno::Success);
+    // Closing a standard stream leaves the stream: writing to it still succeeds.
+    guest.store32(300, 400);
+    guest.store32(304, 1);
+    CHECK(guest.errnoOf("fd_write", { 1, 300, 1, 320 }) == Errno::Success);
+    CHECK(guest.errnoOf("fd_close", { 3 }) == Errno::Badf);
+}
+
+TEST_CASE("Preview1Shim.fd_fdstat_get")
+{
+    auto guest = Guest {};
+    for (auto const fd: StandardStreams)
+    {
+        INFO("fd " << fd);
+        CHECK(guest.errnoOf("fd_fdstat_get", { fd, 200 }) == Errno::Success);
+        CHECK(guest.load(200, 1) == CharacterDevice); // fs_filetype
+        CHECK(guest.load(202, 2) == 0);               // fs_flags
+        CHECK(guest.load(208, 8) == StandardStreamRights);
+        CHECK(guest.load(216, 8) == 0); // fs_rights_inheriting
+    }
+    CHECK(guest.isUntouched(224, 4));
+
+    auto fresh = Guest {};
+    CHECK(fresh.errnoOf("fd_fdstat_get", { 3, 200 }) == Errno::Badf);
+    CHECK(fresh.isUntouched());
+}
+
+TEST_CASE("Preview1Shim.fd_prestat_get")
+{
+    auto guest = Guest {};
+    // There is no preopened directory, so no descriptor has a prestat.
+    for (auto const fd: { 0, 1, 2, 3, 4 })
+        CHECK(guest.errnoOf("fd_prestat_get", { static_cast<uint64_t>(fd), 200 }) == Errno::Badf);
+    CHECK(guest.isUntouched());
+}
+
+TEST_CASE("Preview1Shim.fd_prestat_dir_name")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("fd_prestat_dir_name", { 3, 200, 16 }) == Errno::Badf);
+    CHECK(guest.isUntouched());
+}
+
+TEST_CASE("Preview1Shim.fd_seek")
+{
+    auto guest = Guest {};
+    for (auto const fd: StandardStreams)
+        for (auto const whence: { 0, 1, 2 })
+        {
+            INFO("fd " << fd << ", whence " << whence);
+            CHECK(guest.errnoOf("fd_seek", { fd, 10, static_cast<uint64_t>(whence), 200 }) == Errno::Success);
+            CHECK(guest.load(200, 8) == 0);
+        }
+    CHECK(guest.isUntouched(208, 4));
+
+    auto fresh = Guest {};
+    CHECK(fresh.errnoOf("fd_seek", { 1, 0, 3, 200 }) == Errno::Inval);
+    CHECK(fresh.errnoOf("fd_seek", { 3, 0, 0, 200 }) == Errno::Badf);
+    CHECK(fresh.isUntouched());
+}
+
+TEST_CASE("Preview1Shim.random_get")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("random_get", { 600, 16 }) == Errno::Success);
+    for (auto const offset: std::views::iota(uint32_t { 0 }, uint32_t { 16 }))
+        CHECK(guest.load(600 + offset, 1) == FirstRandomByte + offset);
+    CHECK(guest.isUntouched(616, 4));
+    CHECK(guest.isUntouched(596, 4));
+    CHECK(guest.errnoOf("random_get", { 700, 0 }) == Errno::Success);
+    CHECK(guest.isUntouched(700, 4));
+}
+
+TEST_CASE("Preview1Shim.proc_exit")
+{
+    auto guest = Guest {};
+    CHECK(guest.call("proc_exit", { 0 }).outcome == ShimOutcome::Exit);
+    CHECK(guest.call("proc_exit", { 3 }).outcome == ShimOutcome::Exit);
+    CHECK(guest.isUntouched());
+}
+
+TEST_CASE("Preview1Shim.sched_yield")
+{
+    auto guest = Guest {};
+    CHECK(guest.errnoOf("sched_yield", {}) == Errno::Success);
+}
+
+TEST_CASE("Preview1Shim.outOfBoundsPointerFaults")
+{
+    auto guest = Guest {};
+    guest.store32(300, 400);
+    guest.store32(304, 1);
+    // Each pointer a function writes or reads, two bytes before the end; the other pointers in bounds.
+    CHECK(guest.errnoOf("args_sizes_get", { NearEnd, 100 }) == Errno::Fault);
+    CHECK(guest.errnoOf("args_sizes_get", { 100, NearEnd }) == Errno::Fault);
+    CHECK(guest.errnoOf("environ_sizes_get", { NearEnd, 100 }) == Errno::Fault);
+    CHECK(guest.errnoOf("environ_sizes_get", { 100, NearEnd }) == Errno::Fault);
+    CHECK(guest.errnoOf("clock_time_get", { 0, 1, NearEnd }) == Errno::Fault);
+    CHECK(guest.errnoOf("clock_res_get", { 0, NearEnd }) == Errno::Fault);
+    CHECK(guest.errnoOf("fd_write", { 1, NearEnd, 1, 100 }) == Errno::Fault);
+    CHECK(guest.errnoOf("fd_write", { 1, 300, 1, NearEnd }) == Errno::Fault);
+    CHECK(guest.errnoOf("fd_fdstat_get", { 1, NearEnd }) == Errno::Fault);
+    CHECK(guest.errnoOf("fd_seek", { 1, 0, 0, NearEnd }) == Errno::Fault);
+    CHECK(guest.errnoOf("random_get", { NearEnd, 4 }) == Errno::Fault);
+    // Functions that write nothing still check where they would: past the end, not even zero bytes fit.
+    CHECK(guest.errnoOf("args_get", { MemoryBytes + 1, 100 }) == Errno::Fault);
+    CHECK(guest.errnoOf("args_get", { 100, MemoryBytes + 1 }) == Errno::Fault);
+    CHECK(guest.errnoOf("environ_get", { MemoryBytes + 1, 100 }) == Errno::Fault);
+    CHECK(guest.errnoOf("environ_get", { 100, MemoryBytes + 1 }) == Errno::Fault);
+    CHECK(guest.errnoOf("random_get", { MemoryBytes + 1, 0 }) == Errno::Fault);
+    // An address that wraps around 32 bits.
+    CHECK(guest.errnoOf("random_get", { std::numeric_limits<uint32_t>::max(), 2 }) == Errno::Fault);
