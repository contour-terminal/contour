new file mode 100644
index 000000000..b1c53b785
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/LaunchSpelling_win32.hpp
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// Windows only: how a launch is spelled for CreateProcessW() -- its command line and its environment block,
+/// in UTF-16 -- and the variables a launch into an AppContainer cannot go without. Pure, so that what the
+/// system parses is tested apart from starting anything.
+
+#include <array>
+#include <functional>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace vtextension::wasm::remote::process
+{
+
+/// One environment variable: its name and its value, in UTF-8.
+using EnvironmentEntry = std::pair<std::string, std::string>;
+
+/// The variables CreateProcessW() points into the AppContainer's own folder as it starts a process in one
+/// (Microsoft's "Launch an AppContainer"), in the environment it is given. Given a block without them it
+/// refuses the launch with ERROR_ENVVAR_NOT_FOUND (203), as a GitHub Windows runner showed; a block with
+/// SystemRoot alone starts uncontained.
+inline constexpr auto ContainerRedirectedVariables =
+    std::to_array<std::string_view>({ "LOCALAPPDATA", "TEMP", "TMP" });
+
+/// @return @p text, UTF-8, as UTF-16; nothing if it is not UTF-8.
+[[nodiscard]] std::optional<std::wstring> wideOf(std::string_view text);
+
+/// Appends @p argument to @p commandLine, quoted as the C runtime's argv parser reads it back.
+void appendArgument(std::wstring& commandLine, std::wstring_view argument);
+
+/// @return The environment block of @p environment: `NAME=value` entries sorted by name as Windows wants
+///         them (ordinal, ignoring case), each NUL-terminated, then one NUL more -- two NULs for an empty
+///         one; nothing if an entry is not UTF-8.
+[[nodiscard]] std::optional<std::wstring> environmentBlock(std::span<EnvironmentEntry const> environment);
+
+/// @param environment The environment a launch was asked for.
+/// @param lookup This process's value of a variable; nothing if it has none.
+/// @return @p environment, with each of ContainerRedirectedVariables it lacks (names compare ignoring case)
+///         given the value @p lookup has for it -- the system replaces it with the container's own folder, so
+///         nothing of this process's reaches the child; one @p lookup has none of is left out.
+[[nodiscard]] std::vector<EnvironmentEntry> containedEnvironment(
+    std::span<EnvironmentEntry const> environment,
+    std::function<std::optional<std::string>(std::string_view name)> const& lookup);
+
+} // namespace vtextension::wasm::remote::process
