diff --git a/src/vtextension/wasm/remote/transport/Channel.hpp b/src/vtextension/wasm/remote/transport/Channel.hpp
new file mode 100644
index 000000000..194f90aba
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/Channel.hpp
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// A reliable, ordered byte channel between Contour and its extension host process: one end of a connected
+/// pair. A Unix-domain stream socket on POSIX, an overlapped named pipe on Windows.
+///
+/// Its I/O blocks. shutdown() is what makes a blocked receive return, from any thread, on both ends.
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <span>
+
+namespace vtextension::wasm::remote::transport
+{
+
+/// Why a channel operation failed.
+enum class ChannelError : uint8_t
+{
+    Closed, ///< The peer closed its end, or this end was shut down.
+    Io,     ///< The operating system reported any other failure.
+};
+
+#ifdef _WIN32
+/// The operating system's name for one end: a pipe HANDLE.
+using NativeHandle = void*;
+#else
+/// The operating system's name for one end: a socket descriptor.
+using NativeHandle = int;
+#endif
+
+/// One end of a connected byte channel. Move-only; the end is closed when its owner is destroyed. A
+/// moved-from channel may only be shut down, assigned to or destroyed.
+class Channel
+{
+  public:
+    /// The platform's state of one end; defined by Channel_posix.cpp or Channel_win32.cpp.
+    struct Native;
+
+    /// Takes ownership of an open end.
+    /// @param native The end. Never null.
+    explicit Channel(std::unique_ptr<Native> native) noexcept;
+    ~Channel();
+    Channel(Channel&&) noexcept;
+    Channel& operator=(Channel&&) noexcept;
+    Channel(Channel const&) = delete;
+    Channel& operator=(Channel const&) = delete;
+
+    /// Sends all of @p bytes, blocking until the channel took them.
+    /// @param bytes The bytes to send.
+    /// @return Nothing once every byte is sent; `Closed` if the peer is gone or this end was shut down.
+    [[nodiscard]] std::expected<void, ChannelError> send(std::span<uint8_t const> bytes);
+
+    /// Receives at least one byte, blocking until one arrives.
+    /// @param buffer Where the bytes go. Not empty.
+    /// @return How many bytes arrived, at least one; `Closed` at the peer's end of stream, or once this end
+    ///         was shut down.
+    [[nodiscard]] std::expected<std::size_t, ChannelError> receiveSome(std::span<uint8_t> buffer);
+
+    /// Ends the stream, both ways and for both ends: a receive or send blocked on this end now, from any
+    /// thread, returns `Closed`, as does every later one; and the peer's stream ends as if this end were
+    /// closed, so that its receives return `Closed` once they drained what was sent before, and its sends
+    /// return `Closed`. Idempotent and thread-safe.
+    ///
+    /// On POSIX the descriptor stays open until the channel is destroyed. On Windows, where nothing short of
+    /// closing a pipe's handle ends the peer's stream, the handle is closed as soon as no transfer on this
+    /// end is in flight, and nativeHandle() no longer names it.
+    void shutdown() noexcept;
+
+    /// @return The end's descriptor or handle, still owned by the channel: for handing it to a child
+    ///         process, and for inspecting it. On Windows, INVALID_HANDLE_VALUE once shutdown() closed it.
+    ///         Not to be called, nor its value used, while another thread may call shutdown(): on Windows the
+    ///         handle may be closed, and its value reused, at any moment after shutdown() begins.
+    [[nodiscard]] NativeHandle nativeHandle() const noexcept;
+
+  private:
+    std::unique_ptr<Native> _native;
+};
+
+/// Two connected ends: what one sends, the other receives.
+struct ChannelPair
+{
+    Channel parent; ///< Contour's end.
+    Channel helper; ///< The extension host process's end.
+};
+
+/// Creates a connected pair. Neither end is inherited by a child process unless it is handed over on
+/// purpose.
+/// @return The pair; `Io` if the operating system refused.
+[[nodiscard]] std::expected<ChannelPair, ChannelError> makeChannelPair();
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/Channel_posix.cpp b/src/vtextension/wasm/remote/transport/Channel_posix.cpp
new file mode 100644
index 000000000..9c1f802e6
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/Channel_posix.cpp
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The channel on POSIX: a connected pair of Unix-domain stream sockets, close-on-exec, whose writes never
+// raise SIGPIPE. Shutting an end down is ::shutdown(), which wakes a reader blocked on it; the descriptor is
+// closed only when the channel is destroyed, so that no thread can find its number reused.
+#include <sys/socket.h>
+#include <sys/types.h>
+
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <span>
+#include <utility>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+#ifdef MSG_NOSIGNAL
+    /// Fails a write to a closed peer with EPIPE instead of raising SIGPIPE.
+    constexpr auto SendFlags = MSG_NOSIGNAL;
+#else
+    // macOS has no MSG_NOSIGNAL; its sockets carry SO_NOSIGPIPE instead (configureEnd).
+    constexpr auto SendFlags = 0;
+#endif
+
+    /// @return Why a call that set @p error failed, for the channel.
+    [[nodiscard]] ChannelError channelErrorOf(int error) noexcept
+    {
+        switch (error)
+        {
+            case EPIPE:
+            case ECONNRESET:
+            case ENOTCONN:
+            case ESHUTDOWN: return ChannelError::Closed;
+            default: return ChannelError::Io;
+        }
+    }
+
+    /// Makes @p descriptor close-on-exec and SIGPIPE-free where socketpair() could not ask for that itself.
+    /// @return Whether it succeeded.
+    [[nodiscard]] std::expected<void, ChannelError> configureEnd([[maybe_unused]] int descriptor) noexcept
+    {
+#ifndef SOCK_CLOEXEC
+        if (::fcntl(descriptor, F_SETFD, FD_CLOEXEC) == -1)
+            return std::unexpected(ChannelError::Io);
+#endif
+#ifdef SO_NOSIGPIPE
+        auto const enable = 1;
+        if (::setsockopt(descriptor, SOL_SOCKET, SO_NOSIGPIPE, &enable, sizeof(enable)) == -1)
+            return std::unexpected(ChannelError::Io);
+#endif
+        return {};
+    }
+} // namespace
+
+/// One socket of the pair, closed when it is destroyed.
+struct Channel::Native
+{
+    int descriptor = -1;
+
+    explicit Native(int descriptor) noexcept: descriptor { descriptor } {}
+    ~Native()
+    {
+        if (descriptor != -1)
+            ::close(descriptor);
+    }
+    Native(Native const&) = delete;
+    Native& operator=(Native const&) = delete;
+    Native(Native&&) = delete;
+    Native& operator=(Native&&) = delete;
+};
+
+Channel::Channel(std::unique_ptr<Native> native) noexcept: _native { std::move(native) }
+{
+}
+
+Channel::~Channel() = default;
+Channel::Channel(Channel&&) noexcept = default;
+Channel& Channel::operator=(Channel&&) noexcept = default;
+
+std::expected<void, ChannelError> Channel::send(std::span<uint8_t const> bytes)
+{
+    while (!bytes.empty())
+    {
+        auto const sent = ::send(_native->descriptor, bytes.data(), bytes.size(), SendFlags);
+        if (sent == -1)
+        {
+            if (errno == EINTR)
+                continue;
+            return std::unexpected(channelErrorOf(errno));
+        }
+        bytes = bytes.subspan(static_cast<std::size_t>(sent));
+    }
+    return {};
+}
+
+std::expected<std::size_t, ChannelError> Channel::receiveSome(std::span<uint8_t> buffer)
+{
+    while (true)
+    {
+        auto const received = ::recv(_native->descriptor, buffer.data(), buffer.size(), 0);
+        if (received > 0)
+            return static_cast<std::size_t>(received);
+        if (received == 0)
+            return std::unexpected(ChannelError::Closed);
+        if (errno != EINTR)
+            return std::unexpected(channelErrorOf(errno));
+    }
+}
+
+void Channel::shutdown() noexcept
+{
+    if (_native)
+        ::shutdown(_native->descriptor, SHUT_RDWR);
+}
+
+NativeHandle Channel::nativeHandle() const noexcept
+{
+    return _native ? _native->descriptor : -1;
+}
+
+std::expected<ChannelPair, ChannelError> makeChannelPair()
+{
+    auto descriptors = std::array<int, 2> { -1, -1 };
+#ifdef SOCK_CLOEXEC
+    constexpr auto SocketType = SOCK_STREAM | SOCK_CLOEXEC;
+#else
+    constexpr auto SocketType = SOCK_STREAM;
+#endif
+    if (::socketpair(AF_UNIX, SocketType, 0, descriptors.data()) == -1)
+        return std::unexpected(ChannelError::Io);
+    auto parent = std::make_unique<Channel::Native>(descriptors[0]);
+    auto helper = std::make_unique<Channel::Native>(descriptors[1]);
+    return configureEnd(parent->descriptor)
+        .and_then([&] { return configureEnd(helper->descriptor); })
+        .transform([&] {
+            return ChannelPair { .parent = Channel { std::move(parent) },
+                                 .helper = Channel { std::move(helper) } };
+        });
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/Channel_test.cpp b/src/vtextension/wasm/remote/transport/Channel_test.cpp
new file mode 100644
index 000000000..d4bfbf89b
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/Channel_test.cpp
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The byte channel between Contour and its extension host process: both ways, closing, and what a child
+// process does not inherit.
+#include <catch2/catch_test_macros.hpp>
+
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <future>
+#include <optional>
+#include <span>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+#ifdef _WIN32
+    #define WIN32_LEAN_AND_MEAN
+    #define NOMINMAX
+    #include <Windows.h>
+#else
+    #include <csignal>
+
+    #include <fcntl.h>
+#endif
+
+using vtextension::wasm::remote::transport::Channel;
+using vtextension::wasm::remote::transport::ChannelError;
+using vtextension::wasm::remote::transport::makeChannelPair;
+
+namespace
+{
+
+/// @return Exactly @p count bytes received off @p channel; nothing if it failed first.
+[[nodiscard]] std::optional<std::vector<uint8_t>> receiveExactly(Channel& channel, std::size_t count)
+{
+    auto received = std::vector<uint8_t>(count);
+    auto filled = std::size_t { 0 };
+    while (filled < count)
+    {
+        auto const some = channel.receiveSome(std::span { received }.subspan(filled));
+        if (!some)
+            return std::nullopt;
+        filled += *some;
+    }
+    return received;
+}
+
+} // namespace
+
+TEST_CASE("Channel.pairCarriesBytesBothWays", "[vtextension]")
+{
+    auto pair = makeChannelPair();
+    REQUIRE(pair.has_value());
+
+    auto const request = std::vector<uint8_t> { 1, 2, 3, 4, 5 };
+    REQUIRE(pair->parent.send(request).has_value());
+    CHECK(receiveExactly(pair->helper, request.size()) == request);
+
+    // Larger than any socket buffer: the sender blocks until the receiver drains it.
+    auto const reply = std::vector<uint8_t>(std::size_t { 4 } * 1024 * 1024, uint8_t { 0x5a });
+    auto sent = std::async(std::launch::async, [&] { return pair->helper.send(reply); });
+    CHECK(receiveExactly(pair->parent, reply.size()) == reply);
+    CHECK(sent.get().has_value());
+}
+
+TEST_CASE("Channel.shutdownUnblocksReceive", "[vtextension]")
+{
+    auto pair = makeChannelPair();
+    REQUIRE(pair.has_value());
+
+    auto result = std::promise<std::expected<std::size_t, ChannelError>> {};
+    auto received = result.get_future();
+    auto reader = std::jthread { [&] {
+        auto buffer = std::array<uint8_t, 16> {};
+        result.set_value(pair->parent.receiveSome(buffer));
+    } };
+    // Whether the reader blocked before the shutdown or arrives after it, it returns Closed.
+    std::this_thread::sleep_for(std::chrono::milliseconds { 50 });
+    pair->parent.shutdown();
+    CHECK(received.get() == std::unexpected(ChannelError::Closed));
+
+    // And so does every later receive and send on that end.
+    auto buffer = std::array<uint8_t, 16> {};
+    CHECK(pair->parent.receiveSome(buffer) == std::unexpected(ChannelError::Closed));
+    CHECK(pair->parent.send(std::vector<uint8_t> { 1 }) == std::unexpected(ChannelError::Closed));
+}
+
+TEST_CASE("Channel.shutdownEndsThePeersStream", "[vtextension]")
+{
+    auto pair = makeChannelPair();
+    REQUIRE(pair.has_value());
+
+    auto result = std::promise<std::expected<std::size_t, ChannelError>> {};
+    auto received = result.get_future();
+    auto peer = std::jthread { [&] {
+        auto buffer = std::array<uint8_t, 16> {};
+        result.set_value(pair->helper.receiveSome(buffer));
+    } };
+    // Whether the peer blocked before the shutdown or arrives after it, its stream has ended.
+    std::this_thread::sleep_for(std::chrono::milliseconds { 50 });
+    pair->parent.shutdown();
+    CHECK(received.get() == std::unexpected(ChannelError::Closed));
+    CHECK(pair->helper.send(std::vector<uint8_t>(1024, uint8_t { 1 }))
+          == std::unexpected(ChannelError::Closed));
+}
+
+TEST_CASE("Channel.peerCloseEndsTheStream", "[vtextension]")
+{
+    auto pair = makeChannelPair();
+    REQUIRE(pair.has_value());
+    {
+        auto const helper = std::move(pair->helper);
+    }
+    auto buffer = std::array<uint8_t, 16> {};
+    CHECK(pair->parent.receiveSome(buffer) == std::unexpected(ChannelError::Closed));
+}
+
+TEST_CASE("Channel.sendToClosedPeerFails", "[vtextension]")
+{
+    auto pair = makeChannelPair();
+    REQUIRE(pair.has_value());
+#ifndef _WIN32
+    struct sigaction before {};
+    REQUIRE(::sigaction(SIGPIPE, nullptr, &before) == 0);
+#endif
+    {
+        auto const helper = std::move(pair->helper);
+    }
+    CHECK(pair->parent.send(std::vector<uint8_t>(1024, uint8_t { 1 }))
+          == std::unexpected(ChannelError::Closed));
+#ifndef _WIN32
+    // The process survived the write without a SIGPIPE, and without anyone having to ignore the signal.
+    struct sigaction after {};
+    REQUIRE(::sigaction(SIGPIPE, nullptr, &after) == 0);
+    CHECK(after.sa_handler == before.sa_handler);
+#endif
+}
+
+#ifndef _WIN32
+TEST_CASE("Channel.endsAreCloseOnExec", "[vtextension]")
+{
+    auto pair = makeChannelPair();
+    REQUIRE(pair.has_value());
+    for (auto const* channel: { &pair->parent, &pair->helper })
+    {
+        auto const flags = ::fcntl(channel->nativeHandle(), F_GETFD);
+        REQUIRE(flags != -1);
+        CHECK((flags & FD_CLOEXEC) != 0);
+    }
+}
+#endif
+
+#ifdef _WIN32
+TEST_CASE("Channel.endsAreNotInheritable", "[vtextension]")
+{
+    auto pair = makeChannelPair();
+    REQUIRE(pair.has_value());
+    for (auto const* channel: { &pair->parent, &pair->helper })
+    {
+        auto flags = DWORD { 0 };
+        REQUIRE(::GetHandleInformation(channel->nativeHandle(), &flags));
+        CHECK((flags & HANDLE_FLAG_INHERIT) == 0);
+    }
+}
+#endif
diff --git a/src/vtextension/wasm/remote/transport/Channel_win32.cpp b/src/vtextension/wasm/remote/transport/Channel_win32.cpp
new file mode 100644
index 000000000..3de64af8f
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/Channel_win32.cpp
@@ -0,0 +1,359 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The channel on Windows: the two ends of a byte-mode named pipe, opened for overlapped I/O and waited on, so
+// that shutdown() can cancel a read or write blocked on another thread. The pipe's name is random, the first
+// instance is demanded (so that a pipe someone else created first fails the pair rather than joins it),
+// remote clients are refused, only the current user may open it, and neither handle is inheritable.
+//
+// A pipe has no half-close: its peer's stream ends only when this end's handle is closed. So shutdown()
+// cancels what is in flight and closes the handle as soon as the last transfer on it has returned. Every
+// transfer, and shutdown()'s own cancel, is counted while it may touch the handle, each counting itself
+// before it reads or changes the state; whichever finds the end shut down with nothing in flight closes the
+// handle, exactly once (a compare-exchange from ShutDown to Closed). All of it is sequentially consistent.
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <format>
+#include <memory>
+#include <random>
+#include <span>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <Windows.h>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+    /// How large the pipe's buffers are, each way.
+    constexpr auto PipeBufferBytes = DWORD { 64 * 1024 };
+
+    /// The most bytes one ReadFile or WriteFile moves.
+    constexpr auto MaxTransferBytes = std::size_t { 1024 } * 1024 * 1024;
+
+    /// Where an end is in its life.
+    enum class EndState : uint8_t
+    {
+        Open,     ///< Transfers run.
+        ShutDown, ///< Transfers fail `Closed`; the handle is closed once none is in flight.
+        Closed,   ///< The handle is closed.
+    };
+
+    /// An event an overlapped operation signals, closed with it.
+    class OverlappedEvent
+    {
+      public:
+        OverlappedEvent() noexcept: _event { ::CreateEventW(nullptr, TRUE, FALSE, nullptr) } {}
+        ~OverlappedEvent()
+        {
+            if (_event)
+                ::CloseHandle(_event);
+        }
+        OverlappedEvent(OverlappedEvent const&) = delete;
+        OverlappedEvent& operator=(OverlappedEvent const&) = delete;
+        OverlappedEvent(OverlappedEvent&&) = delete;
+        OverlappedEvent& operator=(OverlappedEvent&&) = delete;
+
+        /// @return The event; null if it could not be created.
+        [[nodiscard]] HANDLE handle() const noexcept { return _event; }
+
+      private:
+        HANDLE _event;
+    };
+
+    /// @return Why a call that set @p error failed, for the channel.
+    [[nodiscard]] ChannelError channelErrorOf(DWORD error) noexcept
+    {
+        switch (error)
+        {
+            case ERROR_BROKEN_PIPE:
+            case ERROR_NO_DATA:
+            case ERROR_PIPE_NOT_CONNECTED:
+            case ERROR_OPERATION_ABORTED: return ChannelError::Closed;
+            default: return ChannelError::Io;
+        }
+    }
+
+    /// @return A pipe name no other pair uses: this process, a serial and 64 random bits.
+    [[nodiscard]] std::wstring uniquePipeName()
+    {
+        static auto serial = std::atomic<uint64_t> { 0 };
+        auto source = std::random_device {};
+        auto const high = static_cast<uint64_t>(source());
+        auto const random = (high << 32) | source();
+        return std::format(L"\\\\.\\pipe\\contour-extension-host-{}-{}-{:016x}",
+                           ::GetCurrentProcessId(),
+                           serial.fetch_add(1),
+                           random);
+    }
+
+    /// Closes a handle that is not owned by a channel yet.
+    struct HandleCloser
+    {
+        void operator()(HANDLE handle) const noexcept { ::CloseHandle(handle); }
+    };
+    using OwnedHandle = std::unique_ptr<void, HandleCloser>;
+
+    /// @return @p handle owned; nothing if it is INVALID_HANDLE_VALUE, as a failed create returns.
+    [[nodiscard]] OwnedHandle own(HANDLE handle) noexcept
+    {
+        return OwnedHandle { handle == INVALID_HANDLE_VALUE ? nullptr : handle };
+    }
+
+    /// Security attributes that let only the current user open the pipe, and no child inherit it. Not
+    /// movable: the attributes point into the descriptor, and the descriptor into the ACL.
+    class OwnerOnlySecurity
+    {
+        struct Key
+        {
+        };
+
+      public:
+        /// Builds a DACL with one entry, granting the process's user full access.
+        /// @return The attributes; `Io` if the token could not be read or the ACL not made.
+        [[nodiscard]] static std::expected<std::unique_ptr<OwnerOnlySecurity>, ChannelError> create()
+        {
+            auto security = std::make_unique<OwnerOnlySecurity>(Key {});
+            auto token = HANDLE { nullptr };
+            if (!::OpenProcessToken(::GetCurrentProcess(), TOKEN_QUERY, &token))
+                return std::unexpected(ChannelError::Io);
+            auto const tokenOwner = OwnedHandle { token };
+            auto size = DWORD { 0 };
+            ::GetTokenInformation(token, TokenUser, nullptr, 0, &size);
+            if (size == 0)
+                return std::unexpected(ChannelError::Io);
+            // uint64_t storage, so that the TOKEN_USER and the ACL are aligned as their headers need.
+            auto tokenUser = std::vector<uint64_t>((size + sizeof(uint64_t) - 1) / sizeof(uint64_t));
+            if (!::GetTokenInformation(token, TokenUser, tokenUser.data(), size, &size))
+                return std::unexpected(ChannelError::Io);
+            auto* const user = reinterpret_cast<TOKEN_USER const*>(tokenUser.data())->User.Sid;
+
+            auto const aclBytes = sizeof(ACL) + sizeof(ACCESS_ALLOWED_ACE) + ::GetLengthSid(user);
+            security->_acl.resize((aclBytes + sizeof(uint64_t) - 1) / sizeof(uint64_t));
+            auto* const acl = reinterpret_cast<ACL*>(security->_acl.data());
+            // The ACE copies the SID, so the token's buffer may go once it is added.
+            if (!::InitializeAcl(
+                    acl, static_cast<DWORD>(security->_acl.size() * sizeof(uint64_t)), ACL_REVISION)
+                || !::AddAccessAllowedAce(acl, ACL_REVISION, GENERIC_ALL, user)
+                || !::InitializeSecurityDescriptor(&security->_descriptor, SECURITY_DESCRIPTOR_REVISION)
+                || !::SetSecurityDescriptorDacl(&security->_descriptor, TRUE, acl, FALSE))
+                return std::unexpected(ChannelError::Io);
+            security->_attributes = SECURITY_ATTRIBUTES { .nLength = sizeof(SECURITY_ATTRIBUTES),
+                                                          .lpSecurityDescriptor = &security->_descriptor,
+                                                          .bInheritHandle = FALSE };
+            return security;
+        }
+
+        /// Constructs empty attributes; only create() can, and it fills them before handing them out.
+        explicit OwnerOnlySecurity(Key /*key*/) noexcept {}
+        OwnerOnlySecurity(OwnerOnlySecurity const&) = delete;
+        OwnerOnlySecurity& operator=(OwnerOnlySecurity const&) = delete;
+        OwnerOnlySecurity(OwnerOnlySecurity&&) = delete;
+        OwnerOnlySecurity& operator=(OwnerOnlySecurity&&) = delete;
+        ~OwnerOnlySecurity() = default;
+
+        /// @return The attributes to create both ends with.
+        [[nodiscard]] SECURITY_ATTRIBUTES* attributes() noexcept { return &_attributes; }
+
+      private:
+        std::vector<uint64_t> _acl;
+        SECURITY_DESCRIPTOR _descriptor {};
+        SECURITY_ATTRIBUTES _attributes {};
+    };
+} // namespace
+
+/// One end of the pipe: closed by shutdown() once it drained, or else when it is destroyed.
+struct Channel::Native
+{
+    HANDLE pipe;
+    std::atomic<EndState> state { EndState::Open };
+    /// Who may touch the handle: every transfer in flight, and every shutdown() from before its state change
+    /// until after its cancel, so that no close slips in ahead of that cancel.
+    std::atomic<uint32_t> inFlight { 0 };
+
+    explicit Native(HANDLE pipe) noexcept: pipe { pipe } {}
+    ~Native()
+    {
+        if (state.load() != EndState::Closed)
+            ::CloseHandle(pipe);
+    }
+    Native(Native const&) = delete;
+    Native& operator=(Native const&) = delete;
+    Native(Native&&) = delete;
+    Native& operator=(Native&&) = delete;
+
+    /// Closes the handle if the end is shut down and nothing is in flight; whoever gets here first does.
+    void closeIfDrained() noexcept
+    {
+        if (inFlight.load() != 0)
+            return;
+        auto expected = EndState::ShutDown;
+        if (state.compare_exchange_strong(expected, EndState::Closed))
+            ::CloseHandle(pipe);
+    }
+
+    /// Runs one overlapped transfer to completion, or until the end is shut down.
+    /// @param start Starts it: ReadFile or WriteFile on the pipe with the given OVERLAPPED.
+    /// @return How many bytes it moved.
+    template <typename Start>
+    [[nodiscard]] std::expected<std::size_t, ChannelError> transfer(Start start)
+    {
+        // Counted before the state is read, and shutdown() stores the state before it reads the count: either
+        // this sees the end shut down, or shutdown() sees this in flight and leaves the handle to it.
+        inFlight.fetch_add(1);
+        auto const result = transferCounted(start);
+        inFlight.fetch_sub(1);
+        if (state.load() != EndState::Open)
+            closeIfDrained();
+        return result;
+    }
+
+  private:
+    template <typename Start>
+    [[nodiscard]] std::expected<std::size_t, ChannelError> transferCounted(Start start)
+    {
+        if (state.load() != EndState::Open)
+            return std::unexpected(ChannelError::Closed);
+        auto const event = OverlappedEvent {};
+        if (!event.handle())
+            return std::unexpected(ChannelError::Io);
+        auto overlapped = OVERLAPPED {};
+        overlapped.hEvent = event.handle();
+        if (!start(overlapped))
+        {
+            auto const error = ::GetLastError();
+            if (error != ERROR_IO_PENDING)
+                return std::unexpected(channelErrorOf(error));
+        }
+        // shutdown() sets the state before it cancels: a transfer started before the cancel is cancelled by
+        // it, and one started after sees the state here and cancels itself.
+        if (state.load() != EndState::Open)
+            ::CancelIoEx(pipe, &overlapped);
+        auto moved = DWORD { 0 };
+        if (!::GetOverlappedResult(pipe, &overlapped, &moved, TRUE))
+            return std::unexpected(channelErrorOf(::GetLastError()));
+        if (state.load() != EndState::Open)
+            return std::unexpected(ChannelError::Closed);
+        return static_cast<std::size_t>(moved);
+    }
+};
+
+Channel::Channel(std::unique_ptr<Native> native) noexcept: _native { std::move(native) }
+{
+}
+
+Channel::~Channel() = default;
+Channel::Channel(Channel&&) noexcept = default;
+Channel& Channel::operator=(Channel&&) noexcept = default;
+
+std::expected<void, ChannelError> Channel::send(std::span<uint8_t const> bytes)
+{
+    while (!bytes.empty())
+    {
+        auto const chunk = bytes.first(std::min(bytes.size(), MaxTransferBytes));
+        auto const sent = _native->transfer([&](OVERLAPPED& overlapped) {
+            return ::WriteFile(
+                _native->pipe, chunk.data(), static_cast<DWORD>(chunk.size()), nullptr, &overlapped);
+        });
+        if (!sent)
+            return std::unexpected(sent.error());
+        bytes = bytes.subspan(*sent);
+    }
+    return {};
+}
+
+std::expected<std::size_t, ChannelError> Channel::receiveSome(std::span<uint8_t> buffer)
+{
+    auto const chunk = buffer.first(std::min(buffer.size(), MaxTransferBytes));
+    auto const received = _native->transfer([&](OVERLAPPED& overlapped) {
+        return ::ReadFile(
+            _native->pipe, chunk.data(), static_cast<DWORD>(chunk.size()), nullptr, &overlapped);
+    });
+    if (received && *received == 0)
+        return std::unexpected(ChannelError::Closed);
+    return received;
+}
+
+void Channel::shutdown() noexcept
+{
+    if (!_native)
+        return;
+    // Counted, as a transfer is, before the state changes: a closer acts only once it sees the end shut down,
+    // which is after this count is visible, so it finds the count non-zero until the cancel is done. Counting
+    // after the state change would leave a window where a finishing transfer closes the handle, and the
+    // cancel then reaches a closed handle whose value the system may already have handed out again.
+    _native->inFlight.fetch_add(1);
+    auto expected = EndState::Open;
+    auto const shutsDown = _native->state.compare_exchange_strong(expected, EndState::ShutDown);
+    if (shutsDown)
+        ::CancelIoEx(_native->pipe, nullptr);
+    _native->inFlight.fetch_sub(1);
+    // Even a repeated shutdown() closes if it drained last: a transfer that finished while this one was
+    // counted left the close to it.
+    _native->closeIfDrained();
+}
+
+NativeHandle Channel::nativeHandle() const noexcept
+{
+    return _native && _native->state.load() != EndState::Closed ? _native->pipe : INVALID_HANDLE_VALUE;
+}
+
+std::expected<ChannelPair, ChannelError> makeChannelPair()
+{
+    auto const security = OwnerOnlySecurity::create();
+    if (!security)
+        return std::unexpected(security.error());
+
+    auto const name = uniquePipeName();
+    auto server =
+        own(::CreateNamedPipeW(name.c_str(),
+                               PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE,
+                               PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS,
+                               1,
+                               PipeBufferBytes,
+                               PipeBufferBytes,
+                               0,
+                               (*security)->attributes()));
+    if (!server)
+        return std::unexpected(ChannelError::Io);
+    auto client = own(::CreateFileW(name.c_str(),
+                                    GENERIC_READ | GENERIC_WRITE,
+                                    0,
+                                    (*security)->attributes(),
+                                    OPEN_EXISTING,
+                                    FILE_FLAG_OVERLAPPED,
+                                    nullptr));
+    if (!client)
+        return std::unexpected(ChannelError::Io);
+    // The client connected when it opened the pipe; the server's connect only confirms it.
+    auto const event = OverlappedEvent {};
+    if (!event.handle())
+        return std::unexpected(ChannelError::Io);
+    auto overlapped = OVERLAPPED {};
+    overlapped.hEvent = event.handle();
+    if (!::ConnectNamedPipe(server.get(), &overlapped))
+    {
+        auto const error = ::GetLastError();
+        auto connected = DWORD { 0 };
+        if (error == ERROR_IO_PENDING)
+        {
+            if (!::GetOverlappedResult(server.get(), &overlapped, &connected, TRUE))
+                return std::unexpected(ChannelError::Io);
+        }
+        else if (error != ERROR_PIPE_CONNECTED)
+            return std::unexpected(ChannelError::Io);
+    }
+    return ChannelPair { .parent = Channel { std::make_unique<Channel::Native>(server.release()) },
+                         .helper = Channel { std::make_unique<Channel::Native>(client.release()) } };
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/PduStream.cpp b/src/vtextension/wasm/remote/transport/PduStream.cpp
new file mode 100644
index 000000000..f09bf0720
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/PduStream.cpp
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/transport/PduStream.hpp>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <span>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/remote/proto/Codec.hpp>
+#include <vtextension/wasm/remote/proto/PduTable.hpp>
+#include <vtextension/wasm/remote/proto/Wire.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+    /// How many bytes a receive asks the channel for at least. A frame larger than this grows the buffer to
+    /// hold it; the buffer drops back to this once it drains, so that one large module does not pin its size.
+    constexpr auto ReceiveChunk = std::size_t { 64 } * 1024;
+
+    /// @return The stream's reason for a channel's failure.
+    [[nodiscard]] StreamError streamErrorOf(ChannelError error) noexcept
+    {
+        switch (error)
+        {
+            case ChannelError::Closed: return StreamError::Closed;
+            case ChannelError::Io: return StreamError::Io;
+        }
+        return StreamError::Io;
+    }
+
+    /// @return How many bytes of @p frame, one encodeFrame() made, its body spans: its length less the kind's
+    ///         one byte.
+    [[nodiscard]] uint64_t bodySizeOf(std::span<uint8_t const> frame) noexcept
+    {
+        auto header = proto::Reader { frame };
+        return header.varint64().value_or(1) - 1;
+    }
+
+    /// @return The stream's reason for a frame the codec refused; never called with NeedMoreData.
+    [[nodiscard]] StreamError streamErrorOf(proto::DecodeError error) noexcept
+    {
+        return error == proto::DecodeError::OverCap ? StreamError::OverCap : StreamError::Malformed;
+    }
+} // namespace
+
+PduStream::PduStream(Channel channel,
+                     proto::ChannelKind kind,
+                     proto::Direction arriving,
+                     proto::PduLimits limits):
+    _channel { std::move(channel) }, _kind { kind }, _arriving { arriving }, _limits { limits }
+{
+}
+
+std::expected<void, StreamError> PduStream::send(proto::Pdu const& pdu)
+{
+    // A PDU the peer would refuse is not sent: the stream stays usable, and the caller learns why. The
+    // encoder checks every list against its cap; the body's bytes are checked here, against the cap the
+    // peer's reader applies under the same limits.
+    auto const frame = proto::encodeFrame(pdu);
+    if (!frame
+        || bodySizeOf(*frame) > proto::PduTable[std::to_underlying(proto::kindOf(pdu)) - 1].sizeCap(_limits))
+        return std::unexpected(StreamError::OverCap);
+    return _channel.send(*frame).transform_error([](ChannelError error) { return streamErrorOf(error); });
+}
+
+std::expected<proto::Pdu, StreamError> PduStream::receive()
+{
+    while (true)
+    {
+        auto decoded = proto::decodeFrame(std::span { _buffer }.first(_buffered), _arriving, _kind, _limits);
+        if (decoded)
+        {
+            // Moves what follows the frame to the front, and lets a buffer a large frame grew go.
+            std::ranges::copy(std::span { _buffer }.subspan(decoded->consumed, _buffered - decoded->consumed),
+                              _buffer.begin());
+            _buffered -= decoded->consumed;
+            if (_buffered == 0 && _buffer.size() > ReceiveChunk)
+                _buffer = std::vector<uint8_t> {};
+            return std::move(decoded->pdu);
+        }
+        if (decoded.error() != proto::DecodeError::NeedMoreData)
+            return std::unexpected(streamErrorOf(decoded.error()));
+
+        if (_buffer.size() - _buffered < ReceiveChunk)
+            _buffer.resize(std::max(_buffered + ReceiveChunk, _buffer.size() * 2));
+        auto const received = _channel.receiveSome(std::span { _buffer }.subspan(_buffered));
+        if (!received)
+            return std::unexpected(streamErrorOf(received.error()));
+        _buffered += *received;
+    }
+}
+
+void PduStream::shutdown() noexcept
+{
+    _channel.shutdown();
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/PduStream.hpp b/src/vtextension/wasm/remote/transport/PduStream.hpp
new file mode 100644
index 000000000..439ff6633
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/PduStream.hpp
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// PDUs over a Channel: frames what it sends, and reads whole frames back, refusing any the codec refuses.
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <vector>
+
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+/// Why a stream could not send or receive a PDU. Every one ends the stream, except an OverCap from send(),
+/// which sent nothing.
+enum class StreamError : uint8_t
+{
+    Closed,    ///< The channel closed, or was shut down.
+    Io,        ///< The channel failed.
+    Malformed, ///< The peer sent a frame the codec refuses: a malformed one, or one of the wrong kind,
+               ///< direction or channel.
+    OverCap,   ///< The peer sent a frame larger than its kind may be; or, from send(), the PDU holds a
+               ///< list over its cap or is larger than its kind may be, and was not sent.
+};
+
+/// One channel's PDUs. Owns the channel and a receive buffer; used by one thread at a time, which may both
+/// send and receive.
+class PduStream
+{
+  public:
+    /// @param channel The channel it reads and writes.
+    /// @param kind Which channel it is: a PDU of the other is refused.
+    /// @param arriving The way PDUs it receives travel: a PDU travelling the other way is refused.
+    /// @param limits The caps of the PDUs whose size follows the stream's limits.
+    PduStream(Channel channel, proto::ChannelKind kind, proto::Direction arriving, proto::PduLimits limits);
+
+    /// Sends one PDU.
+    /// @param pdu The PDU.
+    /// @return Nothing once it is sent; why it was not. `OverCap` if a list it carries exceeds its cap
+    ///         (Pdu.hpp), or its body exceeds its kind's byte cap under the stream's limits (PduTable.hpp):
+    ///         nothing was sent, and the stream remains usable.
+    [[nodiscard]] std::expected<void, StreamError> send(proto::Pdu const& pdu);
+
+    /// Receives the next PDU, blocking until all of it has arrived. A frame larger than its kind may be fails
+    /// as soon as its header arrives, without waiting for its body.
+    /// @return The PDU; why none could be received.
+    [[nodiscard]] std::expected<proto::Pdu, StreamError> receive();
+
+    /// Shuts the channel down: a receive blocked on it, from any thread, fails `Closed`.
+    void shutdown() noexcept;
+
+  private:
+    Channel _channel;
+    proto::ChannelKind _kind;
+    proto::Direction _arriving;
+    proto::PduLimits _limits;
+    std::vector<uint8_t> _buffer; ///< Received bytes; the first _buffered of them are not consumed yet.
+    std::size_t _buffered = 0;
+};
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/PduStream_test.cpp b/src/vtextension/wasm/remote/transport/PduStream_test.cpp
new file mode 100644
index 000000000..fcafa255e
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/PduStream_test.cpp
@@ -0,0 +1,167 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// PDUs over a channel pair: whole frames arrive whole, and a peer that lies, floods or leaves ends the stream
+// for the reason it gave.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <future>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/remote/proto/Codec.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+#include <vtextension/wasm/remote/transport/PduStream.hpp>
+
+using namespace vtextension::wasm::remote;
+using transport::makeChannelPair;
+using transport::PduStream;
+using transport::StreamError;
+
+namespace
+{
+
+/// The control channel's two ends, as Contour and the extension host process hold them.
+struct ControlPair
+{
+    PduStream parent;
+    PduStream helper;
+};
+
+/// @return A connected control channel.
+[[nodiscard]] ControlPair makeControlPair()
+{
+    auto pair = makeChannelPair();
+    REQUIRE(pair.has_value());
+    return ControlPair {
+        .parent = PduStream { std::move(pair->parent),
+                              proto::ChannelKind::Control,
+                              proto::Direction::ToParent,
+                              proto::PduLimits {} },
+        .helper = PduStream { std::move(pair->helper),
+                              proto::ChannelKind::Control,
+                              proto::Direction::ToHelper,
+                              proto::PduLimits {} },
+    };
+}
+
+} // namespace
+
+TEST_CASE("PduStream.roundTripsOverAPair", "[vtextension]")
+{
+    auto pair = makeControlPair();
+
+    auto const hello = proto::Pdu { proto::Hello { .version = proto::ProtocolVersion,
+                                                   .memoryMode = proto::MemoryMode::Copy,
+                                                   .lockdown = proto::LockdownState::Unsandboxed } };
+    REQUIRE(pair.helper.send(hello).has_value());
+    CHECK(pair.parent.receive() == hello);
+
+    // A module larger than a socket's buffer, followed at once by a second PDU: each arrives whole.
+    auto const load = proto::Pdu { proto::Load {
+        .runtimeId = 1,
+        .moduleId = 2,
+        .bytes = std::vector<std::byte>(std::size_t { 3 } * 1024 * 1024, std::byte { 7 }) } };
+    auto const release = proto::Pdu { proto::Release { .target = proto::ReleaseTarget::Module, .id = 2 } };
+    auto sent = std::async(std::launch::async, [&] {
+        return pair.parent.send(load).and_then([&] { return pair.parent.send(release); });
+    });
+    CHECK(pair.helper.receive() == load);
+    CHECK(pair.helper.receive() == release);
+    CHECK(sent.get().has_value());
+}
+
+TEST_CASE("PduStream.overCapFailsWithoutWaitingForTheBody", "[vtextension]")
+{
+    auto channels = makeChannelPair();
+    REQUIRE(channels.has_value());
+    auto stream = PduStream { std::move(channels->parent),
+                              proto::ChannelKind::Control,
+                              proto::Direction::ToParent,
+                              proto::PduLimits {} };
+
+    // A Hello header claiming a megabyte, and nothing after it: the peer stays connected and silent.
+    auto writer = proto::Writer {};
+    writer.varint(1 + (std::size_t { 1024 } * 1024));
+    writer.u8(std::to_underlying(proto::PduKind::Hello));
+    REQUIRE(channels->helper.send(writer.take()).has_value());
+    CHECK(stream.receive() == std::unexpected(StreamError::OverCap));
+}
+
+TEST_CASE("PduStream.overCapIsNotSent", "[vtextension]")
+{
+    auto pair = makeControlPair();
+
+    // A runtime with more host functions than any reader accepts: refused here, so the helper never sees a
+    // protocol violation, and the stream carries on. Small enough to fit the socket's buffer, so that a
+    // sender that did send it fails the checks below rather than blocks.
+    auto const tooMany = proto::Pdu { proto::CreateRuntime {
+        .runtimeId = 1,
+        .memoryBytes = 0,
+        .stackBytes = 0,
+        .functions = std::vector<proto::WireHostFunction>(proto::MaxHostFunctions + 1) } };
+    CHECK(pair.parent.send(tooMany) == std::unexpected(StreamError::OverCap));
+
+    auto const release = proto::Pdu { proto::Release { .target = proto::ReleaseTarget::Runtime, .id = 1 } };
+    REQUIRE(pair.parent.send(release).has_value());
+    CHECK(pair.helper.receive() == release);
+}
+
+TEST_CASE("PduStream.overByteCapIsNotSent", "[vtextension]")
+{
+    // A module larger than the stream's limits let a Load carry: its lists are within their caps, its bytes
+    // are not. Refused here, as the helper's reader would refuse it, and the stream carries on.
+    auto const limits = proto::PduLimits { .maxModuleBytes = 64, .maxMemoryBytes = 64 };
+    auto channels = makeChannelPair();
+    REQUIRE(channels.has_value());
+    auto parent = PduStream {
+        std::move(channels->parent), proto::ChannelKind::Control, proto::Direction::ToParent, limits
+    };
+    auto helper = PduStream {
+        std::move(channels->helper), proto::ChannelKind::Control, proto::Direction::ToHelper, limits
+    };
+
+    auto const tooLarge =
+        proto::Pdu { proto::Load { .runtimeId = 1, .moduleId = 2, .bytes = std::vector<std::byte>(256) } };
+    CHECK(parent.send(tooLarge) == std::unexpected(StreamError::OverCap));
+
+    auto const release = proto::Pdu { proto::Release { .target = proto::ReleaseTarget::Module, .id = 2 } };
+    REQUIRE(parent.send(release).has_value());
+    CHECK(helper.receive() == release);
+}
+
+TEST_CASE("PduStream.peerCloseIsClosed", "[vtextension]")
+{
+    auto pair = makeControlPair();
+    {
+        auto const helper = std::move(pair.helper);
+    }
+    CHECK(pair.parent.receive() == std::unexpected(StreamError::Closed));
+}
+
+TEST_CASE("PduStream.garbageIsMalformed", "[vtextension]")
+{
+    auto channels = makeChannelPair();
+    REQUIRE(channels.has_value());
+    auto stream = PduStream { std::move(channels->parent),
+                              proto::ChannelKind::Control,
+                              proto::Direction::ToParent,
+                              proto::PduLimits {} };
+
+    SECTION("a kind naming no PDU")
+    {
+        REQUIRE(channels->helper.send(std::vector<uint8_t> { 1, 0 }).has_value());
+        CHECK(stream.receive() == std::unexpected(StreamError::Malformed));
+    }
+    SECTION("a PDU travelling the other way")
+    {
+        auto const frame =
+            proto::encodeFrame(proto::Release { .target = proto::ReleaseTarget::Module, .id = 2 });
+        REQUIRE(frame.has_value());
+        REQUIRE(channels->helper.send(*frame).has_value());
+        CHECK(stream.receive() == std::unexpected(StreamError::Malformed));
+    }
+}
