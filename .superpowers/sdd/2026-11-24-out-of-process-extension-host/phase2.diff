+# vtextension_host: the extension host's side of the protocol. HostServer serves one engine's runtimes, modules
+# and instances over a control channel and its lanes; InProcessHostConnector runs one in this process, for the
+# tests and for measuring the protocol without a process boundary. It links no engine: whoever composes a host
+# hands it one (IHostedEngine), and its tests live in vtextension_remote_test (../remote/CMakeLists.txt), which
+# links Wasmtime's.
+
+add_library(vtextension_host STATIC
+    ExecutorThread.cpp
+    ExecutorThread.hpp
+    HostServer.cpp
+    HostServer.hpp
+    IHostedEngine.hpp
+    InProcessHost.cpp
+    InProcessHost.hpp
+    ../remote/HostConnector.hpp
+)
+target_link_libraries(vtextension_host PUBLIC vtextension_remote_wire PRIVATE core::base)
diff --git a/src/vtextension/wasm/host/ExecutorThread.cpp b/src/vtextension/wasm/host/ExecutorThread.cpp
new file mode 100644
index 000000000..3043da7a8
--- /dev/null
+++ b/src/vtextension/wasm/host/ExecutorThread.cpp
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/host/ExecutorThread.hpp>
+
+#include <algorithm>
+#include <cstddef>
+#include <expected>
+#include <functional>
+#include <memory>
+#include <system_error>
+#include <utility>
+
+#ifdef _WIN32
+    #include <Windows.h>
+#else
+    #include <climits>
+
+    #include <pthread.h>
+#endif
+
+namespace vtextension::wasm::host
+{
+
+struct ExecutorThread::State
+{
+    std::function<void()> body;
+#ifdef _WIN32
+    HANDLE thread = nullptr;
+#else
+    pthread_t thread {};
+#endif
+};
+
+namespace
+{
+#ifdef _WIN32
+    DWORD WINAPI runBody(LPVOID state)
+    {
+        static_cast<ExecutorThread::State*>(state)->body();
+        return 0;
+    }
+#else
+    void* runBody(void* state)
+    {
+        static_cast<ExecutorThread::State*>(state)->body();
+        return nullptr;
+    }
+#endif
+} // namespace
+
+std::expected<ExecutorThread, std::error_code> ExecutorThread::start(std::size_t stackBytes,
+                                                                     std::function<void()> body)
+{
+    auto state = std::make_unique<State>(State { .body = std::move(body) });
+#ifdef _WIN32
+    // Reserved, not committed: the pages are touched only as deep as the calls go.
+    state->thread = ::CreateThread(
+        nullptr, stackBytes, &runBody, state.get(), STACK_SIZE_PARAM_IS_A_RESERVATION, nullptr);
+    if (!state->thread)
+        return std::unexpected(
+            std::error_code { static_cast<int>(::GetLastError()), std::system_category() });
+#else
+    auto attributes = pthread_attr_t {};
+    if (auto const failed = ::pthread_attr_init(&attributes); failed != 0)
+        return std::unexpected(std::error_code { failed, std::generic_category() });
+    auto const size = std::max(stackBytes, static_cast<std::size_t>(PTHREAD_STACK_MIN));
+    auto failed = ::pthread_attr_setstacksize(&attributes, size);
+    if (failed == 0)
+        failed = ::pthread_create(&state->thread, &attributes, &runBody, state.get());
+    ::pthread_attr_destroy(&attributes);
+    if (failed != 0)
+        return std::unexpected(std::error_code { failed, std::generic_category() });
+#endif
+    return ExecutorThread { std::move(state) };
+}
+
+ExecutorThread::ExecutorThread(std::unique_ptr<State> state) noexcept: _state { std::move(state) }
+{
+}
+
+ExecutorThread::ExecutorThread(ExecutorThread&&) noexcept = default;
+
+ExecutorThread& ExecutorThread::operator=(ExecutorThread&& other) noexcept
+{
+    if (this != &other)
+    {
+        join();
+        _state = std::move(other._state);
+    }
+    return *this;
+}
+
+ExecutorThread::~ExecutorThread()
+{
+    join();
+}
+
+void ExecutorThread::join() noexcept
+{
+    if (!_state)
+        return;
+#ifdef _WIN32
+    ::WaitForSingleObject(_state->thread, INFINITE);
+    ::CloseHandle(_state->thread);
+#else
+    ::pthread_join(_state->thread, nullptr);
+#endif
+    _state.reset();
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/ExecutorThread.hpp b/src/vtextension/wasm/host/ExecutorThread.hpp
new file mode 100644
index 000000000..bf0f54686
--- /dev/null
+++ b/src/vtextension/wasm/host/ExecutorThread.hpp
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// A thread whose stack size is chosen: what std::thread and std::jthread cannot do, and what a lane executor
+/// needs, since the guest calls it nests run on its stack.
+
+#include <cstddef>
+#include <expected>
+#include <functional>
+#include <memory>
+#include <system_error>
+
+namespace vtextension::wasm::host
+{
+
+/// A thread running one function on a stack of a chosen size, joined when it is destroyed. Move-only.
+class ExecutorThread
+{
+  public:
+    /// The platform's handle and the function it runs, at a stable address the thread is handed; defined in
+    /// ExecutorThread.cpp.
+    struct State;
+
+    /// Starts @p body on a new thread.
+    /// @param stackBytes The least stack the thread gets; the platform's minimum if that is larger.
+    /// @param body What the thread runs. Must not throw.
+    /// @return The running thread; why the platform could not start it, @p body then never running.
+    [[nodiscard]] static std::expected<ExecutorThread, std::error_code> start(std::size_t stackBytes,
+                                                                              std::function<void()> body);
+
+    ExecutorThread(ExecutorThread&&) noexcept;
+    ExecutorThread& operator=(ExecutorThread&&) noexcept;
+    ExecutorThread(ExecutorThread const&) = delete;
+    ExecutorThread& operator=(ExecutorThread const&) = delete;
+    /// Joins the thread, unless it was joined or moved from.
+    ~ExecutorThread();
+
+    /// Waits until the thread finished. Idempotent.
+    void join() noexcept;
+
+  private:
+    explicit ExecutorThread(std::unique_ptr<State> state) noexcept;
+
+    std::unique_ptr<State> _state;
+};
+
+} // namespace vtextension::wasm::host
