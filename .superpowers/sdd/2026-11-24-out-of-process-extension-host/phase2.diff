@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// What the extension host process runs modules on: a WebAssembly backend, and how it shares an instance's
+/// memory with Contour.
+
+#include <vtextension/wasm/WasmRuntime.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+
+namespace vtextension::wasm::host
+{
+
+/// A backend a host process drives. The helper's own interface: the parent never sees one.
+class IHostedEngine: public IWasmBackend
+{
+  public:
+    /// @return How the engine's instances share their linear memory with the parent: what the host states in
+    ///         its Hello, and so how the parent reaches that memory.
+    [[nodiscard]] virtual remote::proto::MemoryMode memoryMode() const noexcept = 0;
+};
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/InProcessHost.cpp b/src/vtextension/wasm/host/InProcessHost.cpp
new file mode 100644
index 000000000..12105e88a
--- /dev/null
+++ b/src/vtextension/wasm/host/InProcessHost.cpp
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/host/InProcessHost.hpp>
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <mutex>
+#include <ranges>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <vtextension/ExtensionError.hpp>
+#include <vtextension/wasm/remote/HostConnector.hpp>
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::host
+{
+
+using remote::transport::Channel;
+using remote::transport::makeChannelPair;
+
+/// The hosts of one connector that are alive: each registers itself while it lives.
+class InProcessHostRegistry
+{
+  public:
+    /// Lists @p host, alive from now on.
+    void add(InProcessHost& host)
+    {
+        auto const lock = std::scoped_lock { _mutex };
+        _hosts.push_back(&host);
+    }
+
+    /// Unlists @p host, about to be destroyed.
+    void remove(InProcessHost& host) noexcept
+    {
+        auto const lock = std::scoped_lock { _mutex };
+        std::erase(_hosts, &host);
+    }
+
+    /// Calls @p visit with every host alive, under the registry's lock: a host is not destroyed meanwhile.
+    template <typename Visit>
+    void forEach(Visit const& visit) const
+    {
+        auto const lock = std::scoped_lock { _mutex };
+        for (auto* host: _hosts)
+            visit(*host);
+    }
+
+  private:
+    mutable std::mutex _mutex;
+    std::vector<InProcessHost*> _hosts;
+};
+
+InProcessHost::InProcessHost(std::shared_ptr<InProcessHostRegistry> registry,
+                             std::unique_ptr<IHostedEngine> engine,
+                             std::vector<Channel> lanes,
+                             Channel control,
+                             HostServerConfig config):
+    _registry { std::move(registry) },
+    _engine { std::move(engine) },
+    _server { *_engine, std::move(lanes), std::move(control), std::move(config) },
+    _thread { [this] {
+        std::ignore = _server.run();
+        _state.store(ServingState::Ended);
+    } }
+{
+    _registry->add(*this);
+}
+
+InProcessHost::~InProcessHost()
+{
+    _registry->remove(*this);
+    terminate();
+    _thread.join();
+}
+
+void InProcessHost::interrupt(uint32_t instanceId) noexcept
+{
+    _server.interrupt(instanceId);
+}
+
+void InProcessHost::terminate() noexcept
+{
+    _state.store(ServingState::Ended);
+    _server.stop();
+}
+
+InProcessHost::ServingState InProcessHost::state() const noexcept
+{
+    return _state.load();
+}
+
+InProcessHostConnector::InProcessHostConnector(EngineFactory engines, HostServerConfig config):
+    _engines { std::move(engines) },
+    _config { std::move(config) },
+    _registry { std::make_shared<InProcessHostRegistry>() },
+    _connects { 0 }
+{
+}
+
+std::expected<remote::HostConnection, ExtensionError> InProcessHostConnector::connect()
+{
+    auto engine = _engines();
+    if (!engine)
+        return std::unexpected(ExtensionError::HostUnavailable);
+    auto control = makeChannelPair();
+    if (!control)
+        return std::unexpected(ExtensionError::HostUnavailable);
+    auto parentLanes = std::vector<Channel> {};
+    auto helperLanes = std::vector<Channel> {};
+    for ([[maybe_unused]] auto const index: std::views::iota(std::size_t { 0 }, remote::MaxLaneChannels))
+    {
+        auto lane = makeChannelPair();
+        if (!lane)
+            return std::unexpected(ExtensionError::HostUnavailable);
+        parentLanes.push_back(std::move(lane->parent));
+        helperLanes.push_back(std::move(lane->helper));
+    }
+    auto handle = std::make_unique<InProcessHost>(
+        _registry, std::move(engine), std::move(helperLanes), std::move(control->helper), _config);
+    _connects.fetch_add(1);
+    return remote::HostConnection { .control = std::move(control->parent),
+                                    .lanes = std::move(parentLanes),
+                                    .handle = std::move(handle) };
+}
+
+std::size_t InProcessHostConnector::connects() const noexcept
+{
+    return _connects.load();
+}
+
+std::size_t InProcessHostConnector::liveHosts() const noexcept
+{
+    auto count = std::size_t { 0 };
+    _registry->forEach([&](InProcessHost const& host) {
+        if (host.state() == InProcessHost::ServingState::Serving)
+            ++count;
+    });
+    return count;
+}
+
+std::size_t InProcessHostConnector::terminateAll() noexcept
+{
+    auto count = std::size_t { 0 };
+    _registry->forEach([&](InProcessHost& host) {
+        if (host.state() == InProcessHost::ServingState::Serving)
+        {
+            host.terminate();
+            ++count;
+        }
+    });
+    return count;
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/InProcessHost.hpp b/src/vtextension/wasm/host/InProcessHost.hpp
new file mode 100644
index 000000000..53c337f49
--- /dev/null
+++ b/src/vtextension/wasm/host/InProcessHost.hpp
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// A host serving in this process, on threads of its own, over real channels: what the tests connect to, and
+/// what measures the protocol's cost without a process boundary.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <functional>
+#include <memory>
+#include <thread>
+#include <vector>
+
+#include <vtextension/ExtensionError.hpp>
+#include <vtextension/wasm/host/HostServer.hpp>
+#include <vtextension/wasm/host/IHostedEngine.hpp>
+#include <vtextension/wasm/remote/HostConnector.hpp>
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::host
+{
+
+/// Creates the engine one host runs on; null if none can be.
+using EngineFactory = std::function<std::unique_ptr<IHostedEngine>()>;
+
+/// The hosts one connector started that are still alive; shared with each of them.
+class InProcessHostRegistry;
+
+/// One host serving in this process: an engine, the server driving it, and the thread the server runs on, in
+/// that order, so that the thread is joined before the server goes, and the server before its engine.
+class InProcessHost final: public remote::IHostHandle
+{
+  public:
+    /// Whether a host's server still serves.
+    enum class ServingState : uint8_t
+    {
+        Ended,   ///< It was told to stop, or run() returned.
+        Serving, ///< run() serves.
+    };
+
+    /// Starts serving.
+    /// @param registry Where the host is listed while it lives.
+    /// @param engine What it runs modules on.
+    /// @param lanes The helper's ends of the lanes.
+    /// @param control The helper's end of the control channel.
+    /// @param config How its server runs.
+    InProcessHost(std::shared_ptr<InProcessHostRegistry> registry,
+                  std::unique_ptr<IHostedEngine> engine,
+                  std::vector<remote::transport::Channel> lanes,
+                  remote::transport::Channel control,
+                  HostServerConfig config);
+    InProcessHost(InProcessHost const&) = delete;
+    InProcessHost(InProcessHost&&) = delete;
+    InProcessHost& operator=(InProcessHost const&) = delete;
+    InProcessHost& operator=(InProcessHost&&) = delete;
+
+    /// Terminates the host and joins its thread, on the thread that drops it.
+    ~InProcessHost() override;
+
+    /// Interrupts the instance directly, under the server's brief instance-map lock.
+    void interrupt(uint32_t instanceId) noexcept override;
+
+    /// Stops the server: its channels close, and its thread winds down.
+    void terminate() noexcept override;
+
+    /// @return Whether its server still serves.
+    [[nodiscard]] ServingState state() const noexcept;
+
+  private:
+    std::shared_ptr<InProcessHostRegistry> _registry;
+    std::atomic<ServingState> _state { ServingState::Serving };
+    std::unique_ptr<IHostedEngine> _engine;
+    HostServer _server;
+    std::jthread _thread;
+};
+
+/// Starts each host as a HostServer in this process, on an engine of its own.
+class InProcessHostConnector final: public remote::IHostConnector
+{
+  public:
+    /// @param engines Creates each host's engine.
+    /// @param config How each host's server runs.
+    InProcessHostConnector(EngineFactory engines, HostServerConfig config);
+
+    /// Starts a host serving MaxLaneChannels lanes and a control channel.
+    /// @return The connection; `HostUnavailable` if no engine or no channel could be created.
+    [[nodiscard]] std::expected<remote::HostConnection, ExtensionError> connect() override;
+
+    /// Test hook.
+    /// @return How many hosts connect() started.
+    [[nodiscard]] std::size_t connects() const noexcept;
+
+    /// Test hook.
+    /// @return How many hosts this connector started still serve: neither terminated, nor stopped by their
+    ///         parent, nor dropped.
+    [[nodiscard]] std::size_t liveHosts() const noexcept;
+
+    /// Test hook: a simulated crash of every live host. Each stops serving, and its channels close.
+    /// @return How many hosts it terminated.
+    std::size_t terminateAll() noexcept;
+
+  private:
+    EngineFactory _engines;
+    HostServerConfig _config;
+    std::shared_ptr<InProcessHostRegistry> _registry;
+    std::atomic<std::size_t> _connects;
+};
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/remote/CMakeLists.txt b/src/vtextension/wasm/remote/CMakeLists.txt
new file mode 100644
index 000000000..881aa14b1
--- /dev/null
+++ b/src/vtextension/wasm/remote/CMakeLists.txt
@@ -0,0 +1,115 @@
+# vtextension_remote_wire: the protocol Contour speaks with its extension host process, and the channels it
+# travels on. The codec (proto/) is pure bytes-in/PDUs-out and the transport (transport/) is the operating
+# system's byte channels; neither links a WebAssembly engine or vtextension itself, so that both the parent and
+# the helper process link them, and both are always built. On Windows the channel's owner-only pipe DACL
+# needs advapi32.
+
+set(_channel_source transport/Channel_posix.cpp)
+if(WIN32)
+    set(_channel_source transport/Channel_win32.cpp)
+endif()
+
+# The codec's sources, compiled into the library and, with the fuzzer's flags, into the fuzz target below: one
+# list, so that the fuzzer never decodes with a codec the library does not ship.
+set(_codec_sources
+    proto/Codec.cpp
+    proto/Codec.hpp
+    proto/Pdu.hpp
+    proto/PduTable.hpp
+    proto/Wire.hpp
+)
+
+add_library(vtextension_remote_wire STATIC
+    ${_codec_sources}
+    transport/Channel.hpp
+    ${_channel_source}
+    transport/PduStream.cpp
+    transport/PduStream.hpp
+)
+# The codec names the runtime vocabulary (WasmRuntime.hpp, ExtensionError.hpp), which is header-only and
+# std-only: the include path is all it takes.
+target_include_directories(vtextension_remote_wire PUBLIC
+    $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/src>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/include>
+)
+
+if(WIN32)
+    target_link_libraries(vtextension_remote_wire PRIVATE advapi32)
+endif()
+
+# vtextension_remote: the backend that runs extensions in a separate host, over the channels above. It links no
+# engine and starts no process itself: a connector (HostConnector.hpp) the composition root injects does.
+add_library(vtextension_remote STATIC
+    CopyPathMemory.cpp
+    CopyPathMemory.hpp
+    HelperIncarnation.cpp
+    HelperIncarnation.hpp
+    HostConnector.hpp
+    RemoteBackend.cpp
+    RemoteBackend.hpp
+    RemoteKindState.cpp
+    RemoteKindState.hpp
+)
+target_link_libraries(vtextension_remote PUBLIC vtextension vtextension_remote_wire)
+
+option(VTEXTENSION_FUZZING "Builds the extension host protocol's libFuzzer target (Clang only) [default: OFF]" OFF)
+if(VTEXTENSION_FUZZING)
+    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+        message(FATAL_ERROR "VTEXTENSION_FUZZING needs Clang, for -fsanitize=fuzzer.")
+    endif()
+    # Decodes its input as every (direction, channel) pair, and checks that what decodes encodes again to
+    # the same PDU. CI runs the fixed-seed mutation case in vtextension_test instead.
+    #
+    # The codec is compiled into the fuzzer itself, with the fuzzer's coverage instrumentation, rather than
+    # linked from vtextension_remote_wire: the fuzzer is guided by the decoder's branches, and the library
+    # every other target links stays uninstrumented (-fsanitize=fuzzer-no-link there would need the
+    # coverage runtime in each of them).
+    #
+    # Not an OBJECT library both share: the fuzzer's copy needs the fuzzer's compile flags, which the
+    # library's must not have. Both compile _codec_sources, so a new codec source reaches both.
+    add_executable(vtextension_remote_fuzz proto/Codec_fuzz.cpp ${_codec_sources})
+    target_include_directories(vtextension_remote_fuzz PRIVATE ${PROJECT_SOURCE_DIR}/src)
+    target_compile_options(vtextension_remote_fuzz PRIVATE -fsanitize=fuzzer)
+    target_link_options(vtextension_remote_fuzz PRIVATE -fsanitize=fuzzer)
+endif()
+
+if(VTEXTENSION_TESTING AND TARGET vtextension_wasmtime_hosted_engine)
+    # The host's server, and the backend that reaches it, driven over real channels on a real engine:
+    # Wasmtime's, the engine a host process runs, reached through its directory's neutral test probe
+    # (vtextension_wasmtime_hosted_engine).
+    #
+    # Beside them, the suites vtextension_test runs on the default backend, here composed by
+    # testing/RemoteDefaultBackend.cpp as the remote backend over hosts in this process: their real guests
+    # run through the protocol.
+    add_executable(vtextension_remote_test
+        ${PROJECT_SOURCE_DIR}/src/vtextension/test_main.cpp
+        ../host/ExecutorThread_test.cpp
+        ../host/HostServer_test.cpp
+        RegistryRemote_test.cpp
+        RemoteBackend_test.cpp
+        testing/RemoteDefaultBackend.cpp
+        ${PROJECT_SOURCE_DIR}/src/vtextension/Bundled_test.cpp
+        ${PROJECT_SOURCE_DIR}/src/vtextension/ControlImports_test.cpp
+        ${PROJECT_SOURCE_DIR}/src/vtextension/Engine_test.cpp
+        ${PROJECT_SOURCE_DIR}/src/vtextension/ExtensionHost_test.cpp
+        ${PROJECT_SOURCE_DIR}/src/vtextension/ExtensionWorkerPool_test.cpp
+        ${PROJECT_SOURCE_DIR}/src/vtextension/Instance_test.cpp
+    )
+    target_link_libraries(vtextension_remote_test PRIVATE
+        vtextension vtextension_remote vtextension_remote_wire vtextension_host vtextension_wasmtime vtextension_wasmtime_hosted_engine
+        contour::wasmtime glaze::glaze core::testing Catch2::Catch2 contour_test_trace)
+    if(CONTOUR_WASM_GUESTS)
+        # The guests vtextension_test reads, from where it reads them (../../CMakeLists.txt).
+        foreach(_guest IN ITEMS echo hostile sleeper spawner)
+            add_dependencies(vtextension_remote_test ${_guest}_wasm)
+        endforeach()
+        add_dependencies(vtextension_remote_test contour_bundled_extensions)
+        target_compile_definitions(vtextension_remote_test PRIVATE
+            VTEXTENSION_TEST_MODULE_DIR="${VTEXTENSION_TEST_MODULE_DIR}")
+    endif()
+    add_test(NAME vtextension_remote_test COMMAND vtextension_remote_test)
+    if(NOT WIN32)
+        # Catch2's TEST_CASE expands __COUNTER__, which Clang flags as a C2y extension under -Werror.
+        target_compile_options(vtextension_remote_test PRIVATE -Wno-c2y-extensions)
+    endif()
+endif()
diff --git a/src/vtextension/wasm/remote/CopyPathMemory.cpp b/src/vtextension/wasm/remote/CopyPathMemory.cpp
new file mode 100644
index 000000000..a4e142025
--- /dev/null
+++ b/src/vtextension/wasm/remote/CopyPathMemory.cpp
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/CopyPathMemory.hpp>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <utility>
+#include <vector>
+
+namespace vtextension::wasm::remote
+{
+
+namespace
+{
+    /// The most bytes a 32-bit memory addresses.
+    constexpr auto AddressSpaceBytes = std::size_t { 1 } << 32;
+} // namespace
+
+CopyPathMemory::CopyPathMemory(uint32_t instanceId, std::size_t memoryBytes, MemoryFetch fetch):
+    _instanceId { instanceId },
+    _memoryBytes { std::min(memoryBytes, AddressSpaceBytes) },
+    _fetch { std::move(fetch) },
+    // Default-initialized: nothing writes the buffer, so the system commits only the pages fetched into it.
+    _shadow { std::make_unique_for_overwrite<std::byte[]>(_memoryBytes) },
+    _slots((_memoryBytes + PageBytes - 1) / PageBytes, NoSlot)
+{
+}
+
+std::optional<std::span<std::byte>> CopyPathMemory::view(uint32_t address, uint32_t size)
+{
+    if (size == 0)
+        return std::span<std::byte> {};
+    auto const begin = std::size_t { address };
+    auto const end = begin + size; // cannot overflow: both are 32-bit
+    if (end > _memoryBytes)
+        return std::nullopt;
+
+    // One fetch per run of adjacent absent pages.
+    auto const firstPage = begin / PageBytes;
+    auto const endPage = ((end - 1) / PageBytes) + 1;
+    auto runBegin = std::optional<std::size_t> {};
+    for (auto const page: std::views::iota(firstPage, endPage))
+    {
+        auto const absent = _slots[page] == NoSlot;
+        if (absent && !runBegin)
+            runBegin = page;
+        else if (!absent && runBegin && !fetchPages(*std::exchange(runBegin, std::nullopt), page))
+            return std::nullopt;
+    }
+    if (runBegin && !fetchPages(*runBegin, endPage))
+        return std::nullopt;
+    return std::span { _shadow.get(), _memoryBytes }.subspan(begin, size);
+}
+
+std::expected<void, CopyPathMemory::FetchError> CopyPathMemory::fetchPages(std::size_t first, std::size_t end)
+{
+    auto const address = first * PageBytes;
+    auto const size = pageEnd(end - 1) - address;
+    auto fetched = _fetch(static_cast<uint32_t>(address), static_cast<uint32_t>(size));
+    if (!fetched || fetched->size() != size)
+        return std::unexpected(FetchError::Unreachable);
+    std::ranges::copy(*fetched, _shadow.get() + address);
+    // Each page's snapshot takes the next slot of the arena, which keeps its capacity across clear().
+    for (auto const page: std::views::iota(first, end))
+    {
+        _slots[page] = static_cast<uint32_t>(_fetched.size());
+        _fetched.push_back(page);
+        _snapshots.resize(_fetched.size() * PageBytes);
+        auto const pageBytes =
+            std::span { *fetched }.subspan((page - first) * PageBytes, pageEnd(page) - (page * PageBytes));
+        std::ranges::copy(pageBytes, snapshotOf(page).begin());
+    }
+    return {};
+}
+
+std::span<std::byte> CopyPathMemory::snapshotOf(std::size_t page) noexcept
+{
+    return std::span { _snapshots }.subspan(std::size_t { _slots[page] } * PageBytes,
+                                            pageEnd(page) - (page * PageBytes));
+}
+
+std::size_t CopyPathMemory::snapshotBytes() const noexcept
+{
+    return _snapshots.size();
+}
+
+std::size_t CopyPathMemory::pageEnd(std::size_t page) const noexcept
+{
+    return std::min((page + 1) * PageBytes, _memoryBytes);
+}
+
+std::vector<proto::MemoryWrite> CopyPathMemory::flush()
+{
+    auto const shadow = std::span { _shadow.get(), _memoryBytes };
+    auto writes = std::vector<proto::MemoryWrite> {};
+    // Emits [begin, end), and takes it into the snapshots of the pages it spans.
+    auto const emit = [&](std::size_t begin, std::size_t end) {
+        auto const run = shadow.subspan(begin, end - begin);
+        writes.push_back(proto::MemoryWrite { .instanceId = _instanceId,
+                                              .address = static_cast<uint32_t>(begin),
+                                              .bytes = { run.begin(), run.end() } });
+        for (auto const page: std::views::iota(begin / PageBytes, ((end - 1) / PageBytes) + 1))
+        {
+            auto const from = std::max(begin, page * PageBytes);
+            auto const to = std::min(end, pageEnd(page));
+            std::ranges::copy(shadow.subspan(from, to - from),
+                              snapshotOf(page).begin()
+                                  + static_cast<std::ptrdiff_t>(from - (page * PageBytes)));
+        }
+    };
+
+    // A run of changed bytes continues across a page boundary only into the adjacent page.
+    std::ranges::sort(_fetched);
+    auto runBegin = std::optional<std::size_t> {};
+    auto previousEnd = std::size_t { 0 };
+    for (auto const page: _fetched)
+    {
+        auto const pageBegin = page * PageBytes;
+        if (runBegin && pageBegin != previousEnd)
+            emit(*std::exchange(runBegin, std::nullopt), previousEnd);
+        previousEnd = pageEnd(page);
+        // Most pages are only read: compared whole, at once, they end any run and need no closer look.
+        auto const snapshot = snapshotOf(page);
+        auto const current = shadow.subspan(pageBegin, snapshot.size());
+        if (std::ranges::equal(current, snapshot))
+        {
+            if (runBegin)
+                emit(*std::exchange(runBegin, std::nullopt), pageBegin);
+            continue;
+        }
+        for (auto const at: std::views::iota(pageBegin, previousEnd))
+        {
+            auto const changed = shadow[at] != snapshot[at - pageBegin];
+            if (changed && !runBegin)
+                runBegin = at;
+            else if (!changed && runBegin)
+                emit(*std::exchange(runBegin, std::nullopt), at);
+        }
+    }
+    if (runBegin)
+        emit(*runBegin, previousEnd);
+    return writes;
+}
+
+void CopyPathMemory::clear() noexcept
+{
+    for (auto const page: _fetched)
+        _slots[page] = NoSlot;
+    _fetched.clear();
+    _snapshots.clear();
+}
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/CopyPathMemory.hpp b/src/vtextension/wasm/remote/CopyPathMemory.hpp
new file mode 100644
index 000000000..a9d8a8ec5
--- /dev/null
+++ b/src/vtextension/wasm/remote/CopyPathMemory.hpp
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// An instance's linear memory as the parent sees it while its host copies memory rather than sharing it: a
+/// shadow of the whole memory, filled page by page as the parent reads it, until the instance next runs.
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <functional>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <span>
+#include <vector>
+
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+
+namespace vtextension::wasm::remote
+{
+
+/// Reads a range of an instance's memory from its host.
+/// @return The range's bytes, exactly as many as asked for; nothing if the range lies outside the memory or
+///         the host could not be reached.
+using MemoryFetch = std::function<std::optional<std::vector<std::byte>>(uint32_t address, uint32_t size)>;
+
+/// The parts of one instance's memory the parent read since the instance last ran, in a shadow of the whole
+/// memory, at the same offsets. A page is fetched the first time a view reaches it, and every view of the
+/// same bytes is the same shadow memory: a write through one view is what every other view of those bytes
+/// reads. What was written goes back to the instance (flush()) before it next runs, after which the fetched
+/// pages are forgotten (clear()).
+///
+/// The shadow is allocated once and left untouched until a page is fetched into it, so that only the pages
+/// read take memory where the system commits it lazily (Linux, macOS, the BSDs). Windows commits the
+/// allocation up front, charging it against the commit limit while its pages stay unused. What each fetched
+/// page held is kept beside it, in an arena that grows by the page and keeps its capacity across clear(), so
+/// that views of as many pages as before allocate nothing for it.
+///
+/// Not thread-safe: used by the thread calling into its instance.
+class CopyPathMemory
+{
+  public:
+    /// The granularity pages are fetched at, in bytes.
+    static constexpr auto PageBytes = std::size_t { 4096 };
+
+    /// @param instanceId The instance the writes flush() returns are addressed to.
+    /// @param memoryBytes The largest the instance's memory may be; no view reaches past it.
+    /// @param fetch Where pages not held yet are read from.
+    CopyPathMemory(uint32_t instanceId, std::size_t memoryBytes, MemoryFetch fetch);
+
+    /// A view of [@p address, @p address + @p size) in the shadow, fetching the pages of it not held yet: one
+    /// fetch per run of adjacent missing pages. Valid until the CopyPathMemory goes; its bytes are the
+    /// instance's only until clear().
+    /// @param address The guest address the view starts at.
+    /// @param size The view's size in bytes; 0 yields an empty span, fetching nothing.
+    /// @return The view; nothing if the range reaches past the memory's limit or could not be fetched.
+    [[nodiscard]] std::optional<std::span<std::byte>> view(uint32_t address, uint32_t size);
+
+    /// @return One write per maximal run of bytes changed since they were fetched or last flushed, in address
+    ///         order. What they return counts as unchanged from then on.
+    [[nodiscard]] std::vector<proto::MemoryWrite> flush();
+
+    /// Forgets every fetched page: the next view of it fetches it again.
+    void clear() noexcept;
+
+    /// Test hook.
+    /// @return How many bytes the snapshots of the fetched pages take: a page's worth per page fetched since
+    ///         clear(), and nothing for the rest of the memory.
+    [[nodiscard]] std::size_t snapshotBytes() const noexcept;
+
+  private:
+    /// The slot of a page that has none: it was not fetched since the instance last ran.
+    static constexpr auto NoSlot = std::numeric_limits<uint32_t>::max();
+
+    /// Why pages could not be fetched.
+    enum class FetchError : uint8_t
+    {
+        Unreachable, ///< The host refused the range, or could not be reached.
+    };
+
+    /// Fetches pages [@p first, @p end) into the shadow, all of them absent, and snapshots each.
+    [[nodiscard]] std::expected<void, FetchError> fetchPages(std::size_t first, std::size_t end);
+
+    /// @return The snapshot of page @p page, which must have been fetched: its bytes as fetched or last
+    /// flushed.
+    [[nodiscard]] std::span<std::byte> snapshotOf(std::size_t page) noexcept;
+
+    /// @return The address one past page @p page's last byte.
+    [[nodiscard]] std::size_t pageEnd(std::size_t page) const noexcept;
+
+    uint32_t _instanceId;
+    std::size_t _memoryBytes;
+    MemoryFetch _fetch;
+    std::unique_ptr<std::byte[]> _shadow; ///< The memory as the parent sees and writes it.
+    std::vector<uint32_t> _slots;         ///< Per page of the memory, its snapshot's slot; NoSlot if absent.
+    std::vector<std::size_t> _fetched;    ///< The pages fetched since clear(), in fetch order.
+    std::vector<std::byte> _snapshots;    ///< One page per slot, in slot order; keeps its capacity.
+};
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/CopyPathMemory_test.cpp b/src/vtextension/wasm/remote/CopyPathMemory_test.cpp
new file mode 100644
index 000000000..0fbb9dd50
--- /dev/null
+++ b/src/vtextension/wasm/remote/CopyPathMemory_test.cpp
@@ -0,0 +1,296 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The parent's copies of an instance's memory: what is fetched, and what is written back.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <vector>
+
+#include <vtextension/wasm/remote/CopyPathMemory.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+
+using vtextension::wasm::remote::CopyPathMemory;
+
+namespace proto = vtextension::wasm::remote::proto;
+
+namespace
+{
+
+/// The instance the tests' writes are addressed to.
+constexpr auto InstanceId = uint32_t { 7 };
+
+/// An instance's memory, as its host holds it: every fetch reads it, every write lands in it.
+class FakeMemory
+{
+  public:
+    /// @param size The memory's size in bytes; byte i holds i, modulo 256.
+    explicit FakeMemory(std::size_t size = 3 * CopyPathMemory::PageBytes)
+    {
+        for (auto const index: std::views::iota(std::size_t { 0 }, size))
+            _bytes.push_back(static_cast<std::byte>(index & 0xFF));
+    }
+
+    /// @return A CopyPathMemory over this memory, as large as it may grow.
+    [[nodiscard]] CopyPathMemory copies()
+    {
+        return CopyPathMemory { InstanceId,
+                                _bytes.size(),
+                                [this](uint32_t address,
+                                       uint32_t size) -> std::optional<std::vector<std::byte>> {
+                                    ++fetches;
+                                    reads.push_back(Read { .address = address, .size = size });
+                                    if (std::size_t { address } + size > _bytes.size())
+                                        return std::nullopt;
+                                    auto const range = std::span { _bytes }.subspan(address, size);
+                                    return std::vector<std::byte> { range.begin(), range.end() };
+                                } };
+    }
+
+    /// Applies @p writes in order.
+    void apply(std::vector<proto::MemoryWrite> const& writes)
+    {
+        for (auto const& write: writes)
+        {
+            REQUIRE(write.instanceId == InstanceId);
+            REQUIRE(std::size_t { write.address } + write.bytes.size() <= _bytes.size());
+            std::ranges::copy(write.bytes, _bytes.begin() + write.address);
+        }
+    }
+
+    /// @return The byte at @p address.
+    [[nodiscard]] std::byte at(std::size_t address) const { return _bytes.at(address); }
+
+    /// One range read from the memory.
+    struct Read
+    {
+        uint32_t address = 0;
+        uint32_t size = 0;
+        bool operator==(Read const&) const = default;
+    };
+
+    int fetches = 0;         ///< How often a range was fetched.
+    std::vector<Read> reads; ///< Every range fetched, in order.
+
+  private:
+    std::vector<std::byte> _bytes;
+};
+
+} // namespace
+
+/// The size of a page of the shadow.
+constexpr auto Page = static_cast<uint32_t>(CopyPathMemory::PageBytes);
+
+TEST_CASE("CopyPathMemory.flushEmitsOnlyChangedRuns", "[vtextension][remote]")
+{
+    auto memory = FakeMemory {};
+    auto copies = memory.copies();
+    auto const view = copies.view(32, 16);
+    REQUIRE(view.has_value());
+    CHECK(view->size() == 16);
+    CHECK(view->front() == std::byte { 32 });
+    CHECK(memory.reads == std::vector { FakeMemory::Read { .address = 0, .size = Page } });
+    CHECK(copies.flush().empty());
+
+    (*view)[3] = std::byte { 0xAA };
+    (*view)[4] = std::byte { 0xBB };
+    // A byte written back to what it held is no change.
+    (*view)[9] = std::byte { 0xCC };
+    (*view)[9] = std::byte { 32 + 9 };
+
+    CHECK(copies.flush()
+          == std::vector { proto::MemoryWrite { .instanceId = InstanceId,
+                                                .address = 35,
+                                                .bytes = { std::byte { 0xAA }, std::byte { 0xBB } } } });
+    // What was flushed counts as unchanged from then on.
+    CHECK(copies.flush().empty());
+}
+
+TEST_CASE("CopyPathMemory.viewsOfHeldPagesFetchNothing", "[vtextension][remote]")
+{
+    auto memory = FakeMemory {};
+    auto copies = memory.copies();
+    auto const whole = copies.view(0, 64);
+    REQUIRE(whole.has_value());
+    (*whole)[10] = std::byte { 0xEE };
+    auto const inner = copies.view(8, 4);
+    REQUIRE(inner.has_value());
+    CHECK((*inner)[2] == std::byte { 0xEE });
+    CHECK(memory.fetches == 1);
+
+    auto const empty = copies.view(1000, 0);
+    REQUIRE(empty.has_value());
+    CHECK(empty->empty());
+    CHECK(memory.fetches == 1);
+
+    copies.clear();
+    REQUIRE(copies.view(8, 4).has_value());
+    CHECK(memory.fetches == 2);
+}
+
+TEST_CASE("CopyPathMemory.overlappingViewsAreTheSameBytes", "[vtextension][remote]")
+{
+    auto memory = FakeMemory {};
+    auto copies = memory.copies();
+
+    // A = [0, 8), B = [4, 12): B's first byte is A's fifth, whichever writes it, and whenever.
+    auto const a = copies.view(0, 8);
+    REQUIRE(a.has_value());
+    auto const b = copies.view(4, 8);
+    REQUIRE(b.has_value());
+    CHECK(&(*b)[1] == &(*a)[5]);
+    (*b)[3] = std::byte { 0xB7 };
+    CHECK((*a)[7] == std::byte { 0xB7 });
+    (*a)[5] = std::byte { 0xA5 };
+    CHECK((*b)[1] == std::byte { 0xA5 });
+
+    // Views taken again see the latest write too, without fetching again.
+    auto const again = copies.view(0, 8);
+    REQUIRE(again.has_value());
+    CHECK((*again)[5] == std::byte { 0xA5 });
+    CHECK((*again)[7] == std::byte { 0xB7 });
+    CHECK(memory.fetches == 1);
+
+    memory.apply(copies.flush());
+    CHECK(memory.at(5) == std::byte { 0xA5 });
+    CHECK(memory.at(7) == std::byte { 0xB7 });
+}
+
+TEST_CASE("CopyPathMemory.noWriteIsLost", "[vtextension][remote]")
+{
+    auto memory = FakeMemory {};
+    auto copies = memory.copies();
+
+    // Two views write the same value to a byte they share, and then one of them writes another: the last
+    // write is what the instance gets.
+    auto const a = copies.view(0, 8);
+    REQUIRE(a.has_value());
+    auto const b = copies.view(4, 8);
+    REQUIRE(b.has_value());
+    (*b)[1] = std::byte { 0 };
+    (*a)[5] = std::byte { 0 };
+    auto const again = copies.view(0, 8);
+    REQUIRE(again.has_value());
+    (*again)[5] = std::byte { 9 };
+
+    memory.apply(copies.flush());
+    CHECK(memory.at(5) == std::byte { 9 });
+}
+
+TEST_CASE("CopyPathMemory.alternatingOverlappingViewsFetchOnce", "[vtextension][remote]")
+{
+    auto memory = FakeMemory {};
+    auto copies = memory.copies();
+
+    for (auto const round: std::views::iota(0, 64))
+    {
+        // Each writes where the other reaches too.
+        auto const a = copies.view(0, 8);
+        REQUIRE(a.has_value());
+        (*a)[4 + (round % 4)] = static_cast<std::byte>(round);
+        auto const b = copies.view(4, 8);
+        REQUIRE(b.has_value());
+        (*b)[round % 8] = static_cast<std::byte>(round);
+    }
+    CHECK(memory.fetches == 1);
+
+    memory.apply(copies.flush());
+    CHECK(memory.at(4 + 7) == std::byte { 63 });
+    CHECK(memory.at(4 + 3) == std::byte { 63 });
+    CHECK(memory.at(4 + 2) == std::byte { 62 });
+}
+
+TEST_CASE("CopyPathMemory.adjacentChangesFlushAsOneWrite", "[vtextension][remote]")
+{
+    auto memory = FakeMemory {};
+    auto copies = memory.copies();
+
+    // Written through two views that meet, at either side of where they meet, and across pages.
+    auto const left = copies.view(Page - 4, 4);
+    REQUIRE(left.has_value());
+    auto const right = copies.view(Page, 4);
+    REQUIRE(right.has_value());
+    std::ranges::fill(*left, std::byte { 0x11 });
+    std::ranges::fill(*right, std::byte { 0x22 });
+
+    auto const writes = copies.flush();
+    REQUIRE(writes.size() == 1);
+    CHECK(writes[0].address == Page - 4);
+    CHECK(writes[0].bytes.size() == 8);
+    memory.apply(writes);
+    CHECK(memory.at(Page - 1) == std::byte { 0x11 });
+    CHECK(memory.at(Page) == std::byte { 0x22 });
+}
+
+TEST_CASE("CopyPathMemory.viewAcrossPages", "[vtextension][remote]")
+{
+    auto memory = FakeMemory {};
+    auto copies = memory.copies();
+
+    // Absent pages next to each other are fetched in one read; a held page between splits the read.
+    REQUIRE(copies.view(Page + 8, 4).has_value());
+    auto const across = copies.view(Page - 2, 4);
+    REQUIRE(across.has_value());
+    CHECK((*across)[1] == static_cast<std::byte>((Page - 1) & 0xFF));
+    CHECK((*across)[2] == std::byte { 0 });
+    auto const whole = copies.view(0, 3 * Page);
+    REQUIRE(whole.has_value());
+    CHECK(memory.reads
+          == std::vector { FakeMemory::Read { .address = Page, .size = Page },
+                           FakeMemory::Read { .address = 0, .size = Page },
+                           FakeMemory::Read { .address = 2 * Page, .size = Page } });
+
+    copies.clear();
+    REQUIRE(copies.view(Page - 2, 4).has_value());
+    CHECK(memory.reads.back() == FakeMemory::Read { .address = 0, .size = 2 * Page });
+}
+
+TEST_CASE("CopyPathMemory.refusesWhatLiesPastTheMemory", "[vtextension][remote]")
+{
+    auto memory = FakeMemory {};
+    auto copies = memory.copies();
+
+    CHECK_FALSE(copies.view((3 * Page) - 8, 16).has_value()); // past the memory's limit
+    CHECK_FALSE(copies.view(0xFFFF'FFF0, 32).has_value());    // past the address space
+    CHECK_FALSE(copies.view(0xFFFF'FFFF, 0xFFFF'FFFF).has_value());
+    CHECK(memory.fetches == 0);
+    CHECK(copies.view((3 * Page) - 8, 8).has_value());
+
+    // A memory smaller than its limit refuses what it does not hold: its host cannot read it.
+    auto copiesOfSmall = CopyPathMemory { InstanceId, 2 * std::size_t { Page }, [](uint32_t, uint32_t) {
+                                             return std::optional<std::vector<std::byte>> {};
+                                         } };
+    CHECK_FALSE(copiesOfSmall.view(Page, 4).has_value());
+}
+
+TEST_CASE("CopyPathMemory.snapshotsOnlyTheFetchedPages", "[vtextension][remote]")
+{
+    auto memory = FakeMemory { 64 * std::size_t { Page } };
+    auto copies = memory.copies();
+    CHECK(copies.snapshotBytes() == 0);
+
+    REQUIRE(copies.view(Page - 2, 4).has_value());
+    REQUIRE(copies.view(40 * Page, 8).has_value());
+    CHECK(copies.snapshotBytes() == 3 * std::size_t { Page });
+    // A view of held pages adds none.
+    REQUIRE(copies.view(0, 8).has_value());
+    CHECK(copies.snapshotBytes() == 3 * std::size_t { Page });
+
+    // Written and flushed, the snapshots stay what was fetched: the arena does not grow.
+    auto const view = copies.view(Page - 2, 4);
+    REQUIRE(view.has_value());
+    std::ranges::fill(*view, std::byte { 0x5A });
+    memory.apply(copies.flush());
+    CHECK(copies.flush().empty());
+    CHECK(copies.snapshotBytes() == 3 * std::size_t { Page });
+    CHECK(memory.at(Page - 2) == std::byte { 0x5A });
+    CHECK(memory.at(Page + 1) == std::byte { 0x5A });
+
+    copies.clear();
+    CHECK(copies.snapshotBytes() == 0);
+    REQUIRE(copies.view(10 * Page, 4).has_value());
+    CHECK(copies.snapshotBytes() == Page);
+}
diff --git a/src/vtextension/wasm/remote/HelperIncarnation.cpp b/src/vtextension/wasm/remote/HelperIncarnation.cpp
new file mode 100644
index 000000000..505651980
--- /dev/null
+++ b/src/vtextension/wasm/remote/HelperIncarnation.cpp
@@ -0,0 +1,129 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/HelperIncarnation.hpp>
+
+#include <expected>
+#include <memory>
+#include <mutex>
+#include <utility>
+#include <variant>
+#include <vector>
+
+namespace vtextension::wasm::remote
+{
+
+using transport::PduStream;
+using transport::StreamError;
+
+namespace
+{
+    /// The limits the parent's ends apply: the protocol's own, which every host applies too.
+    constexpr auto ParentLimits = proto::PduLimits {};
+
+    /// @return Whether a host that said @p hello may be driven: it speaks this protocol, confined itself or
+    ///         runs where there is no confinement, and copies memory, which is how this parent reaches it.
+    [[nodiscard]] bool isAcceptable(proto::Hello const& hello) noexcept
+    {
+        return hello.version == proto::ProtocolVersion && hello.lockdown != proto::LockdownState::Failed
+               && hello.memoryMode == proto::MemoryMode::Copy;
+    }
+
+    /// @return The parent's end of @p channel as a stream of @p kind.
+    [[nodiscard]] PduStream parentEnd(transport::Channel channel, proto::ChannelKind kind)
+    {
+        return PduStream { std::move(channel), kind, proto::Direction::ToParent, ParentLimits };
+    }
+} // namespace
+
+std::expected<std::shared_ptr<HelperIncarnation>, ExtensionError> HelperIncarnation::connect(
+    IHostConnector& connector, proto::CreateRuntime const& runtime)
+{
+    auto connection = connector.connect();
+    if (!connection)
+        return std::unexpected(ExtensionError::HostUnavailable);
+    if (connection->lanes.size() != MaxLaneChannels || !connection->handle)
+    {
+        if (connection->handle)
+            connection->handle->terminate();
+        return std::unexpected(ExtensionError::HostUnavailable);
+    }
+    auto incarnation = std::make_shared<HelperIncarnation>(std::move(*connection));
+
+    // The host speaks first, unasked; a request then creates the runtime.
+    auto const handshake = [&]() -> bool {
+        auto const lock = std::scoped_lock { incarnation->_controlMutex };
+        auto const hello = incarnation->_control.receive();
+        return hello && std::holds_alternative<proto::Hello>(*hello)
+               && isAcceptable(std::get<proto::Hello>(*hello));
+    };
+    auto const created = [&]() -> bool {
+        auto request = runtime;
+        request.runtimeId = RuntimeId;
+        auto const reply = incarnation->request(request);
+        return reply
+               && *reply
+                      == proto::Pdu { proto::RuntimeCreated { .runtimeId = RuntimeId,
+                                                              .error = std::nullopt } };
+    };
+    if (!handshake() || !created())
+    {
+        incarnation->markDead();
+        return std::unexpected(ExtensionError::HostUnavailable);
+    }
+    return incarnation;
+}
+
+HelperIncarnation::HelperIncarnation(HostConnection connection):
+    _control { parentEnd(std::move(connection.control), proto::ChannelKind::Control) },
+    _handle { std::move(connection.handle) }
+{
+    _lanes.reserve(connection.lanes.size());
+    for (auto& lane: connection.lanes)
+        _lanes.push_back(parentEnd(std::move(lane), proto::ChannelKind::Lane));
+}
+
+HelperIncarnation::~HelperIncarnation() = default;
+
+std::expected<proto::Pdu, StreamError> HelperIncarnation::request(proto::Pdu const& pdu)
+{
+    auto const lock = std::scoped_lock { _controlMutex };
+    if (!isAlive())
+        return std::unexpected(StreamError::Closed);
+    if (auto const sent = _control.send(pdu); !sent)
+    {
+        // A PDU over its cap was not sent, and the stream is intact: the request fails, the host lives on.
+        if (sent.error() != StreamError::OverCap)
+            markDead();
+        return std::unexpected(sent.error());
+    }
+    auto reply = _control.receive();
+    if (!reply)
+        markDead();
+    return reply;
+}
+
+void HelperIncarnation::post(proto::Pdu const& pdu) noexcept
+{
+    auto const lock = std::scoped_lock { _controlMutex };
+    if (isAlive())
+        std::ignore = _control.send(pdu);
+}
+
+void HelperIncarnation::markDead() noexcept
+{
+    if (_state.exchange(IncarnationState::Dead) == IncarnationState::Dead)
+        return;
+    _handle->terminate();
+    // A thread blocked on one of the parent's ends returns; a host that never closes its own ends, as a
+    // hostile one may not, cannot keep it waiting.
+    _control.shutdown();
+    for (auto& lane: _lanes)
+        lane.shutdown();
+}
+
+void HelperIncarnation::interrupt(uint32_t instanceId) noexcept
+{
+    if (isAlive())
+        _handle->interrupt(instanceId);
+}
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/HelperIncarnation.hpp b/src/vtextension/wasm/remote/HelperIncarnation.hpp
new file mode 100644
index 000000000..5eddc2262
--- /dev/null
+++ b/src/vtextension/wasm/remote/HelperIncarnation.hpp
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// One incarnation of an extension host, as the parent drives it: its control channel, its lanes and the
+/// handle on it, from the handshake until it dies or is let go.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include <vtextension/ExtensionError.hpp>
+#include <vtextension/wasm/remote/HostConnector.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/remote/transport/PduStream.hpp>
+
+namespace vtextension::wasm::remote
+{
+
+/// Whether an incarnation still serves. It goes from Alive to Dead once, and never back.
+enum class IncarnationState : uint8_t
+{
+    Dead,  ///< It closed a channel, failed one, or broke the protocol; it was terminated.
+    Alive, ///< It answers.
+};
+
+/// One incarnation of a host: started, handshaken, and holding the one runtime its parent created in it.
+///
+/// The control channel is shared by every thread, one request at a time under a mutex; each lane is used only
+/// by the thread holding that lane of the kind (RemoteKindState), so it needs none. Once anything on any of
+/// its channels goes wrong, the incarnation is dead for good: it is terminated, its channels are shut down so
+/// that no thread stays blocked on them, and every later request fails.
+class HelperIncarnation
+{
+  public:
+    /// The id of the one runtime an incarnation holds.
+    static constexpr uint32_t RuntimeId = 1;
+
+    /// Starts a host, checks its Hello, and creates the runtime in it.
+    /// @param connector What starts the host.
+    /// @param runtime The runtime to create; its id is RuntimeId.
+    /// @return The incarnation; `HostUnavailable` if the host could not be started, speaks another protocol
+    ///         version, failed to confine itself, shares memory where the parent copies it, or did not create
+    ///         the runtime. A host refused after it was started is terminated.
+    [[nodiscard]] static std::expected<std::shared_ptr<HelperIncarnation>, ExtensionError> connect(
+        IHostConnector& connector, proto::CreateRuntime const& runtime);
+
+    /// Use connect(). Public for std::make_shared only.
+    /// @param connection The started host's channels and handle; as many lanes as MaxLaneChannels.
+    explicit HelperIncarnation(HostConnection connection);
+
+    HelperIncarnation(HelperIncarnation const&) = delete;
+    HelperIncarnation(HelperIncarnation&&) = delete;
+    HelperIncarnation& operator=(HelperIncarnation const&) = delete;
+    HelperIncarnation& operator=(HelperIncarnation&&) = delete;
+
+    /// Lets the host go: its handle terminates it, and waits until it is gone.
+    ~HelperIncarnation();
+
+    /// Sends @p pdu on the control channel and receives the reply, as one request no other thread's
+    /// interleaves with. A failure to send or receive, but an over-cap PDU the stream refused to send, kills
+    /// the incarnation.
+    /// @return The reply; why there is none: `Closed` if the incarnation is dead already.
+    [[nodiscard]] std::expected<proto::Pdu, transport::StreamError> request(proto::Pdu const& pdu);
+
+    /// Sends @p pdu on the control channel, expecting no reply; does nothing once the incarnation is dead,
+    /// and ignores a failure.
+    void post(proto::Pdu const& pdu) noexcept;
+
+    /// @return Lane @p index's stream; used only by the thread holding that lane.
+    [[nodiscard]] transport::PduStream& lane(std::size_t index) noexcept { return _lanes[index]; }
+
+    /// @return Whether it still serves.
+    [[nodiscard]] bool isAlive() const noexcept { return _state.load() == IncarnationState::Alive; }
+
+    /// Declares it dead, unless it is: terminates the host, then shuts every channel down. Thread-safe;
+    /// only the first call does anything.
+    void markDead() noexcept;
+
+    /// Interrupts one of its instances, for good, without waiting on the host.
+    /// @param instanceId The instance's id; ignored by the host if unknown.
+    void interrupt(uint32_t instanceId) noexcept;
+
+    /// @return A module id never used in this incarnation.
+    [[nodiscard]] uint32_t nextModuleId() noexcept { return _nextModuleId.fetch_add(1); }
+
+    /// @return An instance id never used in this incarnation.
+    [[nodiscard]] uint32_t nextInstanceId() noexcept { return _nextInstanceId.fetch_add(1); }
+
+  private:
+    std::mutex _controlMutex; ///< Held for each request and post on the control channel.
+    transport::PduStream _control;
+    std::vector<transport::PduStream> _lanes;
+    std::atomic<IncarnationState> _state { IncarnationState::Alive };
+    std::atomic<uint32_t> _nextModuleId { 1 };
+    std::atomic<uint32_t> _nextInstanceId { 1 };
+    // Last, so that it goes first: the host is gone before its channels' parent ends close.
+    std::unique_ptr<IHostHandle> _handle;
+};
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/HostConnector.hpp b/src/vtextension/wasm/remote/HostConnector.hpp
new file mode 100644
index 000000000..96a491e84
--- /dev/null
+++ b/src/vtextension/wasm/remote/HostConnector.hpp
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// How Contour reaches an extension host process: a connector starts one, and hands back its channels and a
+/// handle on it. A process supervisor implements it in production; tests connect to a host in this process.
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <vector>
+
+#include <vtextension/ExtensionError.hpp>
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::remote
+{
+
+/// How many lanes a host serves: one per thread that may call into its instances at once.
+inline constexpr std::size_t MaxLaneChannels = 4;
+
+/// One incarnation of a host process, as its parent holds it.
+class IHostHandle
+{
+  public:
+    IHostHandle() = default;
+    IHostHandle(IHostHandle const&) = delete;
+    IHostHandle(IHostHandle&&) = delete;
+    IHostHandle& operator=(IHostHandle const&) = delete;
+    IHostHandle& operator=(IHostHandle&&) = delete;
+    /// Terminates the host, if it still runs, and waits until it is gone.
+    virtual ~IHostHandle() = default;
+
+    /// Interrupts one instance's running call, for good. Never blocks on the host.
+    /// @param instanceId The parent-chosen id of the instance; an id the host does not know is ignored.
+    virtual void interrupt(uint32_t instanceId) noexcept = 0;
+
+    /// Makes the host stop serving: its channels close, and every receive on the parent's ends fails. Does
+    /// not wait for it to be gone.
+    virtual void terminate() noexcept = 0;
+};
+
+/// A host process started and connected: the parent's ends of its channels, and the handle on it.
+struct HostConnection
+{
+    transport::Channel control;            ///< The control channel's parent end.
+    std::vector<transport::Channel> lanes; ///< The lanes' parent ends; MaxLaneChannels of them.
+    std::unique_ptr<IHostHandle> handle;   ///< The host itself.
+};
+
+/// Starts host processes.
+class IHostConnector
+{
+  public:
+    IHostConnector() = default;
+    IHostConnector(IHostConnector const&) = delete;
+    IHostConnector(IHostConnector&&) = delete;
+    IHostConnector& operator=(IHostConnector const&) = delete;
+    IHostConnector& operator=(IHostConnector&&) = delete;
+    virtual ~IHostConnector() = default;
+
+    /// Starts a host and connects to it. The host's first control PDU is its Hello.
+    /// @return The connection; `HostUnavailable` if no host could be started or connected to.
+    [[nodiscard]] virtual std::expected<HostConnection, ExtensionError> connect() = 0;
+};
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/RegistryRemote_test.cpp b/src/vtextension/wasm/remote/RegistryRemote_test.cpp
new file mode 100644
index 000000000..f56638181
--- /dev/null
+++ b/src/vtextension/wasm/remote/RegistryRemote_test.cpp
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The registry and its breaker over a real host: one extension's helper shared by its panes, whose death
+// counts once however many of them saw it, and which an open breaker no longer spawns.
+#include <core/platform/Clock.hpp>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <expected>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <vtextension/CompiledExtension.hpp>
+#include <vtextension/Engine.hpp>
+#include <vtextension/ExtensionError.hpp>
+#include <vtextension/ExtensionHost.hpp>
+#include <vtextension/ExtensionLimits.hpp>
+#include <vtextension/ExtensionRegistry.hpp>
+#include <vtextension/HostBreaker.hpp>
+#include <vtextension/Instance.hpp>
+#include <vtextension/testing/Harness.hpp>
+#include <vtextension/testing/TestModules.hpp>
+#include <vtextension/wasm/BackendConfig.hpp>
+#include <vtextension/wasm/DefaultBackend.hpp>
+#include <vtextension/wasm/WasmRuntime.hpp>
+#include <vtextension/wasm/host/HostServer.hpp>
+#include <vtextension/wasm/host/InProcessHost.hpp>
+#include <vtextension/wasm/testing/HostedEngine.hpp>
+
+using namespace vtextension;
+using vtextension::testing::surface;
+using vtextension::testing::toModule;
+using vtextension::wasm::host::HostServerConfig;
+using vtextension::wasm::host::InProcessHostConnector;
+
+namespace
+{
+
+/// Every pane of these tests is held to the default limits.
+constexpr auto Limits = ExtensionLimits {};
+
+/// @return A connector starting each host in this process, on an engine of its own.
+[[nodiscard]] std::shared_ptr<InProcessHostConnector> makeConnector()
+{
+    return std::make_shared<InProcessHostConnector>([] { return wasm::testing::makeHostedEngine(); },
+                                                    HostServerConfig {});
+}
+
+/// A registry and an engine whose hosts run in this process, started through a connector the test sees.
+struct RemoteRig
+{
+    /// @param hosts What starts the hosts.
+    explicit RemoteRig(std::shared_ptr<InProcessHostConnector> hosts = makeConnector()):
+        connector { std::move(hosts) }
+    {
+    }
+
+    std::shared_ptr<InProcessHostConnector> connector;
+    std::unique_ptr<wasm::IWasmBackend> backend = wasm::makeDefaultBackend(
+        wasm::BackendConfig { .helper = {}, .timeouts = {}, .connector = connector });
+    std::shared_ptr<Engine> engine = [this] {
+        auto created = Engine::create(*backend, Limits);
+        REQUIRE(created.has_value());
+        return std::move(*created);
+    }();
+    std::unique_ptr<wasm::IThreadGuard> threadGuard = vtextension::testing::preparedThread(*backend);
+    core::platform::ManualClock clock;
+    ExtensionRegistry registry { clock, Limits };
+    vtextension::testing::FakeHostServices services;
+
+    /// @return The minimal statusline module, acquired from the registry; it must load.
+    [[nodiscard]] std::shared_ptr<CompiledExtension> acquire()
+    {
+        auto compiled = registry.acquire(*engine, key(), toModule(vtextension::testing::MinimalModule));
+        REQUIRE(compiled.has_value());
+        return std::move(*compiled);
+    }
+
+    /// @return A pane's instance of @p compiled, or why there is none.
+    [[nodiscard]] std::expected<std::unique_ptr<Instance>, ExtensionError> instantiate(
+        CompiledExtension const& compiled)
+    {
+        return Instance::create(*engine, compiled, services, clock, Limits);
+    }
+
+    /// @return The key every pane of these tests names its extension by.
+    [[nodiscard]] static RegistryKey key()
+    {
+        auto const spec = ExtensionSpec { .name = "clock",
+                                          .hostId = "clock@/ext/minimal.wasm",
+                                          .module = toModule(vtextension::testing::MinimalModule),
+                                          .config = {},
+                                          .placement = Placement::Segment,
+                                          .runCommand = CommandPermission::Deny };
+        return registryKeyOf(spec, ExtensionWorld::StatusLine);
+    }
+};
+
+} // namespace
+
+TEST_CASE("one death counts once across panes", "[vtextension][remote][registry]")
+{
+    auto rig = RemoteRig {};
+    auto const compiled = rig.acquire();
+    auto panes = std::vector<std::unique_ptr<Instance>> {};
+    for ([[maybe_unused]] auto const pane: std::views::iota(0, 10))
+    {
+        auto instance = rig.instantiate(*compiled);
+        REQUIRE(instance.has_value());
+        panes.push_back(std::move(*instance));
+    }
+    REQUIRE(rig.connector->connects() == 1);
+
+    CHECK(rig.connector->terminateAll() == 1);
+    for (auto const& pane: panes)
+        CHECK(pane->render(surface(10, 1)).error() == ExtensionError::HostUnavailable);
+    CHECK(compiled->breaker()->faultCount() == 1);
+    CHECK(compiled->breaker()->state() == BreakerState::Closed);
+    CHECK(rig.connector->connects() == 1);
+
+    // One respawn, for the next pane.
+    auto const next = rig.instantiate(*compiled);
+    REQUIRE(next.has_value());
+    CHECK(rig.connector->connects() == 2);
+}
+
+TEST_CASE("breaker open fails fast without spawning", "[vtextension][remote][registry]")
+{
+    auto rig = RemoteRig {};
+    auto const compiled = rig.acquire();
+    for ([[maybe_unused]] auto const death: std::views::iota(0, 3))
+    {
+        auto const instance = rig.instantiate(*compiled);
+        REQUIRE(instance.has_value());
+        REQUIRE(rig.connector->terminateAll() == 1);
+        CHECK((*instance)->render(surface(10, 1)).error() == ExtensionError::HostUnavailable);
+    }
+    REQUIRE(compiled->breaker()->state() == BreakerState::Open);
+    auto const connects = rig.connector->connects();
+
+    CHECK(rig.instantiate(*compiled).error() == ExtensionError::HostUnavailable);
+    CHECK(rig.connector->connects() == connects);
+    CHECK(rig.connector->liveHosts() == 0);
+}
+
+TEST_CASE("registry drop races instantiate (remote)", "[vtextension][remote][registry][threading]")
+{
+    // As over the fake backend, with a real helper behind each entry: whichever thread wins, nothing is
+    // left running once every reference is gone.
+    auto const connector = makeConnector();
+    {
+        auto rig = RemoteRig { connector };
+        for ([[maybe_unused]] auto const round: std::views::iota(0, 200))
+        {
+            auto first = std::optional { rig.acquire() };
+            auto dropper = std::jthread { [&first] { first.reset(); } };
+            auto const second = rig.registry.acquire(
+                *rig.engine, RemoteRig::key(), toModule(vtextension::testing::MinimalModule));
+            REQUIRE(second);
+            auto const instance = rig.instantiate(**second);
+            CHECK(instance);
+            dropper.join();
+            CHECK(rig.registry.liveEntries() <= 1);
+        }
+    }
+    CHECK(connector->liveHosts() == 0);
+}
diff --git a/src/vtextension/wasm/remote/RemoteBackend.cpp b/src/vtextension/wasm/remote/RemoteBackend.cpp
