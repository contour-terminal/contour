+TEST_CASE("RemoteBackend.sameIdentitySharesAHelper", "[vtextension][remote]")
+{
+    auto const connector = makeConnector();
+    auto const backend = makeBackend(connector);
+    auto const runtime = contract::createRuntime(*backend);
+
