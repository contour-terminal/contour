+#ifndef _WIN32
+TEST_CASE("ControlPage.adoptRefusesAWrongSize", "[vtextension]")
+{
+    #ifdef __APPLE__
+    auto const name = std::format("/contour-eh-test-{}", ::getpid());
+    auto const descriptor = ::shm_open(name.c_str(), O_RDWR | O_CREAT | O_EXCL, 0600);
+    REQUIRE(descriptor != -1);
+    ::shm_unlink(name.c_str());
+    #else
+    auto const descriptor = ::memfd_create("contour-eh-test", MFD_CLOEXEC);
+    REQUIRE(descriptor != -1);
+    #endif
+    REQUIRE(::ftruncate(descriptor, 8192) == 0);
+    CHECK(ControlPage::adopt(descriptor) == std::unexpected(SharedObjectError::WrongSize));
+    // A refused handle stays its owner's.
+    CHECK(::close(descriptor) == 0);
+}
+#endif
+
+#if defined(__linux__) || defined(__FreeBSD__)
+TEST_CASE("ControlPage.isSealed", "[vtextension]")
+{
+    auto const page = ControlPage::create();
+    REQUIRE(page.has_value());
+    // Neither process can make the other's mapping run past the object's end, nor shrink it under it.
+    for (auto const size: { 8192, 0 })
+    {
+        auto const resized = ::ftruncate(page->nativeHandle(), size);
+        auto const error = errno;
+        CHECK(resized == -1);
+        CHECK(error == EPERM);
+    }
+}
+#endif
+
+TEST_CASE("ControlPage.isNotInherited", "[vtextension]")
+{
+    auto const page = ControlPage::create();
+    REQUIRE(page.has_value());
+#ifdef _WIN32
+    auto flags = DWORD { 0 };
+    REQUIRE(::GetHandleInformation(page->nativeHandle(), &flags));
+    CHECK((flags & HANDLE_FLAG_INHERIT) == 0);
+#else
+    auto const flags = ::fcntl(page->nativeHandle(), F_GETFD);
+    REQUIRE(flags != -1);
+    CHECK((flags & FD_CLOEXEC) != 0);
+#endif
+}
diff --git a/src/vtextension/wasm/remote/transport/ControlPage_win32.cpp b/src/vtextension/wasm/remote/transport/ControlPage_win32.cpp
new file mode 100644
index 000000000..aad35242b
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/ControlPage_win32.cpp
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The interrupt page on Windows: an unnamed, pagefile-backed section of one page, not inheritable until it is
+// handed over. A section cannot be resized once created, so it needs no seal.
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <utility>
+
+#include <vtextension/wasm/remote/transport/ControlPage.hpp>
+
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+
+namespace vtextension::wasm::remote::transport
+{
+
+static_assert(std::atomic_ref<uint32_t>::is_always_lock_free,
+              "the page is shared between processes: only a lock-free flag is address-free");
+
+namespace
+{
+    /// @return @p section's whole view mapped readable and writable, and its size; or why it could not be.
+    [[nodiscard]] std::expected<std::pair<uint32_t*, std::size_t>, SharedObjectError> mapSection(
+        HANDLE section) noexcept
+    {
+        auto* const view = ::MapViewOfFile(section, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, 0);
+        if (view == nullptr)
+            return std::unexpected(SharedObjectError::Io);
+        auto region = MEMORY_BASIC_INFORMATION {};
+        if (::VirtualQuery(view, &region, sizeof(region)) == 0)
+        {
+            ::UnmapViewOfFile(view);
+            return std::unexpected(SharedObjectError::Io);
+        }
+        return std::pair { static_cast<uint32_t*>(view), static_cast<std::size_t>(region.RegionSize) };
+    }
+} // namespace
+
+ControlPage::ControlPage(NativeHandle handle, uint32_t* flags) noexcept: _handle { handle }, _flags { flags }
+{
+}
+
+std::expected<ControlPage, SharedObjectError> ControlPage::create()
+{
+    auto* const section =
+        ::CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, ControlPageBytes, nullptr);
+    if (section == nullptr)
+        return std::unexpected(SharedObjectError::Io);
+    auto const mapped = mapSection(section);
+    if (!mapped)
+    {
+        ::CloseHandle(section);
+        return std::unexpected(mapped.error());
+    }
+    return ControlPage { section, mapped->first };
+}
+
+std::expected<ControlPage, SharedObjectError> ControlPage::adopt(NativeHandle handle)
+{
+    auto const mapped = mapSection(handle);
+    if (!mapped)
+        return std::unexpected(mapped.error());
+    if (mapped->second != ControlPageBytes)
+    {
+        ::UnmapViewOfFile(mapped->first);
+        return std::unexpected(SharedObjectError::WrongSize);
+    }
+    if (!::SetHandleInformation(handle, HANDLE_FLAG_INHERIT, 0))
+    {
+        ::UnmapViewOfFile(mapped->first);
+        return std::unexpected(SharedObjectError::Io);
+    }
+    return ControlPage { handle, mapped->first };
+}
+
+ControlPage::ControlPage(ControlPage&& other) noexcept:
+    _handle { std::exchange(other._handle, nullptr) }, _flags { std::exchange(other._flags, nullptr) }
+{
+}
+
+ControlPage& ControlPage::operator=(ControlPage&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _handle = std::exchange(other._handle, nullptr);
+        _flags = std::exchange(other._flags, nullptr);
+    }
+    return *this;
+}
+
+ControlPage::~ControlPage()
+{
+    release();
+}
+
+void ControlPage::release() noexcept
+{
+    if (_flags != nullptr)
+        ::UnmapViewOfFile(_flags);
+    if (_handle != nullptr)
+        ::CloseHandle(_handle);
+    _flags = nullptr;
+    _handle = nullptr;
+}
+
+NativeHandle ControlPage::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/HelperArguments.cpp b/src/vtextension/wasm/remote/transport/HelperArguments.cpp
new file mode 100644
index 000000000..375677bba
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/HelperArguments.cpp
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The helper's command line, one row per option: its name, how its value is read into the arguments, and how
+// it is written from them. A new option is a new row; nothing else changes.
+#include <vtextension/wasm/remote/transport/HelperArguments.hpp>
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <bitset>
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <format>
+#include <ranges>
+#include <span>
+#include <string>
+#include <string_view>
+#include <system_error>
+#include <vector>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+    /// @return @p text as a whole decimal number of type T; nothing if it is not one, or out of T's range.
+    template <typename T>
+    [[nodiscard]] std::expected<T, ArgumentError> numberOf(std::string_view text) noexcept
+    {
+        auto value = T {};
+        auto const [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+        if (text.empty() || error != std::errc {} || end != text.data() + text.size())
+            return std::unexpected(ArgumentError::Malformed);
+        return value;
+    }
+
+    /// @return @p text as a handle; `Malformed` if it is none.
+    [[nodiscard]] std::expected<NativeHandle, ArgumentError> handleOf(std::string_view text) noexcept
+    {
+#ifdef _WIN32
+        return numberOf<uintptr_t>(text).transform(
+            [](uintptr_t value) { return std::bit_cast<NativeHandle>(value); });
+#else
+        return numberOf<NativeHandle>(text).and_then(
+            [](NativeHandle value) -> std::expected<NativeHandle, ArgumentError> {
+                if (value < 0)
+                    return std::unexpected(ArgumentError::Malformed);
+                return value;
+            });
+#endif
+    }
+
+    /// @return @p handle's decimal value.
+    [[nodiscard]] std::string textOf(NativeHandle handle)
+    {
+#ifdef _WIN32
+        return std::to_string(std::bit_cast<uintptr_t>(handle));
+#else
+        return std::to_string(handle);
+#endif
+    }
+
+    /// One option: `--name=value`.
+    struct Option
+    {
+        std::string_view name;
+        /// Reads @p value into the arguments.
+        std::expected<void, ArgumentError> (*parse)(HelperArguments& arguments, std::string_view value);
+        /// @return The option's value, from the arguments.
+        std::string (*format)(HelperArguments const& arguments);
+    };
+
+    /// @return A row's parse for a single handle field.
+    template <NativeHandle HelperArguments::* Field>
+    [[nodiscard]] std::expected<void, ArgumentError> parseHandle(HelperArguments& arguments,
+                                                                 std::string_view value)
+    {
+        return handleOf(value).transform([&](NativeHandle handle) { arguments.*Field = handle; });
+    }
+
+    /// @return A row's format for a single handle field.
+    template <NativeHandle HelperArguments::* Field>
+    [[nodiscard]] std::string formatHandle(HelperArguments const& arguments)
+    {
+        return textOf(arguments.*Field);
+    }
+
+    /// @return A row's parse for a number field.
+    template <typename T, T HelperArguments::* Field>
+    [[nodiscard]] std::expected<void, ArgumentError> parseNumber(HelperArguments& arguments,
+                                                                 std::string_view value)
+    {
+        return numberOf<T>(value).transform([&](T number) { arguments.*Field = number; });
+    }
+
+    /// @return A row's format for a number field.
+    template <typename T, T HelperArguments::* Field>
+    [[nodiscard]] std::string formatNumber(HelperArguments const& arguments)
+    {
+        return std::to_string(arguments.*Field);
+    }
+
+    /// Reads the lanes: exactly MaxLaneChannels handles, comma-separated.
+    [[nodiscard]] std::expected<void, ArgumentError> parseLanes(HelperArguments& arguments,
+                                                                std::string_view value)
+    {
+        auto count = std::size_t { 0 };
+        for (auto const part: std::views::split(value, ','))
+        {
+            if (count == MaxLaneChannels)
+                return std::unexpected(ArgumentError::Malformed);
+            auto const handle = handleOf(std::string_view { part });
+            if (!handle)
+                return std::unexpected(handle.error());
+            arguments.lanes[count++] = *handle;
+        }
+        if (count != MaxLaneChannels)
+            return std::unexpected(ArgumentError::Malformed);
+        return {};
+    }
+
+    /// Writes the lanes, comma-separated.
+    [[nodiscard]] std::string formatLanes(HelperArguments const& arguments)
+    {
+        auto text = std::string {};
+        for (auto const lane: arguments.lanes)
+        {
+            if (!text.empty())
+                text += ',';
+            text += textOf(lane);
+        }
+        return text;
+    }
+
+    /// Every option, in the order the command line is written in.
+    constexpr auto Options = std::array {
+        Option { .name = "control",
+                 .parse = &parseHandle<&HelperArguments::control>,
+                 .format = &formatHandle<&HelperArguments::control> },
+        Option { .name = "lanes", .parse = &parseLanes, .format = &formatLanes },
+        Option { .name = "page",
+                 .parse = &parseHandle<&HelperArguments::controlPage>,
+                 .format = &formatHandle<&HelperArguments::controlPage> },
+        Option { .name = "wake",
+                 .parse = &parseHandle<&HelperArguments::wake>,
+                 .format = &formatHandle<&HelperArguments::wake> },
+        Option { .name = "parent",
+                 .parse = &parseNumber<int64_t, &HelperArguments::parentProcessId>,
+                 .format = &formatNumber<int64_t, &HelperArguments::parentProcessId> },
+        Option { .name = "data-bytes",
+                 .parse = &parseNumber<uint64_t, &HelperArguments::dataBytes>,
+                 .format = &formatNumber<uint64_t, &HelperArguments::dataBytes> },
+    };
+
+    /// @return The row of the option @p name; nothing if none has it.
+    [[nodiscard]] std::expected<std::size_t, ArgumentError> optionIndexOf(std::string_view name) noexcept
+    {
+        auto const found = std::ranges::find(Options, name, &Option::name);
+        if (found == Options.end())
+            return std::unexpected(ArgumentError::Unknown);
+        return static_cast<std::size_t>(found - Options.begin());
+    }
+} // namespace
+
+std::vector<std::string> formatHelperArguments(HelperArguments const& arguments)
+{
+    auto result = std::vector<std::string> {};
+    result.reserve(Options.size());
+    for (auto const& option: Options)
+        result.push_back(std::format("--{}={}", option.name, option.format(arguments)));
+    return result;
+}
+
+std::expected<HelperArguments, ArgumentError> parseHelperArguments(
+    std::span<std::string_view const> arguments)
+{
+    constexpr auto Prefix = std::string_view { "--" };
+    auto result = HelperArguments {};
+    auto seen = std::bitset<Options.size()> {};
+    for (auto const argument: arguments)
+    {
+        if (!argument.starts_with(Prefix))
+            return std::unexpected(ArgumentError::Unknown);
+        auto const option = argument.substr(Prefix.size());
+        auto const equals = option.find('=');
+        auto const index = optionIndexOf(option.substr(0, equals));
+        if (!index)
+            return std::unexpected(index.error());
+        if (seen.test(*index))
+            return std::unexpected(ArgumentError::Duplicate);
+        seen.set(*index);
+        if (equals == std::string_view::npos)
+            return std::unexpected(ArgumentError::Malformed);
+        if (auto const parsed = Options[*index].parse(result, option.substr(equals + 1)); !parsed)
+            return std::unexpected(parsed.error());
+    }
+    if (!seen.all())
+        return std::unexpected(ArgumentError::Missing);
+    return result;
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/HelperArguments.hpp b/src/vtextension/wasm/remote/transport/HelperArguments.hpp
new file mode 100644
index 000000000..642ebdd44
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/HelperArguments.hpp
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host process's command line: which of the handles it inherited is which, whose child it is,
+/// and the cap on its memory. Contour formats it, the helper parses it; both link this, and the helper links
+/// nothing else of the launcher's to read its own arguments.
+///
+/// `--control=H --lanes=H,H,H,H --page=H --wake=H --parent=PID --data-bytes=N`, every option once. A handle
+/// is its decimal value: a descriptor number on POSIX, a HANDLE's value on Windows.
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::remote
+{
+
+/// How many lanes a host serves: one per thread that may call into its instances at once.
+inline constexpr std::size_t MaxLaneChannels = 4;
+
+} // namespace vtextension::wasm::remote
+
+namespace vtextension::wasm::remote::transport
+{
+
+/// What an extension host process is told on its command line.
+struct HelperArguments
+{
+    NativeHandle control {};                            ///< The control channel's end.
+    std::array<NativeHandle, MaxLaneChannels> lanes {}; ///< The lanes' ends.
+    NativeHandle controlPage {};                        ///< The interrupt page (ControlPage).
+    NativeHandle wake {};                               ///< The wake signal's receiving end.
+    int64_t parentProcessId = 0;                        ///< The process that started it.
+    uint64_t dataBytes = 0;                             ///< The cap on its data memory; 0: no cap.
+
+    bool operator==(HelperArguments const&) const = default;
+};
+
+/// Why a command line does not parse.
+enum class ArgumentError : uint8_t
+{
+    Unknown,   ///< An argument names no option.
+    Duplicate, ///< An option is given twice.
+    Missing,   ///< An option is not given.
+    Malformed, ///< An option's value is not what it takes.
+};
+
+/// @param arguments What to tell the helper.
+/// @return The command line, one `--name=value` argument per option.
+[[nodiscard]] std::vector<std::string> formatHelperArguments(HelperArguments const& arguments);
+
+/// @param arguments The command line after the program's name, each a `--name=value` argument.
+/// @return What it tells the helper; or the first reason it does not parse.
+[[nodiscard]] std::expected<HelperArguments, ArgumentError> parseHelperArguments(
+    std::span<std::string_view const> arguments);
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/HelperArguments_test.cpp b/src/vtextension/wasm/remote/transport/HelperArguments_test.cpp
new file mode 100644
index 000000000..7e7f5b4fe
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/HelperArguments_test.cpp
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The command line that names, to the extension host process, the handles it inherited: what is formatted
+// parses back to the same values, and every way a command line can be wrong is refused for its reason.
+#include <catch2/catch_test_macros.hpp>
+
+#include <algorithm>
+#include <bit>
+#include <cstdint>
+#include <expected>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <vtextension/wasm/remote/transport/HelperArguments.hpp>
+
+using vtextension::wasm::remote::transport::ArgumentError;
+using vtextension::wasm::remote::transport::formatHelperArguments;
+using vtextension::wasm::remote::transport::HelperArguments;
+using vtextension::wasm::remote::transport::NativeHandle;
+using vtextension::wasm::remote::transport::parseHelperArguments;
+
+namespace
+{
+
+/// @return @p number as a handle value of this platform.
+[[nodiscard]] NativeHandle handleOf(uint64_t number) noexcept
+{
+#ifdef _WIN32
+    return std::bit_cast<NativeHandle>(static_cast<uintptr_t>(number));
+#else
+    return static_cast<NativeHandle>(number);
+#endif
+}
+
+/// @return @p arguments parsed, as the views a process's argv gives.
+[[nodiscard]] std::expected<HelperArguments, ArgumentError> parse(std::vector<std::string> const& arguments)
+{
+    auto views = std::vector<std::string_view> {};
+    for (auto const& argument: arguments)
+        views.emplace_back(argument);
+    return parseHelperArguments(std::span<std::string_view const> { views });
+}
+
+/// @return A complete, valid command line: what the rows below each spoil in one way.
+[[nodiscard]] std::vector<std::string> validArguments()
+{
+    return formatHelperArguments(HelperArguments {
+        .control = handleOf(3),
+        .lanes = { handleOf(4), handleOf(5), handleOf(6), handleOf(7) },
+        .controlPage = handleOf(8),
+        .wake = handleOf(9),
+        .parentProcessId = 4242,
+        .dataBytes = 1024,
+    });
+}
+
+/// @return validArguments() with @p option in place of the one of its name, or appended if none has it.
+[[nodiscard]] std::vector<std::string> validWith(std::string const& option)
+{
+    auto arguments = validArguments();
+    auto const prefix = option.substr(0, option.find('=') + 1);
+    auto const same = std::ranges::find_if(
+        arguments, [&](std::string const& argument) { return argument.starts_with(prefix); });
+    if (same == arguments.end())
+        arguments.push_back(option);
+    else
+        *same = option;
+    return arguments;
+}
+
+/// @return validArguments() without the option whose `--name=` prefix is @p prefix.
+[[nodiscard]] std::vector<std::string> validWithout(std::string_view prefix)
+{
+    auto arguments = validArguments();
+    std::erase_if(arguments, [&](std::string const& argument) { return argument.starts_with(prefix); });
+    return arguments;
+}
+
+/// @return validArguments() with @p option once more at its end.
+[[nodiscard]] std::vector<std::string> validAnd(std::string const& option)
+{
+    auto arguments = validArguments();
+    arguments.push_back(option);
+    return arguments;
+}
+
+} // namespace
+
+TEST_CASE("HelperArguments.roundTrip", "[vtextension]")
+{
+    SECTION("POSIX-style numbers")
+    {
+        auto const arguments =
+            HelperArguments { .control = handleOf(3),
+                              .lanes = { handleOf(4), handleOf(5), handleOf(6), handleOf(7) },
+                              .controlPage = handleOf(8),
+                              .wake = handleOf(9),
+                              .parentProcessId = 12345,
+                              .dataBytes = uint64_t { 1 } << 30 };
+        CHECK(parse(formatHelperArguments(arguments)) == arguments);
+    }
+    SECTION("large values, and no cap")
+    {
+#ifdef _WIN32
+        // Handle values as Windows hands them out: pointer-sized, beyond 32 bits.
+        constexpr auto Large = uint64_t { 0x7fff'0000'0000 };
+#else
+        // A descriptor is an int.
+        constexpr auto Large = uint64_t { 0x7fff'0000 };
+#endif
+        auto const arguments = HelperArguments {
+            .control = handleOf(Large + 0x1234),
+            .lanes = { handleOf(0x2a4), handleOf(0x2a8), handleOf(Large + 0xfff0), handleOf(Large + 4) },
+            .controlPage = handleOf(Large + 0xfffc),
+            .wake = handleOf(0x10),
+            .parentProcessId = 0x7fff'ffff'ffff,
+            .dataBytes = 0
+        };
+        CHECK(parse(formatHelperArguments(arguments)) == arguments);
+    }
+}
+
+TEST_CASE("HelperArguments.rejects", "[vtextension]")
+{
+    struct Row
+    {
+        std::string_view name;
+        std::vector<std::string> arguments;
+        ArgumentError error;
+    };
+    auto const rows = std::vector<Row> {
+        { .name = "an unknown option", .arguments = validAnd("--bogus=1"), .error = ArgumentError::Unknown },
+        { .name = "a repeated option", .arguments = validAnd("--wake=9"), .error = ArgumentError::Duplicate },
+        { .name = "a missing option", .arguments = validWithout("--wake="), .error = ArgumentError::Missing },
+        { .name = "too few lanes",
+          .arguments = validWith("--lanes=4,5,6"),
+          .error = ArgumentError::Malformed },
+        { .name = "a parent that is no number",
+          .arguments = validWith("--parent=x"),
+          .error = ArgumentError::Malformed },
+        { .name = "a negative cap",
+          .arguments = validWith("--data-bytes=-1"),
+          .error = ArgumentError::Malformed },
+    };
+    for (auto const& row: rows)
+    {
+        INFO(row.name);
+        CHECK(parse(row.arguments) == std::unexpected(row.error));
+    }
+}
diff --git a/src/vtextension/wasm/remote/transport/WakeSignal.hpp b/src/vtextension/wasm/remote/transport/WakeSignal.hpp
new file mode 100644
index 000000000..c2bfa45cd
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/WakeSignal.hpp
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The wake signal: how Contour tells its extension host process that it raised an interrupt flag
+/// (ControlPage.hpp). A one-byte-per-wake stream socket pair on POSIX, a manual-reset event on Windows.
+///
+/// Sending never blocks and never raises SIGPIPE, whatever the helper does: a full buffer only means that a
+/// wake is queued already, and the helper scans the whole page on every wake.
+
+#include <cstdint>
+#include <expected>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+struct WakePair;
+
+/// What a signal() did.
+enum class WakeResult : uint8_t
+{
+    Pending, ///< Nothing: a wake is queued already, which the receiver has not taken yet.
+    Sent,    ///< A wake is queued now; or the receiver is gone, and there is nobody left to wake.
+};
+
+/// Why a wait() returned.
+enum class WakeWait : uint8_t
+{
+    Stopped,  ///< stop() was called.
+    PeerGone, ///< The sender is gone, and no wake is queued (POSIX; Windows cannot tell).
+    Woken,    ///< At least one wake was queued, and every queued one is taken.
+};
+
+/// The parent's end. Move-only; closed when destroyed.
+class WakeSender
+{
+  public:
+    WakeSender(WakeSender&& other) noexcept;
+    WakeSender& operator=(WakeSender&& other) noexcept;
+    WakeSender(WakeSender const&) = delete;
+    WakeSender& operator=(WakeSender const&) = delete;
+    ~WakeSender();
+
+    /// Queues a wake. Never blocks, never raises SIGPIPE; any thread.
+    /// @return Whether a wake was queued, or one was queued already.
+    [[nodiscard]] WakeResult signal() const noexcept;
+
+    /// @return The end's handle, still owned by it.
+    [[nodiscard]] NativeHandle nativeHandle() const noexcept;
+
+  private:
+    friend std::expected<WakePair, ChannelError> makeWakePair();
+    explicit WakeSender(NativeHandle handle) noexcept;
+
+    NativeHandle _handle;
+};
+
+/// The helper's end. Move-only; closed when destroyed.
+class WakeReceiver
+{
+  public:
+    /// Takes ownership of the end this process inherited, made close-on-exec (not inheritable) again.
+    /// @param handle The end.
+    /// @return The receiver; `Io` if @p handle is no such end, in which case it stays the caller's.
+    [[nodiscard]] static std::expected<WakeReceiver, ChannelError> adopt(NativeHandle handle);
+
+    WakeReceiver(WakeReceiver&& other) noexcept;
+    WakeReceiver& operator=(WakeReceiver&& other) noexcept;
+    WakeReceiver(WakeReceiver const&) = delete;
+    WakeReceiver& operator=(WakeReceiver const&) = delete;
+    ~WakeReceiver();
+
+    /// Blocks until a wake is queued, the sender is gone, or stop() was called. One thread at a time.
+    /// @return Why it returned; `Woken` only once every queued wake is taken. `Stopped` wins over the others.
+    [[nodiscard]] WakeWait wait() noexcept;
+
+    /// Ends a wait() blocked now, and every later one, with `Stopped`. Thread-safe and idempotent.
+    void stop() const noexcept;
+
+    /// @return The end's handle, still owned by it.
+    [[nodiscard]] NativeHandle nativeHandle() const noexcept;
+
+  private:
+    friend std::expected<WakePair, ChannelError> makeWakePair();
+#ifdef _WIN32
+    WakeReceiver(NativeHandle handle, void* stopEvent) noexcept;
+#else
+    WakeReceiver(NativeHandle handle, int stopRead, int stopWrite) noexcept;
+#endif
+
+    /// Closes what this end holds, if anything.
+    void release() noexcept;
+
+    NativeHandle _handle;
+#ifdef _WIN32
+    void* _stopEvent; ///< A manual-reset event stop() sets.
+#else
+    int _stopRead;  ///< The stop pipe's read end, readable once stop() was called.
+    int _stopWrite; ///< Its write end.
+#endif
+};
+
+/// A connected sender and receiver.
+struct WakePair
+{
+    WakeSender parent;   ///< Contour's end.
+    WakeReceiver helper; ///< The extension host process's end, to hand over.
+};
+
+/// Creates a connected pair. Neither end is inherited by a child process unless it is handed over on
+/// purpose.
+/// @return The pair; `Io` if the system refused.
+[[nodiscard]] std::expected<WakePair, ChannelError> makeWakePair();
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/WakeSignal_posix.cpp b/src/vtextension/wasm/remote/transport/WakeSignal_posix.cpp
new file mode 100644
index 000000000..b01c7e553
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/WakeSignal_posix.cpp
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The wake signal on POSIX: a Unix-domain stream socket pair, one byte per wake. The sender's end is
+// non-blocking and its sends carry MSG_NOSIGNAL (macOS: SO_NOSIGPIPE), so a full buffer or a gone receiver
+// costs the parent neither a block nor a SIGPIPE -- a pipe would raise SIGPIPE, and the parent installs no
+// handler. The receiver polls its end beside a pipe of its own that stop() writes to.
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <utility>
+
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+
+#include <vtextension/wasm/remote/transport/WakeSignal.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+#ifdef MSG_NOSIGNAL
+    /// Never blocks, and fails a send to a gone peer with EPIPE instead of raising SIGPIPE.
+    constexpr auto SendFlags = MSG_DONTWAIT | MSG_NOSIGNAL;
+#else
+    // macOS has no MSG_NOSIGNAL; the sender's socket carries SO_NOSIGPIPE instead.
+    constexpr auto SendFlags = MSG_DONTWAIT;
+#endif
+
+    /// Closes @p descriptor if it is open.
+    void closeDescriptor(int descriptor) noexcept
+    {
+        if (descriptor != -1)
+            ::close(descriptor);
+    }
+
+    /// Adds @p flags to @p descriptor's file status flags.
+    [[nodiscard]] std::expected<void, ChannelError> addStatusFlags(int descriptor, int flags) noexcept
+    {
+        auto const current = ::fcntl(descriptor, F_GETFL);
+        if (current == -1 || ::fcntl(descriptor, F_SETFL, current | flags) == -1)
+            return std::unexpected(ChannelError::Io);
+        return {};
+    }
+
+    /// Makes @p descriptor close-on-exec.
+    [[nodiscard]] std::expected<void, ChannelError> setCloseOnExec(int descriptor) noexcept
+    {
+        if (::fcntl(descriptor, F_SETFD, FD_CLOEXEC) == -1)
+            return std::unexpected(ChannelError::Io);
+        return {};
+    }
+
+    /// @return A pipe whose ends are close-on-exec and non-blocking, read end first.
+    [[nodiscard]] std::expected<std::array<int, 2>, ChannelError> makeStopPipe() noexcept
+    {
+        auto ends = std::array<int, 2> { -1, -1 };
+#ifdef __APPLE__
+        if (::pipe(ends.data()) == -1)
+            return std::unexpected(ChannelError::Io);
+        for (auto const end: ends)
+            if (!setCloseOnExec(end) || !addStatusFlags(end, O_NONBLOCK))
+            {
+                closeDescriptor(ends[0]);
+                closeDescriptor(ends[1]);
+                return std::unexpected(ChannelError::Io);
+            }
+#else
+        if (::pipe2(ends.data(), O_CLOEXEC | O_NONBLOCK) == -1)
+            return std::unexpected(ChannelError::Io);
+#endif
+        return ends;
+    }
+
+    /// Makes a receiver's end what wait() needs: close-on-exec, and non-blocking so that it drains.
+    [[nodiscard]] std::expected<void, ChannelError> configureReceiver(int descriptor) noexcept
+    {
+        return setCloseOnExec(descriptor).and_then([&] { return addStatusFlags(descriptor, O_NONBLOCK); });
+    }
+
+    /// Makes a sender's end non-blocking, and on macOS SIGPIPE-free.
+    [[nodiscard]] std::expected<void, ChannelError> configureSender(int descriptor) noexcept
+    {
+#ifdef SO_NOSIGPIPE
+        auto const enable = 1;
+        if (::setsockopt(descriptor, SOL_SOCKET, SO_NOSIGPIPE, &enable, sizeof(enable)) == -1)
+            return std::unexpected(ChannelError::Io);
+#endif
+        return setCloseOnExec(descriptor).and_then([&] { return addStatusFlags(descriptor, O_NONBLOCK); });
+    }
+
+    /// What draining a receiver's socket found.
+    enum class Drained : uint8_t
+    {
+        Nothing,     ///< No byte, and the stream goes on.
+        EndOfStream, ///< The sender is gone, and nothing was queued.
+        Wakes,       ///< At least one wake was taken.
+    };
+
+    /// Takes every byte queued on @p descriptor.
+    [[nodiscard]] Drained drain(int descriptor) noexcept
+    {
+        auto buffer = std::array<uint8_t, 256> {};
+        auto drained = Drained::Nothing;
+        while (true)
+        {
+            auto const received = ::recv(descriptor, buffer.data(), buffer.size(), MSG_DONTWAIT);
+            if (received > 0)
+                drained = Drained::Wakes;
+            else if (received == -1 && errno == EINTR)
+                continue;
+            else if (received == -1 && (errno == EAGAIN || errno == EWOULDBLOCK))
+                return drained;
+            else
+                // End of stream, or a failure that ends it as surely.
+                return drained == Drained::Wakes ? drained : Drained::EndOfStream;
+        }
+    }
+} // namespace
+
+WakeSender::WakeSender(NativeHandle handle) noexcept: _handle { handle }
+{
+}
+
+WakeSender::WakeSender(WakeSender&& other) noexcept: _handle { std::exchange(other._handle, -1) }
+{
+}
+
+WakeSender& WakeSender::operator=(WakeSender&& other) noexcept
+{
+    if (this != &other)
+    {
+        closeDescriptor(_handle);
+        _handle = std::exchange(other._handle, -1);
+    }
+    return *this;
+}
+
+WakeSender::~WakeSender()
+{
+    closeDescriptor(_handle);
+}
+
+WakeResult WakeSender::signal() const noexcept
+{
+    auto const wake = uint8_t { 1 };
+    while (true)
+    {
+        if (::send(_handle, &wake, sizeof(wake), SendFlags) == 1)
+            return WakeResult::Sent;
+        if (errno == EINTR)
+            continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK)
+            return WakeResult::Pending;
+        // The receiver is gone (EPIPE, ECONNRESET): nobody is left to wake, and its exit is seen elsewhere.
+        return WakeResult::Sent;
+    }
+}
+
+NativeHandle WakeSender::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+WakeReceiver::WakeReceiver(NativeHandle handle, int stopRead, int stopWrite) noexcept:
+    _handle { handle }, _stopRead { stopRead }, _stopWrite { stopWrite }
+{
+}
+
+std::expected<WakeReceiver, ChannelError> WakeReceiver::adopt(NativeHandle handle)
+{
+    struct stat status {};
+    if (::fstat(handle, &status) == -1 || !S_ISSOCK(status.st_mode))
+        return std::unexpected(ChannelError::Io);
+    return configureReceiver(handle).and_then(makeStopPipe).transform([&](std::array<int, 2> stop) {
+        return WakeReceiver { handle, stop[0], stop[1] };
+    });
+}
+
+WakeReceiver::WakeReceiver(WakeReceiver&& other) noexcept:
+    _handle { std::exchange(other._handle, -1) },
+    _stopRead { std::exchange(other._stopRead, -1) },
+    _stopWrite { std::exchange(other._stopWrite, -1) }
+{
+}
+
+WakeReceiver& WakeReceiver::operator=(WakeReceiver&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _handle = std::exchange(other._handle, -1);
+        _stopRead = std::exchange(other._stopRead, -1);
+        _stopWrite = std::exchange(other._stopWrite, -1);
+    }
+    return *this;
+}
+
+WakeReceiver::~WakeReceiver()
+{
+    release();
+}
+
+void WakeReceiver::release() noexcept
+{
+    closeDescriptor(_handle);
+    closeDescriptor(_stopRead);
+    closeDescriptor(_stopWrite);
+    _handle = -1;
+    _stopRead = -1;
+    _stopWrite = -1;
+}
+
+WakeWait WakeReceiver::wait() noexcept
+{
+    while (true)
+    {
+        auto descriptors = std::array { pollfd { .fd = _stopRead, .events = POLLIN, .revents = 0 },
+                                        pollfd { .fd = _handle, .events = POLLIN, .revents = 0 } };
+        if (::poll(descriptors.data(), descriptors.size(), -1) == -1)
+        {
+            if (errno == EINTR)
+                continue;
+            // Nothing can be waited on any more: as good as a gone sender.
+            return WakeWait::PeerGone;
+        }
+        // The stop pipe is never drained: once stopped, every wait returns at once.
+        if (descriptors[0].revents != 0)
+            return WakeWait::Stopped;
+        if (descriptors[1].revents == 0)
+            continue;
+        switch (drain(_handle))
+        {
+            case Drained::Wakes: return WakeWait::Woken;
+            case Drained::EndOfStream: return WakeWait::PeerGone;
+            case Drained::Nothing: break;
+        }
+    }
+}
+
+void WakeReceiver::stop() const noexcept
+{
+    auto const stop = uint8_t { 1 };
+    // A full pipe is a stopped receiver already.
+    while (::write(_stopWrite, &stop, sizeof(stop)) == -1 && errno == EINTR)
+    {
+    }
+}
+
+NativeHandle WakeReceiver::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+std::expected<WakePair, ChannelError> makeWakePair()
+{
+    auto ends = std::array<int, 2> { -1, -1 };
+#ifdef SOCK_CLOEXEC
+    constexpr auto SocketType = SOCK_STREAM | SOCK_CLOEXEC;
+#else
+    constexpr auto SocketType = SOCK_STREAM;
+#endif
+    if (::socketpair(AF_UNIX, SocketType, 0, ends.data()) == -1)
+        return std::unexpected(ChannelError::Io);
+    // Owned from here on, so that every failure below closes both.
+    auto sender = WakeSender { ends[0] };
+    auto const stop = makeStopPipe();
+    if (!stop)
+    {
+        closeDescriptor(ends[1]);
+        return std::unexpected(stop.error());
+    }
+    auto receiver = WakeReceiver { ends[1], (*stop)[0], (*stop)[1] };
+    return configureSender(sender.nativeHandle())
+        .and_then([&] { return configureReceiver(receiver.nativeHandle()); })
+        .transform([&] { return WakePair { .parent = std::move(sender), .helper = std::move(receiver) }; });
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/WakeSignal_test.cpp b/src/vtextension/wasm/remote/transport/WakeSignal_test.cpp
new file mode 100644
index 000000000..b53f40a78
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/WakeSignal_test.cpp
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The wake signal Contour sends its extension host process when it raised an interrupt flag: it wakes a
+// waiting receiver, never blocks the sender, ends a wait on stop() or when the sender is gone, and never ends
+// the sender's process when the receiver is gone.
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+#include <cstddef>
+#include <future>
+#include <ranges>
+#include <thread>
+#include <tuple>
+#include <utility>
+
+#include <vtextension/wasm/remote/transport/WakeSignal.hpp>
+
+#ifndef _WIN32
+    #include <csignal>
+#endif
+
+using vtextension::wasm::remote::transport::makeWakePair;
+using vtextension::wasm::remote::transport::WakeResult;
+using vtextension::wasm::remote::transport::WakeWait;
+
+TEST_CASE("WakeSignal.signalWakesTheReceiver", "[vtextension]")
+{
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    auto result = std::promise<WakeWait> {};
+    auto woken = result.get_future();
+    auto waiter = std::jthread { [&] { result.set_value(pair->helper.wait()); } };
+    std::this_thread::sleep_for(std::chrono::milliseconds { 20 });
+    CHECK(pair->parent.signal() == WakeResult::Sent);
+    CHECK(woken.get() == WakeWait::Woken);
+}
+
+TEST_CASE("WakeSignal.signalNeverBlocks", "[vtextension]")
+{
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+
+    constexpr auto Signals = 100'000;
+    struct Counts
+    {
+        WakeResult first = WakeResult::Pending;
+        std::size_t pending = 0;
+    };
+    // Nobody waits: a sender that blocked on a full buffer would never return.
+    auto signalled = std::async(std::launch::async, [&] {
+        auto counts = Counts { .first = pair->parent.signal() };
+        for ([[maybe_unused]] auto const i: std::views::iota(1, Signals))
+            if (pair->parent.signal() == WakeResult::Pending)
+                ++counts.pending;
+        return counts;
+    });
+    REQUIRE(signalled.wait_for(std::chrono::seconds { 5 }) == std::future_status::ready);
+    auto const counts = signalled.get();
+    CHECK(counts.first == WakeResult::Sent);
+    CHECK(counts.pending > 0);
+
+    // One wait takes every queued wake; the next one finds none and waits until stopped.
+    CHECK(pair->helper.wait() == WakeWait::Woken);
+    auto next = std::async(std::launch::async, [&] { return pair->helper.wait(); });
+    CHECK(next.wait_for(std::chrono::milliseconds { 50 }) == std::future_status::timeout);
+    pair->helper.stop();
+    CHECK(next.get() == WakeWait::Stopped);
+}
+
+TEST_CASE("WakeSignal.stopEndsAWait", "[vtextension]")
+{
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    auto result = std::promise<WakeWait> {};
+    auto stopped = result.get_future();
+    auto waiter = std::jthread { [&] { result.set_value(pair->helper.wait()); } };
+    std::this_thread::sleep_for(std::chrono::milliseconds { 20 });
+    pair->helper.stop();
+    CHECK(stopped.get() == WakeWait::Stopped);
+    // Stopped for good, even with a wake queued.
+    CHECK(pair->parent.signal() == WakeResult::Sent);
+    CHECK(pair->helper.wait() == WakeWait::Stopped);
+}
+
+#ifndef _WIN32
+TEST_CASE("WakeSignal.senderGoneIsPeerGone", "[vtextension]")
+{
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    {
+        auto const sender = std::move(pair->parent);
+    }
+    CHECK(pair->helper.wait() == WakeWait::PeerGone);
+}
+
+TEST_CASE("WakeSignal.signalToAGoneReceiverKeepsSigpipeAway", "[vtextension]")
+{
+    struct sigaction before {};
+    struct sigaction byDefault {};
+    byDefault.sa_handler = SIG_DFL;
+    REQUIRE(::sigaction(SIGPIPE, &byDefault, &before) == 0);
+
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    {
+        auto const receiver = std::move(pair->helper);
+    }
+    // At SIG_DFL, a SIGPIPE would end this process here.
+    std::ignore = pair->parent.signal();
+    std::ignore = pair->parent.signal();
+    SUCCEED("the process lives");
+
+    REQUIRE(::sigaction(SIGPIPE, &before, nullptr) == 0);
+}
+#endif
diff --git a/src/vtextension/wasm/remote/transport/WakeSignal_win32.cpp b/src/vtextension/wasm/remote/transport/WakeSignal_win32.cpp
new file mode 100644
index 000000000..e896322ef
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/WakeSignal_win32.cpp
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The wake signal on Windows: a manual-reset event, which SetEvent() sets without ever blocking. Manual, not
+// auto-reset, so that the sender can tell a wake already queued (the event is set) from one it queues: the
+// receiver resets it once its wait returned, and before its caller scans the page, so that a flag raised
+// before a signal() that found the event set is still seen by that scan. The receiver waits on it beside a
+// stop event of its own. A gone sender cannot be told on Windows; the job ends a helper whose parent is gone.
+#include <array>
+#include <cstdint>
+#include <expected>
+#include <utility>
+
+#include <vtextension/wasm/remote/transport/WakeSignal.hpp>
+
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+    /// Closes @p handle if it is open.
+    void closeHandle(HANDLE handle) noexcept
+    {
+        if (handle != nullptr)
+            ::CloseHandle(handle);
+    }
+
+    /// @return A new, unset, uninheritable manual-reset event; null if the system refused.
+    [[nodiscard]] HANDLE makeEvent() noexcept
+    {
+        return ::CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    }
+} // namespace
+
+WakeSender::WakeSender(NativeHandle handle) noexcept: _handle { handle }
+{
+}
+
+WakeSender::WakeSender(WakeSender&& other) noexcept: _handle { std::exchange(other._handle, nullptr) }
+{
+}
+
+WakeSender& WakeSender::operator=(WakeSender&& other) noexcept
+{
+    if (this != &other)
+    {
+        closeHandle(_handle);
+        _handle = std::exchange(other._handle, nullptr);
+    }
+    return *this;
+}
+
+WakeSender::~WakeSender()
+{
+    closeHandle(_handle);
+}
+
+WakeResult WakeSender::signal() const noexcept
+{
+    if (::WaitForSingleObject(_handle, 0) == WAIT_OBJECT_0)
+        return WakeResult::Pending;
+    ::SetEvent(_handle);
+    return WakeResult::Sent;
+}
+
+NativeHandle WakeSender::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+WakeReceiver::WakeReceiver(NativeHandle handle, void* stopEvent) noexcept:
+    _handle { handle }, _stopEvent { stopEvent }
+{
+}
+
+std::expected<WakeReceiver, ChannelError> WakeReceiver::adopt(NativeHandle handle)
+{
+    // Waiting with a zero timeout tells an event (or any waitable object) from a handle that is not open.
+    if (handle == nullptr || ::WaitForSingleObject(handle, 0) == WAIT_FAILED)
+        return std::unexpected(ChannelError::Io);
+    if (!::SetHandleInformation(handle, HANDLE_FLAG_INHERIT, 0))
+        return std::unexpected(ChannelError::Io);
+    auto* const stop = makeEvent();
+    if (stop == nullptr)
+        return std::unexpected(ChannelError::Io);
+    return WakeReceiver { handle, stop };
+}
+
+WakeReceiver::WakeReceiver(WakeReceiver&& other) noexcept:
+    _handle { std::exchange(other._handle, nullptr) }, _stopEvent { std::exchange(other._stopEvent, nullptr) }
+{
+}
+
+WakeReceiver& WakeReceiver::operator=(WakeReceiver&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _handle = std::exchange(other._handle, nullptr);
+        _stopEvent = std::exchange(other._stopEvent, nullptr);
+    }
+    return *this;
+}
+
+WakeReceiver::~WakeReceiver()
+{
+    release();
+}
+
+void WakeReceiver::release() noexcept
+{
+    closeHandle(_handle);
+    closeHandle(_stopEvent);
+    _handle = nullptr;
+    _stopEvent = nullptr;
+}
+
+WakeWait WakeReceiver::wait() noexcept
+{
+    // The stop event first: WaitForMultipleObjects reports the lowest index signalled, so a stop wins.
+    auto const handles = std::array<HANDLE, 2> { _stopEvent, _handle };
+    switch (::WaitForMultipleObjects(static_cast<DWORD>(handles.size()), handles.data(), FALSE, INFINITE))
+    {
+        case WAIT_OBJECT_0: return WakeWait::Stopped;
+        case WAIT_OBJECT_0 + 1: ::ResetEvent(_handle); return WakeWait::Woken;
+        default: return WakeWait::PeerGone;
+    }
+}
+
+void WakeReceiver::stop() const noexcept
+{
+    ::SetEvent(_stopEvent);
+}
+
+NativeHandle WakeReceiver::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+std::expected<WakePair, ChannelError> makeWakePair()
+{
+    auto* const wake = makeEvent();
+    if (wake == nullptr)
+        return std::unexpected(ChannelError::Io);
+    auto* receiverEnd = HANDLE { nullptr };
+    if (!::DuplicateHandle(::GetCurrentProcess(),
+                           wake,
+                           ::GetCurrentProcess(),
+                           &receiverEnd,
+                           0,
+                           FALSE,
+                           DUPLICATE_SAME_ACCESS))
+    {
+        ::CloseHandle(wake);
+        return std::unexpected(ChannelError::Io);
+    }
+    auto sender = WakeSender { wake };
+    auto* const stop = makeEvent();
+    if (stop == nullptr)
+    {
+        ::CloseHandle(receiverEnd);
+        return std::unexpected(ChannelError::Io);
+    }
+    return WakePair { .parent = std::move(sender), .helper = WakeReceiver { receiverEnd, stop } };
+}
+
+} // namespace vtextension::wasm::remote::transport
