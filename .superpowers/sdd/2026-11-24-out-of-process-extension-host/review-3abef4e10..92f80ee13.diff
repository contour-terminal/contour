+TEST_CASE("RecordingLauncher.recordsAndRewritesLaterLaunches", "[vtextension]")
+{
+    auto const inner = std::make_shared<process::testing::FakeProcessLauncher>();
+    auto const recording =
+        std::make_shared<process::testing::RecordingLauncher>(inner, [](std::vector<std::string> arguments) {
+            arguments.emplace_back("--later");
+            return arguments;
+        });
+    auto const spec = LaunchSpec { .executable = "helper",
+                                   .inherited = {},
+                                   .arguments = [](auto) { return std::vector<std::string> { "--x" }; },
+                                   .environment = {},
+                                   .caps = {} };
+    auto first = recording->launch(spec);
+    auto second = recording->launch(spec);
+    REQUIRE(first.has_value());
+    REQUIRE(second.has_value());
+
+    CHECK(recording->launches() == 2);
+    CHECK(recording->processIds() == std::vector { (*first)->id(), (*second)->id() });
+    auto const noHandles = std::span<NativeHandle const> {};
+    CHECK(inner->launches()[0].arguments(noHandles) == std::vector<std::string> { "--x" });
+    CHECK(inner->launches()[1].arguments(noHandles) == std::vector<std::string> { "--x", "--later" });
+
+    auto killerId = std::thread::id {};
+    auto killer = std::jthread { [&] {
+        killerId = std::this_thread::get_id();
+        (*second)->kill();
+    } };
+    killer.join();
+    CHECK(recording->killThreads() == std::vector { killerId });
+    CHECK(inner->kills() == std::vector<std::size_t> { 1 });
+}
diff --git a/src/vtextension/wasm/remote/process/Process_freebsd.cpp b/src/vtextension/wasm/remote/process/Process_freebsd.cpp
new file mode 100644
index 000000000..bb3e618ca
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/Process_freebsd.cpp
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The launcher on FreeBSD. pdfork() with PD_CLOEXEC: the child is a process descriptor from the first
+// instruction, which kill() signals (pdkill), the wait set polls (it hangs up when the process exits), and
+// whose close ends the process -- nothing ever addresses it by a pid that could be reused. Everything the
+// child needs is prepared before the fork, so that the child of this multi-threaded process calls only
+// async-signal-safe functions: dup2(), closefrom(), chdir(), sigaction(), sigprocmask() and execve(), and
+// _exit(127) on any failure.
+#include <sys/procdesc.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#include <cerrno>
+#include <csignal>
+#include <expected>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <unistd.h>
+
+#include <vtextension/wasm/remote/process/PosixLaunch.hpp>
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+namespace vtextension::wasm::remote::process
+{
+
+namespace
+{
+    using posix::UniqueFd;
+
+    /// The exit code of a child that could not become the program it was to run.
+    constexpr auto ExecFailed = 127;
+
+    class FreeBsdProcessHandle final: public IProcessHandle
+    {
+      public:
+        FreeBsdProcessHandle(pid_t pid, UniqueFd descriptor) noexcept:
+            _pid { pid }, _descriptor { std::move(descriptor) }
+        {
+        }
+
+        [[nodiscard]] ProcessId id() const noexcept override { return _pid; }
+
+        void kill() noexcept override
+        {
+            if (!_status)
+                ::pdkill(_descriptor.get(), SIGKILL);
+        }
+
+        [[nodiscard]] std::optional<ExitStatus> tryReap() noexcept override
+        {
+            if (_status)
+                return _status;
+            auto status = 0;
+            // The descriptor holds the pid until it is closed: reaping by pid cannot reach another process.
+            while (true)
+            {
+                auto const reaped = ::waitpid(_pid, &status, WNOHANG);
+                if (reaped == 0)
+                    return std::nullopt;
+                if (reaped == _pid)
+                    break;
+                if (errno == EINTR)
+                    continue;
+                _status = ExitStatus { .kind = ExitKind::Exited, .value = -1 };
+                return _status;
+            }
+            _status = posix::exitStatusOfWait(status);
+            return _status;
+        }
+
+        [[nodiscard]] Waitable waitable() const noexcept override { return _descriptor.get(); }
+
+      private:
+        pid_t _pid;
+        UniqueFd _descriptor;
+        std::optional<ExitStatus> _status; ///< Set once reaped.
+    };
+
+    /// Becomes @p prepared's program, in the child of pdfork(). Async-signal-safe throughout; never returns.
+    [[noreturn]] void becomeChild(posix::PreparedLaunch& prepared,
+                                  char* const* argv,
+                                  char* const* envp) noexcept
+    {
+        struct sigaction byDefault {};
+        byDefault.sa_handler = SIG_DFL;
+        for (auto const signal: std::views::iota(1, NSIG))
+            if (signal != SIGKILL && signal != SIGSTOP)
+                ::sigaction(signal, &byDefault, nullptr);
+        auto empty = sigset_t {};
+        sigemptyset(&empty);
+        ::sigprocmask(SIG_SETMASK, &empty, nullptr);
+
+        if (::dup2(prepared.nullDevice.get(), STDIN_FILENO) == -1
+            || ::dup2(prepared.nullDevice.get(), STDOUT_FILENO) == -1)
+            ::_exit(ExecFailed);
+        auto child = posix::FirstChildDescriptor;
+        for (auto const& parked: prepared.parked)
+            if (::dup2(parked.get(), child++) == -1)
+                ::_exit(ExecFailed);
+        ::closefrom(prepared.childEnd());
+        if (::chdir("/") == -1)
+            ::_exit(ExecFailed);
+        ::execve(prepared.executable.c_str(), argv, envp);
+        ::_exit(ExecFailed);
+    }
+
+    class FreeBsdProcessLauncher final: public IProcessLauncher
+    {
+      public:
+        [[nodiscard]] std::expected<std::unique_ptr<IProcessHandle>, LaunchError> launch(
+            LaunchSpec const& spec) override
+        {
+            auto prepared = posix::prepareLaunch(spec);
+            if (!prepared)
+                return std::unexpected(prepared.error());
+            auto argv = prepared->argv();
+            auto envp = prepared->envp();
+
+            auto descriptor = -1;
+            auto const pid = ::pdfork(&descriptor, PD_CLOEXEC);
+            if (pid == -1)
+                return std::unexpected(posix::launchErrorOf(errno));
+            if (pid == 0)
+                becomeChild(*prepared, argv.data(), envp.data());
+            return std::make_unique<FreeBsdProcessHandle>(pid, UniqueFd { descriptor });
+        }
+
+        [[nodiscard]] std::expected<std::unique_ptr<IExitWaitSet>, LaunchError> makeWaitSet(
+            core::IClock& clock) override
+        {
+            return posix::makePollExitWaitSet(clock);
+        }
+    };
+} // namespace
+
+std::shared_ptr<IProcessLauncher> makeSystemProcessLauncher()
+{
+    return std::make_shared<FreeBsdProcessLauncher>();
+}
+
+std::vector<std::pair<std::string, std::string>> defaultHelperEnvironment()
+{
+    return {};
+}
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/Process_linux.cpp b/src/vtextension/wasm/remote/process/Process_linux.cpp
new file mode 100644
index 000000000..ec85bd56b
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/Process_linux.cpp
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The launcher on Linux. posix_spawn(), whose glibc implementation clones with CLONE_VM | CLONE_VFORK rather
+// than forking: no copy of a large, sanitized, multi-threaded parent, and no window in which a forked child
+// may only call async-signal-safe functions. The child's descriptors are set by file actions -- the null
+// device on 0 and 1, the parked inherited descriptors dup2()ed onto 3, 4, …, everything from the first beyond
+// them closed -- and it starts in "/" with default signal dispositions and an empty mask.
+//
+// Right after the spawn the child is pinned by a pidfd: kill() signals the pidfd, tryReap() waits on it, and
+// the wait set polls it, so that no number is ever used after the process behind it could have been reaped
+// and the number reused. A kernel without pidfds (before 5.3) is refused.
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#include <cerrno>
+#include <csignal>
+#include <expected>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <unistd.h>
+
+#include <vtextension/wasm/remote/process/PosixLaunch.hpp>
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+namespace vtextension::wasm::remote::process
+{
+
+namespace
+{
+    using posix::UniqueFd;
+
+    /// waitid()'s id type for a pidfd: an enumerator of glibc's, not a macro, and not in older headers.
+    constexpr auto PidfdIdType = static_cast<idtype_t>(3);
+
+    /// @return A pidfd for @p pid, close-on-exec; or the errno pidfd_open() failed with.
+    [[nodiscard]] std::expected<UniqueFd, int> openPidfd(pid_t pid) noexcept
+    {
+        auto const pidfd = static_cast<int>(::syscall(SYS_pidfd_open, pid, 0));
+        if (pidfd == -1)
+            return std::unexpected(errno);
+        return UniqueFd { pidfd };
+    }
+
+    class LinuxProcessHandle final: public IProcessHandle
+    {
+      public:
+        LinuxProcessHandle(pid_t pid, UniqueFd pidfd) noexcept: _pid { pid }, _pidfd { std::move(pidfd) } {}
+
+        [[nodiscard]] ProcessId id() const noexcept override { return _pid; }
+
+        void kill() noexcept override
+        {
+            if (!_status)
+                ::syscall(SYS_pidfd_send_signal, _pidfd.get(), SIGKILL, nullptr, 0);
+        }
+
+        [[nodiscard]] std::optional<ExitStatus> tryReap() noexcept override
+        {
+            if (_status)
+                return _status;
+            auto info = siginfo_t {};
+            while (::waitid(PidfdIdType, static_cast<id_t>(_pidfd.get()), &info, WEXITED | WNOHANG) == -1)
+            {
+                if (errno == EINTR)
+                    continue;
+                // ECHILD: reaped by someone else (a SIGCHLD handler), and its status lost with it. It is gone
+                // either way; the code says the status is not known.
+                _status = ExitStatus { .kind = ExitKind::Exited, .value = -1 };
+                return _status;
+            }
+            if (info.si_pid == 0)
+                return std::nullopt;
+            _status = info.si_code == CLD_EXITED
+                          ? ExitStatus { .kind = ExitKind::Exited, .value = info.si_status }
+                          : ExitStatus { .kind = ExitKind::Signalled, .value = info.si_status };
+            return _status;
+        }
+
+        [[nodiscard]] Waitable waitable() const noexcept override { return _pidfd.get(); }
+
+      private:
+        pid_t _pid;
+        UniqueFd _pidfd;
+        std::optional<ExitStatus> _status; ///< Set once reaped.
+    };
+
+    class LinuxProcessLauncher final: public IProcessLauncher
+    {
+      public:
+        [[nodiscard]] std::expected<std::unique_ptr<IProcessHandle>, LaunchError> launch(
+            LaunchSpec const& spec) override
+        {
+            auto prepared = posix::prepareLaunch(spec);
+            if (!prepared)
+                return std::unexpected(prepared.error());
+
+            auto actions = posix::FileActions {};
+            actions.check(
+                ::posix_spawn_file_actions_adddup2(actions.get(), prepared->nullDevice.get(), STDIN_FILENO));
+            actions.check(
+                ::posix_spawn_file_actions_adddup2(actions.get(), prepared->nullDevice.get(), STDOUT_FILENO));
+            auto child = posix::FirstChildDescriptor;
+            for (auto const& parked: prepared->parked)
+                actions.check(::posix_spawn_file_actions_adddup2(actions.get(), parked.get(), child++));
+            actions.check(::posix_spawn_file_actions_addclosefrom_np(actions.get(), prepared->childEnd()));
+            actions.check(::posix_spawn_file_actions_addchdir_np(actions.get(), "/"));
+
+            auto attributes = posix::SpawnAttributes {};
+            auto defaults = sigset_t {};
+            auto mask = sigset_t {};
+            ::sigfillset(&defaults);
+            ::sigemptyset(&mask);
+            attributes.check(::posix_spawnattr_setsigdefault(attributes.get(), &defaults));
+            attributes.check(::posix_spawnattr_setsigmask(attributes.get(), &mask));
+            attributes.check(
+                ::posix_spawnattr_setflags(attributes.get(), POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK));
+            if (actions.error() != 0)
+                return std::unexpected(posix::launchErrorOf(actions.error()));
+            if (attributes.error() != 0)
+                return std::unexpected(posix::launchErrorOf(attributes.error()));
+
+            auto argv = prepared->argv();
+            auto envp = prepared->envp();
+            auto pid = pid_t { -1 };
+            if (auto const error = ::posix_spawn(&pid,
+                                                 prepared->executable.c_str(),
+                                                 actions.get(),
+                                                 attributes.get(),
+                                                 argv.data(),
+                                                 envp.data());
+                error != 0)
+                return std::unexpected(posix::launchErrorOf(error));
+
+            auto pidfd = openPidfd(pid);
+            if (!pidfd)
+            {
+                // Not to be watched safely: it must not run unwatched either. Not yet reaped, the pid is
+                // still its own.
+                ::kill(pid, SIGKILL);
+                while (::waitpid(pid, nullptr, 0) == -1 && errno == EINTR)
+                {
+                }
+                return std::unexpected(posix::launchErrorOf(pidfd.error()));
+            }
+            return std::make_unique<LinuxProcessHandle>(pid, *std::move(pidfd));
+        }
+
+        [[nodiscard]] std::expected<std::unique_ptr<IExitWaitSet>, LaunchError> makeWaitSet(
+            core::IClock& clock) override
+        {
+            return posix::makePollExitWaitSet(clock);
+        }
+    };
+} // namespace
+
+std::shared_ptr<IProcessLauncher> makeSystemProcessLauncher()
+{
+    return std::make_shared<LinuxProcessLauncher>();
+}
+
+std::vector<std::pair<std::string, std::string>> defaultHelperEnvironment()
+{
+    return {};
+}
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/Process_macos.cpp b/src/vtextension/wasm/remote/process/Process_macos.cpp
new file mode 100644
index 000000000..82db09ee8
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/Process_macos.cpp
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The launcher on macOS. posix_spawn() with POSIX_SPAWN_CLOEXEC_DEFAULT, Apple's extension that closes every
+// descriptor no file action names: the null device on 0 and 1, stderr inherited, the parked inherited
+// descriptors dup2()ed onto 3, 4, …; the child starts in "/" with default signal dispositions and an empty
+// mask.
+//
+// The parent's own ends are close-on-exec, but between their creation and that flag (macOS has no
+// SOCK_CLOEXEC) a concurrent fork() and exec() elsewhere in the process could inherit one; the spawn itself
+// cannot, as CLOEXEC_DEFAULT closes all it did not name.
+//
+// macOS has no process descriptors: a process is its pid, watched through kqueue's EVFILT_PROC. kill() is
+// guarded by the handle's reaped status, as a pid once reaped may name another process.
+#include <sys/event.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <chrono>
+#include <csignal>
+#include <ctime>
+#include <expected>
+#include <map>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <spawn.h>
+#include <unistd.h>
+
+#include <vtextension/wasm/remote/process/PosixLaunch.hpp>
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+namespace vtextension::wasm::remote::process
+{
+
+namespace
+{
+    using posix::UniqueFd;
+
+    /// kqueue's event record, named apart from the function of the same name.
+    using KernelEvent = struct kevent;
+
+    /// The EVFILT_USER event a wake triggers.
+    constexpr auto WakeIdent = uintptr_t { 0 };
+
+    class MacProcessHandle final: public IProcessHandle
+    {
+      public:
+        explicit MacProcessHandle(pid_t pid) noexcept: _pid { pid } {}
+
+        [[nodiscard]] ProcessId id() const noexcept override { return _pid; }
+
+        void kill() noexcept override
+        {
+            if (!_status)
+                ::kill(_pid, SIGKILL);
+        }
+
+        [[nodiscard]] std::optional<ExitStatus> tryReap() noexcept override
+        {
+            if (_status)
+                return _status;
+            auto status = 0;
+            while (true)
+            {
+                auto const reaped = ::waitpid(_pid, &status, WNOHANG);
+                if (reaped == 0)
+                    return std::nullopt;
+                if (reaped == _pid)
+                    break;
+                if (errno == EINTR)
+                    continue;
+                // ECHILD: reaped by someone else, and its status lost with it.
+                _status = ExitStatus { .kind = ExitKind::Exited, .value = -1 };
+                return _status;
+            }
+            _status = posix::exitStatusOfWait(status);
+            return _status;
+        }
+
+        [[nodiscard]] Waitable waitable() const noexcept override { return _pid; }
+
+      private:
+        pid_t _pid;
+        std::optional<ExitStatus> _status; ///< Set once reaped.
+    };
+
+    /// Waits on a kqueue: EVFILT_PROC NOTE_EXIT per process, EVFILT_USER for wake().
+    class KqueueExitWaitSet final: public IExitWaitSet
+    {
+      public:
+        KqueueExitWaitSet(core::IClock& clock, UniqueFd queue) noexcept:
+            _clock { &clock }, _queue { std::move(queue) }
+        {
+        }
+
+        [[nodiscard]] std::expected<void, LaunchError> watch(uint64_t key,
+                                                             IProcessHandle const& process) override
+        {
+            auto const pid = process.waitable();
+            auto change = KernelEvent {};
+            EV_SET(&change,
+                   static_cast<uintptr_t>(pid),
+                   EVFILT_PROC,
+                   EV_ADD | EV_ONESHOT,
+                   NOTE_EXIT,
+                   0,
+                   reinterpret_cast<void*>(static_cast<uintptr_t>(key)));
+            if (::kevent(_queue.get(), &change, 1, nullptr, 0, nullptr) == -1)
+            {
+                // ESRCH: it exited before it could be watched; it is reported at the next wait.
+                if (errno != ESRCH)
+                    return std::unexpected(posix::launchErrorOf(errno));
+                _exited.push_back(key);
+            }
+            _watched.insert_or_assign(key, pid);
+            return {};
+        }
+
+        void unwatch(uint64_t key) noexcept override
+        {
+            auto const found = _watched.find(key);
+            if (found == _watched.end())
+                return;
+            auto change = KernelEvent {};
+            EV_SET(&change, static_cast<uintptr_t>(found->second), EVFILT_PROC, EV_DELETE, 0, 0, nullptr);
+            // Fails harmlessly once the one-shot event fired.
+            ::kevent(_queue.get(), &change, 1, nullptr, 0, nullptr);
+            _watched.erase(found);
+            std::erase(_exited, key);
+        }
+
+        [[nodiscard]] std::vector<uint64_t> wait(std::optional<core::SteadyTimePoint> deadline) override
+        {
+            // An exit seen once is reported as long as it is watched, as a polled descriptor would be.
+            auto ended = _exited;
+            auto timeout = timespec {};
+            auto const hasTimeout = !ended.empty() || deadline.has_value();
+            if (ended.empty() && deadline)
+            {
+                auto const remaining = std::max(core::SteadyDuration::zero(), *deadline - _clock->now());
+                auto const seconds = std::chrono::floor<std::chrono::seconds>(remaining);
+                timeout.tv_sec = static_cast<time_t>(seconds.count());
+                timeout.tv_nsec = static_cast<long>(
+                    std::chrono::ceil<std::chrono::nanoseconds>(remaining - seconds).count());
+            }
+            auto events = std::array<KernelEvent, 16> {};
+            auto received = 0;
+            while (true)
+            {
+                received = ::kevent(_queue.get(),
+                                    nullptr,
+                                    0,
+                                    events.data(),
+                                    static_cast<int>(events.size()),
+                                    hasTimeout ? &timeout : nullptr);
+                if (received != -1 || errno != EINTR)
+                    break;
+            }
+            for (auto const& event:
+                 std::span { events }.first(static_cast<std::size_t>(std::max(received, 0))))
+            {
+                if (event.filter != EVFILT_PROC)
+                    continue;
+                auto const key = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(event.udata));
+                if (_watched.contains(key) && std::ranges::find(_exited, key) == _exited.end())
+                {
+                    _exited.push_back(key);
+                    ended.push_back(key);
+                }
+            }
+            return ended;
+        }
+
+        void wake() noexcept override
+        {
+            auto change = KernelEvent {};
+            EV_SET(&change, WakeIdent, EVFILT_USER, 0, NOTE_TRIGGER, 0, nullptr);
+            ::kevent(_queue.get(), &change, 1, nullptr, 0, nullptr);
+        }
+
+      private:
+        core::IClock* _clock;
+        UniqueFd _queue;
+        std::map<uint64_t, pid_t> _watched;
+        std::vector<uint64_t> _exited; ///< Keys whose exit was seen: reported until unwatched.
+    };
+
+    class MacProcessLauncher final: public IProcessLauncher
+    {
+      public:
+        [[nodiscard]] std::expected<std::unique_ptr<IProcessHandle>, LaunchError> launch(
+            LaunchSpec const& spec) override
+        {
+            auto prepared = posix::prepareLaunch(spec);
+            if (!prepared)
+                return std::unexpected(prepared.error());
+
+            auto actions = posix::FileActions {};
+            actions.check(
+                ::posix_spawn_file_actions_adddup2(actions.get(), prepared->nullDevice.get(), STDIN_FILENO));
+            actions.check(
+                ::posix_spawn_file_actions_adddup2(actions.get(), prepared->nullDevice.get(), STDOUT_FILENO));
+            actions.check(::posix_spawn_file_actions_addinherit_np(actions.get(), STDERR_FILENO));
+            auto child = posix::FirstChildDescriptor;
+            for (auto const& parked: prepared->parked)
+                actions.check(::posix_spawn_file_actions_adddup2(actions.get(), parked.get(), child++));
+            actions.check(::posix_spawn_file_actions_addchdir_np(actions.get(), "/"));
+
+            auto attributes = posix::SpawnAttributes {};
+            auto defaults = sigset_t {};
+            auto mask = sigset_t {};
+            sigfillset(&defaults);
+            sigemptyset(&mask);
+            attributes.check(::posix_spawnattr_setsigdefault(attributes.get(), &defaults));
+            attributes.check(::posix_spawnattr_setsigmask(attributes.get(), &mask));
+            attributes.check(
+                ::posix_spawnattr_setflags(attributes.get(),
+                                           static_cast<short>(POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK
+                                                              | POSIX_SPAWN_CLOEXEC_DEFAULT)));
+            if (actions.error() != 0)
+                return std::unexpected(posix::launchErrorOf(actions.error()));
+            if (attributes.error() != 0)
+                return std::unexpected(posix::launchErrorOf(attributes.error()));
+
+            auto argv = prepared->argv();
+            auto envp = prepared->envp();
+            auto pid = pid_t { -1 };
+            if (auto const error = ::posix_spawn(&pid,
+                                                 prepared->executable.c_str(),
+                                                 actions.get(),
+                                                 attributes.get(),
+                                                 argv.data(),
+                                                 envp.data());
+                error != 0)
+                return std::unexpected(posix::launchErrorOf(error));
+            return std::make_unique<MacProcessHandle>(pid);
+        }
+
+        [[nodiscard]] std::expected<std::unique_ptr<IExitWaitSet>, LaunchError> makeWaitSet(
+            core::IClock& clock) override
+        {
+            // kqueue descriptors are not inherited by children: no close-on-exec needed.
+            auto queue = UniqueFd { ::kqueue() };
+            if (queue.get() == -1)
+                return std::unexpected(posix::launchErrorOf(errno));
+            struct kevent change {};
+            EV_SET(&change, WakeIdent, EVFILT_USER, EV_ADD | EV_CLEAR, 0, 0, nullptr);
+            if (::kevent(queue.get(), &change, 1, nullptr, 0, nullptr) == -1)
+                return std::unexpected(posix::launchErrorOf(errno));
+            return std::make_unique<KqueueExitWaitSet>(clock, std::move(queue));
+        }
+    };
+} // namespace
+
+std::shared_ptr<IProcessLauncher> makeSystemProcessLauncher()
+{
+    return std::make_shared<MacProcessLauncher>();
+}
