diff --git a/src/vtextension/wasm/remote/transport/ControlPage.hpp b/src/vtextension/wasm/remote/transport/ControlPage.hpp
new file mode 100644
index 000000000..b9a981093
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/ControlPage.hpp
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The interrupt page: one page of shared memory Contour and its extension host process both map, a flag per
+/// interrupt slot. Contour raises an instance's slot to interrupt its running call; the helper, woken by the
+/// wake signal (WakeSignal.hpp), scans the page for raised slots.
+///
+/// Contour only ever stores to the page, never reads it back, so a helper that scribbles over it can mislead
+/// only itself.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+/// The interrupt page's size: one page on every platform this runs on.
+inline constexpr std::size_t ControlPageBytes = 4096;
+
+/// How many interrupt slots the page holds: a 32-bit flag each.
+inline constexpr uint32_t InterruptSlotCount = ControlPageBytes / sizeof(std::atomic<uint32_t>);
+
+/// Why a shared memory object could not be made or mapped.
+enum class SharedObjectError : uint8_t
+{
+    Unsupported, ///< The system has no shared memory object of the kind needed.
+    Io,          ///< The system refused.
+    WrongSize,   ///< The object adopted is not the size expected.
+};
+
+/// One page both processes map: a flag per interrupt slot. Move-only; unmapped and closed when destroyed. A
+/// moved-from page may only be assigned to or destroyed.
+class ControlPage
+{
+  public:
+    /// Creates the page, all slots clear: Contour's side. Not inherited by a child unless handed over.
+    /// @return The page; `Unsupported` or `Io` if the system refused.
+    [[nodiscard]] static std::expected<ControlPage, SharedObjectError> create();
+
+    /// Maps a page this process inherited: the helper's side. Takes ownership of @p handle, made
+    /// close-on-exec (not inheritable) again.
+    /// @param handle The page's handle.
+    /// @return The page; `WrongSize` if the object is not ControlPageBytes large, `Io` if it cannot be
+    /// mapped.
+    ///         On failure @p handle stays the caller's.
+    [[nodiscard]] static std::expected<ControlPage, SharedObjectError> adopt(NativeHandle handle);
+
+    ControlPage(ControlPage&& other) noexcept;
+    ControlPage& operator=(ControlPage&& other) noexcept;
+    ControlPage(ControlPage const&) = delete;
+    ControlPage& operator=(ControlPage const&) = delete;
+    ~ControlPage();
+
+    /// Raises @p slot. Wait-free.
+    /// @param slot The slot; below InterruptSlotCount, or else nothing happens.
+    void raise(uint32_t slot) noexcept;
+
+    /// Clears @p slot. Wait-free.
+    /// @param slot The slot; below InterruptSlotCount, or else nothing happens.
+    void clear(uint32_t slot) noexcept;
+
+    /// @param slot The slot.
+    /// @return Whether @p slot is raised; never for one at or beyond InterruptSlotCount.
+    [[nodiscard]] bool isRaised(uint32_t slot) const noexcept;
+
+    /// @return The page's handle, still owned by the page: for handing it to a child process.
+    [[nodiscard]] NativeHandle nativeHandle() const noexcept;
+
+  private:
+    ControlPage(NativeHandle handle, uint32_t* flags) noexcept;
+
+    /// @return @p slot's flag.
+    [[nodiscard]] std::atomic_ref<uint32_t> flag(uint32_t slot) const noexcept;
+
+    /// Unmaps and closes what this page holds, if anything.
+    void release() noexcept;
+
+    NativeHandle _handle;
+    uint32_t* _flags; ///< The mapping, InterruptSlotCount flags; null once moved from.
+};
+
+inline std::atomic_ref<uint32_t> ControlPage::flag(uint32_t slot) const noexcept
+{
+    return std::atomic_ref<uint32_t> { _flags[slot] };
+}
+
+inline void ControlPage::raise(uint32_t slot) noexcept
+{
+    // Release: what the raiser wrote before it raised is seen by whoever sees the flag raised.
+    if (slot < InterruptSlotCount)
+        flag(slot).store(1, std::memory_order_release);
+}
+
+inline void ControlPage::clear(uint32_t slot) noexcept
+{
+    if (slot < InterruptSlotCount)
+        flag(slot).store(0, std::memory_order_release);
+}
+
+inline bool ControlPage::isRaised(uint32_t slot) const noexcept
+{
+    return slot < InterruptSlotCount && flag(slot).load(std::memory_order_acquire) != 0;
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/ControlPage_posix.cpp b/src/vtextension/wasm/remote/transport/ControlPage_posix.cpp
new file mode 100644
index 000000000..348c834bc
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/ControlPage_posix.cpp
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The interrupt page on POSIX. Linux and FreeBSD: an anonymous memfd, sealed against shrinking and growing,
+// so that neither process can make the other's mapping fault past the object's end. macOS has no memfd: a
+// POSIX shared memory object under a name unique to this process, created exclusively and unlinked at once,
+// so that it is reachable only through the descriptor.
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <atomic>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <utility>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <vtextension/wasm/remote/transport/ControlPage.hpp>
+
+#ifdef __APPLE__
+    #include <format>
+    #include <string>
+#endif
+
+namespace vtextension::wasm::remote::transport
+{
+
+static_assert(std::atomic_ref<uint32_t>::is_always_lock_free,
+              "the page is shared between processes: only a lock-free flag is address-free");
+
+namespace
+{
+    /// @return Why a call that set @p error failed.
+    [[nodiscard]] SharedObjectError sharedObjectErrorOf(int error) noexcept
+    {
+        return error == ENOSYS || error == EINVAL ? SharedObjectError::Unsupported : SharedObjectError::Io;
+    }
+
+    /// @return A new shared memory object of ControlPageBytes, close-on-exec; or why it could not be made.
+    [[nodiscard]] std::expected<int, SharedObjectError> createObject() noexcept
+    {
+#ifdef __APPLE__
+        static auto serial = std::atomic<uint64_t> { 0 };
+        auto const name = std::format("/contour-eh-{}-{}", ::getpid(), serial.fetch_add(1));
+        auto const descriptor = ::shm_open(name.c_str(), O_RDWR | O_CREAT | O_EXCL, 0600);
+        if (descriptor == -1)
+            return std::unexpected(sharedObjectErrorOf(errno));
+        ::shm_unlink(name.c_str());
+        if (::fcntl(descriptor, F_SETFD, FD_CLOEXEC) == -1
+            || ::ftruncate(descriptor, static_cast<off_t>(ControlPageBytes)) == -1)
+        {
+            auto const error = errno;
+            ::close(descriptor);
+            return std::unexpected(sharedObjectErrorOf(error));
+        }
+        return descriptor;
+#else
+        auto const descriptor =
+            ::memfd_create("contour-extension-host-control", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+        if (descriptor == -1)
+            return std::unexpected(sharedObjectErrorOf(errno));
+        if (::ftruncate(descriptor, static_cast<off_t>(ControlPageBytes)) == -1
+            || ::fcntl(descriptor, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL) == -1)
+        {
+            auto const error = errno;
+            ::close(descriptor);
+            return std::unexpected(sharedObjectErrorOf(error));
+        }
+        return descriptor;
+#endif
+    }
+
+    /// @return @p descriptor's page mapped shared, readable and writable; or why it could not be.
+    [[nodiscard]] std::expected<uint32_t*, SharedObjectError> mapPage(int descriptor) noexcept
+    {
+        auto* const mapping =
+            ::mmap(nullptr, ControlPageBytes, PROT_READ | PROT_WRITE, MAP_SHARED, descriptor, 0);
+        if (mapping == MAP_FAILED)
+            return std::unexpected(SharedObjectError::Io);
+        return static_cast<uint32_t*>(mapping);
+    }
+} // namespace
+
+ControlPage::ControlPage(NativeHandle handle, uint32_t* flags) noexcept: _handle { handle }, _flags { flags }
+{
+}
+
+std::expected<ControlPage, SharedObjectError> ControlPage::create()
+{
+    auto const descriptor = createObject();
+    if (!descriptor)
+        return std::unexpected(descriptor.error());
+    auto const flags = mapPage(*descriptor);
+    if (!flags)
+    {
+        ::close(*descriptor);
+        return std::unexpected(flags.error());
+    }
+    return ControlPage { *descriptor, *flags };
+}
+
+std::expected<ControlPage, SharedObjectError> ControlPage::adopt(NativeHandle handle)
+{
+    struct stat status {};
+    if (::fstat(handle, &status) == -1)
+        return std::unexpected(SharedObjectError::Io);
+    if (std::cmp_not_equal(status.st_size, ControlPageBytes))
+        return std::unexpected(SharedObjectError::WrongSize);
+    if (::fcntl(handle, F_SETFD, FD_CLOEXEC) == -1)
+        return std::unexpected(SharedObjectError::Io);
+    return mapPage(handle).transform([&](uint32_t* flags) { return ControlPage { handle, flags }; });
+}
+
+ControlPage::ControlPage(ControlPage&& other) noexcept:
+    _handle { std::exchange(other._handle, -1) }, _flags { std::exchange(other._flags, nullptr) }
+{
+}
+
+ControlPage& ControlPage::operator=(ControlPage&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _handle = std::exchange(other._handle, -1);
+        _flags = std::exchange(other._flags, nullptr);
+    }
+    return *this;
+}
+
+ControlPage::~ControlPage()
+{
+    release();
+}
+
+void ControlPage::release() noexcept
+{
+    if (_flags != nullptr)
+        ::munmap(_flags, ControlPageBytes);
+    if (_handle != -1)
+        ::close(_handle);
+    _flags = nullptr;
+    _handle = -1;
+}
+
+NativeHandle ControlPage::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+} // namespace vtextension::wasm::remote::transport
