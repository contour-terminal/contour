+++ b/src/vtextension/wasm/remote/process/testing/FakeProcessLauncher.hpp
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// A launcher that starts nothing: it records what it was asked to start and hands back processes a test ends
+/// by hand. Its wait sets ignore real time -- they return only once a process ended or they were woken -- so
+/// that a supervisor driven by a ManualClock is deterministic.
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <optional>
+#include <thread>
+#include <vector>
+
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+namespace vtextension::wasm::remote::process::testing
+{
+
+/// The status a fake process's kill() ends it with: as SIGKILL (9) ends a POSIX process.
+inline constexpr auto FakeKilledStatus = ExitStatus { .kind = ExitKind::Signalled, .value = 9 };
+
+/// The id the first fake process gets; each later one the next.
+inline constexpr ProcessId FirstFakeProcessId = 1000;
+
+/// Records launches and hands back processes that end when the test says. Thread-safe: every record is
+/// guarded by one mutex.
+class FakeProcessLauncher final: public IProcessLauncher
+{
+  public:
+    /// What the launcher and every process and set of it share.
+    struct State;
+
+    FakeProcessLauncher();
+    FakeProcessLauncher(FakeProcessLauncher const&) = delete;
+    FakeProcessLauncher(FakeProcessLauncher&&) = delete;
+    FakeProcessLauncher& operator=(FakeProcessLauncher const&) = delete;
+    FakeProcessLauncher& operator=(FakeProcessLauncher&&) = delete;
+    ~FakeProcessLauncher() override;
+
+    /// Records @p spec and the calling thread.
+    /// @return A process with the next id, running until exit() or its kill().
+    [[nodiscard]] std::expected<std::unique_ptr<IProcessHandle>, LaunchError> launch(
+        LaunchSpec const& spec) override;
+
+    /// @return A set that returns only when a watched process ended, or it was woken; it records each
+    ///         wait's deadline, and otherwise ignores it.
+    [[nodiscard]] std::expected<std::unique_ptr<IExitWaitSet>, LaunchError> makeWaitSet(
+        core::IClock& clock) override;
+
+    /// Ends the @p index-th process launched with @p status, and wakes every set that watches it.
+    /// @param index The process, counted from 0 in launch order.
+    /// @param status How it ended.
+    void exit(std::size_t index, ExitStatus status);
+
+    /// @return The index of the process each kill() was called on, in call order -- also those that did
+    ///         nothing, on a process that had ended already.
+    [[nodiscard]] std::vector<std::size_t> kills() const;
+
+    /// @return Every spec launched, in order.
+    [[nodiscard]] std::vector<LaunchSpec> launches() const;
+
+    /// @return The thread each launch ran on, in order.
+    [[nodiscard]] std::vector<std::thread::id> launchThreads() const;
+
+    /// @return The deadline the latest wait() of any set was given; nothing if it had none, or none waited.
+    [[nodiscard]] std::optional<core::SteadyTimePoint> lastDeadline() const;
+
+  private:
+    std::shared_ptr<State> _state;
+};
+
+} // namespace vtextension::wasm::remote::process::testing
diff --git a/src/vtextension/wasm/remote/process/testing/LaunchProbe.cpp b/src/vtextension/wasm/remote/process/testing/LaunchProbe.cpp
new file mode 100644
index 000000000..7966290a1
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/testing/LaunchProbe.cpp
@@ -0,0 +1,152 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// extension_host_probe: started by the launcher's tests in the place of the extension host process, it
+// reports what it was started with, on the control channel it was handed, and exits once that channel ends.
+//
+//   extension_host_probe --report <helper arguments> [--check-handle=H]…
+//
+// The report is one `key=value` line each: `cwd=` its working directory, `env=NAME` per environment variable,
+// and `fd=N` per open descriptor (POSIX) or `handle=H:valid|invalid` per --check-handle (Windows); then
+// `end`.
+#include <array>
+#include <bit>
+#include <charconv>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <format>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+#include <vtextension/wasm/remote/transport/HelperArguments.hpp>
+
+#ifdef _WIN32
+    #define WIN32_LEAN_AND_MEAN
+    #include <Windows.h>
+#else
+    #include <algorithm>
+    #include <ranges>
+
+    #include <fcntl.h>
+    #include <unistd.h>
+#endif
+
+using vtextension::wasm::remote::transport::Channel;
+using vtextension::wasm::remote::transport::parseHelperArguments;
+
+namespace
+{
+
+/// Exit codes, each a way the probe failed before it reported.
+enum class ProbeExit : uint8_t
+{
+    Reported = 0,     ///< It reported, and its control channel ended.
+    Usage = 2,        ///< Its command line is not what it takes.
+    NoControl = 3,    ///< Its control channel cannot be adopted.
+    ReportFailed = 4, ///< The report could not be sent.
+};
+
+/// The prefix of the option naming a handle whose validity is reported.
+constexpr auto CheckHandle = std::string_view { "--check-handle=" };
+
+/// @return The names of the variables of @p environment (POSIX: main's, null-terminated; Windows: this
+///         process's), one line each.
+[[nodiscard]] std::string environmentLines([[maybe_unused]] char const* const* environment)
+{
+    auto lines = std::string {};
+#ifdef _WIN32
+    auto* const block = ::GetEnvironmentStringsW();
+    for (auto const* entry = block; *entry != L'\0'; entry += std::wstring_view { entry }.size() + 1)
+    {
+        auto const text = std::wstring_view { entry };
+        // `=C:=C:\…`: the per-drive working directories, which are no variables.
+        if (text.starts_with(L'='))
+            continue;
+        auto const name = std::filesystem::path { text.substr(0, text.find(L'=')) }.string();
+        lines += std::format("env={}\n", name);
+    }
+    ::FreeEnvironmentStringsW(block);
+#else
+    for (auto const* const* entry = environment; *entry != nullptr; ++entry)
+    {
+        auto const text = std::string_view { *entry };
+        lines += std::format("env={}\n", text.substr(0, text.find('=')));
+    }
+#endif
+    return lines;
+}
+
+/// @return The open handles, one line each: every descriptor (POSIX), or the validity of each of @p checked
+///         (Windows).
+[[nodiscard]] std::string handleLines([[maybe_unused]] std::span<std::string_view const> checked)
+{
+    auto lines = std::string {};
+#ifdef _WIN32
+    for (auto const value: checked)
+    {
+        auto number = uintptr_t {};
+        std::from_chars(value.data(), value.data() + value.size(), number);
+        auto flags = DWORD { 0 };
+        auto const isValid = ::GetHandleInformation(std::bit_cast<HANDLE>(number), &flags) != FALSE;
+        lines += std::format("handle={}:{}\n", value, isValid ? "valid" : "invalid");
+    }
+#else
+    // Asked of each number rather than listed from /proc/self/fd or /dev/fd, whose listing holds a descriptor
+    // of its own. The launcher's children start with few, and low, numbers; well below this bound.
+    constexpr auto Highest = 4096L;
+    auto const openMax = ::sysconf(_SC_OPEN_MAX);
+    auto const limit = openMax > 0 ? std::min(openMax, Highest) : Highest;
+    for (auto const descriptor: std::views::iota(0, static_cast<int>(limit)))
+        if (::fcntl(descriptor, F_GETFD) != -1)
+            lines += std::format("fd={}\n", descriptor);
+#endif
+    return lines;
+}
+
+/// Reports what the probe was started with, then waits for its control channel to end.
+[[nodiscard]] ProbeExit report(std::span<std::string_view const> arguments, char const* const* environment)
+{
+    auto helperArguments = std::vector<std::string_view> {};
+    auto checked = std::vector<std::string_view> {};
+    for (auto const argument: arguments)
+        if (argument.starts_with(CheckHandle))
+            checked.push_back(argument.substr(CheckHandle.size()));
+        else
+            helperArguments.push_back(argument);
+    auto const parsed = parseHelperArguments(helperArguments);
+    if (!parsed)
+        return ProbeExit::Usage;
+    auto control = Channel::adopt(parsed->control);
+    if (!control)
+        return ProbeExit::NoControl;
+
+    auto const text = std::format("cwd={}\n{}{}end\n",
+                                  std::filesystem::current_path().string(),
+                                  environmentLines(environment),
+                                  handleLines(checked));
+    auto const bytes = std::span { reinterpret_cast<uint8_t const*>(text.data()), text.size() };
+    if (!control->send(bytes))
+        return ProbeExit::ReportFailed;
+
+    // Whatever arrives is ignored; the end of the stream ends the probe.
+    auto buffer = std::array<uint8_t, 64> {};
+    while (control->receiveSome(buffer))
+    {
+    }
+    return ProbeExit::Reported;
+}
+
+} // namespace
+
+// The third parameter is what POSIX systems pass and Windows' C runtime passes too: the environment, read
+// without a global.
+int main(int argc, char const* argv[], char const* envp[])
+{
+    auto const arguments = std::vector<std::string_view>(argv + 1, argv + argc);
+    if (arguments.empty() || arguments.front() != "--report")
+        return static_cast<int>(ProbeExit::Usage);
+    return static_cast<int>(report(std::span { arguments }.subspan(1), envp));
+}
diff --git a/src/vtextension/wasm/remote/process/testing/RecordingLauncher.hpp b/src/vtextension/wasm/remote/process/testing/RecordingLauncher.hpp
new file mode 100644
index 000000000..f9ccf198d
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/testing/RecordingLauncher.hpp
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// A launcher that decorates another: it records what was launched and from which threads its processes were
+/// killed, and can rewrite the command line of every launch after the first -- how a test makes a respawned
+/// helper behave unlike the first one.
+
+#include <cstddef>
+#include <expected>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <span>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+namespace vtextension::wasm::remote::process::testing
+{
+
+/// Rewrites a launch's command line.
+using ArgumentRewrite = std::function<std::vector<std::string>(std::vector<std::string>)>;
+
+/// Records the launches and kills of another launcher. Thread-safe: every record is guarded by one mutex.
+class RecordingLauncher final: public IProcessLauncher
+{
+  public:
+    /// @param inner What starts the processes.
+    /// @param laterArguments Applied to the command line of every launch after the first; none to leave
+    ///        them as they are.
+    explicit RecordingLauncher(std::shared_ptr<IProcessLauncher> inner, ArgumentRewrite laterArguments = {}):
+        _inner { std::move(inner) },
+        _records { std::make_shared<Records>() },
+        _laterArguments { std::move(laterArguments) }
+    {
+    }
+
+    [[nodiscard]] std::expected<std::unique_ptr<IProcessHandle>, LaunchError> launch(
+        LaunchSpec const& spec) override
+    {
+        auto const isLater = [&] {
+            auto const lock = std::scoped_lock { _records->mutex };
+            return _records->launches++ > 0;
+        }();
+        auto launched = [&] {
+            if (!isLater || !_laterArguments)
+                return _inner->launch(spec);
+            auto rewritten = spec;
+            rewritten.arguments = [original = spec.arguments, rewrite = _laterArguments](
+                                      std::span<transport::NativeHandle const> childHandles) {
+                return rewrite(original(childHandles));
+            };
+            return _inner->launch(rewritten);
+        }();
+        if (!launched)
+            return std::unexpected(launched.error());
+        auto const lock = std::scoped_lock { _records->mutex };
+        _records->processIds.push_back((*launched)->id());
+        return std::make_unique<RecordingHandle>(*std::move(launched), _records);
+    }
+
+    [[nodiscard]] std::expected<std::unique_ptr<IExitWaitSet>, LaunchError> makeWaitSet(
+        core::IClock& clock) override
+    {
+        return _inner->makeWaitSet(clock);
+    }
+
+    /// @return How many launches were asked for, failed ones included.
+    [[nodiscard]] std::size_t launches() const
+    {
+        auto const lock = std::scoped_lock { _records->mutex };
+        return _records->launches;
+    }
+
+    /// @return The id of every process started, in order.
+    [[nodiscard]] std::vector<ProcessId> processIds() const
+    {
+        auto const lock = std::scoped_lock { _records->mutex };
+        return _records->processIds;
+    }
+
+    /// @return The thread each kill() ran on, in call order.
+    [[nodiscard]] std::vector<std::thread::id> killThreads() const
+    {
+        auto const lock = std::scoped_lock { _records->mutex };
+        return _records->killThreads;
+    }
+
+  private:
+    /// What the launcher and its handles record, which a handle may outlive the launcher with.
+    struct Records
+    {
+        mutable std::mutex mutex;
+        std::size_t launches = 0;
+        std::vector<ProcessId> processIds;
+        std::vector<std::thread::id> killThreads;
+    };
+
+    /// Forwards to the inner launcher's handle, recording each kill.
+    class RecordingHandle final: public IProcessHandle
+    {
+      public:
+        RecordingHandle(std::unique_ptr<IProcessHandle> inner, std::shared_ptr<Records> records) noexcept:
+            _inner { std::move(inner) }, _records { std::move(records) }
+        {
+        }
+
+        [[nodiscard]] ProcessId id() const noexcept override { return _inner->id(); }
+
+        void kill() noexcept override
+        {
+            {
+                auto const lock = std::scoped_lock { _records->mutex };
+                _records->killThreads.push_back(std::this_thread::get_id());
+            }
+            _inner->kill();
+        }
+
+        [[nodiscard]] std::optional<ExitStatus> tryReap() noexcept override { return _inner->tryReap(); }
+
+        [[nodiscard]] Waitable waitable() const noexcept override { return _inner->waitable(); }
+
+      private:
+        std::unique_ptr<IProcessHandle> _inner;
+        std::shared_ptr<Records> _records;
+    };
+
+    std::shared_ptr<IProcessLauncher> _inner;
+    std::shared_ptr<Records> _records;
+    ArgumentRewrite _laterArguments;
+};
+
+} // namespace vtextension::wasm::remote::process::testing
diff --git a/src/vtextension/wasm/remote/transport/Channel.hpp b/src/vtextension/wasm/remote/transport/Channel.hpp
index 194f90aba..cdbb3f58d 100644
--- a/src/vtextension/wasm/remote/transport/Channel.hpp
+++ b/src/vtextension/wasm/remote/transport/Channel.hpp
@@ -35,20 +35,29 @@ using NativeHandle = int;
 /// moved-from channel may only be shut down, assigned to or destroyed.
 class Channel
 {
   public:
     /// The platform's state of one end; defined by Channel_posix.cpp or Channel_win32.cpp.
     struct Native;
 
     /// Takes ownership of an open end.
     /// @param native The end. Never null.
     explicit Channel(std::unique_ptr<Native> native) noexcept;
+
+    /// Takes ownership of an end this process inherited from its parent: a stream socket on POSIX, a pipe
+    /// opened for overlapped I/O on Windows. The end is made close-on-exec (not inheritable) again, and on
+    /// macOS SIGPIPE-free, as makeChannelPair()'s ends are.
+    /// @param handle The end.
+    /// @return The channel; `Io` if @p handle names no open socket (pipe), in which case it stays the
+    ///         caller's.
+    [[nodiscard]] static std::expected<Channel, ChannelError> adopt(NativeHandle handle);
+
     ~Channel();
     Channel(Channel&&) noexcept;
     Channel& operator=(Channel&&) noexcept;
     Channel(Channel const&) = delete;
     Channel& operator=(Channel const&) = delete;
 
