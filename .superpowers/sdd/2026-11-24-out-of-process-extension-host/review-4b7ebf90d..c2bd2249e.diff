--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/GuestMemoryMapping.cpp
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// What every system's guest memory mapping shares: placing the object and opening its pages are each system's
+// own (GuestMemoryMapping_posix.cpp, GuestMemoryMapping_win32.cpp); the layout rules and owning the mapping
+// are not.
+#include <vtextension/wasm/remote/transport/GuestMemoryMapping.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <limits>
+#include <utility>
+
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+bool isGuestMemoryLayout(uint64_t objectBytes, uint64_t initialBytes, uint64_t guardBytes) noexcept
+{
+    constexpr auto Page = proto::WasmPageBytes;
+    constexpr auto Addressable = uint64_t { std::numeric_limits<std::size_t>::max() };
+    return objectBytes != 0 && objectBytes % Page == 0 && initialBytes % Page == 0 && guardBytes % Page == 0
+           && initialBytes <= objectBytes && objectBytes <= Addressable
+           && guardBytes <= Addressable - objectBytes;
+}
+
+GuestMemoryMapping::GuestMemoryMapping(std::byte* base,
+                                       uint64_t objectBytes,
+                                       uint64_t accessibleBytes,
+                                       uint64_t guardBytes) noexcept:
+    _base { base },
+    _objectBytes { objectBytes },
+    _accessibleBytes { accessibleBytes },
+    _guardBytes { guardBytes }
+{
+}
+
+GuestMemoryMapping::GuestMemoryMapping(GuestMemoryMapping&& other) noexcept:
+    _base { std::exchange(other._base, nullptr) },
+    _objectBytes { std::exchange(other._objectBytes, 0) },
+    _accessibleBytes { std::exchange(other._accessibleBytes, 0) },
+    _guardBytes { std::exchange(other._guardBytes, 0) }
+{
+}
+
+GuestMemoryMapping& GuestMemoryMapping::operator=(GuestMemoryMapping&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _base = std::exchange(other._base, nullptr);
+        _objectBytes = std::exchange(other._objectBytes, 0);
+        _accessibleBytes = std::exchange(other._accessibleBytes, 0);
+        _guardBytes = std::exchange(other._guardBytes, 0);
+    }
+    return *this;
+}
+
+GuestMemoryMapping::~GuestMemoryMapping()
+{
+    release();
+}
+
+std::expected<void, MappingError> GuestMemoryMapping::open(uint64_t bytes) noexcept
+{
+    if (bytes > _objectBytes || bytes % proto::WasmPageBytes != 0)
+        return std::unexpected(MappingError::WrongSize);
+    if (bytes <= _accessibleBytes)
+        return {};
+    return openRange(_accessibleBytes, bytes).transform([&] { _accessibleBytes = bytes; });
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/GuestMemoryMapping.hpp b/src/vtextension/wasm/remote/transport/GuestMemoryMapping.hpp
new file mode 100644
index 000000000..535a74d03
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/GuestMemoryMapping.hpp
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host's mapping of an instance's memory object: the object Contour made and granted it,
+/// mapped writable at the base of a reservation that also holds the guard region the engine's compiled code
+/// relies on, with only the bytes the guest's memory spans open. Growing opens more of the object, never
+/// moves it, and never closes what was open.
+///
+/// Every size is a whole number of guest pages (64 KiB), which is also Windows' allocation granularity, so
+/// that a placeholder splits there.
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+/// Why an object could not be mapped, or more of it opened.
+enum class MappingError : uint8_t
+{
+    WrongSize,   ///< The object is not the size it was granted as, or a size asked for is not one it can be.
+    Io,          ///< The system refused: the handle names no object, or one that cannot be mapped writable.
+    Unsupported, ///< This system cannot place a shared object inside a reservation.
+};
+
+/// An instance's memory object, mapped into the extension host: [0, objectBytes()) is the object, followed by
+/// guardBytes() that are never accessible; of the object only [0, accessibleBytes()) is open. Move-only;
+/// unmapped, guard included, when destroyed. It does not own the object's handle: the mapping keeps the
+/// object alive on its own.
+class GuestMemoryMapping
+{
+  public:
+    /// Maps @p object at the base of a fresh reservation of @p objectBytes + @p guardBytes, and opens its
+    /// first @p initialBytes for reading and writing. The object must be mappable writable, and of
+    /// @p objectBytes: on POSIX its size is checked (fitsSharedObject()); on Windows a section too small for
+    /// the view fails to map.
+    /// @param object The object's handle; still the caller's.
+    /// @param objectBytes The size it was granted as: whole guest pages, more than 0.
+    /// @param initialBytes How many of its bytes are open at first: whole guest pages, at most @p
+    /// objectBytes.
+    /// @param guardBytes How many inaccessible bytes follow it: whole guest pages.
+    /// @return The mapping; `WrongSize` for sizes that do not fit those rules or an object of another size,
+    ///         `Io` if the system refused, `Unsupported` if this system has no way to place it.
+    [[nodiscard]] static std::expected<GuestMemoryMapping, MappingError> map(NativeHandle object,
+                                                                             uint64_t objectBytes,
+                                                                             uint64_t initialBytes,
+                                                                             uint64_t guardBytes);
+
+    GuestMemoryMapping(GuestMemoryMapping&& other) noexcept;
+    GuestMemoryMapping& operator=(GuestMemoryMapping&& other) noexcept;
+    GuestMemoryMapping(GuestMemoryMapping const&) = delete;
+    GuestMemoryMapping& operator=(GuestMemoryMapping const&) = delete;
+    ~GuestMemoryMapping();
+
+    /// @return Where the object is mapped: the guest's byte 0. Null once moved from.
+    [[nodiscard]] std::byte* base() const noexcept { return _base; }
+
+    /// @return How many bytes from base() are open: the guest memory's current size.
+    [[nodiscard]] uint64_t accessibleBytes() const noexcept { return _accessibleBytes; }
+
+    /// @return The object's size: the most the guest memory may span.
+    [[nodiscard]] uint64_t objectBytes() const noexcept { return _objectBytes; }
+
+    /// @return How many inaccessible bytes follow the object.
+    [[nodiscard]] uint64_t guardBytes() const noexcept { return _guardBytes; }
+
+    /// Opens the object's first @p bytes for reading and writing; on Windows by committing the pages through
+    /// this view. Never closes what is open: asking for fewer bytes than are open does nothing.
+    /// @param bytes How many bytes are to be open: whole guest pages, at most objectBytes().
+    /// @return Nothing once they are open; `WrongSize` for a size that does not fit, `Io` if the system
+    ///         refused.
+    [[nodiscard]] std::expected<void, MappingError> open(uint64_t bytes) noexcept;
+
+  private:
+    GuestMemoryMapping(std::byte* base,
+                       uint64_t objectBytes,
+                       uint64_t accessibleBytes,
+                       uint64_t guardBytes) noexcept;
+
+    /// Opens [@p from, @p to), whole guest pages within the object, as this system does.
+    [[nodiscard]] std::expected<void, MappingError> openRange(uint64_t from, uint64_t to) noexcept;
+
+    /// Unmaps the object and frees the reservation, if it holds them.
+    void release() noexcept;
+
+    std::byte* _base = nullptr;    ///< The object's first byte; null once moved from.
+    uint64_t _objectBytes = 0;     ///< The object's size.
+    uint64_t _accessibleBytes = 0; ///< How much of it is open.
+    uint64_t _guardBytes = 0;      ///< The inaccessible bytes after it.
+};
+
+/// Whether sizes are ones GuestMemoryMapping::map() takes: whole guest pages, an object of at least one, its
+/// initial bytes within it, and the whole reservation addressable.
+/// @param objectBytes The object's size.
+/// @param initialBytes How many of its bytes open at first.
+/// @param guardBytes How many inaccessible bytes follow it.
+/// @return Whether they are.
+[[nodiscard]] bool isGuestMemoryLayout(uint64_t objectBytes,
+                                       uint64_t initialBytes,
+                                       uint64_t guardBytes) noexcept;
+
+/// Whether this system can map guest memory as GuestMemoryMapping does: always on POSIX; on Windows only
+/// where the placeholder functions exist (Windows 10 1803 and later) and a 64 KiB probe maps, opens and
+/// writes. Asked once; the answer is kept.
+/// @return Whether it can.
+[[nodiscard]] bool canMapGuestMemory() noexcept;
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/GuestMemoryMapping_posix.cpp b/src/vtextension/wasm/remote/transport/GuestMemoryMapping_posix.cpp
new file mode 100644
index 000000000..f1450916f
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/GuestMemoryMapping_posix.cpp
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Guest memory on POSIX: an inaccessible reservation of the object and its guard (PROT_NONE, MAP_NORESERVE,
+// so that it charges nothing), the object mapped shared over its start (MAP_FIXED), writable to prove the
+// handle grants writing, and every byte past the open ones closed again. Opening more is one mprotect().
+#include <sys/mman.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+
+#include <vtextension/wasm/remote/transport/GuestMemoryMapping.hpp>
+#include <vtextension/wasm/remote/transport/SharedObject.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+    /// @return The error a failed size check of the object maps to.
+    [[nodiscard]] MappingError mappingErrorOf(SharedObjectError error) noexcept
+    {
+        return error == SharedObjectError::WrongSize ? MappingError::WrongSize : MappingError::Io;
+    }
+} // namespace
+
+std::expected<GuestMemoryMapping, MappingError> GuestMemoryMapping::map(NativeHandle object,
+                                                                        uint64_t objectBytes,
+                                                                        uint64_t initialBytes,
+                                                                        uint64_t guardBytes)
+{
+    if (!isGuestMemoryLayout(objectBytes, initialBytes, guardBytes))
+        return std::unexpected(MappingError::WrongSize);
+    if (auto const sized = checkSharedObjectSize(object, objectBytes); !sized)
+        return std::unexpected(mappingErrorOf(sized.error()));
+
+    auto const objectSize = static_cast<std::size_t>(objectBytes);
+    auto const reservationSize = static_cast<std::size_t>(objectBytes + guardBytes);
+    auto* const reservation =
+        ::mmap(nullptr, reservationSize, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (reservation == MAP_FAILED)
+        return std::unexpected(MappingError::Io);
+    // From here on the mapping owns the reservation, and unmaps it on every way out.
+    auto mapping = GuestMemoryMapping { static_cast<std::byte*>(reservation), objectBytes, 0, guardBytes };
+    if (::mmap(reservation, objectSize, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, object, 0)
+        == MAP_FAILED)
+        return std::unexpected(MappingError::Io);
+    // Writable it proved the handle grants writing; only the initial bytes stay so.
+    auto const closed = objectSize - static_cast<std::size_t>(initialBytes);
+    if (closed != 0 && ::mprotect(mapping._base + initialBytes, closed, PROT_NONE) != 0)
+        return std::unexpected(MappingError::Io);
+    mapping._accessibleBytes = initialBytes;
+    return mapping;
+}
+
+std::expected<void, MappingError> GuestMemoryMapping::openRange(uint64_t from, uint64_t to) noexcept
+{
+    if (::mprotect(_base + from, static_cast<std::size_t>(to - from), PROT_READ | PROT_WRITE) != 0)
+        return std::unexpected(MappingError::Io);
+    return {};
+}
+
+void GuestMemoryMapping::release() noexcept
+{
+    // One munmap() covers the object's mapping and the guard's reservation alike.
+    if (_base != nullptr)
+        ::munmap(_base, static_cast<std::size_t>(_objectBytes + _guardBytes));
+    _base = nullptr;
+}
+
+bool canMapGuestMemory() noexcept
+{
+    return true;
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/GuestMemoryMapping_test.cpp b/src/vtextension/wasm/remote/transport/GuestMemoryMapping_test.cpp
new file mode 100644
index 000000000..2726a6fef
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/GuestMemoryMapping_test.cpp
@@ -0,0 +1,207 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The extension host's mapping of guest memory: only the bytes the guest's memory spans are open, the object
+// and the guard after it are not, what is open is the parent's object, an object of another size is refused,
+// and opening never closes anything.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+
+#include <vtextension/wasm/remote/transport/GuestMemoryMapping.hpp>
+#include <vtextension/wasm/remote/transport/SharedObject.hpp>
+
+#ifdef _WIN32
+    #define WIN32_LEAN_AND_MEAN
+    #include <Windows.h>
+#elifdef __linux__
+    #include <fstream>
+    #include <string>
+#endif
+
+using vtextension::wasm::remote::transport::canMapGuestMemory;
+using vtextension::wasm::remote::transport::createSharedObject;
+using vtextension::wasm::remote::transport::GuestMemoryMapping;
+using vtextension::wasm::remote::transport::isGuestMemoryLayout;
+using vtextension::wasm::remote::transport::MapAccess;
+using vtextension::wasm::remote::transport::MappingError;
+using vtextension::wasm::remote::transport::SharedMapping;
+using vtextension::wasm::remote::transport::SharedObjectUse;
+
+namespace
+{
+
+/// A guest page.
+constexpr auto Page = uint64_t { 64 } * 1024;
+
+/// The object the cases map: four guest pages.
+constexpr auto ObjectBytes = 4 * Page;
+
+/// The guard the cases reserve after it.
+constexpr auto GuardBytes = 2 * Page;
+
+#ifdef _WIN32
+/// Whether this runs under wine.
+[[nodiscard]] bool runsUnderWine() noexcept
+{
+    auto* const ntdll = ::GetModuleHandleW(L"ntdll.dll");
+    return ntdll != nullptr && ::GetProcAddress(ntdll, "wine_get_version") != nullptr;
+}
+#endif
+
+/// Skips the case where this system cannot map guest memory: only wine may say so.
+void requireGuestMapping()
+{
+#ifdef _WIN32
+    if (!canMapGuestMemory() && runsUnderWine())
+        SKIP("wine places no section view over a placeholder");
+#endif
+    REQUIRE(canMapGuestMemory());
+}
+
+#ifdef __linux__
+/// @return The permissions /proc/self/maps shows for the mapping holding @p address ("rw-s", "---p", ...);
+///         empty if none holds it.
+[[nodiscard]] std::string permissionsAt(std::byte const* address)
+{
+    auto const where = reinterpret_cast<std::uintptr_t>(address);
+    auto maps = std::ifstream { "/proc/self/maps" };
+    auto line = std::string {};
+    while (std::getline(maps, line))
+    {
+        auto const dash = line.find('-');
+        auto const space = line.find(' ');
+        if (dash == std::string::npos || space == std::string::npos)
+            continue;
+        auto const from = std::stoull(line.substr(0, dash), nullptr, 16);
+        auto const to = std::stoull(line.substr(dash + 1, space - dash - 1), nullptr, 16);
+        if (from <= where && where < to)
+            return line.substr(space + 1, 4);
+    }
+    return {};
+}
+#endif
+
+} // namespace
+
+TEST_CASE("GuestMemoryMapping.layoutIsWholeGuestPages", "[vtextension]")
+{
+    CHECK(isGuestMemoryLayout(ObjectBytes, Page, GuardBytes));
+    CHECK(isGuestMemoryLayout(ObjectBytes, 0, 0));
+    CHECK(isGuestMemoryLayout(ObjectBytes, ObjectBytes, 0));
+    CHECK_FALSE(isGuestMemoryLayout(0, 0, 0));
+    CHECK_FALSE(isGuestMemoryLayout(ObjectBytes + 1, Page, 0));
+    CHECK_FALSE(isGuestMemoryLayout(ObjectBytes, Page + 1, 0));
+    CHECK_FALSE(isGuestMemoryLayout(ObjectBytes, Page, 1));
+    CHECK_FALSE(isGuestMemoryLayout(ObjectBytes, ObjectBytes + Page, 0));
+    CHECK_FALSE(isGuestMemoryLayout(ObjectBytes, Page, UINT64_MAX - (Page - 1)));
+}
+
+TEST_CASE("GuestMemoryMapping.opensOnlyTheInitialBytes", "[vtextension]")
+{
+    requireGuestMapping();
+    auto const object = createSharedObject(ObjectBytes, SharedObjectUse::GuestMemory);
+    REQUIRE(object.has_value());
+    auto const mapping = GuestMemoryMapping::map(object->get(), ObjectBytes, Page, GuardBytes);
+    REQUIRE(mapping.has_value());
+    CHECK(mapping->accessibleBytes() == Page);
+    CHECK(mapping->objectBytes() == ObjectBytes);
+    CHECK(mapping->guardBytes() == GuardBytes);
+    auto const* const base = mapping->base();
+
+#ifdef __linux__
+    // Open and shared; closed and shared; the guard, closed and the helper's own.
+    CHECK(permissionsAt(base) == "rw-s");
+    CHECK(permissionsAt(base + Page - 1) == "rw-s");
+    CHECK(permissionsAt(base + Page) == "---s");
+    CHECK(permissionsAt(base + ObjectBytes - 1) == "---s");
+    CHECK(permissionsAt(base + ObjectBytes) == "---p");
+    CHECK(permissionsAt(base + ObjectBytes + GuardBytes - 1) == "---p");
+#elifdef _WIN32
+    auto region = MEMORY_BASIC_INFORMATION {};
+    REQUIRE(::VirtualQuery(base, &region, sizeof(region)) != 0);
+    CHECK(region.State == MEM_COMMIT);
+    CHECK(region.Protect == PAGE_READWRITE);
+    CHECK(region.Type == MEM_MAPPED);
+    CHECK(region.RegionSize == Page);
+    REQUIRE(::VirtualQuery(base + Page, &region, sizeof(region)) != 0);
+    CHECK(region.State == MEM_RESERVE);
+    CHECK(region.Type == MEM_MAPPED);
+    REQUIRE(::VirtualQuery(base + ObjectBytes, &region, sizeof(region)) != 0);
+    CHECK(region.State == MEM_RESERVE);
+    CHECK(region.Type == MEM_PRIVATE);
+    CHECK(region.RegionSize == GuardBytes);
+#else
+    SKIP("this system's mappings are not inspected");
+#endif
+}
+
+TEST_CASE("GuestMemoryMapping.openedBytesAreTheParentsBytes", "[vtextension]")
+{
+    requireGuestMapping();
+    auto const object = createSharedObject(ObjectBytes, SharedObjectUse::GuestMemory);
+    REQUIRE(object.has_value());
+    auto parent = SharedMapping::map(object->get(), ObjectBytes, MapAccess::ReadWrite);
+    REQUIRE(parent.has_value());
+    // Contour commits what it grants through its own view, as the helper does through its.
+    REQUIRE(parent->commit(0, ObjectBytes).has_value());
+    auto helper = GuestMemoryMapping::map(object->get(), ObjectBytes, Page, GuardBytes);
+    REQUIRE(helper.has_value());
+
+    helper->base()[16] = std::byte { 42 };
+    CHECK(parent->bytes()[16] == std::byte { 42 });
+    parent->bytes()[Page - 1] = std::byte { 7 };
+    CHECK(helper->base()[Page - 1] == std::byte { 7 });
+
+    REQUIRE(helper->open(2 * Page).has_value());
+    CHECK(helper->accessibleBytes() == 2 * Page);
+    helper->base()[Page + 8] = std::byte { 9 };
+    CHECK(parent->bytes()[Page + 8] == std::byte { 9 });
+}
+
+TEST_CASE("GuestMemoryMapping.refusesAnObjectTooSmall", "[vtextension]")
+{
+    requireGuestMapping();
+    auto const object = createSharedObject(ObjectBytes / 2, SharedObjectUse::GuestMemory);
+    REQUIRE(object.has_value());
+    auto const mapping = GuestMemoryMapping::map(object->get(), ObjectBytes, Page, GuardBytes);
+    REQUIRE_FALSE(mapping.has_value());
+#ifndef _WIN32
+    // POSIX measures the object; Windows only fails to map a view larger than the section.
+    CHECK(mapping.error() == MappingError::WrongSize);
+#endif
+
+    // Sizes that are no layout are refused before the object is looked at.
+    CHECK(GuestMemoryMapping::map(object->get(), ObjectBytes / 2, Page + 1, 0).error()
+          == MappingError::WrongSize);
+}
+
+TEST_CASE("GuestMemoryMapping.neverShrinks", "[vtextension]")
+{
+    requireGuestMapping();
+    auto const object = createSharedObject(ObjectBytes, SharedObjectUse::GuestMemory);
+    REQUIRE(object.has_value());
+    auto mapping = GuestMemoryMapping::map(object->get(), ObjectBytes, Page, 0);
+    REQUIRE(mapping.has_value());
+
+    REQUIRE(mapping->open(3 * Page).has_value());
+    CHECK(mapping->accessibleBytes() == 3 * Page);
+    REQUIRE(mapping->open(Page).has_value());
+    CHECK(mapping->accessibleBytes() == 3 * Page);
+    mapping->base()[(3 * Page) - 1] = std::byte { 1 };
+    CHECK(mapping->base()[(3 * Page) - 1] == std::byte { 1 });
+
+    CHECK(mapping->open(ObjectBytes + Page).error() == MappingError::WrongSize);
+    CHECK(mapping->open((3 * Page) + 1).error() == MappingError::WrongSize);
+    CHECK(mapping->accessibleBytes() == 3 * Page);
+}
+
+#ifdef _WIN32
+TEST_CASE("GuestMemoryMapping.placeholdersWork", "[vtextension]")
+{
+    if (!canMapGuestMemory() && runsUnderWine())
+        SKIP("wine places no section view over a placeholder: the helper copies memory there");
+    CHECK(canMapGuestMemory());
+}
+#endif
diff --git a/src/vtextension/wasm/remote/transport/GuestMemoryMapping_win32.cpp b/src/vtextension/wasm/remote/transport/GuestMemoryMapping_win32.cpp
new file mode 100644
index 000000000..0768a47a4
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/GuestMemoryMapping_win32.cpp
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Guest memory on Windows, through placeholders: a placeholder reservation of the object and its guard
+// (VirtualAlloc2), split where the object ends, the section mapped over the object's placeholder
+// (MapViewOfFile3, MEM_REPLACE_PLACEHOLDER) with write access, and the open pages committed through this view
+// (VirtualAlloc, MEM_COMMIT): a reserved section's pages are committed by whoever touches them, so the helper
+// commits what it opens itself, whether Windows commits for the section or for each view.
+//
+// The placeholder functions are Windows 10 1803's; they are looked up in kernelbase at run time, so that an
+// older system says it cannot map guest memory (canMapGuestMemory()) rather than fail to load. A section too
+// small for the view fails to map: that is the size check, as the placeholder's view cannot be measured the
+// way SharedMapping measures a whole-section view.
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <optional>
+
+#include <vtextension/wasm/remote/transport/GuestMemoryMapping.hpp>
+#include <vtextension/wasm/remote/transport/OwnedHandle.hpp>
+#include <vtextension/wasm/remote/transport/SharedObject.hpp>
+
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+    using VirtualAlloc2Fn =
+        PVOID(WINAPI*)(HANDLE, PVOID, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+    using MapViewOfFile3Fn =
+        PVOID(WINAPI*)(HANDLE, HANDLE, PVOID, ULONG64, SIZE_T, ULONG, ULONG, MEM_EXTENDED_PARAMETER*, ULONG);
+
+    /// The placeholder functions, where the system has them.
+    struct PlaceholderFunctions
+    {
+        VirtualAlloc2Fn virtualAlloc2 = nullptr;   ///< Reserves a placeholder.
+        MapViewOfFile3Fn mapViewOfFile3 = nullptr; ///< Maps a view over a placeholder.
+    };
+
+    /// @return The placeholder functions; nothing on a system without them. Looked up once.
+    [[nodiscard]] std::optional<PlaceholderFunctions> const& placeholderFunctions() noexcept
+    {
+        static auto const functions = []() -> std::optional<PlaceholderFunctions> {
+            auto* const kernelbase = ::GetModuleHandleW(L"kernelbase.dll");
+            if (kernelbase == nullptr)
+                return std::nullopt;
+            auto const found = PlaceholderFunctions {
+                .virtualAlloc2 =
+                    reinterpret_cast<VirtualAlloc2Fn>(::GetProcAddress(kernelbase, "VirtualAlloc2")),
+                .mapViewOfFile3 =
+                    reinterpret_cast<MapViewOfFile3Fn>(::GetProcAddress(kernelbase, "MapViewOfFile3")),
+            };
+            if (found.virtualAlloc2 == nullptr || found.mapViewOfFile3 == nullptr)
+                return std::nullopt;
+            return found;
+        }();
+        return functions;
+    }
+
+    /// Commits [@p from, @p from + @p bytes) through the view it lies in.
+    /// @return Whether the system committed it.
+    [[nodiscard]] std::expected<void, MappingError> commitThroughView(std::byte* from,
+                                                                      uint64_t bytes) noexcept
+    {
+        if (bytes != 0
+            && ::VirtualAlloc(from, static_cast<SIZE_T>(bytes), MEM_COMMIT, PAGE_READWRITE) == nullptr)
+            return std::unexpected(MappingError::Io);
+        return {};
+    }
+} // namespace
+
+std::expected<GuestMemoryMapping, MappingError> GuestMemoryMapping::map(NativeHandle object,
+                                                                        uint64_t objectBytes,
+                                                                        uint64_t initialBytes,
+                                                                        uint64_t guardBytes)
+{
+    if (!isGuestMemoryLayout(objectBytes, initialBytes, guardBytes))
+        return std::unexpected(MappingError::WrongSize);
+    auto const& functions = placeholderFunctions();
+    if (!functions)
+        return std::unexpected(MappingError::Unsupported);
+
+    auto* const process = ::GetCurrentProcess();
+    auto* const reservation =
+        static_cast<std::byte*>(functions->virtualAlloc2(process,
+                                                         nullptr,
+                                                         static_cast<SIZE_T>(objectBytes + guardBytes),
+                                                         MEM_RESERVE | MEM_RESERVE_PLACEHOLDER,
+                                                         PAGE_NOACCESS,
+                                                         nullptr,
+                                                         0));
+    if (reservation == nullptr)
+        return std::unexpected(MappingError::Io);
+    // Two placeholders, the object's and the guard's, so that the view replaces exactly the first.
+    if (guardBytes != 0
+        && ::VirtualFree(
+               reservation, static_cast<SIZE_T>(objectBytes), MEM_RELEASE | MEM_PRESERVE_PLACEHOLDER)
+               == 0)
+    {
+        ::VirtualFree(reservation, 0, MEM_RELEASE);
+        return std::unexpected(MappingError::Io);
+    }
+    auto const freeReservation = [&] {
+        ::VirtualFree(reservation, 0, MEM_RELEASE);
+        if (guardBytes != 0)
+            ::VirtualFree(reservation + objectBytes, 0, MEM_RELEASE);
+    };
+    if (functions->mapViewOfFile3(object,
+                                  process,
+                                  reservation,
+                                  0,
+                                  static_cast<SIZE_T>(objectBytes),
+                                  MEM_REPLACE_PLACEHOLDER,
+                                  PAGE_READWRITE,
+                                  nullptr,
+                                  0)
+        == nullptr)
+    {
+        freeReservation();
+        return std::unexpected(MappingError::Io);
+    }
+    // From here on the mapping owns the view and the guard, and releases them on every way out.
+    auto mapping = GuestMemoryMapping { reservation, objectBytes, 0, guardBytes };
+    return commitThroughView(reservation, initialBytes).transform([&] {
+        mapping._accessibleBytes = initialBytes;
+        return std::move(mapping);
+    });
+}
+
+std::expected<void, MappingError> GuestMemoryMapping::openRange(uint64_t from, uint64_t to) noexcept
+{
+    return commitThroughView(_base + from, to - from);
+}
+
+void GuestMemoryMapping::release() noexcept
+{
+    if (_base == nullptr)
+        return;
+    // Unmapping a view that replaced a placeholder frees its range; the guard is a placeholder of its own.
+    ::UnmapViewOfFile(_base);
+    if (_guardBytes != 0)
+        ::VirtualFree(_base + _objectBytes, 0, MEM_RELEASE);
+    _base = nullptr;
+}
+
+bool canMapGuestMemory() noexcept
+{
+    static auto const canMap = [] {
+        constexpr auto ProbeBytes = uint64_t { 64 } * 1024;
+        auto const object = createSharedObject(ProbeBytes, SharedObjectUse::GuestMemory);
+        if (!object)
+            return false;
+        auto const mapping = GuestMemoryMapping::map(object->get(), ProbeBytes, ProbeBytes, ProbeBytes);
+        if (!mapping)
+            return false;
+        auto* const base = static_cast<std::byte volatile*>(mapping->base());
+        base[ProbeBytes - 1] = std::byte { 0x5A };
+        return base[ProbeBytes - 1] == std::byte { 0x5A };
+    }();
+    return canMap;
+}
