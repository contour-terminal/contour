diff --git a/src/vtextension/wasm/host/linux/Landlock.cpp b/src/vtextension/wasm/host/linux/Landlock.cpp
new file mode 100644
index 000000000..343d9db04
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/Landlock.cpp
@@ -0,0 +1,179 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/host/linux/Landlock.hpp>
+
+#include <sys/syscall.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <ranges>
+
+#include <unistd.h>
+
+#include <vtextension/wasm/host/linux/SystemCallRows.hpp>
+
+namespace vtextension::wasm::host
+{
+
+namespace
+{
+    // File system rights, by the ABI that added them (LANDLOCK_ACCESS_FS_*).
+    constexpr auto FirstFsRights = uint64_t { 0b1'1111'1111'1111 }; // EXECUTE … MAKE_SYM
+    constexpr auto Refer = uint64_t { 0b10'0000'0000'0000 };
+    constexpr auto IoctlDevice = uint64_t { 0b1000'0000'0000'0000 };
+    constexpr auto ResolveUnix = uint64_t { 0b1'0000'0000'0000'0000 };
+    // Network rights (LANDLOCK_ACCESS_NET_*).
+    constexpr auto BindTcp = uint64_t { 0b0001 };
+    constexpr auto ConnectTcp = uint64_t { 0b0010 };
+    constexpr auto BindUdp = uint64_t { 0b0100 };
+    constexpr auto ConnectSendUdp = uint64_t { 0b1000 };
+    // Scopes (LANDLOCK_SCOPE_*).
+    constexpr auto AbstractUnixSocket = uint64_t { 0b01 };
+    constexpr auto Signal = uint64_t { 0b10 };
+    // landlock_restrict_self() flags (LANDLOCK_RESTRICT_SELF_*).
+    constexpr auto ThreadSync = uint32_t { 0b1000 };
+    // landlock_create_ruleset()'s flag asking for the ABI version.
+    constexpr auto RulesetVersion = uint32_t { 0b0001 };
+    // landlock_add_rule()'s rule type of a directory and what lies beneath it.
+    constexpr auto RulePathBeneath = 1;
+
+    constexpr auto Abi2Fs = FirstFsRights | Refer;
+    constexpr auto Abi3Fs = Abi2Fs | LandlockTruncate;
+    constexpr auto Abi5Fs = Abi3Fs | IoctlDevice;
+    constexpr auto Abi9Fs = Abi5Fs | ResolveUnix;
+    constexpr auto TcpRights = BindTcp | ConnectTcp;
+    constexpr auto AllNetRights = TcpRights | BindUdp | ConnectSendUdp;
+    constexpr auto AllScopes = AbstractUnixSocket | Signal;
+
+    // Each ABI as the kernel's Documentation/userspace-api/landlock.rst lists what it added.
+    constexpr auto AbiTable = std::array {
+        LandlockAbiRow {
+            .abi = 1, .fsRights = FirstFsRights, .netRights = 0, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow { .abi = 2, .fsRights = Abi2Fs, .netRights = 0, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow { .abi = 3, .fsRights = Abi3Fs, .netRights = 0, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow {
+            .abi = 4, .fsRights = Abi3Fs, .netRights = TcpRights, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow {
+            .abi = 5, .fsRights = Abi5Fs, .netRights = TcpRights, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow {
+            .abi = 6, .fsRights = Abi5Fs, .netRights = TcpRights, .scopes = AllScopes, .restrictFlags = 0 },
+        LandlockAbiRow {
+            .abi = 7, .fsRights = Abi5Fs, .netRights = TcpRights, .scopes = AllScopes, .restrictFlags = 0 },
+        LandlockAbiRow { .abi = 8,
+                         .fsRights = Abi5Fs,
+                         .netRights = TcpRights,
+                         .scopes = AllScopes,
+                         .restrictFlags = ThreadSync },
+        LandlockAbiRow { .abi = 9,
+                         .fsRights = Abi9Fs,
+                         .netRights = TcpRights,
+                         .scopes = AllScopes,
+                         .restrictFlags = ThreadSync },
+        LandlockAbiRow { .abi = 10,
+                         .fsRights = Abi9Fs,
+                         .netRights = AllNetRights,
+                         .scopes = AllScopes,
+                         .restrictFlags = ThreadSync },
+    };
+
+    /// What landlock_add_rule() is given for a LANDLOCK_RULE_PATH_BENEATH rule, laid out as the kernel's.
+    struct [[gnu::packed]] PathBeneathAttr
+    {
+        uint64_t allowedAccess;
+        int32_t parentFd;
+    };
+
+    /// @return @p result, a raw system call's, as the result or `-errno`.
+    [[nodiscard]] long resultOrError(long result) noexcept
+    {
+        return result < 0 ? -errno : result;
+    }
+
+    /// @return The number of @p call here.
+    [[nodiscard]] long numberOf(SystemCall call) noexcept
+    {
+        return systemCallNumber(call, ThisAuditArch).value_or(NoSystemCall);
+    }
+
+    [[nodiscard]] bool isUnavailable(long error) noexcept
+    {
+        return error == -ENOSYS || error == -EOPNOTSUPP;
+    }
+
+    [[nodiscard]] ConfinementFailure fileSystemFailure(long error) noexcept
+    {
+        return ConfinementFailure { .step = remote::proto::LockdownStep::FileSystem,
+                                    .code = static_cast<int>(-error) };
+    }
+} // namespace
+
+std::span<LandlockAbiRow const> landlockAbis() noexcept
+{
+    return AbiTable;
+}
+
+LandlockSystem systemLandlock() noexcept
+{
+    return LandlockSystem {
+        .createRuleset =
+            [](LandlockRulesetAttr const* attr, std::size_t size, uint32_t flags) noexcept {
+                return resultOrError(
+                    ::syscall(numberOf(SystemCall::LandlockCreateRuleset), attr, size, flags));
+            },
+        .addPathBeneathRule =
+            [](int ruleset, PathBeneathRule rule) noexcept {
+                auto const attr =
+                    PathBeneathAttr { .allowedAccess = rule.allowedAccess, .parentFd = rule.parent };
+                return resultOrError(
+                    ::syscall(numberOf(SystemCall::LandlockAddRule), ruleset, RulePathBeneath, &attr, 0U));
+            },
+        .restrictSelf =
+            [](int ruleset, uint32_t flags) noexcept {
+                return resultOrError(::syscall(numberOf(SystemCall::LandlockRestrictSelf), ruleset, flags));
+            },
+        .closeRuleset = [](int ruleset) noexcept { ::close(ruleset); },
+    };
+}
+
+std::expected<LandlockOutcome, ConfinementFailure> restrictFileSystem(
+    std::span<PathBeneathRule const> allowed, LandlockSystem const& system)
+{
+    auto const version = system.createRuleset(nullptr, 0, RulesetVersion);
+    if (isUnavailable(version))
+        return LandlockOutcome::Unavailable;
+    if (version < 0)
+        return std::unexpected(fileSystemFailure(version));
+    // The best ABI both know: the kernel's, or our newest if the kernel's is newer still.
+    auto const newestFirst = AbiTable | std::views::reverse;
+    auto const known = std::ranges::find_if(
+        newestFirst, [version](LandlockAbiRow const& row) { return row.abi <= version; });
+    if (known == newestFirst.end())
+        return LandlockOutcome::Unavailable;
+    auto const& abi = *known;
+
+    auto const attr = LandlockRulesetAttr { .handledAccessFs = abi.fsRights,
+                                            .handledAccessNet = abi.netRights,
+                                            .scoped = abi.scopes };
+    auto const ruleset = system.createRuleset(&attr, sizeof(attr), 0);
+    if (isUnavailable(ruleset))
+        return LandlockOutcome::Unavailable;
+    if (ruleset < 0)
+        return std::unexpected(fileSystemFailure(ruleset));
+    auto const descriptor = static_cast<int>(ruleset);
+    auto const restricted = [&]() -> std::expected<LandlockOutcome, ConfinementFailure> {
+        for (auto const& rule: allowed)
+        {
+            auto const granted =
+                PathBeneathRule { .parent = rule.parent, .allowedAccess = rule.allowedAccess & abi.fsRights };
+            if (auto const added = system.addPathBeneathRule(descriptor, granted); added < 0)
+                return std::unexpected(fileSystemFailure(added));
+        }
+        if (auto const enforced = system.restrictSelf(descriptor, abi.restrictFlags); enforced < 0)
+            return std::unexpected(fileSystemFailure(enforced));
+        return LandlockOutcome::Restricted;
+    }();
+    system.closeRuleset(descriptor);
+    return restricted;
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/linux/Landlock.hpp b/src/vtextension/wasm/host/linux/Landlock.hpp
new file mode 100644
index 000000000..c599bb915
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/Landlock.hpp
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host's file system restriction on Linux: a Landlock ruleset that handles every right the
+/// kernel's ABI knows and grants none (but an instrumented build's own), enforced on every thread where the
+/// ABI can, and on every thread started later in any case.
+///
+/// The ABI's rights and flags are our own constants, ABI by ABI: the headers a build sees may be older than
+/// the kernel it runs on. A kernel without Landlock, or one whose Landlock is off, is no failure: the system
+/// call filter confines the host alone there.
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <span>
+
+#include <vtextension/wasm/host/Sandbox.hpp>
+
+namespace vtextension::wasm::host
+{
+
+/// What one Landlock ABI handles, cumulatively.
+struct LandlockAbiRow
+{
+    int abi;                ///< The ABI version, as landlock_create_ruleset() reports it.
+    uint64_t fsRights;      ///< Every file system right it knows (LANDLOCK_ACCESS_FS_*).
+    uint64_t netRights;     ///< Every network right it knows (LANDLOCK_ACCESS_NET_*).
+    uint64_t scopes;        ///< Every scope it knows (LANDLOCK_SCOPE_*).
+    uint32_t restrictFlags; ///< What landlock_restrict_self() is passed: TSYNC where it has it.
+};
+
+/// @return One row per ABI version from 1, in order.
+[[nodiscard]] std::span<LandlockAbiRow const> landlockAbis() noexcept;
+
+// Landlock's file system rights an instrumented build grants itself: our values of LANDLOCK_ACCESS_FS_*.
+inline constexpr auto LandlockReadFile = uint64_t { 0b0100 };           ///< LANDLOCK_ACCESS_FS_READ_FILE.
+inline constexpr auto LandlockWriteFile = uint64_t { 0b0010 };          ///< LANDLOCK_ACCESS_FS_WRITE_FILE.
+inline constexpr auto LandlockReadDirectory = uint64_t { 0b1000 };      ///< LANDLOCK_ACCESS_FS_READ_DIR.
+inline constexpr auto LandlockMakeRegular = uint64_t { 0b1'0000'0000 }; ///< LANDLOCK_ACCESS_FS_MAKE_REG.
+inline constexpr auto LandlockTruncate = uint64_t { 0b100'0000'0000'0000 }; ///< LANDLOCK_ACCESS_FS_TRUNCATE.
+
+/// What landlock_create_ruleset() is given: the fields every ABI up to the scopes knows.
+struct LandlockRulesetAttr
+{
+    uint64_t handledAccessFs;  ///< The file system rights handled: denied unless a rule grants them.
+    uint64_t handledAccessNet; ///< The network rights handled.
+    uint64_t scoped;           ///< The scopes restricted.
+};
+
+/// A directory beneath which some rights are granted.
+struct PathBeneathRule
+{
+    int parent;             ///< The directory, opened O_PATH; the caller's to close.
+    uint64_t allowedAccess; ///< What is granted beneath it; reduced to what the ABI handles.
+};
+
+/// The Landlock system calls, injectable. Each returns what the system call returns, or `-errno` on failure.
+struct LandlockSystem
+{
+    /// landlock_create_ruleset(); with a null attribute, size 0 and flag VERSION, the ABI version.
+    long (*createRuleset)(LandlockRulesetAttr const* attr, std::size_t size, uint32_t flags) noexcept;
+    /// landlock_add_rule() of a LANDLOCK_RULE_PATH_BENEATH rule.
+    long (*addPathBeneathRule)(int ruleset, PathBeneathRule rule) noexcept;
+    /// landlock_restrict_self().
+    long (*restrictSelf)(int ruleset, uint32_t flags) noexcept;
+    /// Closes a ruleset's descriptor.
+    void (*closeRuleset)(int ruleset) noexcept;
+};
+
+/// @return The kernel's Landlock system calls.
+[[nodiscard]] LandlockSystem systemLandlock() noexcept;
+
+/// Whether the file system was restricted.
+enum class LandlockOutcome : uint8_t
+{
+    Unavailable, ///< The kernel has no Landlock, or it is off: nothing was restricted, and nothing failed.
+    Restricted,  ///< Every right the best ABI knows is handled, and the threads it reaches restricted.
+};
+
+/// Restricts the calling thread -- every thread, where the ABI has TSYNC -- and the threads it starts later
+/// to the rights @p allowed grants, under the best ABI both the kernel and landlockAbis() know. The thread
+/// must have no_new_privs set.
+/// @param allowed What is granted, beneath which directories.
+/// @param system The system calls.
+/// @return `Restricted`, or `Unavailable` where the kernel has no Landlock (`ENOSYS`) or has it off
+///         (`EOPNOTSUPP`); `FileSystem` with the errno on any other failure.
+[[nodiscard]] std::expected<LandlockOutcome, ConfinementFailure> restrictFileSystem(
+    std::span<PathBeneathRule const> allowed, LandlockSystem const& system);
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/linux/Landlock_test.cpp b/src/vtextension/wasm/host/linux/Landlock_test.cpp
new file mode 100644
index 000000000..1e16e080d
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/Landlock_test.cpp
@@ -0,0 +1,185 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The file system restriction against a fake kernel: which ABI it uses, what it hands the kernel, and which
+// of the kernel's answers are failures.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cerrno>
+#include <cstdint>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/host/linux/Landlock.hpp>
+
+using namespace vtextension::wasm::host;
+using vtextension::wasm::remote::proto::LockdownStep;
+
+namespace
+{
+
+/// What the fake system calls answer: an ABI or a descriptor, or `-errno`.
+struct Answers
+{
+    long version = 0;    ///< The version query.
+    long created = 0;    ///< Creating the ruleset.
+    long restricted = 0; ///< Restricting.
+};
+
+/// The kernel the fake system calls answer as, and what they were asked. One case at a time.
+struct FakeKernel
+{
+    Answers answers;                         ///< What they answer.
+    std::optional<LandlockRulesetAttr> attr; ///< What the ruleset was created with.
+    std::vector<PathBeneathRule> rules;      ///< What was added.
+    std::optional<uint32_t> restrictFlags;   ///< What restricting was passed.
+    std::vector<int> closed;                 ///< What was closed.
+};
+
+/// @return The fake kernel the fake system calls answer as: they are plain functions, which capture nothing.
+[[nodiscard]] FakeKernel& kernel()
+{
+    static auto instance = FakeKernel {};
+    return instance;
+}
+
+constexpr auto Ruleset = 42;
+
+[[nodiscard]] LandlockSystem fakeSystem(Answers answers)
+{
+    kernel() = FakeKernel { .answers = answers, .attr = {}, .rules = {}, .restrictFlags = {}, .closed = {} };
+    return LandlockSystem {
+        .createRuleset =
+            [](LandlockRulesetAttr const* attr, std::size_t size, uint32_t flags) noexcept -> long {
+            if (attr == nullptr)
+                return size == 0 && flags == 1 ? kernel().answers.version : -EINVAL;
+            kernel().attr = *attr;
+            return kernel().answers.created;
+        },
+        .addPathBeneathRule = [](int ruleset, PathBeneathRule rule) noexcept -> long {
+            if (ruleset != Ruleset)
+                return -EBADF;
+            kernel().rules.push_back(rule);
+            return 0;
+        },
+        .restrictSelf = [](int ruleset, uint32_t flags) noexcept -> long {
+            if (ruleset != Ruleset)
+                return -EBADF;
+            kernel().restrictFlags = flags;
+            return kernel().answers.restricted;
+        },
+        .closeRuleset = [](int ruleset) noexcept { kernel().closed.push_back(ruleset); },
+    };
+}
+
+[[nodiscard]] LandlockAbiRow const& abiRow(int abi)
+{
+    return landlockAbis()[static_cast<std::size_t>(abi - 1)];
+}
+
+} // namespace
+
+TEST_CASE("Landlock.abiTableIsMonotonic", "[vtextension][sandbox]")
+{
+    auto const abis = landlockAbis();
+    REQUIRE_FALSE(abis.empty());
+    CHECK(abis.front().abi == 1);
+    for (auto const index: std::views::iota(std::size_t { 1 }, abis.size()))
+    {
+        auto const& before = abis[index - 1];
+        auto const& row = abis[index];
+        INFO("ABI " << row.abi);
+        CHECK(row.abi == before.abi + 1);
+        // Each ABI knows all its predecessor knew.
+        CHECK((row.fsRights & before.fsRights) == before.fsRights);
+        CHECK((row.netRights & before.netRights) == before.netRights);
+        CHECK((row.scopes & before.scopes) == before.scopes);
+        CHECK((row.restrictFlags & before.restrictFlags) == before.restrictFlags);
+    }
+    // Network rights from 4, scopes from 6, TSYNC from 8.
+    CHECK(abiRow(3).netRights == 0);
+    CHECK(abiRow(4).netRights != 0);
+    CHECK(abiRow(5).scopes == 0);
+    CHECK(abiRow(6).scopes != 0);
+    CHECK(abiRow(7).restrictFlags == 0);
+    CHECK(abiRow(8).restrictFlags != 0);
+}
+
+TEST_CASE("Landlock.usesTheBestAbiTheKernelHas", "[vtextension][sandbox]")
+{
+    auto const directory =
+        PathBeneathRule { .parent = 5, .allowedAccess = LandlockReadFile | LandlockTruncate };
+
+    SECTION("ABI 3: no network rights, no scopes, no TSYNC")
+    {
+        auto const restricted = restrictFileSystem(std::span { &directory, 1 },
+                                                   fakeSystem(Answers { .version = 3, .created = Ruleset }));
+        REQUIRE(restricted == LandlockOutcome::Restricted);
+        REQUIRE(kernel().attr.has_value());
+        CHECK(kernel().attr->handledAccessFs == abiRow(3).fsRights);
+        CHECK(kernel().attr->handledAccessNet == 0);
+        CHECK(kernel().attr->scoped == 0);
+        CHECK(kernel().restrictFlags == 0U);
+        REQUIRE(kernel().rules.size() == 1);
+        CHECK(kernel().rules.front().parent == 5);
+        CHECK(kernel().rules.front().allowedAccess == (LandlockReadFile | LandlockTruncate));
+    }
+    SECTION("ABI 2 grants no right it does not handle")
+    {
+        REQUIRE(restrictFileSystem(std::span { &directory, 1 },
+                                   fakeSystem(Answers { .version = 2, .created = Ruleset }))
+                == LandlockOutcome::Restricted);
+        REQUIRE(kernel().rules.size() == 1);
+        CHECK(kernel().rules.front().allowedAccess == LandlockReadFile);
+    }
+    SECTION("ABI 8 and later: TSYNC; a kernel newer than the table gets the table's best")
+    {
+        for (auto const version: { 8L, 10L, 99L })
+        {
+            REQUIRE(restrictFileSystem({}, fakeSystem(Answers { .version = version, .created = Ruleset }))
+                    == LandlockOutcome::Restricted);
+            auto const& best = version > landlockAbis().back().abi ? landlockAbis().back()
+                                                                   : abiRow(static_cast<int>(version));
+            REQUIRE(kernel().attr.has_value());
+            CHECK(kernel().attr->handledAccessFs == best.fsRights);
+            CHECK(kernel().attr->handledAccessNet == best.netRights);
+            CHECK(kernel().attr->scoped == best.scopes);
+            CHECK(kernel().restrictFlags == best.restrictFlags);
+            CHECK((best.restrictFlags & 0b1000U) != 0);
+            CHECK(kernel().closed == std::vector<int> { Ruleset });
+        }
+    }
+}
+
+TEST_CASE("Landlock.unavailableIsNotAFailure", "[vtextension][sandbox]")
+{
+    for (auto const error: { ENOSYS, EOPNOTSUPP })
+    {
+        INFO(error);
+        // Asked of the version, or of the ruleset.
+        CHECK(restrictFileSystem({}, fakeSystem(Answers { .version = -error }))
+              == LandlockOutcome::Unavailable);
+        CHECK(kernel().closed.empty());
+        CHECK(restrictFileSystem({}, fakeSystem(Answers { .version = 6, .created = -error }))
+              == LandlockOutcome::Unavailable);
+        CHECK_FALSE(kernel().restrictFlags.has_value());
+    }
+}
+
+TEST_CASE("Landlock.otherErrorsAreFailures", "[vtextension][sandbox]")
+{
+    // Restricting without no_new_privs.
+    auto const restricted = restrictFileSystem(
+        {}, fakeSystem(Answers { .version = 10, .created = Ruleset, .restricted = -EPERM }));
+    REQUIRE_FALSE(restricted.has_value());
+    CHECK(restricted.error() == ConfinementFailure { .step = LockdownStep::FileSystem, .code = EPERM });
+    CHECK(kernel().closed == std::vector<int> { Ruleset });
+
+    // Anything else the version query or the ruleset's creation says.
+    CHECK(restrictFileSystem({}, fakeSystem(Answers { .version = -EFAULT })).error()
+          == ConfinementFailure { .step = LockdownStep::FileSystem, .code = EFAULT });
+    CHECK(restrictFileSystem({}, fakeSystem(Answers { .version = 4, .created = -ENOMEM })).error()
+          == ConfinementFailure { .step = LockdownStep::FileSystem, .code = ENOMEM });
+}
diff --git a/src/vtextension/wasm/host/linux/SeccompFilter.cpp b/src/vtextension/wasm/host/linux/SeccompFilter.cpp
