diff --git a/src/vtextension/wasm/remote/transport/OwnedHandle.hpp b/src/vtextension/wasm/remote/transport/OwnedHandle.hpp
new file mode 100644
index 000000000..e1ab0464f
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/OwnedHandle.hpp
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// A handle this process owns, closed when its owner is destroyed: a descriptor on POSIX, a HANDLE on
+/// Windows. What a shared memory object is made as, and what crosses to the extension host process.
+
+#include <utility>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+#ifdef _WIN32
+/// The value no handle has: null, which no section or pipe handle is.
+inline constexpr auto NoNativeHandle = nullptr;
+#else
+/// The value no descriptor has.
+inline constexpr NativeHandle NoNativeHandle = -1;
+#endif
+
+/// Owns one handle, and closes it when destroyed. Move-only; a moved-from one owns nothing.
+class OwnedHandle
+{
+  public:
+    /// Owns nothing.
+    OwnedHandle() noexcept = default;
+
+    /// Takes ownership of @p handle.
+    /// @param handle The handle; NoNativeHandle for none.
+    explicit OwnedHandle(NativeHandle handle) noexcept: _handle { handle } {}
+
+    OwnedHandle(OwnedHandle&& other) noexcept: _handle { other.release() } {}
+
+    OwnedHandle& operator=(OwnedHandle&& other) noexcept
+    {
+        if (this != &other)
+            reset(other.release());
+        return *this;
+    }
+
+    OwnedHandle(OwnedHandle const&) = delete;
+    OwnedHandle& operator=(OwnedHandle const&) = delete;
+
+    ~OwnedHandle() { reset(NoNativeHandle); }
+
+    /// @return The handle, still owned; NoNativeHandle if none.
+    [[nodiscard]] NativeHandle get() const noexcept { return _handle; }
+
+    /// Gives the handle up, unclosed.
+    /// @return The handle, now the caller's; NoNativeHandle if none.
+    [[nodiscard]] NativeHandle release() noexcept { return std::exchange(_handle, NoNativeHandle); }
+
+    /// @return Whether it owns a handle.
+    [[nodiscard]] explicit operator bool() const noexcept { return _handle != NoNativeHandle; }
+
+  private:
+    /// Closes the handle owned, if any, and owns @p handle instead.
+    void reset(NativeHandle handle) noexcept
+    {
+        if (auto const previous = std::exchange(_handle, handle); previous != NoNativeHandle)
+            closeNativeHandle(previous);
+    }
+
+    NativeHandle _handle = NoNativeHandle;
+};
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/SharedObject.cpp b/src/vtextension/wasm/remote/transport/SharedObject.cpp
new file mode 100644
index 000000000..66fbe5405
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/SharedObject.cpp
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// What every system's mapping of a shared memory object shares: mapping and committing are each system's own
+// (SharedObject_posix.cpp, SharedObject_win32.cpp), owning the mapping is not.
+#include <vtextension/wasm/remote/transport/SharedObject.hpp>
+
+#include <cstdint>
+#include <expected>
+#include <span>
+#include <utility>
+
+namespace vtextension::wasm::remote::transport
+{
+
+SharedMapping::SharedMapping(std::span<std::byte> bytes, MapAccess access) noexcept:
+    _bytes { bytes }, _access { access }
+{
+}
+
+SharedMapping::SharedMapping(SharedMapping&& other) noexcept:
+    _bytes { std::exchange(other._bytes, {}) }, _access { other._access }
+{
+}
+
+SharedMapping& SharedMapping::operator=(SharedMapping&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _bytes = std::exchange(other._bytes, {});
+        _access = other._access;
+    }
+    return *this;
+}
+
+SharedMapping::~SharedMapping()
+{
+    release();
+}
+
+std::expected<void, SharedObjectError> SharedMapping::commit(uint64_t from, uint64_t to) noexcept
+{
+    if (from > to || to > _bytes.size())
+        return std::unexpected(SharedObjectError::OutOfRange);
+    if (from == to)
+        return {};
+    return commitRange(from, to);
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/SharedObject.hpp b/src/vtextension/wasm/remote/transport/SharedObject.hpp
new file mode 100644
index 000000000..4dcf3922f
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/SharedObject.hpp
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// Shared memory objects Contour and its extension host process both map, made in one place: the interrupt
+/// page (ControlPage.hpp) and an instance's guest memory. Linux and FreeBSD make a memfd, sealed against
+/// resizing; macOS a POSIX shared memory object under a name unique to this process, unlinked at once, sized
+/// once; Windows an unnamed pagefile-backed section, whose guest memory is reserved and committed page by
+/// page.
+///
+/// A mapping trusts no size the object reports beyond what fitsSharedObject() accepts: XNU rounds an object
+/// up to its page, which may be larger than the page of the process that reads it (an x86_64 helper under
+/// Rosetta sees 4 KiB pages, its arm64 parent rounded to 16 KiB).
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <span>
+
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+#include <vtextension/wasm/remote/transport/OwnedHandle.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+/// The largest page a system this runs on rounds a shared memory object up to: 16 KiB, on Apple silicon.
+inline constexpr uint64_t MaxPageBytes = uint64_t { 16 } * 1024;
+
+/// Whether an object of @p objectBytes, as the system reports it, is one made of @p expectedBytes: at least
+/// that, and at most that rounded up to MaxPageBytes, whatever the reader's own page. Whatever lies beyond
+/// @p expectedBytes is never mapped.
+/// @param objectBytes The size the system reports.
+/// @param expectedBytes The size it was made of.
+/// @return Whether it is that object's size.
+[[nodiscard]] constexpr bool fitsSharedObject(uint64_t objectBytes, uint64_t expectedBytes) noexcept
+{
+    auto const remainder = expectedBytes % MaxPageBytes;
+    auto const slack = remainder == 0 ? 0 : MaxPageBytes - remainder;
+    return objectBytes >= expectedBytes && objectBytes - expectedBytes <= slack;
+}
+
+/// What a shared memory object is for, which decides how it is made and sealed.
+enum class SharedObjectUse : uint8_t
+{
+    GuestMemory,   ///< An instance's memory: the helper writes it. Reserved on Windows, committed on demand.
+    InterruptPage, ///< The interrupt page: only Contour writes it. Sealed against later write mappings.
+};
+
+/// How a mapping may touch the object.
+enum class MapAccess : uint8_t
+{
+    ReadOnly,  ///< It reads.
+    ReadWrite, ///< It reads and writes.
+};
+
+/// Why a shared memory object could not be made, sealed or mapped.
+enum class SharedObjectError : uint8_t
+{
+    Unsupported, ///< The system has no shared memory object of the kind needed.
+    Io,          ///< The system refused.
+    WrongSize,   ///< The object is not the size expected, or no object can have that size.
+    OutOfRange,  ///< A range runs past the mapping's end.
+};
+
+/// Makes a shared memory object of @p bytes, not inherited by a child unless handed over. Linux and FreeBSD
+/// seal it against shrinking and growing at once; sealSharedObject() seals it for good once Contour mapped
+/// it. On Windows, guest memory is a reserved section whose pages commit() commits.
+/// @param bytes Its size: more than 0.
+/// @param use What it is for.
+/// @return Its handle; `WrongSize` for a size no object has, `Unsupported` or `Io` if the system refused.
+[[nodiscard]] std::expected<OwnedHandle, SharedObjectError> createSharedObject(uint64_t bytes,
+                                                                               SharedObjectUse use);
+
+/// Seals @p handle's object for good, once Contour mapped it: on Linux and FreeBSD against further seals,
+/// and for the interrupt page, on Linux 5.1 and later, against any write mapping made after Contour's own.
+/// Guest memory is never sealed against writes: the helper writes it. Nothing to do on macOS and Windows.
+/// @param handle An object createSharedObject() made for @p use.
+/// @param use What it is for.
+/// @return Nothing once sealed; `Io` if the system refused.
+[[nodiscard]] std::expected<void, SharedObjectError> sealSharedObject(NativeHandle handle,
+                                                                      SharedObjectUse use) noexcept;
+
+#ifndef _WIN32
+/// Checks the size of the object @p handle names, as fstat() reports it.
+/// @param handle A shared memory object.
+/// @param expectedBytes The size it was made of.
+/// @return Nothing if fitsSharedObject() accepts it; `WrongSize` if not, `Io` if it cannot be asked.
+[[nodiscard]] std::expected<void, SharedObjectError> checkSharedObjectSize(NativeHandle handle,
+                                                                           uint64_t expectedBytes) noexcept;
+#endif
+
+/// The first bytes of a shared memory object, mapped shared. Move-only; unmapped when destroyed. It does not
+/// own the object's handle: the mapping keeps the object alive on its own.
+class SharedMapping
+{
+  public:
+    /// Maps the first @p bytes of @p handle's object, once its size is checked: by fstat() on POSIX
+    /// (checkSharedObjectSize()), by the view's extent on Windows.
+    /// @param handle The object; still the caller's.
+    /// @param bytes How many bytes to map: the size the object was made of.
+    /// @param access How the mapping may touch them.
+    /// @return The mapping; `WrongSize` if the object is not of @p bytes, `Io` if it cannot be mapped.
+    [[nodiscard]] static std::expected<SharedMapping, SharedObjectError> map(NativeHandle handle,
+                                                                             uint64_t bytes,
+                                                                             MapAccess access);
+
+    SharedMapping(SharedMapping&& other) noexcept;
+    SharedMapping& operator=(SharedMapping&& other) noexcept;
+    SharedMapping(SharedMapping const&) = delete;
+    SharedMapping& operator=(SharedMapping const&) = delete;
+    ~SharedMapping();
+
+    /// @return The mapped bytes; empty once moved from.
+    [[nodiscard]] std::span<std::byte> bytes() const noexcept { return _bytes; }
+
+    /// Commits [@p from, @p to) of the mapping, so that it can be touched: on Windows, the reserved pages of
+    /// guest memory, committed through this view (VirtualAlloc, MEM_COMMIT); nothing elsewhere, where every
+    /// page of the object is backed on first touch. Committing a committed page again does nothing.
+    /// @param from The first byte.
+    /// @param to One past the last byte; at most bytes().size().
+    /// @return Nothing once committed; `OutOfRange` if the range runs past the mapping, `Io` if the system
+    ///         refused.
+    [[nodiscard]] std::expected<void, SharedObjectError> commit(uint64_t from, uint64_t to) noexcept;
+
+  private:
+    /// @param bytes The mapping, its own.
+    /// @param access How it was mapped.
+    SharedMapping(std::span<std::byte> bytes, MapAccess access) noexcept;
+
+    /// Commits [@p from, @p to), a range within the mapping, as this system does.
+    [[nodiscard]] std::expected<void, SharedObjectError> commitRange(uint64_t from, uint64_t to) noexcept;
+
+    /// Unmaps what it holds, if anything.
+    void release() noexcept;
+
+    std::span<std::byte> _bytes; ///< The mapping; empty once moved from.
+    MapAccess _access;           ///< How it was mapped.
+};
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/SharedObject_posix.cpp b/src/vtextension/wasm/remote/transport/SharedObject_posix.cpp
new file mode 100644
index 000000000..43bc2f651
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/SharedObject_posix.cpp
@@ -0,0 +1,189 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Shared memory objects on POSIX. Linux and FreeBSD (13 and later): an anonymous memfd, sealed against
+// shrinking and growing as it is made, so that neither process can make the other's mapping fault past the
+// object's end, and against further seals once Contour mapped it. macOS has no memfd: a POSIX shared memory
+// object under a name unique to this process, created exclusively and unlinked at once, so that it is
+// reachable only through the descriptor. XNU sizes such an object once, and rounds it up to its page.
+//
+// The interrupt page is also sealed, on Linux 5.1 and later, against every write mapping made after
+// Contour's own (F_SEAL_FUTURE_WRITE): the helper only reads it. Guest memory never is: the helper writes it.
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <limits>
+#include <ranges>
+#include <span>
+#include <utility>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <vtextension/wasm/remote/transport/SharedObject.hpp>
+
+#ifdef __APPLE__
+    #include <atomic>
+    #include <format>
+    #include <string>
+#endif
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+    /// Whether an object is sealed against write mappings made after Contour's own.
+    enum class LaterWrites : uint8_t
+    {
+        Allowed, ///< The helper maps it writable.
+        Sealed,  ///< Nobody maps it writable after Contour (F_SEAL_FUTURE_WRITE, where there is one).
+    };
+
+    /// How an object for one use is made and sealed.
+    struct UseRow
+    {
+        SharedObjectUse use;     ///< The use.
+        char const* memfdName;   ///< The memfd's name, as /proc shows it (Linux, FreeBSD).
+        LaterWrites laterWrites; ///< Whether it is sealed against later write mappings.
+    };
+
+    /// Every use, at its enumerator's index.
+    constexpr auto Uses = std::array {
+        UseRow { .use = SharedObjectUse::GuestMemory,
+                 .memfdName = "contour-extension-host-memory",
+                 .laterWrites = LaterWrites::Allowed },
+        UseRow { .use = SharedObjectUse::InterruptPage,
+                 .memfdName = "contour-extension-host-control",
+                 .laterWrites = LaterWrites::Sealed },
+    };
+    static_assert(std::ranges::all_of(std::views::iota(std::size_t { 0 }, Uses.size()),
+                                      [](std::size_t index) {
+                                          return std::to_underlying(Uses[index].use) == index;
+                                      }));
+
+    /// @return How an object for @p use is made and sealed.
+    [[nodiscard]] UseRow const& rowOf(SharedObjectUse use) noexcept
+    {
+        return Uses[std::to_underlying(use)];
+    }
+
+    /// @return Why a call that set @p error failed.
+    [[nodiscard]] SharedObjectError sharedObjectErrorOf(int error) noexcept
+    {
+        return error == ENOSYS || error == EINVAL ? SharedObjectError::Unsupported : SharedObjectError::Io;
+    }
+
+    /// @return Nothing if @p result is not -1; why the call failed otherwise.
+    [[nodiscard]] std::expected<void, SharedObjectError> succeeded(int result) noexcept
+    {
+        if (result == -1)
+            return std::unexpected(sharedObjectErrorOf(errno));
+        return {};
+    }
+
+    /// @return A new object, close-on-exec and not yet sized; or why it could not be made.
+    [[nodiscard]] std::expected<OwnedHandle, SharedObjectError> openObject(
+        [[maybe_unused]] UseRow const& row) noexcept
+    {
+#ifdef __APPLE__
+        static auto serial = std::atomic<uint64_t> { 0 };
+        auto const name = std::format("/contour-eh-{}-{}", ::getpid(), serial.fetch_add(1));
+        auto object = OwnedHandle { ::shm_open(name.c_str(), O_RDWR | O_CREAT | O_EXCL, 0600) };
+        if (!object)
+            return std::unexpected(sharedObjectErrorOf(errno));
+        ::shm_unlink(name.c_str());
+        return succeeded(::fcntl(object.get(), F_SETFD, FD_CLOEXEC)).transform([&] {
+            return std::move(object);
+        });
+#else
+        auto object = OwnedHandle { ::memfd_create(row.memfdName, MFD_CLOEXEC | MFD_ALLOW_SEALING) };
+        if (!object)
+            return std::unexpected(sharedObjectErrorOf(errno));
+        return object;
+#endif
+    }
+} // namespace
+
+std::expected<OwnedHandle, SharedObjectError> createSharedObject(uint64_t bytes, SharedObjectUse use)
+{
+    if (bytes == 0 || bytes > static_cast<uint64_t>(std::numeric_limits<off_t>::max()))
+        return std::unexpected(SharedObjectError::WrongSize);
+    // Sized once -- all XNU allows -- and, where there are seals, sealed at that size at once.
+    return openObject(rowOf(use)).and_then([bytes](OwnedHandle object) {
+        return succeeded(::ftruncate(object.get(), static_cast<off_t>(bytes)))
+#ifndef __APPLE__
+            .and_then(
+                [&] { return succeeded(::fcntl(object.get(), F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW)); })
+#endif
+            .transform([&] { return std::move(object); });
+    });
+}
+
+std::expected<void, SharedObjectError> sealSharedObject([[maybe_unused]] NativeHandle handle,
+                                                        [[maybe_unused]] SharedObjectUse use) noexcept
+{
+#ifndef __APPLE__
+    #ifdef F_SEAL_FUTURE_WRITE
+    // EINVAL: a kernel older than the seal; the helper's read-only mapping is then the only guard.
+    if (rowOf(use).laterWrites == LaterWrites::Sealed
+        && ::fcntl(handle, F_ADD_SEALS, F_SEAL_FUTURE_WRITE) == -1 && errno != EINVAL)
+        return std::unexpected(sharedObjectErrorOf(errno));
+    #endif
+    return succeeded(::fcntl(handle, F_ADD_SEALS, F_SEAL_SEAL));
+#else
+    return {};
+#endif
+}
+
+std::expected<void, SharedObjectError> checkSharedObjectSize(NativeHandle handle,
+                                                             uint64_t expectedBytes) noexcept
+{
+    struct stat status {};
+    if (::fstat(handle, &status) == -1)
+        return std::unexpected(SharedObjectError::Io);
+    if (status.st_size < 0 || !fitsSharedObject(static_cast<uint64_t>(status.st_size), expectedBytes))
+        return std::unexpected(SharedObjectError::WrongSize);
+    return {};
+}
+
+std::expected<SharedMapping, SharedObjectError> SharedMapping::map(NativeHandle handle,
+                                                                   uint64_t bytes,
+                                                                   MapAccess access)
+{
+    if (bytes == 0 || bytes > std::numeric_limits<std::size_t>::max())
+        return std::unexpected(SharedObjectError::WrongSize);
+    return checkSharedObjectSize(handle, bytes)
+        .and_then([&]() -> std::expected<SharedMapping, SharedObjectError> {
+            auto const protection = access == MapAccess::ReadWrite ? PROT_READ | PROT_WRITE : PROT_READ;
+            auto* const mapping =
+                ::mmap(nullptr, static_cast<std::size_t>(bytes), protection, MAP_SHARED, handle, 0);
+            if (mapping == MAP_FAILED)
+                return std::unexpected(SharedObjectError::Io);
+            return SharedMapping {
+                std::span { static_cast<std::byte*>(mapping), static_cast<std::size_t>(bytes) }, access
+            };
+        });
+}
+
+std::expected<void, SharedObjectError> SharedMapping::commitRange([[maybe_unused]] uint64_t from,
+                                                                  [[maybe_unused]] uint64_t to) noexcept
+{
+    // Every page of the object is backed on first touch.
+    return {};
+}
+
+void SharedMapping::release() noexcept
+{
+    if (!_bytes.empty())
+        ::munmap(_bytes.data(), _bytes.size());
+    _bytes = {};
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/SharedObject_test.cpp b/src/vtextension/wasm/remote/transport/SharedObject_test.cpp
new file mode 100644
index 000000000..eb4a3b35a
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/SharedObject_test.cpp
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The shared memory objects Contour and its extension host process both map: a size rounded up to any page a
+// parent may use is accepted and no more, what one mapping writes the other sees, and nobody can resize an
+// object, inherit it unasked, or find more of a reserved one committed than was asked for.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <initializer_list>
+#include <utility>
+
+#include <vtextension/wasm/remote/transport/SharedObject.hpp>
+
+#ifdef _WIN32
+    #define WIN32_LEAN_AND_MEAN
+    #include <Windows.h>
+#else
+    #include <sys/mman.h>
+    #include <sys/types.h>
+
+    #include <cerrno>
+
+    #include <fcntl.h>
+    #include <unistd.h>
+#endif
+
+using vtextension::wasm::remote::transport::createSharedObject;
+using vtextension::wasm::remote::transport::fitsSharedObject;
+using vtextension::wasm::remote::transport::MapAccess;
+using vtextension::wasm::remote::transport::sealSharedObject;
+using vtextension::wasm::remote::transport::SharedMapping;
+using vtextension::wasm::remote::transport::SharedObjectError;
+using vtextension::wasm::remote::transport::SharedObjectUse;
+#ifndef _WIN32
+using vtextension::wasm::remote::transport::checkSharedObjectSize;
+#endif
+
+namespace
+{
+
+constexpr auto KiB = uint64_t { 1024 };
+constexpr auto MiB = 1024 * KiB;
+
+/// The size the tests' guest memory is made of: a guest's page.
+constexpr auto GuestBytes = 64 * KiB;
+
+} // namespace
+
+TEST_CASE("SharedObject.sizeMayBeRoundedUpToTheLargestPage", "[vtextension]")
+{
+    // An arm64 parent's 4 KiB object, rounded to its 16 KiB page, read by an x86_64 helper under Rosetta,
+    // whose own page is 4 KiB.
+    STATIC_CHECK(fitsSharedObject(16 * KiB, 4 * KiB));
+    STATIC_CHECK(fitsSharedObject(4 * KiB, 4 * KiB));
+    STATIC_CHECK(fitsSharedObject(32 * MiB, 32 * MiB));
+    STATIC_CHECK_FALSE(fitsSharedObject((16 * KiB) + 1, 4 * KiB));
+    STATIC_CHECK_FALSE(fitsSharedObject((4 * KiB) - 1, 4 * KiB));
+    STATIC_CHECK_FALSE(fitsSharedObject((32 * MiB) + (16 * KiB), 32 * MiB));
+    // No size near the top wraps around.
+    STATIC_CHECK_FALSE(fitsSharedObject(0, UINT64_MAX));
+    STATIC_CHECK(fitsSharedObject(UINT64_MAX, UINT64_MAX));
+}
+
+TEST_CASE("SharedObject.writesAreSeenThroughASecondMapping", "[vtextension]")
+{
+    auto const object = createSharedObject(GuestBytes, SharedObjectUse::GuestMemory);
+    REQUIRE(object.has_value());
+    auto first = SharedMapping::map(object->get(), GuestBytes, MapAccess::ReadWrite);
+    REQUIRE(first.has_value());
+    auto second = SharedMapping::map(object->get(), GuestBytes, MapAccess::ReadWrite);
+    REQUIRE(second.has_value());
+    REQUIRE(sealSharedObject(object->get(), SharedObjectUse::GuestMemory).has_value());
+    CHECK(first->bytes().size() == GuestBytes);
+    REQUIRE(first->commit(0, GuestBytes).has_value());
+    REQUIRE(second->commit(0, GuestBytes).has_value());
+
+    first->bytes().front() = std::byte { 0x5A };
+    second->bytes().back() = std::byte { 0xA5 };
+    CHECK(second->bytes().front() == std::byte { 0x5A });
+    CHECK(first->bytes().back() == std::byte { 0xA5 });
+
+    // A moved mapping is the same mapping.
+    auto moved = std::move(*second);
+    CHECK(moved.bytes().front() == std::byte { 0x5A });
+
+    // Nothing past the mapping commits.
+    CHECK(first->commit(0, GuestBytes + 1) == std::unexpected(SharedObjectError::OutOfRange));
+    CHECK(first->commit(2, 1) == std::unexpected(SharedObjectError::OutOfRange));
+}
+
+TEST_CASE("SharedObject.noObjectIsEmpty", "[vtextension]")
+{
+    for (auto const use: { SharedObjectUse::GuestMemory, SharedObjectUse::InterruptPage })
+        CHECK(createSharedObject(0, use) == std::unexpected(SharedObjectError::WrongSize));
+}
+
+#if defined(__linux__) || defined(__FreeBSD__)
+TEST_CASE("SharedObject.isSealedAgainstResizing", "[vtextension]")
+{
+    auto const object = createSharedObject(GuestBytes, SharedObjectUse::GuestMemory);
+    REQUIRE(object.has_value());
+    // Against resizing from the start: nobody can make another's mapping fault past the end, nor shrink it.
+    CHECK(::fcntl(object->get(), F_GET_SEALS) == (F_SEAL_SHRINK | F_SEAL_GROW));
+    auto const mapping = SharedMapping::map(object->get(), GuestBytes, MapAccess::ReadWrite);
+    REQUIRE(mapping.has_value());
+    REQUIRE(sealSharedObject(object->get(), SharedObjectUse::GuestMemory).has_value());
+    for (auto const size: { 2 * GuestBytes, uint64_t { 0 } })
+    {
+        auto const resized = ::ftruncate(object->get(), static_cast<off_t>(size));
+        auto const error = errno;
+        CHECK(resized == -1);
+        CHECK(error == EPERM);
+    }
+    // Guest memory stays writable for the helper: sealed against resizing and further seals, never against
+    // writes.
+    CHECK(::fcntl(object->get(), F_GET_SEALS) == (F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL));
+    auto* const helperView =
+        ::mmap(nullptr, GuestBytes, PROT_READ | PROT_WRITE, MAP_SHARED, object->get(), 0);
+    CHECK(helperView != MAP_FAILED);
+    if (helperView != MAP_FAILED)
+        ::munmap(helperView, GuestBytes);
+}
+#endif
+
+TEST_CASE("SharedObject.isNotInherited", "[vtextension]")
+{
+    for (auto const use: { SharedObjectUse::GuestMemory, SharedObjectUse::InterruptPage })
+    {
+        auto const object = createSharedObject(GuestBytes, use);
+        REQUIRE(object.has_value());
+#ifdef _WIN32
+        auto flags = DWORD { 0 };
+        REQUIRE(::GetHandleInformation(object->get(), &flags));
+        CHECK((flags & HANDLE_FLAG_INHERIT) == 0);
+#else
+        auto const flags = ::fcntl(object->get(), F_GETFD);
+        REQUIRE(flags != -1);
+        CHECK((flags & FD_CLOEXEC) != 0);
+#endif
+    }
+}
+
+TEST_CASE("SharedObject.checkRefusesAWrongSize", "[vtextension]")
+{
+    // Made of 32 KiB and expected as 4: more than any page rounds 4 KiB up to. Made of 4 KiB and expected as
+    // 32: less.
+    auto const large = createSharedObject(32 * KiB, SharedObjectUse::GuestMemory);
+    REQUIRE(large.has_value());
+    auto const small = createSharedObject(4 * KiB, SharedObjectUse::GuestMemory);
+    REQUIRE(small.has_value());
+    CHECK(SharedMapping::map(large->get(), 4 * KiB, MapAccess::ReadOnly)
+          == std::unexpected(SharedObjectError::WrongSize));
+    CHECK(SharedMapping::map(small->get(), 32 * KiB, MapAccess::ReadOnly)
+          == std::unexpected(SharedObjectError::WrongSize));
+    CHECK(SharedMapping::map(small->get(), 4 * KiB, MapAccess::ReadOnly).has_value());
+#ifndef _WIN32
+    CHECK(checkSharedObjectSize(large->get(), 4 * KiB) == std::unexpected(SharedObjectError::WrongSize));
+    CHECK(checkSharedObjectSize(small->get(), 32 * KiB) == std::unexpected(SharedObjectError::WrongSize));
+    CHECK(checkSharedObjectSize(small->get(), 4 * KiB).has_value());
+    // What names no object cannot be asked.
+    CHECK(checkSharedObjectSize(-1, 4 * KiB) == std::unexpected(SharedObjectError::Io));
+#endif
+}
+
+#ifdef _WIN32
+TEST_CASE("SharedObject.reservedSectionCommitsOnlyWhatIsAsked", "[vtextension]")
+{
+    // Guest memory is reserved: only the pages committed through a view are backed, and charged.
+    auto const object = createSharedObject(MiB, SharedObjectUse::GuestMemory);
+    REQUIRE(object.has_value());
+    auto mapping = SharedMapping::map(object->get(), MiB, MapAccess::ReadWrite);
+    REQUIRE(mapping.has_value());
+    auto* const base = mapping->bytes().data();
+
+    auto region = MEMORY_BASIC_INFORMATION {};
+    REQUIRE(::VirtualQuery(base, &region, sizeof(region)) != 0);
+    CHECK(region.State == MEM_RESERVE);
+
+    REQUIRE(mapping->commit(0, GuestBytes).has_value());
+    REQUIRE(::VirtualQuery(base, &region, sizeof(region)) != 0);
+    CHECK(region.State == MEM_COMMIT);
+    CHECK(region.RegionSize == GuestBytes);
+    REQUIRE(::VirtualQuery(base + GuestBytes, &region, sizeof(region)) != 0);
+    CHECK(region.State == MEM_RESERVE);
+
+    mapping->bytes()[GuestBytes - 1] = std::byte { 1 };
+    CHECK(mapping->bytes()[GuestBytes - 1] == std::byte { 1 });
+}
+#endif
