@@ -0,0 +1,446 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Every PDU is a struct whose fields are listed once, by members(); the writers and readers below walk that
+// list by field type. A new PDU is a struct, its members(), its table row (PduTable.hpp) and an instantiation
+// at the bottom of this file.
+#include <vtextension/wasm/remote/proto/Codec.hpp>
+
+#include <algorithm>
+#include <concepts>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <string>
+#include <tuple>
+#include <type_traits>
+#include <utility>
+#include <variant>
+#include <vector>
+
+#include <vtextension/wasm/remote/proto/PduTable.hpp>
+
+namespace vtextension::wasm::remote::proto
+{
+
+namespace
+{
+    /// The outcome of reading one field.
+    using Status = std::expected<void, DecodeError>;
+
+    /// Whether @p T is @p U, or a const @p U.
+    template <typename T, typename U>
+    concept Of = std::same_as<std::remove_const_t<T>, U>;
+
+    /// An enumeration the wire carries as one byte.
+    template <typename T>
+    concept WireEnum = std::is_enum_v<T> && sizeof(T) == 1;
+
+    // The last enumerator of every enumeration the wire carries: a byte naming one past it is BadEnum. A new
+    // enumeration on the wire needs one here, or its read does not compile.
+    constexpr ValueType lastEnumerator(ValueType) noexcept
+    {
+        return ValueType::F64;
+    }
+    constexpr ExternKind lastEnumerator(ExternKind) noexcept
+    {
+        return ExternKind::Global;
+    }
+    constexpr Linkage lastEnumerator(Linkage) noexcept
+    {
+        return Linkage::Satisfied;
+    }
+    constexpr CallFailure lastEnumerator(CallFailure) noexcept
+    {
+        return CallFailure::HostFailure;
+    }
+    constexpr ExtensionError lastEnumerator(ExtensionError) noexcept
+    {
+        return ExtensionError::ModuleTooLarge;
+    }
+    constexpr MemoryMode lastEnumerator(MemoryMode) noexcept
+    {
+        return MemoryMode::Shared;
+    }
+    constexpr LockdownState lastEnumerator(LockdownState) noexcept
+    {
+        return LockdownState::LockedDown;
+    }
+    constexpr ReleaseTarget lastEnumerator(ReleaseTarget) noexcept
+    {
+        return ReleaseTarget::Runtime;
+    }
+    constexpr MemoryStatus lastEnumerator(MemoryStatus) noexcept
+    {
+        return MemoryStatus::Ok;
+    }
+
+    // The fields of every struct the wire carries, in wire order. Each takes the struct const or not, so that
+    // the writers and the readers walk the one list.
+    constexpr auto members(Of<FunctionSignature> auto& value) noexcept
+    {
+        return std::tie(value.parameters, value.results);
+    }
+    constexpr auto members(Of<ImportDescription> auto& value) noexcept
+    {
+        return std::tie(value.module, value.name, value.kind, value.signature, value.linkage);
+    }
+    constexpr auto members(Of<ExportDescription> auto& value) noexcept
+    {
+        return std::tie(value.name, value.kind, value.signature, value.initialPages);
+    }
+    constexpr auto members(Of<WireHostFunction> auto& value) noexcept
+    {
+        return std::tie(value.module, value.name, value.parameterCount);
+    }
+    constexpr auto members(Of<Hello> auto& value) noexcept
+    {
+        return std::tie(value.version, value.memoryMode, value.lockdown);
+    }
+    constexpr auto members(Of<CreateRuntime> auto& value) noexcept
+    {
+        return std::tie(value.runtimeId, value.memoryBytes, value.stackBytes, value.functions);
+    }
+    constexpr auto members(Of<RuntimeCreated> auto& value) noexcept
+    {
+        return std::tie(value.runtimeId, value.error);
+    }
+    constexpr auto members(Of<Load> auto& value) noexcept
+    {
+        return std::tie(value.runtimeId, value.moduleId, value.bytes);
+    }
+    constexpr auto members(Of<Loaded> auto& value) noexcept
+    {
+        return std::tie(value.moduleId, value.error, value.imports, value.exports);
+    }
+    constexpr auto members(Of<Instantiate> auto& value) noexcept
+    {
+        return std::tie(value.moduleId, value.instanceId);
+    }
+    constexpr auto members(Of<Instantiated> auto& value) noexcept
+    {
+        return std::tie(value.instanceId, value.error, value.callableExports);
+    }
+    constexpr auto members(Of<Release> auto& value) noexcept
+    {
+        return std::tie(value.target, value.id);
+    }
+    constexpr auto members(Of<Call> auto& value) noexcept
+    {
+        return std::tie(value.instanceId, value.exportOrdinal, value.argv);
+    }
+    constexpr auto members(Of<CallHost> auto& value) noexcept
+    {
+        return std::tie(value.functionIndex, value.arguments);
+    }
+    constexpr auto members(Of<HostResult> auto& value) noexcept
+    {
+        return std::tie(value.error);
+    }
+    constexpr auto members(Of<CallResult> auto& value) noexcept
+    {
+        return std::tie(value.failure, value.argv);
+    }
+    constexpr auto members(Of<MemoryRead> auto& value) noexcept
+    {
+        return std::tie(value.instanceId, value.address, value.size);
+    }
+    constexpr auto members(Of<MemoryData> auto& value) noexcept
+    {
+        return std::tie(value.status, value.bytes);
+    }
+    constexpr auto members(Of<MemoryWrite> auto& value) noexcept
+    {
+        return std::tie(value.instanceId, value.address, value.bytes);
+    }
+
+    /// A struct whose fields members() lists.
+    template <typename T>
+    concept Described = requires(T& value) { members(value); };
+
+    // The element counts a body's byte cap does not bound tightly enough: a one-byte varint per value lets a
+    // Call's cap hold five times MaxCallValues values.
+    [[nodiscard]] constexpr bool withinCounts(auto const&) noexcept
+    {
+        return true;
+    }
+    [[nodiscard]] constexpr bool withinCounts(Call const& value) noexcept
+    {
+        return value.argv.size() <= MaxCallValues;
+    }
+    [[nodiscard]] constexpr bool withinCounts(CallResult const& value) noexcept
+    {
+        return value.argv.size() <= MaxCallValues;
+    }
+    [[nodiscard]] constexpr bool withinCounts(CallHost const& value) noexcept
+    {
+        return value.arguments.size() <= MaxHostParameters;
+    }
+
+    // Writers, declared before any is defined, so that each finds the others whatever it nests.
+    void write(Writer& writer, uint32_t value);
+    void write(Writer& writer, uint64_t value);
+    template <WireEnum E>
+    void write(Writer& writer, E value);
+    template <WireEnum E>
+    void write(Writer& writer, std::optional<E> const& value);
+    void write(Writer& writer, std::string const& value);
+    void write(Writer& writer, std::vector<std::byte> const& value);
+    template <typename T>
+    void write(Writer& writer, std::vector<T> const& values);
+    template <Described T>
+    void write(Writer& writer, T const& value);
+
+    void write(Writer& writer, uint32_t value)
+    {
+        writer.varint(value);
+    }
+
+    void write(Writer& writer, uint64_t value)
+    {
+        writer.varint(value);
+    }
+
+    template <WireEnum E>
+    void write(Writer& writer, E value)
+    {
+        writer.u8(std::to_underlying(value));
+    }
+
+    /// A status: 0 for none, else the enumerator's value + 1.
+    template <WireEnum E>
+    void write(Writer& writer, std::optional<E> const& value)
+    {
+        writer.u8(value ? static_cast<uint8_t>(std::to_underlying(*value) + 1) : uint8_t { 0 });
+    }
+
+    void write(Writer& writer, std::string const& value)
+    {
+        writer.varint(value.size());
+        writer.bytes(std::as_bytes(std::span { value }));
+    }
+
+    void write(Writer& writer, std::vector<std::byte> const& value)
+    {
+        writer.varint(value.size());
+        writer.bytes(value);
+    }
+
+    template <typename T>
+    void write(Writer& writer, std::vector<T> const& values)
+    {
+        writer.varint(values.size());
+        for (auto const& value: values)
+            write(writer, value);
+    }
+
+    template <Described T>
+    void write(Writer& writer, T const& value)
+    {
+        std::apply([&writer](auto const&... fields) { (write(writer, fields), ...); }, members(value));
+    }
+
+    // Readers, likewise declared first.
+    Status read(Reader& reader, uint32_t& value);
+    Status read(Reader& reader, uint64_t& value);
+    template <WireEnum E>
+    Status read(Reader& reader, E& value);
+    template <WireEnum E>
+    Status read(Reader& reader, std::optional<E>& value);
+    Status read(Reader& reader, std::string& value);
+    Status read(Reader& reader, std::vector<std::byte>& value);
+    template <typename T>
+    Status read(Reader& reader, std::vector<T>& values);
+    template <Described T>
+    Status read(Reader& reader, T& value);
+
+    Status read(Reader& reader, uint32_t& value)
+    {
+        return reader.varint32().transform([&value](uint32_t read) { value = read; });
+    }
+
+    Status read(Reader& reader, uint64_t& value)
+    {
+        return reader.varint64().transform([&value](uint64_t read) { value = read; });
+    }
+
+    template <WireEnum E>
+    Status read(Reader& reader, E& value)
+    {
+        return reader.u8().and_then([&value](uint8_t byte) -> Status {
+            if (byte > std::to_underlying(lastEnumerator(E {})))
+                return std::unexpected(DecodeError::BadEnum);
+            value = static_cast<E>(byte);
+            return {};
+        });
+    }
+
+    template <WireEnum E>
+    Status read(Reader& reader, std::optional<E>& value)
+    {
+        return reader.u8().and_then([&value](uint8_t byte) -> Status {
+            if (byte == 0)
+            {
+                value.reset();
+                return {};
+            }
+            if (byte - 1 > std::to_underlying(lastEnumerator(E {})))
+                return std::unexpected(DecodeError::BadEnum);
+            value = static_cast<E>(byte - 1);
+            return {};
+        });
+    }
+
+    Status read(Reader& reader, std::string& value)
+    {
+        return reader.varint64()
+            .and_then([&](uint64_t count) { return reader.bytes(count); })
+            .transform(
+                [&value](std::span<uint8_t const> bytes) { value.assign(bytes.begin(), bytes.end()); });
+    }
+
+    Status read(Reader& reader, std::vector<std::byte>& value)
+    {
+        return reader.varint64()
+            .and_then([&](uint64_t count) { return reader.bytes(count); })
+            .transform([&value](std::span<uint8_t const> bytes) {
+                auto const view = std::as_bytes(bytes);
+                value.assign(view.begin(), view.end());
+            });
+    }
+
+    template <typename T>
+    Status read(Reader& reader, std::vector<T>& values)
+    {
+        auto const count = reader.varint64();
+        if (!count)
+            return std::unexpected(count.error());
+        values.clear();
+        values.reserve(boundedReserveCount<T>(*count, reader.remaining()));
+        // Every element takes at least one byte, so a lying count runs the reader short, not this loop long.
+        for ([[maybe_unused]] auto const index: std::views::iota(uint64_t { 0 }, *count))
+        {
+            auto& element = values.emplace_back();
+            if (auto const status = read(reader, element); !status)
+                return status;
+        }
+        return {};
+    }
+
+    template <Described T>
+    Status read(Reader& reader, T& value)
+    {
+        auto status = Status {};
+        std::apply([&](auto&... fields) { static_cast<void>(((status = read(reader, fields)) && ...)); },
+                   members(value));
+        return status;
+    }
+
+    /// @return The largest frame length any kind may declare under @p limits: its body and its kind.
+    [[nodiscard]] uint64_t largestFrameLength(PduLimits const& limits) noexcept
+    {
+        return std::ranges::max(PduTable | std::views::transform([&limits](PduRow const& row) {
+                                    return row.sizeCap(limits);
+                                }))
+               + MaxVarint32Bytes;
+    }
+
+} // namespace
+
+template <typename Body>
+std::expected<Pdu, DecodeError> decodeBody(std::span<uint8_t const> body)
+{
+    auto reader = Reader { body };
+    auto value = Body {};
+    return read(reader, value).and_then([&]() -> std::expected<Pdu, DecodeError> {
+        if (!reader.atEnd())
+            return std::unexpected(DecodeError::TrailingBytes);
+        if (!withinCounts(value))
+            return std::unexpected(DecodeError::OverCap);
+        return Pdu { std::move(value) };
+    });
+}
+
+PduKind kindOf(Pdu const& pdu) noexcept
+{
+    return static_cast<PduKind>(pdu.index() + 1);
+}
+
+std::vector<uint8_t> encodeFrame(Pdu const& pdu)
+{
+    // Every kind fits a one-byte varint, so the kind is its value's byte.
+    static_assert(std::to_underlying(PduKind::MemoryWrite) < 0x80);
+    auto body = Writer {};
+    std::visit([&body](auto const& value) { write(body, value); }, pdu);
+    auto const bodyBytes = body.take();
+
+    auto frame = Writer {};
+    frame.varint(1 + bodyBytes.size());
+    frame.u8(std::to_underlying(kindOf(pdu)));
+    frame.bytes(std::as_bytes(std::span { bodyBytes }));
+    return frame.take();
+}
+
+std::expected<DecodedFrame, DecodeError> decodeFrame(std::span<uint8_t const> buffer,
+                                                     Direction arriving,
+                                                     ChannelKind channel,
+                                                     PduLimits const& limits)
+{
+    auto header = Reader { buffer };
+    auto const length = header.varint64();
+    if (!length)
+        return std::unexpected(length.error() == DecodeError::Truncated ? DecodeError::NeedMoreData
+                                                                        : length.error());
+    // Refused before the kind is known, so that no header makes the reader wait for more than any kind holds.
+    if (*length > largestFrameLength(limits))
+        return std::unexpected(DecodeError::OverCap);
+    auto const frameStart = header.consumed();
+    auto const available = buffer.size() - frameStart;
+    auto const complete = available >= *length;
+
+    // The kind lies inside the frame: running past what arrived waits, running past the frame is a lie.
+    auto frame =
+        Reader { buffer.subspan(frameStart, complete ? static_cast<std::size_t>(*length) : available) };
+    auto const kind = frame.varint32();
+    if (!kind)
+        return std::unexpected(kind.error() == DecodeError::Truncated && !complete ? DecodeError::NeedMoreData
+                                                                                   : kind.error());
+    if (*kind == 0 || *kind > PduTable.size())
+        return std::unexpected(DecodeError::UnknownKind);
+    auto const& row = PduTable[*kind - 1];
+    if (row.direction != arriving)
+        return std::unexpected(DecodeError::WrongDirection);
+    if (row.channel != channel)
+        return std::unexpected(DecodeError::WrongChannel);
+    auto const bodySize = *length - frame.consumed();
+    if (bodySize > row.sizeCap(limits))
+        return std::unexpected(DecodeError::OverCap);
+    if (!complete)
+        return std::unexpected(DecodeError::NeedMoreData);
+
+    auto const consumed = frameStart + static_cast<std::size_t>(*length);
+    return row.decode(buffer.subspan(frameStart + frame.consumed(), static_cast<std::size_t>(bodySize)))
+        .transform(
+            [consumed](Pdu&& pdu) { return DecodedFrame { .pdu = std::move(pdu), .consumed = consumed }; });
+}
+
+// The bodies the PduTable decodes, one per Pdu alternative; the table's static_assert names each.
+template std::expected<Pdu, DecodeError> decodeBody<Hello>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<CreateRuntime>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<RuntimeCreated>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<Load>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<Loaded>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<Instantiate>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<Instantiated>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<Release>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<Call>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<CallHost>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<HostResult>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<CallResult>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<MemoryRead>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<MemoryData>(std::span<uint8_t const>);
+template std::expected<Pdu, DecodeError> decodeBody<MemoryWrite>(std::span<uint8_t const>);
+
+} // namespace vtextension::wasm::remote::proto
diff --git a/src/vtextension/wasm/remote/proto/Codec.hpp b/src/vtextension/wasm/remote/proto/Codec.hpp
new file mode 100644
index 000000000..d5d70d2da
--- /dev/null
+++ b/src/vtextension/wasm/remote/proto/Codec.hpp
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// Frames PDUs, and reads them back, checked against the PduTable.
+///
+///   varint length   (of the kind and the body; excludes itself)
+///   varint kind     (a PduKind; zero and anything past the last kind are refused)
+///   body            (the PDU's fields, in declaration order, consumed exactly)
+///
+/// Fields encode as varints (u32 and u64), one byte per enum, one byte per optional error or failure
+/// (0 for none, else the enumerator's value + 1), and byte strings and vectors as a varint count followed by
+/// their elements.
+///
+/// A reader never buffers toward a frame it will refuse: the declared length is checked against the largest
+/// cap of any kind before the kind is known, then against the kind's own cap once it is (decodeFrame).
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <span>
+#include <vector>
+
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/remote/proto/Wire.hpp>
+
+namespace vtextension::wasm::remote::proto
+{
+
+/// @return The kind of @p pdu.
+[[nodiscard]] PduKind kindOf(Pdu const& pdu) noexcept;
+
+/// Encodes @p pdu as one frame.
+/// @param pdu The PDU to encode. Its element counts are the caller's to keep within MaxCallValues and
+///            MaxHostParameters; a reader refuses a frame that exceeds them.
+/// @return The frame's bytes.
+[[nodiscard]] std::vector<uint8_t> encodeFrame(Pdu const& pdu);
+
+/// One frame read off the front of a buffer.
+struct DecodedFrame
+{
+    Pdu pdu;              ///< The PDU it carries.
+    std::size_t consumed; ///< How many bytes of the buffer the frame spans.
+};
+
+/// Decodes the frame at the front of @p buffer.
+/// @param buffer The bytes received so far; the frame starts at its first byte.
+/// @param arriving The way the frame travels: a PDU of the other direction is `WrongDirection`.
+/// @param channel The channel it arrived on: a PDU of the other channel is `WrongChannel`.
+/// @param limits The caps of the PDUs whose size follows the stream's limits.
+/// @return The PDU and the frame's size. `NeedMoreData` while the frame is incomplete and nothing in it is
+///         wrong yet; any other error is a violation that ends the stream.
+[[nodiscard]] std::expected<DecodedFrame, DecodeError> decodeFrame(std::span<uint8_t const> buffer,
+                                                                   Direction arriving,
+                                                                   ChannelKind channel,
+                                                                   PduLimits const& limits);
+
+} // namespace vtextension::wasm::remote::proto
diff --git a/src/vtextension/wasm/remote/proto/Codec_fuzz.cpp b/src/vtextension/wasm/remote/proto/Codec_fuzz.cpp
new file mode 100644
index 000000000..575bbf7c5
--- /dev/null
+++ b/src/vtextension/wasm/remote/proto/Codec_fuzz.cpp
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// libFuzzer target for the extension host protocol's codec (VTEXTENSION_FUZZING). Decodes its input as a
+// frame arriving each way on each channel; whatever decodes must encode again to a frame that decodes to the
+// same PDU.
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+#include <vtextension/wasm/remote/proto/Codec.hpp>
+
+using namespace vtextension::wasm::remote::proto;
+
+extern "C" int LLVMFuzzerTestOneInput(uint8_t const* data, std::size_t size)
+{
+    auto const input = std::span { data, size };
+    // Small limits, so that the fuzzer reaches the caps that follow them.
+    auto const limits = PduLimits { .maxModuleBytes = 4096, .maxMemoryBytes = 4096 };
+    for (auto const direction: std::array { Direction::ToHelper, Direction::ToParent })
+    {
+        for (auto const channel: std::array { ChannelKind::Control, ChannelKind::Lane })
+        {
+            auto const decoded = decodeFrame(input, direction, channel, limits);
+            if (!decoded)
+                continue;
+            if (decoded->consumed > input.size())
+                __builtin_trap();
+            auto const again = decodeFrame(encodeFrame(decoded->pdu), direction, channel, limits);
+            if (!again || again->pdu != decoded->pdu)
+                __builtin_trap();
+        }
+    }
+    return 0;
+}
diff --git a/src/vtextension/wasm/remote/proto/Codec_test.cpp b/src/vtextension/wasm/remote/proto/Codec_test.cpp
new file mode 100644
index 000000000..ac3e93823
--- /dev/null
+++ b/src/vtextension/wasm/remote/proto/Codec_test.cpp
@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The extension host protocol's codec: every kind round-trips, and every frame a peer could make up is
+// refused for the right reason, from as few bytes as the reason needs.
+#include <catch2/catch_message.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <initializer_list>
+#include <optional>
+#include <random>
+#include <ranges>
+#include <span>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/remote/proto/Codec.hpp>
+#include <vtextension/wasm/remote/proto/PduTable.hpp>
+
+using namespace vtextension::wasm::remote::proto;
+using vtextension::ExtensionError;
+using vtextension::wasm::CallFailure;
+using vtextension::wasm::ExportDescription;
+using vtextension::wasm::ExternKind;
+using vtextension::wasm::ImportDescription;
+using vtextension::wasm::Linkage;
+using vtextension::wasm::ValueType;
+
+namespace
+{
+
+/// @return @p values as bytes.
+[[nodiscard]] std::vector<std::byte> raw(std::initializer_list<uint8_t> values)
+{
+    return std::ranges::to<std::vector<std::byte>>(
+        values | std::views::transform([](uint8_t value) { return static_cast<std::byte>(value); }));
+}
+
+/// @return One populated PDU of every kind, in kind order.
+[[nodiscard]] std::vector<Pdu> samples()
+{
+    return {
+        Hello { .version = ProtocolVersion,
+                .memoryMode = MemoryMode::Shared,
+                .lockdown = LockdownState::LockedDown },
+        CreateRuntime {
+            .runtimeId = 7,
+            .memoryBytes = uint64_t { 32 } * 1024 * 1024,
+            .stackBytes = uint64_t { 128 } * 1024,
+            .functions = { WireHostFunction {
+                               .module = "contour:ext/host@0", .name = "log", .parameterCount = 3 },
+                           WireHostFunction { .module = "wasi", .name = "x", .parameterCount = 0 } },
+        },
+        RuntimeCreated { .runtimeId = 7, .error = ExtensionError::RuntimeUnavailable },
+        Load { .runtimeId = 7, .moduleId = 9, .bytes = raw({ 0x00, 0x61, 0x73, 0x6d, 0xff }) },
+        Loaded {
+            .moduleId = 9,
+            .error = std::nullopt,
+            .imports = { ImportDescription { .module = "m",
+                                             .name = "f",
+                                             .kind = ExternKind::Function,
+                                             .signature = { .parameters = { ValueType::I32, ValueType::I64 },
+                                                            .results = { ValueType::F32 } },
+                                             .linkage = Linkage::Satisfied },
+                         ImportDescription { .module = "m",
+                                             .name = "mem",
+                                             .kind = ExternKind::Memory,
+                                             .signature = {},
+                                             .linkage = Linkage::Unsatisfied } },
+            .exports = { ExportDescription { .name = "add",
+                                             .kind = ExternKind::Function,
+                                             .signature = { .parameters = { ValueType::I32, ValueType::I32 },
+                                                            .results = { ValueType::I32 } },
+                                             .initialPages = 0 },
+                         ExportDescription { .name = "memory",
+                                             .kind = ExternKind::Memory,
+                                             .signature = {},
+                                             .initialPages = 17 } },
+        },
+        Instantiate { .moduleId = 9, .instanceId = 11 },
+        Instantiated { .instanceId = 11, .error = std::nullopt, .callableExports = { 0, 3, 70000 } },
+        Release { .target = ReleaseTarget::Runtime, .id = 7 },
+        Call { .instanceId = 11, .exportOrdinal = 2, .argv = { 1, 0xFFFFFFFF, 300 } },
+        CallHost { .functionIndex = 4, .arguments = { 1, 2, 3 } },
+        HostResult { .error = ExtensionError::PermissionDenied },
+        CallResult { .failure = CallFailure::HostFailure, .argv = { 42 } },
+        MemoryRead { .instanceId = 11, .address = 0x10000, .size = 256 },
+        MemoryData { .status = MemoryStatus::Ok, .bytes = raw({ 1, 2, 3 }) },
+        MemoryWrite { .instanceId = 11, .address = 0xFFFFFFF0, .bytes = raw({ 9, 8 }) },
+    };
+}
+
+/// @return The table row of @p pdu's kind.
+[[nodiscard]] PduRow const& rowOf(Pdu const& pdu)
+{
+    return PduTable.at(std::to_underlying(kindOf(pdu)) - 1);
+}
+
+/// @return @p value as a varint.
+[[nodiscard]] std::vector<uint8_t> varint(uint64_t value)
+{
+    auto writer = Writer {};
+    writer.varint(value);
+    return writer.take();
+}
+
+/// @return A frame of kind @p kind around @p body, framed as the codec frames.
+[[nodiscard]] std::vector<uint8_t> frameOf(uint64_t kind, std::span<uint8_t const> body)
+{
+    auto const tag = varint(kind);
+    auto frame = varint(tag.size() + body.size());
+    frame.insert(frame.end(), tag.begin(), tag.end());
+    frame.insert(frame.end(), body.begin(), body.end());
+    return frame;
+}
+
+/// @return Why @p frame decodes to nothing as a @p row PDU; nothing if it decodes.
+[[nodiscard]] std::optional<DecodeError> errorOf(std::span<uint8_t const> frame, PduRow const& row)
+{
+    auto const decoded = decodeFrame(frame, row.direction, row.channel, PduLimits {});
+    if (decoded)
+        return std::nullopt;
+    return decoded.error();
+}
+
+} // namespace
+
+TEST_CASE("PduCodec.tableHasOneRowPerKind", "[vtextension]")
+{
+    CHECK(PduTable.size() == 15);
+    for (auto const index: std::views::iota(std::size_t { 0 }, PduTable.size()))
+    {
+        INFO("row " << index);
+        CHECK(PduTable[index].kind == static_cast<PduKind>(index + 1));
+    }
+}
+
+TEST_CASE("PduCodec.roundTrip", "[vtextension]")
+{
+    for (auto const& sample: samples())
+    {
+        DYNAMIC_SECTION("kind " << static_cast<int>(kindOf(sample)))
+        {
+            auto const& row = rowOf(sample);
+            auto const frame = encodeFrame(sample);
+            auto const decoded = decodeFrame(frame, row.direction, row.channel, PduLimits {});
+            REQUIRE(decoded.has_value());
+            CHECK(decoded->pdu == sample);
+            CHECK(decoded->consumed == frame.size());
+        }
+    }
+}
+
+TEST_CASE("PduCodec.decodesOneFrameOffAStream", "[vtextension]")
+{
+    auto const first = Pdu { Call { .instanceId = 1, .exportOrdinal = 2, .argv = { 3 } } };
+    auto const second = Pdu { MemoryRead { .instanceId = 4, .address = 5, .size = 6 } };
+    auto stream = encodeFrame(first);
+    auto const firstSize = stream.size();
+    auto const tail = encodeFrame(second);
+    stream.insert(stream.end(), tail.begin(), tail.end());
+
+    auto const decoded = decodeFrame(stream, Direction::ToHelper, ChannelKind::Lane, PduLimits {});
+    REQUIRE(decoded.has_value());
+    CHECK(decoded->pdu == first);
+    CHECK(decoded->consumed == firstSize);
+}
+
+TEST_CASE("PduCodec.everyPrefixNeedsMoreData", "[vtextension]")
+{
+    for (auto const& sample: samples())
+    {
+        auto const& row = rowOf(sample);
+        auto const frame = encodeFrame(sample);
+        for (auto const size: std::views::iota(std::size_t { 0 }, frame.size()))
+        {
+            INFO("kind " << static_cast<int>(row.kind) << ", " << size << " of " << frame.size() << " bytes");
+            CHECK(errorOf(std::span { frame }.first(size), row) == DecodeError::NeedMoreData);
+        }
+    }
+}
+
+TEST_CASE("PduCodec.overCapIsRejectedFromTheHeader", "[vtextension]")
+{
+    for (auto const& row: PduTable)
+    {
+        INFO("kind " << static_cast<int>(row.kind));
+        // The length counts the kind's byte, then one body byte more than the cap allows; no body follows.
+        auto header = varint(1 + row.sizeCap(PduLimits {}) + 1);
+        header.push_back(std::to_underlying(row.kind));
+        CHECK(errorOf(header, row) == DecodeError::OverCap);
+
+        auto const atCap = [&] {
+            auto frame = varint(1 + row.sizeCap(PduLimits {}));
+            frame.push_back(std::to_underlying(row.kind));
+            return frame;
+        }();
+        CHECK(errorOf(atCap, row) == DecodeError::NeedMoreData);
+    }
+
+    // A length beyond every kind's cap is refused before the kind arrives.
+    auto const largest = std::ranges::max(
+        PduTable | std::views::transform([](PduRow const& row) { return row.sizeCap(PduLimits {}); }));
+    auto const lengthOnly = varint(largest + MaxVarint32Bytes + 1);
+    CHECK(errorOf(lengthOnly, PduTable.front()) == DecodeError::OverCap);
+
+    // The stream's limits move the caps that follow them.
+    auto const small = PduLimits { .maxModuleBytes = 100, .maxMemoryBytes = 200 };
+    auto const load =
+        encodeFrame(Load { .runtimeId = 1, .moduleId = 2, .bytes = std::vector<std::byte>(101) });
+    auto const& loadRow = PduTable.at(std::to_underlying(PduKind::Load) - 1);
+    CHECK(decodeFrame(load, loadRow.direction, loadRow.channel, small).has_value());
+    auto const tooLarge =
+        encodeFrame(Load { .runtimeId = 1, .moduleId = 2, .bytes = std::vector<std::byte>(200) });
+    CHECK(decodeFrame(tooLarge, loadRow.direction, loadRow.channel, small).error() == DecodeError::OverCap);
+}
+
+TEST_CASE("PduCodec.lyingBodyIsMalformed", "[vtextension]")
+{
+    auto const& helloRow = PduTable.at(std::to_underlying(PduKind::Hello) - 1);
+
+    SECTION("an inner count beyond the body is Truncated")
+    {
+        // Load: runtime 1, module 2, then a hundred bytes claimed and three present.
+        auto const body = std::vector<uint8_t> { 1, 2, 100, 0xaa, 0xbb, 0xcc };
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::Load), body),
+                      PduTable.at(std::to_underlying(PduKind::Load) - 1))
+              == DecodeError::Truncated);
+        // Call: instance 1, export 2, then three values claimed and one present.
+        auto const call = std::vector<uint8_t> { 1, 2, 3, 7 };
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::Call), call),
+                      PduTable.at(std::to_underlying(PduKind::Call) - 1))
+              == DecodeError::Truncated);
+    }
+
+    SECTION("a byte after the last field is TrailingBytes")
+    {
+        auto const body = std::vector<uint8_t> { 1, 0, 2, 0 };
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::Hello), body), helloRow)
+              == DecodeError::TrailingBytes);
+    }
+
+    SECTION("an enumeration byte out of range is BadEnum")
+    {
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::Hello), std::vector<uint8_t> { 1, 2, 2 }), helloRow)
+              == DecodeError::BadEnum);
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::Hello), std::vector<uint8_t> { 1, 0, 3 }), helloRow)
+              == DecodeError::BadEnum);
+        // A status names the error + 1; one past the last error is out of range.
+        auto const lastError = std::to_underlying(ExtensionError::ModuleTooLarge);
+        auto const& createdRow = PduTable.at(std::to_underlying(PduKind::RuntimeCreated) - 1);
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::RuntimeCreated),
+                              std::vector<uint8_t> { 7, static_cast<uint8_t>(lastError + 1) }),
+                      createdRow)
+              == std::nullopt);
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::RuntimeCreated),
+                              std::vector<uint8_t> { 7, static_cast<uint8_t>(lastError + 2) }),
+                      createdRow)
+              == DecodeError::BadEnum);
+    }
+
+    SECTION("a kind naming no PDU is UnknownKind")
+    {
+        CHECK(errorOf(frameOf(0, {}), helloRow) == DecodeError::UnknownKind);
+        CHECK(errorOf(frameOf(16, {}), helloRow) == DecodeError::UnknownKind);
+    }
+
+    SECTION("an over-long varint is MalformedVarint")
+    {
+        // A u32 field may take five bytes, and its fifth only four bits.
+        auto const sixBytes = std::vector<uint8_t> { 0x80, 0x80, 0x80, 0x80, 0x80, 0x00, 0, 0 };
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::Hello), sixBytes), helloRow)
+              == DecodeError::MalformedVarint);
+        auto const beyond32Bits = std::vector<uint8_t> { 0xff, 0xff, 0xff, 0xff, 0x1f, 0, 0 };
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::Hello), beyond32Bits), helloRow)
+              == DecodeError::MalformedVarint);
+        auto const largest = std::vector<uint8_t> { 0xff, 0xff, 0xff, 0xff, 0x0f, 0, 0 };
+        CHECK(errorOf(frameOf(std::to_underlying(PduKind::Hello), largest), helloRow) == std::nullopt);
+    }
+
+    SECTION("more values than a call carries is OverCap")
+    {
+        auto const& callRow = PduTable.at(std::to_underlying(PduKind::Call) - 1);
+        auto const call = encodeFrame(
+            Call { .instanceId = 1, .exportOrdinal = 0, .argv = std::vector<uint32_t>(MaxCallValues + 1) });
+        CHECK(errorOf(call, callRow) == DecodeError::OverCap);
+        auto const atMost = encodeFrame(
+            Call { .instanceId = 1, .exportOrdinal = 0, .argv = std::vector<uint32_t>(MaxCallValues) });
+        CHECK(errorOf(atMost, callRow) == std::nullopt);
+
+        auto const& hostRow = PduTable.at(std::to_underlying(PduKind::CallHost) - 1);
+        auto const host = encodeFrame(
+            CallHost { .functionIndex = 0, .arguments = std::vector<uint32_t>(MaxHostParameters + 1) });
+        CHECK(errorOf(host, hostRow) == DecodeError::OverCap);
+    }
+}
+
+TEST_CASE("PduCodec.directionAndChannelAreChecked", "[vtextension]")
+{
+    auto const call = encodeFrame(Call { .instanceId = 1, .exportOrdinal = 2, .argv = {} });
+    CHECK(decodeFrame(call, Direction::ToParent, ChannelKind::Lane, PduLimits {}).error()
+          == DecodeError::WrongDirection);
+    auto const load = encodeFrame(Load { .runtimeId = 1, .moduleId = 2, .bytes = {} });
+    CHECK(decodeFrame(load, Direction::ToHelper, ChannelKind::Lane, PduLimits {}).error()
+          == DecodeError::WrongChannel);
+}
+
+TEST_CASE("PduCodec.mutatedFramesNeverCrash", "[vtextension]")
+{
+    auto const all = samples();
+    auto const frames =
+        std::ranges::to<std::vector<std::vector<uint8_t>>>(all | std::views::transform(encodeFrame));
+    constexpr auto Seeds = std::array { uint32_t { 0x5eed } };
+    for (auto const seed: Seeds)
+    {
+        INFO("seed " << seed);
+        // std::mt19937's output is fully specified, unlike the distributions', so every standard library
+        // mutates alike.
+        auto random = std::mt19937 { seed };
+        auto const pick = [&random](std::size_t bound) {
+            return static_cast<std::size_t>(random() % bound);
+        };
+        auto decodes = std::size_t { 0 };
+        for (auto const iteration: std::views::iota(0, 10'000))
+        {
+            auto const index = pick(frames.size());
+            auto frame = frames[index];
+            switch (pick(3))
+            {
+                case 0: // Flips up to four bytes to anything.
+                    for ([[maybe_unused]] auto const flip: std::views::iota(std::size_t { 0 }, 1 + pick(4)))
+                        frame[pick(frame.size())] = static_cast<uint8_t>(pick(256));
+                    break;
+                case 1: // Cuts the frame short.
+                    frame.resize(pick(frame.size()));
+                    break;
+                default: // Splices the tail of another frame onto a prefix of this one.
+                {
+                    auto const& other = frames[pick(frames.size())];
+                    frame.resize(pick(frame.size()) + 1);
+                    frame.insert(frame.end(),
+                                 other.begin() + static_cast<std::ptrdiff_t>(pick(other.size())),
+                                 other.end());
+                    break;
+                }
+            }
+            auto const& row = rowOf(all[index]);
+            auto const decoded = decodeFrame(frame, row.direction, row.channel, PduLimits {});
+            if (!decoded)
+                continue;
+            // What decodes is a frame of its own: it encodes again to what decodes alike.
+            ++decodes;
+            INFO("iteration " << iteration);
+            CHECK(decoded->consumed <= frame.size());
+            auto const redecoded =
+                decodeFrame(encodeFrame(decoded->pdu), row.direction, row.channel, PduLimits {});
+            REQUIRE(redecoded.has_value());
+            CHECK(redecoded->pdu == decoded->pdu);
+        }
+        // Byte flips in a field's value leave many frames valid; a run that decoded none tested nothing.
+        CHECK(decodes > 0);
+    }
+}
diff --git a/src/vtextension/wasm/remote/proto/Pdu.hpp b/src/vtextension/wasm/remote/proto/Pdu.hpp
