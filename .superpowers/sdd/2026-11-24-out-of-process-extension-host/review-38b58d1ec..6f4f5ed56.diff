new file mode 100644
index 000000000..3c2bbedda
--- /dev/null
+++ b/src/vtextension/wasm/wamr/TableCaps.cpp
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/wamr/TableCaps.hpp>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <vector>
+
+namespace vtextension::wasm::wamr
+{
+
+namespace
+{
+    /// The limits flag saying that a maximum follows the initial size.
+    constexpr auto HasMaximum = std::byte { 0b0000'0001 };
+
+    /// Appends @p value to @p out as an unsigned LEB128 number, in as few bytes as it takes.
+    void appendU32(std::vector<std::byte>& out, uint32_t value)
+    {
+        constexpr auto PayloadMask = uint32_t { 0b0111'1111 };
+        constexpr auto ContinueBit = uint32_t { 0b1000'0000 };
+        while (value > PayloadMask)
+        {
+            out.push_back(static_cast<std::byte>((value & PayloadMask) | ContinueBit));
+            value >>= 7;
+        }
+        out.push_back(static_cast<std::byte>(value));
+    }
+
+    /// @return Whether @p table may grow past @p maxElements as it is declared, and begins within it.
+    [[nodiscard]] bool needsCap(binary::TableDeclaration const& table, uint32_t maxElements) noexcept
+    {
+        return table.initialElements <= maxElements && (!table.maximum || *table.maximum > maxElements);
+    }
+
+    /// @return The content of a table section declaring @p tables, each capped at @p maxElements.
+    [[nodiscard]] std::vector<std::byte> cappedTableSection(std::span<binary::TableDeclaration const> tables,
+                                                            uint32_t maxElements)
+    {
+        auto content = std::vector<std::byte> {};
+        appendU32(content, static_cast<uint32_t>(tables.size()));
+        for (auto const& table: tables)
+        {
+            auto const maximum = needsCap(table, maxElements) ? std::optional { maxElements } : table.maximum;
+            content.push_back(std::byte { table.elementType });
+            content.push_back(maximum ? HasMaximum : std::byte { 0 });
+            appendU32(content, table.initialElements);
+            if (maximum)
+                appendU32(content, *maximum);
+        }
+        return content;
+    }
+} // namespace
+
+std::expected<std::vector<std::byte>, binary::BinaryError> capTableMaxima(std::vector<std::byte> module,
+                                                                          uint32_t maxElements)
+{
+    auto const all = binary::sections(module);
+    if (!all)
+        return std::unexpected(all.error());
+    if (std::ranges::count(*all, binary::TableSectionId, &binary::Section::id) > 1)
+        return std::unexpected(binary::BinaryError::Malformed);
+    auto const tables = binary::tableDeclarations(module);
+    if (!tables)
+        return std::unexpected(tables.error());
+    if (std::ranges::none_of(*tables, [&](auto const& table) { return needsCap(table, maxElements); }))
+        return module;
+
+    auto result = std::vector<std::byte>(module.begin(), module.begin() + binary::ModuleHeader.size());
+    auto previousEnd = binary::ModuleHeader.size();
+    for (auto const& section: *all)
+    {
+        auto const end = section.offset + section.content.size();
+        if (section.id == binary::TableSectionId)
+        {
+            auto const content = cappedTableSection(*tables, maxElements);
+            result.push_back(std::byte { binary::TableSectionId });
+            appendU32(result, static_cast<uint32_t>(content.size()));
+            result.insert(result.end(), content.begin(), content.end());
+        }
+        else
+            result.insert(result.end(),
+                          module.begin() + static_cast<std::ptrdiff_t>(previousEnd),
+                          module.begin() + static_cast<std::ptrdiff_t>(end));
+        previousEnd = end;
+    }
+    return result;
+}
+
+} // namespace vtextension::wasm::wamr
diff --git a/src/vtextension/wasm/wamr/TableCaps.hpp b/src/vtextension/wasm/wamr/TableCaps.hpp
new file mode 100644
index 000000000..e8bafc0cd
--- /dev/null
+++ b/src/vtextension/wasm/wamr/TableCaps.hpp
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Internal to the WAMR backend: the rewrite of a module's bytes that makes WAMR hold every table to the
+// runtime's cap (RuntimeLimits::tableElements).
+//
+// WAMR has no option for a table cap. It lets a table grow to its declared maximum, but caps one declared
+// without a maximum, or with a larger one, at twice its initial size or MaxTableElements, whichever is
+// larger -- not at a cap of the host's choosing. So before WAMR sees a module, every table it defines is
+// given a declared maximum no larger than the cap, and `table.grow` past the cap returns -1 as it does on
+// every backend. A table whose initial size already exceeds the cap is left as it is: the backend refuses
+// to instantiate it before WAMR could.
+//
+// Pure and dependency-free, so that every framing rule is table-testable.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <vector>
+
+#include <vtextension/wasm/WasmBinary.hpp>
+
+namespace vtextension::wasm::wamr
+{
+
+/// Gives every table @p module defines a declared maximum of at most @p maxElements, keeping a lower one.
+/// Only the table section is rewritten, and only if a table needs it; every other section is copied as it
+/// was.
+/// @param module A WebAssembly core module's bytes.
+/// @param maxElements The cap on each table's elements.
+/// @return The module, rewritten or as it was; why its bytes could not be read (@see
+///         binary::tableDeclarations), `Malformed` also for a second table section.
+[[nodiscard]] std::expected<std::vector<std::byte>, binary::BinaryError> capTableMaxima(
+    std::vector<std::byte> module, uint32_t maxElements);
+
+} // namespace vtextension::wasm::wamr
diff --git a/src/vtextension/wasm/wamr/TableCaps_test.cpp b/src/vtextension/wasm/wamr/TableCaps_test.cpp
new file mode 100644
index 000000000..8b90a0eb7
--- /dev/null
+++ b/src/vtextension/wasm/wamr/TableCaps_test.cpp
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The rewrite that holds WAMR to the runtime's table cap: which tables it caps, what it leaves alone, and the
+// bytes it refuses.
+#include <catch2/catch_message.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <initializer_list>
+#include <ranges>
+#include <string_view>
+#include <vector>
+
+#include <vtextension/wasm/WasmBinary.hpp>
+#include <vtextension/wasm/wamr/TableCaps.hpp>
+
+using vtextension::wasm::binary::BinaryError;
+using vtextension::wasm::wamr::capTableMaxima;
+
+namespace
+{
+
+using Bytes = std::vector<std::byte>;
+
+/// @return @p values as bytes.
+[[nodiscard]] Bytes raw(std::initializer_list<uint8_t> values)
+{
+    return std::ranges::to<Bytes>(
+        values | std::views::transform([](uint8_t value) { return static_cast<std::byte>(value); }));
+}
+
+/// @return The module header followed by @p sections.
+[[nodiscard]] Bytes module(std::initializer_list<uint8_t> sections)
+{
+    auto result = raw({ 0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00 });
+    for (auto const value: sections)
+        result.push_back(static_cast<std::byte>(value));
+    return result;
+}
+
+/// The cap every case is rewritten under: 1024, two bytes as LEB128.
+constexpr auto Cap = uint32_t { 1024 };
+
+} // namespace
+
+TEST_CASE("TableCaps.capTableMaxima", "[vtextension]")
+{
+    struct Case
+    {
+        std::string_view description;
+        Bytes input;
+        std::expected<Bytes, BinaryError> output;
+    };
+    auto const cases = std::vector<Case> {
+        { .description = "no table: unchanged",
+          .input = module({ 0x05, 0x03, 0x01, 0x00, 0x01 }),
+          .output = module({ 0x05, 0x03, 0x01, 0x00, 0x01 }) },
+        { .description = "a maximum within the cap: unchanged",
+          .input = module({ 0x04, 0x05, 0x01, 0x70, 0x01, 0x02, 0x08 }),
+          .output = module({ 0x04, 0x05, 0x01, 0x70, 0x01, 0x02, 0x08 }) },
+        { .description = "no maximum: the cap is declared, and the section grows",
+          .input = module({ 0x04, 0x04, 0x01, 0x70, 0x00, 0x02 }),
+          .output = module({ 0x04, 0x06, 0x01, 0x70, 0x01, 0x02, 0x80, 0x08 }) },
+        { .description = "a maximum above the cap is lowered to it",
+          .input = module({ 0x04, 0x07, 0x01, 0x6f, 0x01, 0x02, 0x80, 0x80, 0x04 }),
+          .output = module({ 0x04, 0x06, 0x01, 0x6f, 0x01, 0x02, 0x80, 0x08 }) },
+        { .description = "an initial size above the cap is left for instantiation to refuse",
+          .input = module({ 0x04, 0x05, 0x01, 0x70, 0x00, 0x81, 0x08 }),
+          .output = module({ 0x04, 0x05, 0x01, 0x70, 0x00, 0x81, 0x08 }) },
+        { .description = "the sections around the table section are copied as they were",
+          .input = module({ 0x01,
+                            0x04,
+                            0x01,
+                            0x60,
+                            0x00,
+                            0x00,
+                            0x04,
+                            0x04,
+                            0x01,
+                            0x70,
+                            0x00,
+                            0x01,
+                            0x05,
+                            0x03,
+                            0x01,
+                            0x00,
+                            0x01 }),
+          .output = module({ 0x01,
+                             0x04,
+                             0x01,
+                             0x60,
+                             0x00,
+                             0x00,
+                             0x04,
+                             0x06,
+                             0x01,
+                             0x70,
+                             0x01,
+                             0x01,
+                             0x80,
+                             0x08,
+                             0x05,
+                             0x03,
+                             0x01,
+                             0x00,
+                             0x01 }) },
+        { .description = "of two tables, only the one that needs it changes",
+          .input = module({ 0x04, 0x08, 0x02, 0x70, 0x01, 0x01, 0x02, 0x70, 0x00, 0x03 }),
+          .output = module({ 0x04, 0x0a, 0x02, 0x70, 0x01, 0x01, 0x02, 0x70, 0x01, 0x03, 0x80, 0x08 }) },
+        { .description = "a second table section",
+          .input = module({ 0x04, 0x04, 0x01, 0x70, 0x00, 0x01, 0x04, 0x04, 0x01, 0x70, 0x00, 0x01 }),
+          .output = std::unexpected(BinaryError::Malformed) },
+        { .description = "a typed reference table",
+          .input = module({ 0x04, 0x05, 0x01, 0x64, 0x70, 0x00, 0x01 }),
+          .output = std::unexpected(BinaryError::Malformed) },
+        { .description = "a 64-bit table",
+          .input = module({ 0x04, 0x04, 0x01, 0x70, 0x04, 0x01 }),
+          .output = std::unexpected(BinaryError::Malformed) },
+        { .description = "a table cut short",
+          .input = module({ 0x04, 0x03, 0x01, 0x70, 0x01 }),
+          .output = std::unexpected(BinaryError::Truncated) },
+        { .description = "no module",
+          .input = raw({ 0x00 }),
+          .output = std::unexpected(BinaryError::NotAModule) },
+    };
+    for (auto const& [description, input, output]: cases)
+    {
+        INFO(description);
+        CHECK(capTableMaxima(input, Cap) == output);
+    }
+}
