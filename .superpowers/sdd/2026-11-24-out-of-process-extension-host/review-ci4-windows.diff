diff --git a/src/vtextension/wasm/remote/process/testing/LoaderProbe.cpp b/src/vtextension/wasm/remote/process/testing/LoaderProbe.cpp
new file mode 100644
index 000000000..4147c0e25
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/testing/LoaderProbe.cpp
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The loader probe (Windows only, test-only, never installed): what a process can load, said on its stderr by
+// one that imports nothing but kernel32 -- its C runtime linked in -- so that it starts wherever a process
+// can start at all, contained or not.
+//
+//   extension_host_loader_probe [LIBRARY]...
+//
+// It writes one line each: `started`; `console=ok`, or `console=error:<code>` with the Win32 error, for
+// whether it may create a console of its own (AllocConsole(), freed again at once); `library=<LIBRARY> ok` or
+// `library=<LIBRARY> error:<code>` for each LIBRARY in the order given (none may hold a double quote), loaded
+// with LoadLibraryExW() and kept loaded, so that a library is tried after those it imports when they come
+// first; then `end`. It exits 0.
+#define WIN32_LEAN_AND_MEAN
+#include <format>
+#include <optional>
+#include <ranges>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <Windows.h>
+
+namespace
+{
+
+/// Writes @p line, UTF-16, to stderr as one UTF-8 line.
+void say(std::wstring_view line)
+{
+    auto text = std::string {};
+    if (!line.empty())
+    {
+        auto const size = ::WideCharToMultiByte(
+            CP_UTF8, 0, line.data(), static_cast<int>(line.size()), nullptr, 0, nullptr, nullptr);
+        text.resize(static_cast<std::size_t>(size));
+        ::WideCharToMultiByte(
+            CP_UTF8, 0, line.data(), static_cast<int>(line.size()), text.data(), size, nullptr, nullptr);
+    }
+    text += '\n';
+    auto written = DWORD { 0 };
+    ::WriteFile(
+        ::GetStdHandle(STD_ERROR_HANDLE), text.data(), static_cast<DWORD>(text.size()), &written, nullptr);
+}
+
+/// @return `ok` for ERROR_SUCCESS, else `error:<code>` with @p error, a Win32 error.
+[[nodiscard]] std::wstring outcomeOf(DWORD error)
+{
+    if (error == ERROR_SUCCESS)
+        return L"ok";
+    return std::format(L"error:{}", error);
+}
+
+/// @return The Win32 error of a call that returned @p result: ERROR_SUCCESS if it is not zero, the thread's
+///         last error if it is.
+template <typename Result>
+[[nodiscard]] DWORD errorOf(Result result)
+{
+    return result ? DWORD { ERROR_SUCCESS } : ::GetLastError();
+}
+
+/// @return The arguments of @p commandLine, the program's name first: split at blanks outside double
+///         quotes, the quotes dropped -- enough for paths, which hold no quote. Parsed here, from the wide
+///         command line, because the entry point is main(), whose argv is in the ANSI code page; and
+///         CommandLineToArgvW() lives in shell32, which this process must not import.
+[[nodiscard]] std::vector<std::wstring> argumentsOf(std::wstring_view commandLine)
+{
+    auto arguments = std::vector<std::wstring> {};
+    auto argument = std::optional<std::wstring> {};
+    auto quoted = false;
+    for (auto const c: commandLine)
+    {
+        if (c == L'"')
+        {
+            quoted = !quoted;
+            if (!argument)
+                argument.emplace();
+        }
+        else if ((c == L' ' || c == L'\t') && !quoted)
+        {
+            if (argument)
+                arguments.push_back(*std::exchange(argument, std::nullopt));
+        }
+        else
+        {
+            if (!argument)
+                argument.emplace();
+            *argument += c;
+        }
+    }
+    if (argument)
+        arguments.push_back(*std::move(argument));
+    return arguments;
+}
+
+} // namespace
+
+int main()
+{
+    say(L"started");
+    auto const consoleError = errorOf(::AllocConsole());
+    say(std::format(L"console={}", outcomeOf(consoleError)));
+    if (consoleError == ERROR_SUCCESS)
+        ::FreeConsole();
+    for (auto const& library: argumentsOf(::GetCommandLineW()) | std::views::drop(1))
+        say(std::format(
+            L"library={} {}", library, outcomeOf(errorOf(::LoadLibraryExW(library.c_str(), nullptr, 0)))));
+    say(L"end");
+    return 0;
+}
diff --git a/src/vtextension/wasm/remote/process/testing/PeImports_win32.cpp b/src/vtextension/wasm/remote/process/testing/PeImports_win32.cpp
new file mode 100644
index 000000000..014e8031b
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/testing/PeImports_win32.cpp
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/process/testing/PeImports_win32.hpp>
+
+#include <catch2/catch_message.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstddef>
+#include <cstring>
+#include <fstream>
+#include <functional>
+#include <ios>
+#include <iterator>
+#include <ranges>
+#include <string_view>
+#include <utility>
+
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+
+namespace vtextension::wasm::remote::process::testing
+{
+
+namespace
+{
+    /// The prefixes of API set names: contracts the loader maps onto libraries, not files.
+    constexpr auto ApiSetPrefixes = std::to_array<std::string_view>({ "api-ms-win-", "ext-ms-win-" });
+
+    /// @return The system directory, as the loader searches it.
+    [[nodiscard]] std::filesystem::path systemDirectory()
+    {
+        auto directory = std::wstring(MAX_PATH, L'\0');
+        auto const length = ::GetSystemDirectoryW(directory.data(), static_cast<UINT>(directory.size()));
+        REQUIRE(length != 0);
+        REQUIRE(length < directory.size());
+        directory.resize(length);
+        return directory;
+    }
+} // namespace
+
+std::vector<std::string> startupImportsOf(std::filesystem::path const& file)
+{
+    auto stream = std::ifstream { file, std::ios::binary };
+    REQUIRE(stream.good());
+    auto const bytes = std::vector<char> { std::istreambuf_iterator<char> { stream }, {} };
+    auto const read = [&]<typename T>(std::size_t offset) {
+        REQUIRE(offset + sizeof(T) <= bytes.size());
+        auto value = T {};
+        std::memcpy(&value, bytes.data() + offset, sizeof(T));
+        return value;
+    };
+    auto const dos = read.operator()<IMAGE_DOS_HEADER>(0);
+    REQUIRE(dos.e_magic == IMAGE_DOS_SIGNATURE);
+    auto const headersAt = static_cast<std::size_t>(dos.e_lfanew);
+    auto const headers = read.operator()<IMAGE_NT_HEADERS64>(headersAt);
+    REQUIRE(headers.Signature == IMAGE_NT_SIGNATURE);
+    REQUIRE(headers.OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC);
+    auto const sectionsAt =
+        headersAt + offsetof(IMAGE_NT_HEADERS64, OptionalHeader) + headers.FileHeader.SizeOfOptionalHeader;
+    // Where in the file the image's address @p rva lies.
+    auto const fileOffsetOf = [&](DWORD rva) -> std::size_t {
+        for (auto const index: std::views::iota(WORD { 0 }, headers.FileHeader.NumberOfSections))
+        {
+            auto const section =
+                read.operator()<IMAGE_SECTION_HEADER>(sectionsAt + (index * sizeof(IMAGE_SECTION_HEADER)));
+            auto const size = std::max<DWORD>(section.Misc.VirtualSize, section.SizeOfRawData);
+            if (rva >= section.VirtualAddress && rva < section.VirtualAddress + size)
+                return rva - section.VirtualAddress + section.PointerToRawData;
+        }
+        FAIL("address 0x" << std::hex << rva << " lies in no section");
+        return 0;
+    };
+    auto const directory = headers.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+    auto imports = std::vector<std::string> {};
+    if (directory.VirtualAddress == 0)
+        return imports;
+    auto const first = fileOffsetOf(directory.VirtualAddress);
+    for (auto const index: std::views::iota(std::size_t { 0 }))
+    {
+        auto const descriptor =
+            read.operator()<IMAGE_IMPORT_DESCRIPTOR>(first + (index * sizeof(IMAGE_IMPORT_DESCRIPTOR)));
+        if (descriptor.Name == 0)
+            break;
+        auto const nameAt = fileOffsetOf(descriptor.Name);
+        auto name =
+            std::string { bytes.data() + nameAt, ::strnlen(bytes.data() + nameAt, bytes.size() - nameAt) };
+        std::ranges::transform(name, name.begin(), [](char c) {
+            return static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        });
+        imports.push_back(std::move(name));
+    }
+    return imports;
+}
+
+ImportClosure importClosureOf(std::filesystem::path const& executable)
+{
+    auto const besideIt = executable.parent_path();
+    auto const system = systemDirectory();
+    auto closure = ImportClosure {};
+    auto seen = std::vector<std::string> {};
+    // Depth first, each library listed after what it imports.
+    auto const visit = [&](this auto const& self, std::filesystem::path const& image) -> void {
+        for (auto const& name: startupImportsOf(image))
+        {
+            if (std::ranges::contains(seen, name))
+                continue;
+            seen.push_back(name);
+            if (std::ranges::any_of(ApiSetPrefixes, [&](auto prefix) { return name.starts_with(prefix); }))
+                continue;
+            auto const candidates = std::array { besideIt / name, system / name };
+            auto const found = std::ranges::find_if(
+                candidates, [](auto const& path) { return std::filesystem::is_regular_file(path); });
+            if (found == candidates.end())
+            {
+                closure.unresolved.push_back(name);
+                continue;
+            }
+            self(*found);
+            closure.libraries.push_back(*found);
+        }
+    };
+    visit(executable);
+    return closure;
+}
+
+} // namespace vtextension::wasm::remote::process::testing
diff --git a/src/vtextension/wasm/remote/process/testing/PeImports_win32.hpp b/src/vtextension/wasm/remote/process/testing/PeImports_win32.hpp
new file mode 100644
