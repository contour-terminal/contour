+
+#include <memory>
+
+#include <vtextension/wasm/BackendConfig.hpp>
+#include <vtextension/wasm/DefaultBackend.hpp>
+#include <vtextension/wasm/WasmRuntime.hpp>
+#include <vtextension/wasm/testing/BackendContract.hpp>
+
+namespace
+{
+
