diff --git a/src/vtextension/wasm/remote/LaneWatch.cpp b/src/vtextension/wasm/remote/LaneWatch.cpp
new file mode 100644
index 000000000..b326c5baf
--- /dev/null
+++ b/src/vtextension/wasm/remote/LaneWatch.cpp
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Every access is sequentially consistent, which the parent's interrupt relies on: a call records its frame
+// (enter(), the depth store last) and then reads its instance's interrupt flag, while interrupt() sets that
+// flag and then reads the depth -- so that either the call sees the flag and does not start, or the interrupt
+// sees the frame and arms it. The frames are rare and the cost is a few stores per call, beside a round trip
+// to another process.
+#include <vtextension/wasm/remote/LaneWatch.hpp>
+
+#include <core/Assert.hpp>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace vtextension::wasm::remote
+{
+
+void LaneWatch::enter(uint32_t instanceId) noexcept
+{
+    auto const depth = _depth.load();
+    if (depth < LaneFrameCapacity)
+    {
+        auto& frame = _frames[depth];
+        frame.instanceId.store(instanceId);
+        frame.state.store(FrameState::Running);
+        // Last: an arming of the frame that was here before carries that frame's serial, never this one.
+        frame.serial.store(_nextSerial.fetch_add(1));
+    }
+    _depth.store(depth + 1);
+}
+
+void LaneWatch::leave() noexcept
+{
+    auto const depth = _depth.load();
+    Require(depth > 0);
+    // The frame is gone once the depth says so: its arming, if any, goes with it, since a frame entered here
+    // next has a serial of its own.
+    _depth.store(depth - 1);
+}
+
+void LaneWatch::beginHostCall() noexcept
+{
+    if (auto const depth = _depth.load(); depth > 0 && depth <= LaneFrameCapacity)
+        _frames[depth - 1].state.store(FrameState::ServingHost);
+}
+
+void LaneWatch::endHostCall() noexcept
+{
+    if (auto const depth = _depth.load(); depth > 0 && depth <= LaneFrameCapacity)
+        _frames[depth - 1].state.store(FrameState::Running);
+}
+
+bool LaneWatch::interrupt(uint32_t instanceId) noexcept
+{
+    auto const depth = std::min(_depth.load(), LaneFrameCapacity);
+    for (auto& frame: std::span { _frames }.first(depth))
+    {
+        if (frame.instanceId.load() != instanceId)
+            continue;
+        // Should the frame have been left and another entered in its place meanwhile, this arms a serial no
+        // frame has any more: an arming that the supervisor never sees.
+        frame.armedSerial.store(frame.serial.load());
+        return true;
+    }
+    return false;
+}
+
+LaneObservation LaneWatch::observe() const noexcept
+{
+    auto const depth = _depth.load();
+    if (depth == 0)
+        return LaneObservation {};
+    auto observation =
+        LaneObservation { .epoch = 0, .arming = LaneArming::Disarmed, .place = LanePlace::InHelper };
+    auto const recorded = std::span { _frames }.first(std::min(depth, LaneFrameCapacity));
+    for (auto const& frame: recorded)
+    {
+        auto const serial = frame.serial.load();
+        if (serial != 0 && frame.armedSerial.load() == serial)
+        {
+            observation.epoch = serial;
+            observation.arming = LaneArming::Armed;
+            break;
+        }
+    }
+    // A frame deeper than the record runs in the host, as far as the backstop knows: its grace runs.
+    if (depth <= LaneFrameCapacity && recorded.back().state.load() == FrameState::ServingHost)
+        observation.place = LanePlace::ServingHost;
+    return observation;
+}
+
+LaneWatch& LaneWatchSet::lane(std::size_t index) noexcept
+{
+    Require(index < _lanes.size());
+    return _lanes[index];
+}
+
+bool LaneWatchSet::interrupt(uint32_t instanceId) noexcept
+{
+    auto found = false;
+    for (auto& lane: _lanes)
+        found = lane.interrupt(instanceId) || found;
+    return found;
+}
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/LaneWatch.hpp b/src/vtextension/wasm/remote/LaneWatch.hpp
new file mode 100644
index 000000000..369fe4c3e
--- /dev/null
+++ b/src/vtextension/wasm/remote/LaneWatch.hpp
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// What the supervisor's backstop sees of an extension host's lanes: which of the parent's frames run on
+/// each, which of them an interrupt armed, and whether the innermost one waits on the parent's host call.
+///
+/// A lane's thread records its frames as it runs them; any thread arms one by interrupting its instance; the
+/// supervisor observes, and gives a host whose armed frame does not end within the grace a kill. Everything
+/// here is atomics, and nothing waits: interrupt() runs on the watchdog, which must never be stalled.
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/remote/transport/HelperArguments.hpp>
+
+namespace vtextension::wasm::remote
+{
+
+/// How many frames of a lane are recorded: as many guest calls as nest (MaxCallDepth), and a memory read the
+/// innermost one's host call makes. Deeper frames are only counted, and cannot be armed.
+inline constexpr std::size_t LaneFrameCapacity = proto::MaxCallDepth + 1;
+
+/// Whether an interrupt armed a frame on the lane.
+enum class LaneArming : uint8_t
+{
+    Disarmed, ///< No frame on the lane was interrupted.
+    Armed,    ///< A frame on the lane was interrupted, and has not ended.
+};
+
+/// Who the lane waits on.
+enum class LanePlace : uint8_t
+{
+    Idle,        ///< No frame runs on it.
+    InHelper,    ///< Its innermost frame waits on the host: the host's time.
+    ServingHost, ///< Its innermost frame runs a host call in the parent: the parent's time.
+};
+
+/// One look at a lane.
+struct LaneObservation
+{
+    /// Names the arming in force: it changes whenever another frame is armed, or the armed one ends. 0 while
+    /// disarmed.
+    uint64_t epoch = 0;
+    LaneArming arming = LaneArming::Disarmed; ///< Whether a frame on it is armed.
+    LanePlace place = LanePlace::Idle;        ///< Who it waits on.
+};
+
+/// One lane's frames as its thread runs them, for the backstop. Atomics only: the lane's thread records,
+/// any thread interrupts, the supervisor observes, and none of them waits on another.
+///
+/// Every frame is given a serial unique on the lane; an interrupt arms a frame by storing its serial beside
+/// it, so that an arming outlives neither the frame nor a frame entered later in its place.
+class LaneWatch
+{
+  public:
+    LaneWatch() noexcept = default;
+    LaneWatch(LaneWatch const&) = delete;
+    LaneWatch(LaneWatch&&) = delete;
+    LaneWatch& operator=(LaneWatch const&) = delete;
+    LaneWatch& operator=(LaneWatch&&) = delete;
+    ~LaneWatch() = default;
+
+    /// The lane's thread: a call into, or a memory read of, instance @p instanceId begins.
+    /// @param instanceId The instance's id.
+    void enter(uint32_t instanceId) noexcept;
+
+    /// The lane's thread: the innermost frame ends, disarming it if it was armed.
+    void leave() noexcept;
+
+    /// The lane's thread: the innermost frame runs a host call, in the parent.
+    void beginHostCall() noexcept;
+
+    /// The lane's thread: the innermost frame's host call returned.
+    void endHostCall() noexcept;
+
+    /// Any thread, wait-free: arms the outermost frame of @p instanceId on the lane, if there is one; a frame
+    /// armed already stays armed as it was.
+    /// @param instanceId The instance interrupted.
+    /// @return Whether a frame of it was on the lane.
+    [[nodiscard]] bool interrupt(uint32_t instanceId) noexcept;
+
+    /// The supervisor: what the lane does now. Wait-free; a frame that enters or leaves meanwhile may or may
+    /// not be seen, as the next look will.
+    [[nodiscard]] LaneObservation observe() const noexcept;
+
+  private:
+    /// Whether a frame runs on the lane's thread or waits on the parent.
+    enum class FrameState : uint8_t
+    {
+        Running,     ///< It waits on the host.
+        ServingHost, ///< It runs a host call.
+    };
+
+    /// One recorded frame.
+    struct Frame
+    {
+        std::atomic<uint64_t> serial { 0 };      ///< Its serial; 0 until a frame was entered here.
+        std::atomic<uint64_t> armedSerial { 0 }; ///< The serial an interrupt armed; armed iff it is `serial`.
+        std::atomic<uint32_t> instanceId { 0 };  ///< The instance it runs.
+        std::atomic<FrameState> state { FrameState::Running };
+    };
+
+    std::array<Frame, LaneFrameCapacity> _frames {};
+    std::atomic<std::size_t> _depth { 0 };   ///< How many frames run, recorded or not.
+    std::atomic<uint64_t> _nextSerial { 1 }; ///< The next frame's serial; the lane's thread's.
+};
+
+/// The lanes of one host, MaxLaneChannels of them.
+class LaneWatchSet
+{
+  public:
+    /// @param index The lane's index, below MaxLaneChannels.
+    /// @return The lane.
+    [[nodiscard]] LaneWatch& lane(std::size_t index) noexcept;
+
+    /// Any thread, wait-free: arms the frames of @p instanceId on every lane (LaneWatch::interrupt()).
+    /// @param instanceId The instance interrupted.
+    /// @return Whether any lane runs a frame of it.
+    [[nodiscard]] bool interrupt(uint32_t instanceId) noexcept;
+
+    /// @return Every lane, in index order.
+    [[nodiscard]] std::span<LaneWatch const> lanes() const noexcept { return _lanes; }
+
+  private:
+    std::array<LaneWatch, MaxLaneChannels> _lanes {};
+};
+
+} // namespace vtextension::wasm::remote
diff --git a/src/vtextension/wasm/remote/LaneWatch_test.cpp b/src/vtextension/wasm/remote/LaneWatch_test.cpp
new file mode 100644
index 000000000..74d44cbcc
--- /dev/null
+++ b/src/vtextension/wasm/remote/LaneWatch_test.cpp
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// What the supervisor's backstop sees of each lane: which frames run there, which of them an interrupt armed,
+// and whether the innermost one waits on the parent.
+#include <catch2/catch_test_macros.hpp>
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <ranges>
+#include <thread>
+
+#include <vtextension/wasm/remote/LaneWatch.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+
+using vtextension::wasm::remote::LaneArming;
+using vtextension::wasm::remote::LaneObservation;
+using vtextension::wasm::remote::LanePlace;
+using vtextension::wasm::remote::LaneWatch;
+using vtextension::wasm::remote::LaneWatchSet;
+using vtextension::wasm::remote::MaxLaneChannels;
+
+namespace proto = vtextension::wasm::remote::proto;
+
+TEST_CASE("LaneWatch.interruptArmsOnlyAFrameOnTheLane", "[vtextension]")
+{
+    auto watch = LaneWatch {};
+    CHECK(watch.observe().place == LanePlace::Idle);
+    CHECK_FALSE(watch.interrupt(7)); // nothing runs
+
+    watch.enter(7);
+    CHECK_FALSE(watch.interrupt(8));
+    CHECK(watch.observe().arming == LaneArming::Disarmed);
+    CHECK(watch.observe().place == LanePlace::InHelper);
+
+    CHECK(watch.interrupt(7));
+    auto const armed = watch.observe();
+    CHECK(armed.arming == LaneArming::Armed);
+    CHECK(armed.place == LanePlace::InHelper);
+
+    // Interrupted again, the same frame stays armed: the backstop's grace runs on.
+    CHECK(watch.interrupt(7));
+    CHECK(watch.observe().epoch == armed.epoch);
+}
+
+TEST_CASE("LaneWatch.leavingTheInterruptedFrameDisarms", "[vtextension]")
+{
+    auto watch = LaneWatch {};
+    watch.enter(7);
+    watch.enter(9);
+    CHECK(watch.interrupt(9));
+    auto const armed = watch.observe();
+    CHECK(armed.arming == LaneArming::Armed);
+
+    watch.leave();
+    auto const left = watch.observe();
+    CHECK(left.arming == LaneArming::Disarmed);
+    CHECK(left.epoch != armed.epoch);
+    CHECK(left.place == LanePlace::InHelper);
+
+    CHECK(watch.interrupt(7));
+    auto const again = watch.observe();
+    CHECK(again.arming == LaneArming::Armed);
+    CHECK(again.epoch != armed.epoch);
+    CHECK(again.epoch != left.epoch);
+
+    watch.leave();
+    CHECK(watch.observe().arming == LaneArming::Disarmed);
+    CHECK(watch.observe().place == LanePlace::Idle);
+}
+
+TEST_CASE("LaneWatch.frameEnteredAfterItsInstanceLeftIsNotArmed", "[vtextension]")
+{
+    // An interrupt arms the frame it found, not a later one of the same instance.
+    auto watch = LaneWatch {};
+    watch.enter(7);
+    CHECK(watch.interrupt(7));
+    watch.leave();
+    watch.enter(7);
+    CHECK(watch.observe().arming == LaneArming::Disarmed);
+}
+
+TEST_CASE("LaneWatch.hostCallParksTheInnermostFrame", "[vtextension]")
+{
+    auto watch = LaneWatch {};
+    watch.enter(7);
+    watch.beginHostCall();
+    CHECK(watch.observe().place == LanePlace::ServingHost);
+
+    // The parent calls back in: the helper runs again.
+    watch.enter(9);
+    CHECK(watch.observe().place == LanePlace::InHelper);
+    watch.leave();
+    CHECK(watch.observe().place == LanePlace::ServingHost);
+
+    watch.endHostCall();
+    CHECK(watch.observe().place == LanePlace::InHelper);
+    watch.leave();
+    CHECK(watch.observe().place == LanePlace::Idle);
+}
+
+TEST_CASE("LaneWatch.deepNestingIsBalanced", "[vtextension]")
+{
+    constexpr auto Depth = uint32_t { 20 };
+    static_assert(Depth > proto::MaxCallDepth + 1);
+    auto watch = LaneWatch {};
+    for (auto const id: std::views::iota(uint32_t { 1 }, Depth + 1))
+        watch.enter(id);
+    CHECK(watch.observe().place == LanePlace::InHelper);
+
+    // Recorded up to MaxCallDepth + 1 frames; the deeper ones are counted only, and cannot be armed.
+    CHECK(watch.interrupt(proto::MaxCallDepth + 1));
+    CHECK_FALSE(watch.interrupt(Depth));
+
+    for ([[maybe_unused]] auto const index: std::views::iota(uint32_t { 0 }, Depth))
+        watch.leave();
+    auto const idle = watch.observe();
+    CHECK(idle.place == LanePlace::Idle);
+    CHECK(idle.arming == LaneArming::Disarmed);
+}
+
+TEST_CASE("LaneWatchSet.interruptsTheLaneTheInstanceRunsOn", "[vtextension]")
+{
+    auto set = LaneWatchSet {};
+    CHECK(set.lanes().size() == MaxLaneChannels);
+    set.lane(2).enter(5);
+    CHECK_FALSE(set.interrupt(6));
+    CHECK(set.interrupt(5));
+    for (auto const index: std::views::iota(std::size_t { 0 }, MaxLaneChannels))
+        CHECK((set.lanes()[index].observe().arming == LaneArming::Armed) == (index == 2));
+}
+
+TEST_CASE("LaneWatchSet.interruptRacesFrames", "[vtextension][threading]")
+{
+    constexpr auto Rounds = 100'000;
+    auto set = LaneWatchSet {};
+    auto running = std::atomic<bool> { true };
+    auto lane = std::jthread { [&] {
+        for ([[maybe_unused]] auto const round: std::views::iota(0, Rounds))
+        {
+            set.lane(0).enter(7);
+            set.lane(0).beginHostCall();
+            set.lane(0).enter(9);
+            set.lane(0).leave();
+            set.lane(0).endHostCall();
+            set.lane(0).leave();
+        }
+        running.store(false);
+    } };
+    auto observations = std::size_t { 0 };
+    while (running.load())
+    {
+        std::ignore = set.interrupt(7);
+        std::ignore = set.interrupt(9);
+        std::ignore = set.lanes()[0].observe();
+        ++observations;
+    }
+    lane.join();
+    auto const ended = set.lanes()[0].observe();
+    CHECK(ended.arming == LaneArming::Disarmed);
+    CHECK(ended.place == LanePlace::Idle);
+    CHECK(observations > 0);
+}
