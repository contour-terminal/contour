+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/process/testing/HelperComposition.hpp>
+
+#include <core/Clock.hpp>
+#include <core/Environment.hpp>
+
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
