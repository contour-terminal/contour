+++ b/src/vtextension/wasm/wasmtime/WasmtimeBackend.hpp
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The Wasmtime backend of the WebAssembly runtime interface: extensions compiled to native code by
+// Cranelift, one engine per runtime, configured from the one feature table (../EngineFeatures.hpp).
+#pragma once
+
+#include <cstdint>
+#include <memory>
+
+#include <vtextension/wasm/WasmRuntime.hpp>
+
+namespace vtextension::wasm::wasmtime
+{
+
+/// How compiled guest code detects an out-of-bounds access or a stack overflow.
+enum class TrapMode : uint8_t
+{
+    Software, ///< Explicit bounds and stack checks in the compiled code; no signal handler is installed.
+    Signals,  ///< Guard pages and a process signal handler, as Wasmtime does by default.
+};
+
+/// How every Wasmtime backend of a process is set up.
+struct WasmtimeConfig
+{
+    /// How traps are detected. Software keeps the contract's promise of no process signal handler.
+    TrapMode trapMode = TrapMode::Software;
+};
+
+/// What all Wasmtime backends of a process share: the bring-up generation and the count of runtimes
+/// alive. Created once by the composition root and handed to every backend it makes, so that they
+/// behave as one (@see IWasmBackend).
+class KindState;
+
+/// Creates the state Wasmtime backends of one process share.
+/// @return The state, with no runtime alive and generation 0.
+[[nodiscard]] std::shared_ptr<KindState> makeKindState();
+
+/// Creates a Wasmtime backend.
+/// @param kind The state every Wasmtime backend of the process shares.
+/// @param config How the backend sets up each engine it creates.
+/// @return The backend. Refused memory growth is not reported (MemoryGrowthReporting::Unreported).
+[[nodiscard]] std::unique_ptr<IWasmBackend> makeWasmtimeBackend(std::shared_ptr<KindState> kind,
+                                                                WasmtimeConfig config);
+
+} // namespace vtextension::wasm::wasmtime
diff --git a/src/vtextension/wasm/wasmtime/WasmtimeBackend_test.cpp b/src/vtextension/wasm/wasmtime/WasmtimeBackend_test.cpp
new file mode 100644
index 000000000..7ba35d332
--- /dev/null
+++ b/src/vtextension/wasm/wasmtime/WasmtimeBackend_test.cpp
@@ -0,0 +1,90 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The Wasmtime backend: the backend contract every runtime must meet, and what is Wasmtime's alone,
+// the features it enables unless told otherwise, checked with its C API directly.
+#include <catch2/catch_message.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <span>
+
+#include <wasmtime.h>
+
+#include <vtextension/ExtensionError.hpp>
+#include <vtextension/wasm/EngineFeatures.hpp>
+#include <vtextension/wasm/testing/BackendContract.hpp>
+#include <vtextension/wasm/testing/FeatureModules.hpp>
+#include <vtextension/wasm/wasmtime/WasmtimeBackend.hpp>
+#include <vtextension/wasm/wasmtime/WasmtimeHandles.hpp>
+
+using vtextension::ExtensionError;
+using vtextension::wasm::FeatureState;
+using vtextension::wasm::IWasmBackend;
+using vtextension::wasm::MemoryGrowthReporting;
+using vtextension::wasm::wasmtime::makeKindState;
+using vtextension::wasm::wasmtime::makeWasmtimeBackend;
+using vtextension::wasm::wasmtime::TrapMode;
+using vtextension::wasm::wasmtime::WasmtimeConfig;
+
+namespace
+{
+
+/// Makes the backend under test, for the contract suite.
+struct WasmtimeTraits
+{
+    /// @return A Wasmtime backend of the one kind state this test binary shares, as a process would.
+    [[nodiscard]] static std::unique_ptr<IWasmBackend> make()
+    {
+        static auto const kind = makeKindState();
+        return makeWasmtimeBackend(kind, WasmtimeConfig { .trapMode = TrapMode::Software });
+    }
+};
+
+/// @return Whether an engine left at Wasmtime's defaults compiles @p bytes.
+[[nodiscard]] bool defaultEngineAccepts(std::span<std::uint8_t const> bytes)
+{
+    namespace detail = vtextension::wasm::wasmtime::detail;
+    auto const engine = detail::EngineHandle { wasm_engine_new() };
+    REQUIRE(engine);
+    auto* module = static_cast<wasmtime_module_t*>(nullptr);
+    auto const error =
+        detail::ErrorHandle { wasmtime_module_new(engine.get(), bytes.data(), bytes.size(), &module) };
+    auto const owned = detail::ModuleHandle { module };
+    return !error;
+}
+
+} // namespace
+
+CONTOUR_WASM_BACKEND_CONTRACT(WasmtimeTraits)
+
+TEST_CASE("WasmtimeBackend.refusesWhatWasmtimeEnablesByDefault", "[wasmtime]")
+{
+    // A feature Wasmtime enables unless told otherwise is refused only because the backend switched it
+    // off. Each such module is checked against both: a default engine accepts it, the backend refuses it.
+    auto const backend = WasmtimeTraits::make();
+    auto const runtime = vtextension::wasm::testing::contract::createRuntime(*backend);
+    auto enabledByDefault = std::size_t { 0 };
+    for (auto const& [feature, bytes]: vtextension::wasm::testing::FeatureModules)
+    {
+        auto const& row = vtextension::wasm::featureRow(feature);
+        if (row.state != FeatureState::Off || !defaultEngineAccepts(bytes))
+            continue;
+        ++enabledByDefault;
+        INFO("feature: " << row.name);
+        auto const module = std::as_bytes(bytes);
+        auto const loaded = runtime->load({ module.begin(), module.end() });
+        REQUIRE_FALSE(loaded.has_value());
+        CHECK(loaded.error() == ExtensionError::InvalidComponent);
+    }
+    // Wasmtime 48 enables GC, exceptions, 64-bit memories, typed function references, threads, tail
+    // calls, multiple memories, SIMD and relaxed SIMD by default; were none of them, this case checked
+    // nothing.
+    CHECK(enabledByDefault >= 9);
+}
+
+TEST_CASE("WasmtimeBackend.leavesMemoryGrowthUnreported", "[wasmtime]")
+{
+    CHECK(WasmtimeTraits::make()->capabilities().memoryGrowth == MemoryGrowthReporting::Unreported);
+}
diff --git a/src/vtextension/wasm/wasmtime/WasmtimeHandles.hpp b/src/vtextension/wasm/wasmtime/WasmtimeHandles.hpp
new file mode 100644
index 000000000..f53b2c08d
--- /dev/null
+++ b/src/vtextension/wasm/wasmtime/WasmtimeHandles.hpp
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Owning handles on Wasmtime's opaque objects, so that headers need not pull wasmtime.h in.
+#pragma once
+
+#include <memory>
+
+struct wasm_engine_t;
+struct wasm_functype_t;
+struct wasm_trap_t;
+struct wasmtime_error;
+struct wasmtime_linker;
+struct wasmtime_module;
+struct wasmtime_store;
+
+namespace vtextension::wasm::wasmtime::detail
+{
+
+/// Deletes an engine.
+struct EngineDeleter
+{
+    /// Deletes @p engine.
+    void operator()(wasm_engine_t* engine) const noexcept;
+};
+
+/// Deletes a store, and every instance in it.
+struct StoreDeleter
+{
+    /// Deletes @p store.
+    void operator()(wasmtime_store* store) const noexcept;
+};
+
+/// Deletes a compiled module.
+struct ModuleDeleter
+{
+    /// Deletes @p module.
+    void operator()(wasmtime_module* module) const noexcept;
+};
+
+/// Deletes a linker.
+struct LinkerDeleter
+{
+    /// Deletes @p linker.
+    void operator()(wasmtime_linker* linker) const noexcept;
+};
+
+/// Deletes an error.
+struct ErrorDeleter
+{
+    /// Deletes @p error.
+    void operator()(wasmtime_error* error) const noexcept;
+};
+
+/// Deletes a trap.
+struct TrapDeleter
+{
+    /// Deletes @p trap.
+    void operator()(wasm_trap_t* trap) const noexcept;
+};
+
+/// Deletes a function type.
+struct FuncTypeDeleter
+{
+    /// Deletes @p type.
+    void operator()(wasm_functype_t* type) const noexcept;
+};
+
+/// An engine: the compiler and its configuration.
+using EngineHandle = std::unique_ptr<wasm_engine_t, EngineDeleter>;
+
+/// A store: what instances live in.
+using StoreHandle = std::unique_ptr<wasmtime_store, StoreDeleter>;
+
+/// A compiled module.
+using ModuleHandle = std::unique_ptr<wasmtime_module, ModuleDeleter>;
+
+/// A linker: the host functions modules are instantiated against.
+using LinkerHandle = std::unique_ptr<wasmtime_linker, LinkerDeleter>;
+
+/// An error a Wasmtime call returned; null for none.
+using ErrorHandle = std::unique_ptr<wasmtime_error, ErrorDeleter>;
+
+/// A trap.
+using TrapHandle = std::unique_ptr<wasm_trap_t, TrapDeleter>;
+
+/// A function type.
+using FuncTypeHandle = std::unique_ptr<wasm_functype_t, FuncTypeDeleter>;
+
+} // namespace vtextension::wasm::wasmtime::detail
