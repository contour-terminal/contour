@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/host/DescriptorRights.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <ranges>
+#include <span>
+#include <utility>
+
+namespace vtextension::wasm::host
+{
+
+namespace
+{
+    using enum DescriptorRight;
+
+    // Each role's rights. F_GETFL is everyone's: it reads, and a stream's flags are what C's stdio and WAMR
+    // ask of any descriptor they are handed.
+    constexpr auto ControlRights =
+        std::array { Read, Write, Receive, Send, Event, Shutdown, Fstat, GetStatusFlags };
+    constexpr auto LaneRights = std::array { Read, Write, Receive, Send, Event, Shutdown, GetStatusFlags };
+    constexpr auto PageRights = std::array { MapRead, Fstat, GetStatusFlags };
+    constexpr auto WakeRights = std::array { Read, Event, GetStatusFlags };
+    constexpr auto StandardErrorRights = std::array { Write, Fstat, GetStatusFlags };
+    // WAMR's WASI stats the device and reads its flags as it instantiates a module; a guest writes to it,
+    // seeks it (fd_seek) and reads its flags (fd_fdstat_get), each of which the backend contract asserts.
+    constexpr auto EngineDeviceRights = std::array { Write, Fstat, Seek, GetStatusFlags };
+
+    /// Every role, at its enumerator's index.
+    constexpr auto RoleRightsTable = std::array {
+        DescriptorRoleRights { .role = DescriptorRole::Control, .rights = ControlRights },
+        DescriptorRoleRights { .role = DescriptorRole::Lane, .rights = LaneRights },
+        DescriptorRoleRights { .role = DescriptorRole::Page, .rights = PageRights },
+        DescriptorRoleRights { .role = DescriptorRole::Wake, .rights = WakeRights },
+        DescriptorRoleRights { .role = DescriptorRole::StandardError, .rights = StandardErrorRights },
+        DescriptorRoleRights { .role = DescriptorRole::EngineDevice, .rights = EngineDeviceRights },
+    };
+
+    static_assert(std::ranges::all_of(std::views::iota(std::size_t { 0 }, RoleRightsTable.size()),
+                                      [](std::size_t index) {
+                                          return std::to_underlying(RoleRightsTable[index].role) == index;
+                                      }),
+                  "RoleRightsTable lists every DescriptorRole at its own index");
+    static_assert(RoleRightsTable.back().role == DescriptorRole::EngineDevice,
+                  "RoleRightsTable ends at the last DescriptorRole");
+} // namespace
+
+std::span<DescriptorRoleRights const> descriptorRoleRights() noexcept
+{
+    return RoleRightsTable;
+}
+
+std::span<DescriptorRight const> rightsOf(DescriptorRole role) noexcept
+{
+    return RoleRightsTable[std::to_underlying(role)].rights;
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/DescriptorRights.hpp b/src/vtextension/wasm/host/DescriptorRights.hpp
new file mode 100644
index 000000000..8c9b49211
--- /dev/null
+++ b/src/vtextension/wasm/host/DescriptorRights.hpp
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// What each descriptor the extension host keeps is used for once it is locked down, and so what a sandbox
+/// that limits descriptor by descriptor (FreeBSD's Capsicum) leaves it. Named in the system's neutral words,
+/// so that the table is the same everywhere and is tested everywhere; each such sandbox maps a right to its
+/// own.
+
+#include <cstdint>
+#include <span>
+
+namespace vtextension::wasm::host
+{
+
+/// What a descriptor the host keeps is for.
+enum class DescriptorRole : uint8_t
+{
+    Control,       ///< The control channel: requests in, replies and granted handles over it.
+    Lane,          ///< A lane channel, which carries the calls of one executor.
+    Page,          ///< The interrupt page, mapped read-only before the lockdown.
+    Wake,          ///< The wake signal's receiving end, which the interrupt listener waits on.
+    StandardError, ///< Standard error, which the host tells why it fails on.
+    EngineDevice,  ///< A device the engine opened before the lockdown: WAMR's null device, its guests' stdio.
+};
+
+/// One thing a descriptor may be used for. There is deliberately none for an ioctl: no descriptor needs one.
+enum class DescriptorRight : uint8_t
+{
+    Read,           ///< read(2) and its kin.
+    Write,          ///< write(2), writev(2) and their kin.
+    Receive,        ///< recv(2), recvmsg(2): taking in what a socket carries, descriptors included.
+    Send,           ///< send(2), sendmsg(2).
+    Event,          ///< Waiting on it: poll(2), kevent(2).
+    Shutdown,       ///< shutdown(2).
+    Fstat,          ///< fstat(2): what C's stdio and WAMR's WASI ask of a stream.
+    MapRead,        ///< Mapping it read-only, mmap(2).
+    Seek,           ///< lseek(2): a guest's fd_seek on its null device.
+    GetStatusFlags, ///< fcntl(2) F_GETFL and no other fcntl that needs a right: a guest's fd_fdstat_get.
+};
+
+/// The rights of one role.
+struct DescriptorRoleRights
+{
+    DescriptorRole role;                     ///< The role.
+    std::span<DescriptorRight const> rights; ///< What a descriptor of it may be used for; never empty.
+};
+
+/// @return Every DescriptorRole's rights, one row each, at its enumerator's index.
+[[nodiscard]] std::span<DescriptorRoleRights const> descriptorRoleRights() noexcept;
+
+/// @param role A role.
+/// @return What a descriptor of @p role may be used for.
+[[nodiscard]] std::span<DescriptorRight const> rightsOf(DescriptorRole role) noexcept;
+
+} // namespace vtextension::wasm::host
