+    // The host locks down right after starting its threads: none may still be starting by then. start()
+    // returns once the thread has entered the function that runs the body -- the C library's start-up done --
+    // which may be just before the body's first statement: so the body is waited for, not raced. It is still
+    // waited for with a bound, as a thread start() returned for that never runs is a failure, not a hang.
+    auto entered = std::latch { 1 };
     auto release = std::latch { 1 };
     auto thread = ExecutorThread::start(std::size_t { 1024 } * 1024, [&] {
-        ++entered;
+        entered.count_down();
         release.wait();
     });
     REQUIRE(thread.has_value());
-    CHECK(entered.load() == 1);
+    auto const deadline = std::chrono::steady_clock::now() + std::chrono::seconds { 10 };
+    while (!entered.try_wait() && std::chrono::steady_clock::now() < deadline)
+        std::this_thread::yield();
+    CHECK(entered.try_wait());
     release.count_down();
 }
 
