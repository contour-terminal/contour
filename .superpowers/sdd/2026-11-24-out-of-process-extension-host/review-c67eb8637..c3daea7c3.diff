+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/ExtensionHostSupervisor.hpp b/src/vtextension/wasm/remote/process/ExtensionHostSupervisor.hpp
new file mode 100644
index 000000000..87cf0d4e8
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/ExtensionHostSupervisor.hpp
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The one thread per hosting process that owns every extension host process: it launches them, watches
+/// for their end, reaps them, kills them, and keeps their timers.
+///
+/// Who wants a helper reaches the supervisor through its mailbox, which every connector and handle shares and
+/// none of them owns: the last of them can never be dropped on the supervisor's own thread and have to join
+/// it. A launch runs on the supervisor's thread and blocks its caller until it did; everything else is
+/// posted and returns at once. Each helper is held by a SupervisedHelper, whose destruction lets it go.
+
+#include <core/Clock.hpp>
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <thread>
+#include <vector>
+
+#include <vtextension/wasm/remote/HostConnector.hpp>
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+namespace vtextension::wasm::remote::process
+{
+
+/// How long a stopping supervisor waits for the helpers it killed to be reaped.
+inline constexpr auto ShutdownReapBudget = std::chrono::milliseconds { 100 };
+
+/// How a supervisor is set up.
+struct SupervisorConfig
+{
+    std::shared_ptr<IProcessLauncher> launcher; ///< What starts and waits for the helpers.
+    core::IClock* clock = nullptr;              ///< Non-null; outlives the supervisor.
+    /// How long a helper that was let go may take to exit on its own once its channels closed, before it is
+    /// killed: 0 kills at once. Test compositions wait, so that coverage and sanitizer reports get written.
+    std::chrono::milliseconds teardownGrace { 0 };
+};
+
+/// Why a supervisor could not start.
+enum class SupervisorError : uint8_t
+{
+    WaitSetUnavailable, ///< The launcher made no set to wait for its processes with.
+    ThreadUnavailable,  ///< No thread could be started.
+};
+
+/// Why the supervisor killed a helper; indexes SupervisorCounters::kills.
+enum class KillReason : uint8_t
+{
+    Requested,   ///< Its holder asked (SupervisedHelper::kill()).
+    StepTimeout, ///< It overstayed a step's watch.
+    Grace,       ///< It did not stop a call within the grace after an interrupt.
+    Dropped,     ///< Its holder let it go.
+    Shutdown,    ///< The supervisor stopped, or can no longer wait for its helpers.
+};
+
+/// How many KillReasons there are.
+inline constexpr std::size_t KillReasonCount = 5;
+
+/// What a supervisor did so far. Test hook.
+struct SupervisorCounters
+{
+    std::size_t launches = 0;       ///< Helpers started.
+    std::size_t reaped = 0;         ///< Helpers whose end was collected.
+    std::size_t deathsObserved = 0; ///< Ends noticed while the supervisor ran, rather than while it stopped.
+    std::size_t uncleanExits = 0;   ///< Ends other than exit code 0, or a kill the supervisor sent.
+    std::array<std::size_t, KillReasonCount> kills {}; ///< Kills sent, indexed by KillReason.
+};
+
+class SupervisorMailbox;
+class ExtensionHostSupervisor;
+/// The supervisor thread's state; what it does is in the source.
+class SupervisorLoop;
+
+/// The parent's grip on one supervised helper. Move-only; destroying it lets the helper go: the supervisor
+/// kills it (after `teardownGrace`, if it has not exited by then) and reaps it, and this returns at once.
+/// Every call is a no-op once the supervisor stopped.
+class SupervisedHelper
+{
+  public:
+    SupervisedHelper(SupervisedHelper const&) = delete;
+    SupervisedHelper& operator=(SupervisedHelper const&) = delete;
+    SupervisedHelper(SupervisedHelper&& other) noexcept;
+    SupervisedHelper& operator=(SupervisedHelper&& other) noexcept;
+    ~SupervisedHelper();
+
+    /// @return The helper's process id.
+    [[nodiscard]] ProcessId processId() const noexcept { return _processId; }
+
+    /// Has the supervisor kill the helper. Posts, and returns.
+    void kill() noexcept;
+
+    /// Arms a step's timeout, from now: should the watch still live once @p budget passed, the supervisor
+    /// kills the helper and runs the attachment's onDeath.
+    /// @param step The step about to begin.
+    /// @param budget How long it may take.
+    /// @return What disarms it when destroyed; inert once the supervisor stopped.
+    [[nodiscard]] remote::StepWatch watch(remote::HostStep step, std::chrono::milliseconds budget);
+
+    /// Tells the supervisor what to do when the helper ends. Posts, and returns.
+    /// @param attachment Its onDeath runs once, on the supervisor's thread, once the helper ended or was
+    ///        killed for a timeout; at once there if that happened already.
+    void attach(remote::HostAttachment attachment);
+
+    /// Wakes the supervisor. Wait-free.
+    void nudge() noexcept;
+
+  private:
+    friend class SupervisorMailbox;
+
+    SupervisedHelper(std::shared_ptr<SupervisorMailbox> mailbox, uint64_t key, ProcessId processId) noexcept;
+
+    /// Lets the helper go, unless it was moved from.
+    void release() noexcept;
+
+    std::shared_ptr<SupervisorMailbox> _mailbox;
+    uint64_t _key = 0; ///< The supervisor's name for the helper; 0 once moved from.
+    ProcessId _processId = 0;
+};
+
+/// The supervisor's command queue, and the wake of the set it waits on. Shared and thread-safe; outlives the
+/// supervisor, after which it refuses every command.
+class SupervisorMailbox: public std::enable_shared_from_this<SupervisorMailbox>
+{
+    /// Restricts construction to the supervisor, while std::make_shared can call it.
+    struct Passkey
+    {
+        explicit Passkey() = default;
+    };
+
+  public:
+    /// One command, of the kinds the supervisor's thread processes.
+    struct Command;
+
+    /// Made by ExtensionHostSupervisor::start().
+    /// @param waitSet What the supervisor waits on; woken by every post.
+    /// @param clock What watches are timed by; outlives the supervisor, not necessarily the mailbox.
+    SupervisorMailbox(Passkey, std::unique_ptr<IExitWaitSet> waitSet, core::IClock& clock);
+    SupervisorMailbox(SupervisorMailbox const&) = delete;
+    SupervisorMailbox(SupervisorMailbox&&) = delete;
+    SupervisorMailbox& operator=(SupervisorMailbox const&) = delete;
+    SupervisorMailbox& operator=(SupervisorMailbox&&) = delete;
+    ~SupervisorMailbox();
+
+    /// Launches @p spec on the supervisor's thread, and blocks the caller until it did. Never called on the
+    /// supervisor's thread.
+    /// @return The helper; why it did not start -- `Stopped` once the supervisor is gone, or can no longer
+    /// wait
+    ///         for its helpers.
+    [[nodiscard]] std::expected<SupervisedHelper, LaunchError> launch(LaunchSpec spec);
+
+  private:
+    friend class SupervisedHelper;
+    friend class ExtensionHostSupervisor;
+    friend class SupervisorLoop;
+
+    /// Whether commands are taken.
+    enum class MailboxState : uint8_t
+    {
+        Closed, ///< The supervisor stopped: every command is dropped.
+        Open,   ///< The supervisor takes them.
+    };
+
+    /// Queues @p command and wakes the supervisor.
+    /// @return Whether it was queued; not once the mailbox closed.
+    bool post(Command command) noexcept;
+
+    /// @return Every command queued, in order; the queue empty.
+    [[nodiscard]] std::vector<Command> take() noexcept;
+
+    /// Blocks until a command is queued, or @p timeout passed. For a supervisor that cannot wait on its set.
+    void waitForCommands(std::chrono::milliseconds timeout);
+
+    /// Queues the last command, and closes. @param stop The Stop command.
+    void close(Command stop) noexcept;
+
+    /// @return The time by the supervisor's clock; nothing once the mailbox closed, when the clock may be
+    /// gone.
+    [[nodiscard]] std::optional<core::SteadyTimePoint> now() const noexcept;
+
+    /// @return A timer serial not handed out before; never 0, which a helper's teardown timer uses.
+    [[nodiscard]] uint32_t nextSerial() noexcept;
+
+    /// Wakes the supervisor. Wait-free.
+    void wake() noexcept { _waitSet->wake(); }
+
+    mutable std::mutex _mutex;
+    std::condition_variable _posted;          ///< Notified on every post; waited on by waitForCommands().
+    MailboxState _state = MailboxState::Open; ///< Guarded by _mutex.
+    std::vector<Command> _commands;           ///< Guarded by _mutex.
+    std::unique_ptr<IExitWaitSet> _waitSet;   ///< Fixed after construction; waited on by the supervisor only.
+    core::IClock* _clock;                     ///< Read only under _mutex while open.
+    std::atomic<uint32_t> _nextSerial { 1 };  ///< The next timer serial.
+    std::thread::id _supervisorThread;        ///< Written once, before the mailbox is handed out.
+};
+
+/// The one thread that owns every extension host process of this hosting process. Its destructor kills every
+/// helper, reaps those that end within ShutdownReapBudget (after `teardownGrace` for them to exit on their
+/// own, when that is set), and joins: bounded however the helpers behave.
+class ExtensionHostSupervisor
+{
+    struct Passkey
+    {
+        explicit Passkey() = default;
+    };
+
+  public:
+    /// Starts the supervisor's thread.
+    /// @param config Its launcher and clock, both non-null.
+    /// @return The supervisor; or why it could not start.
+    [[nodiscard]] static std::expected<std::unique_ptr<ExtensionHostSupervisor>, SupervisorError> start(
+        SupervisorConfig config);
+
+    /// Use start(). Public for std::make_unique only.
+    ExtensionHostSupervisor(Passkey,
+                            std::shared_ptr<SupervisorMailbox> mailbox,
+                            std::unique_ptr<SupervisorLoop> loop);
+    ExtensionHostSupervisor(ExtensionHostSupervisor const&) = delete;
+    ExtensionHostSupervisor(ExtensionHostSupervisor&&) = delete;
+    ExtensionHostSupervisor& operator=(ExtensionHostSupervisor const&) = delete;
+    ExtensionHostSupervisor& operator=(ExtensionHostSupervisor&&) = delete;
+
+    /// Kills every helper, reaps within the budget, and joins.
+    ~ExtensionHostSupervisor();
+
+    /// @return What connectors and handles reach the supervisor through.
+    [[nodiscard]] std::shared_ptr<SupervisorMailbox> mailbox() const noexcept { return _mailbox; }
+
+    /// Test hook: returns once everything posted before it was processed -- and every helper that ended by
+    /// then, and every timer due by then, with it.
+    void sync();
+
+    /// Test hook.
+    /// @return What it did so far.
+    [[nodiscard]] SupervisorCounters counters() const;
+
+    /// Test hook.
+    /// @return The supervisor's thread.
+    [[nodiscard]] std::thread::id threadId() const noexcept { return _threadId; }
+
+    /// Test hook.
+    /// @return How many helpers were launched and not yet reaped.
+    [[nodiscard]] std::size_t liveProcesses() const;
+
+  private:
+    std::shared_ptr<SupervisorMailbox> _mailbox;
+    std::unique_ptr<SupervisorLoop> _loop;
+    std::jthread _thread;
+    std::thread::id _threadId;
+};
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/ExtensionHostSupervisor_test.cpp b/src/vtextension/wasm/remote/process/ExtensionHostSupervisor_test.cpp
new file mode 100644
index 000000000..5c30f495e
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/ExtensionHostSupervisor_test.cpp
@@ -0,0 +1,385 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The supervisor over a fake launcher and a manual clock: every timeout is the clock's, and sync() makes each
+// step of a case deterministic.
+#include <core/Clock.hpp>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <future>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/BackendConfig.hpp>
+#include <vtextension/wasm/remote/HostConnector.hpp>
+#include <vtextension/wasm/remote/process/ExtensionHostSupervisor.hpp>
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+#include <vtextension/wasm/remote/process/testing/FakeProcessLauncher.hpp>
+
+using vtextension::wasm::HostTimeouts;
+using vtextension::wasm::remote::HostAttachment;
+using vtextension::wasm::remote::HostStep;
+using vtextension::wasm::remote::process::ExitKind;
+using vtextension::wasm::remote::process::ExitStatus;
+using vtextension::wasm::remote::process::ExtensionHostSupervisor;
+using vtextension::wasm::remote::process::KillReason;
+using vtextension::wasm::remote::process::LaunchError;
+using vtextension::wasm::remote::process::LaunchSpec;
+using vtextension::wasm::remote::process::ShutdownReapBudget;
+using vtextension::wasm::remote::process::SupervisedHelper;
+using vtextension::wasm::remote::process::SupervisorConfig;
+using vtextension::wasm::remote::process::testing::FakeProcessLauncher;
+using namespace std::chrono_literals;
+
+namespace
+{
+
+/// @return What a fake launch is asked to start; the fake starts nothing of it.
+[[nodiscard]] LaunchSpec fakeSpec()
+{
+    return LaunchSpec { .executable = "helper",
+                        .inherited = {},
+                        .arguments = [](auto /*handles*/) { return std::vector<std::string> {}; },
+                        .environment = {},
+                        .caps = {} };
+}
+
+/// @return How many kills the supervisor sent for @p reason.
+[[nodiscard]] std::size_t killsFor(ExtensionHostSupervisor const& supervisor, KillReason reason)
+{
+    return supervisor.counters().kills.at(std::to_underlying(reason));
+}
+
+/// A supervisor over a fake launcher, timed by a manual clock.
+struct Rig
+{
+    explicit Rig(std::chrono::milliseconds teardownGrace = 0ms): grace { teardownGrace } {}
+
+    std::chrono::milliseconds grace;
+    std::shared_ptr<FakeProcessLauncher> fake = std::make_shared<FakeProcessLauncher>();
+    core::ManualClock clock {};
+    std::unique_ptr<ExtensionHostSupervisor> supervisor = [this] {
+        auto started = ExtensionHostSupervisor::start(
+            SupervisorConfig { .launcher = fake, .clock = &clock, .teardownGrace = grace });
+        REQUIRE(started.has_value());
+        return std::move(*started);
+    }();
+    std::shared_ptr<std::atomic<int>> deaths = std::make_shared<std::atomic<int>>(0);
+
+    /// @return A helper launched through the mailbox, which must start.
+    [[nodiscard]] SupervisedHelper launch() const
+    {
+        auto helper = supervisor->mailbox()->launch(fakeSpec());
+        REQUIRE(helper.has_value());
+        return std::move(*helper);
+    }
+
+    /// @return An attachment counting its helper's deaths in `deaths`.
+    [[nodiscard]] HostAttachment countingDeaths() const
+    {
+        return HostAttachment { .onDeath = [deaths = deaths] { deaths->fetch_add(1); } };
+    }
+
+    /// Moves the clock on by @p delta, and lets the supervisor see it.
+    void advance(core::SteadyDuration delta)
+    {
+        clock.advance(delta);
+        supervisor->sync();
+    }
+
+    /// Lets the supervisor process everything and wait once: the fake's lastDeadline() then is what it waits
+    /// with when idle.
+    void settle() const
+    {
+        supervisor->sync();
+        supervisor->sync();
+    }
+};
+
+/// One step and its default budget.
+struct StepRow
+{
+    HostStep step;
+    std::chrono::milliseconds budget;
+    char const* name;
+};
+
+} // namespace
+
+TEST_CASE("Supervisor.launchRunsOnItsThread", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto const helper = rig.launch();
+    CHECK(rig.fake->launchThreads() == std::vector { rig.supervisor->threadId() });
+    CHECK(helper.processId() == vtextension::wasm::remote::process::testing::FirstFakeProcessId);
+    rig.supervisor->sync();
+    CHECK(rig.supervisor->counters().launches == 1);
+    CHECK(rig.supervisor->liveProcesses() == 1);
+}
+
+TEST_CASE("Supervisor.stepTimeoutsKill", "[vtextension]")
+{
+    constexpr auto Defaults = HostTimeouts {};
+    auto const rows = std::array {
+        StepRow { .step = HostStep::Handshake, .budget = Defaults.handshake, .name = "handshake" },
+        StepRow { .step = HostStep::Load, .budget = Defaults.load, .name = "load" },
+        StepRow { .step = HostStep::Instantiate, .budget = Defaults.instantiate, .name = "instantiate" },
+    };
+    REQUIRE(rows[0].budget == 2000ms);
+    REQUIRE(rows[1].budget == 10000ms);
+    REQUIRE(rows[2].budget == 1000ms);
+    for (auto const& row: rows)
+    {
+        DYNAMIC_SECTION(row.name)
+        {
+            auto rig = Rig {};
+            auto helper = rig.launch();
+            helper.attach(rig.countingDeaths());
+            auto const watch = helper.watch(row.step, row.budget);
+            rig.advance(row.budget - 1ms);
+            CHECK(rig.fake->kills().empty());
+            CHECK(rig.deaths->load() == 0);
+
+            rig.advance(1ms);
+            CHECK(rig.fake->kills() == std::vector<std::size_t> { 0 });
+            CHECK(rig.deaths->load() == 1);
+            CHECK(killsFor(*rig.supervisor, KillReason::StepTimeout) == 1);
+            // Its own kill: no unclean exit, and its death is told once, however it is then reaped.
+            CHECK(rig.supervisor->counters().reaped == 1);
+            CHECK(rig.supervisor->counters().uncleanExits == 0);
+        }
+    }
+}
+
+TEST_CASE("Supervisor.watchIsTimedFromItsCaller", "[vtextension]")
+{
+    // The budget runs from watch(), not from when the supervisor gets to the command.
+    auto rig = Rig {};
+    auto helper = rig.launch();
+    auto const watch = helper.watch(HostStep::Load, 10ms);
+    rig.clock.advance(10ms);
+    rig.supervisor->sync();
+    CHECK(rig.fake->kills() == std::vector<std::size_t> { 0 });
+}
+
+TEST_CASE("Supervisor.disarmedWatchNeverFires", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto helper = rig.launch();
+    {
+        auto const watch = helper.watch(HostStep::Load, 10ms);
+    }
+    // Disarmed before the time passes: the supervisor may otherwise look at the clock in between.
+    rig.supervisor->sync();
+    rig.advance(1h);
+    CHECK(rig.fake->kills().empty());
+    rig.settle();
+    CHECK(rig.fake->lastDeadline() == std::nullopt);
+}
+
+TEST_CASE("Supervisor.armedWatchIsWaitedFor", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto helper = rig.launch();
+    auto const watch = helper.watch(HostStep::Instantiate, 1000ms);
+    rig.settle();
+    CHECK(rig.fake->lastDeadline() == core::SteadyTimePoint {} + 1000ms);
+}
+
+TEST_CASE("Supervisor.exitIsObservedAndReaped", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto helper = rig.launch();
+    helper.attach(rig.countingDeaths());
+    rig.supervisor->sync();
+    rig.fake->exit(0, ExitStatus { .kind = ExitKind::Exited, .value = 3 });
+    rig.supervisor->sync();
+
+    auto const counters = rig.supervisor->counters();
+    CHECK(counters.deathsObserved == 1);
+    CHECK(counters.reaped == 1);
+    CHECK(counters.uncleanExits == 1);
+    CHECK(rig.deaths->load() == 1);
+    CHECK(rig.supervisor->liveProcesses() == 0);
+    // Reaped: a kill now reaches nothing.
+    helper.kill();
+    rig.supervisor->sync();
+    CHECK(rig.fake->kills().empty());
+}
+
+TEST_CASE("Supervisor.attachAfterDeathFiresAtOnce", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto helper = rig.launch();
+    rig.fake->exit(0, ExitStatus { .kind = ExitKind::Exited, .value = 0 });
+    rig.supervisor->sync();
+    CHECK(rig.supervisor->counters().reaped == 1);
+    CHECK(rig.supervisor->counters().uncleanExits == 0);
+
+    helper.attach(rig.countingDeaths());
+    rig.supervisor->sync();
+    CHECK(rig.deaths->load() == 1);
+}
+
+TEST_CASE("Supervisor.requestedKillIsNotUnclean", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto helper = rig.launch();
+    helper.attach(rig.countingDeaths());
+    helper.kill();
+    rig.supervisor->sync();
+    CHECK(rig.fake->kills() == std::vector<std::size_t> { 0 });
+    // The fake ended it as SIGKILL does.
+    auto const counters = rig.supervisor->counters();
+    CHECK(counters.reaped == 1);
+    CHECK(counters.uncleanExits == 0);
+    CHECK(killsFor(*rig.supervisor, KillReason::Requested) == 1);
+    CHECK(rig.deaths->load() == 1);
+}
+
+TEST_CASE("Supervisor.crashAfterAKillIsStillUnclean", "[vtextension]")
+{
+    // Only the status a kill ends a process with is the supervisor's doing.
+    auto rig = Rig {};
+    auto helper = rig.launch();
+    rig.fake->survivesKill(0);
+    helper.kill();
+    rig.supervisor->sync();
+    rig.fake->exit(0, ExitStatus { .kind = ExitKind::Signalled, .value = 11 });
+    rig.supervisor->sync();
+    CHECK(rig.supervisor->counters().uncleanExits == 1);
+}
+
+TEST_CASE("Supervisor.dropKillsAndReaps", "[vtextension]")
+{
+    auto rig = Rig {};
+    {
+        auto const helper = rig.launch();
+    }
+    rig.supervisor->sync();
+    CHECK(killsFor(*rig.supervisor, KillReason::Dropped) == 1);
+    CHECK(rig.supervisor->counters().reaped == 1);
+    CHECK(rig.supervisor->counters().uncleanExits == 0);
+    CHECK(rig.supervisor->liveProcesses() == 0);
+}
+
+TEST_CASE("Supervisor.dropWaitsTheTeardownGrace", "[vtextension]")
+{
+    auto rig = Rig { 2000ms };
+    {
+        auto helper = rig.launch();
+        helper.attach(rig.countingDeaths());
+    }
+    rig.supervisor->sync(); // the grace runs from when the supervisor lets it go
+    rig.advance(1999ms);
+    CHECK(rig.fake->kills().empty());
+    rig.advance(1ms);
+    CHECK(killsFor(*rig.supervisor, KillReason::Dropped) == 1);
+    CHECK(rig.supervisor->counters().reaped == 1);
+    // Let go: its attachment was forgotten with it.
+    CHECK(rig.deaths->load() == 0);
+}
+
+TEST_CASE("Supervisor.helperExitingWithinTheGraceIsNotKilled", "[vtextension]")
+{
+    auto rig = Rig { 2000ms };
+    {
+        auto const helper = rig.launch();
+    }
+    rig.supervisor->sync();
+    rig.fake->exit(0, ExitStatus { .kind = ExitKind::Exited, .value = 0 });
+    rig.advance(1h);
+    CHECK(rig.fake->kills().empty());
+    CHECK(rig.supervisor->counters().reaped == 1);
+    CHECK(rig.supervisor->counters().uncleanExits == 0);
+    CHECK(rig.supervisor->liveProcesses() == 0);
+}
+
+TEST_CASE("Supervisor.idleNeverWakes", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto const helper = rig.launch();
+    rig.settle();
+    CHECK(rig.fake->lastDeadline() == std::nullopt);
+}
+
+TEST_CASE("Supervisor.stopIsBounded", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto helpers = std::vector<SupervisedHelper> {};
+    for ([[maybe_unused]] auto const index: { 0, 1, 2 })
+        helpers.push_back(rig.launch());
+    rig.fake->survivesKill(2);
+    auto stopping = std::async(std::launch::async, [&] { rig.supervisor.reset(); });
+
+    // The reap budget is the manual clock's: it passes as the test moves the clock on, and wakes the
+    // supervisor to look.
+    auto rounds = 0;
+    while (stopping.wait_for(10ms) != std::future_status::ready && ++rounds < 100)
+    {
+        rig.clock.advance(ShutdownReapBudget);
+        helpers.front().nudge();
+    }
+    REQUIRE(stopping.wait_for(1s) == std::future_status::ready);
+    CHECK(rig.fake->kills().size() == 3);
+}
+
+TEST_CASE("Supervisor.mailboxOutlivesTheSupervisor", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto const mailbox = rig.supervisor->mailbox();
+    auto helper = rig.launch();
+    rig.supervisor.reset();
+    CHECK(rig.fake->kills() == std::vector<std::size_t> { 0 }); // the supervisor's own, as it stopped
+
+    helper.kill();
+    {
+        auto const watch = helper.watch(HostStep::Load, 1ms);
+    }
+    helper.attach(rig.countingDeaths());
+    helper.nudge();
+    {
+        auto const dropped = std::move(helper);
+    }
+    CHECK(rig.fake->kills().size() == 1);
+    CHECK(rig.deaths->load() == 0);
+    CHECK(mailbox->launch(fakeSpec()).error() == LaunchError::Stopped);
+}
+
+TEST_CASE("Supervisor.failedWaitStopsEveryHelper", "[vtextension]")
+{
+    // The set cannot wait any more: the supervisor says so once, stops every helper and starts no more,
+    // and still processes its commands until it is destroyed.
+    auto rig = Rig {};
+    auto helper = rig.launch();
+    helper.attach(rig.countingDeaths());
+    rig.supervisor->sync();
+    rig.fake->failWaits(LaunchError::Io);
+    rig.supervisor->sync();
+    CHECK(killsFor(*rig.supervisor, KillReason::Shutdown) == 1);
+    CHECK(rig.deaths->load() == 1);
+    CHECK(rig.supervisor->counters().reaped == 1);
+    CHECK(rig.supervisor->counters().uncleanExits == 0);
+    CHECK(rig.supervisor->mailbox()->launch(fakeSpec()).error() == LaunchError::Stopped);
+    CHECK(rig.fake->launches().size() == 1);
+}
+
+TEST_CASE("Supervisor.moveHandsTheHelperOn", "[vtextension]")
+{
+    auto rig = Rig {};
+    auto first = rig.launch();
+    auto second = std::move(first);
+    rig.supervisor->sync();
+    CHECK(rig.fake->kills().empty());
+    second = rig.launch(); // lets the first go
+    rig.supervisor->sync();
+    CHECK(killsFor(*rig.supervisor, KillReason::Dropped) == 1);
+    CHECK(rig.supervisor->liveProcesses() == 1);
+}
diff --git a/src/vtextension/wasm/remote/process/HostTimers.cpp b/src/vtextension/wasm/remote/process/HostTimers.cpp
new file mode 100644
index 000000000..f60346039
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HostTimers.cpp
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/process/HostTimers.hpp>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+namespace vtextension::wasm::remote::process
+{
+
+void HostTimers::arm(TimerKey key, core::SteadyTimePoint now, core::SteadyDuration budget)
+{
+    _timers.insert_or_assign(key, Entry { .remaining = budget, .runningSince = now });
+}
+
+void HostTimers::pause(TimerKey key, core::SteadyTimePoint now) noexcept
+{
+    auto const timer = _timers.find(key);
+    if (timer == _timers.end() || !timer->second.runningSince)
+        return;
+    auto& entry = timer->second;
+    entry.remaining = std::max(core::SteadyDuration {}, entry.remaining - (now - *entry.runningSince));
+    entry.runningSince = std::nullopt;
+}
+
+void HostTimers::resume(TimerKey key, core::SteadyTimePoint now) noexcept
+{
+    auto const timer = _timers.find(key);
+    if (timer == _timers.end() || timer->second.runningSince)
+        return;
+    timer->second.runningSince = now;
+}
+
+void HostTimers::disarm(TimerKey key) noexcept
+{
+    _timers.erase(key);
+}
+
+void HostTimers::disarmHelper(uint64_t helper) noexcept
+{
+    std::erase_if(_timers, [helper](auto const& timer) { return timer.first.helper == helper; });
+}
+
+std::vector<TimerKey> HostTimers::expire(core::SteadyTimePoint now)
+{
+    auto expired = std::vector<TimerKey> {};
+    std::erase_if(_timers, [&](auto const& timer) {
+        auto const deadline = deadlineOf(timer.second);
+        if (!deadline || *deadline > now)
+            return false;
+        expired.push_back(timer.first);
+        return true;
+    });
+    return expired;
+}
+
+std::optional<core::SteadyTimePoint> HostTimers::nextDeadline() const noexcept
+{
+    auto earliest = std::optional<core::SteadyTimePoint> {};
+    for (auto const& [key, entry]: _timers)
+        if (auto const deadline = deadlineOf(entry); deadline && (!earliest || *deadline < *earliest))
+            earliest = deadline;
+    return earliest;
+}
+
+std::size_t HostTimers::armed() const noexcept
+{
+    return _timers.size();
+}
+
+std::optional<core::SteadyTimePoint> HostTimers::deadlineOf(Entry const& entry) noexcept
+{
+    if (!entry.runningSince)
+        return std::nullopt;
+    return *entry.runningSince + entry.remaining;
+}
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/HostTimers.hpp b/src/vtextension/wasm/remote/process/HostTimers.hpp
new file mode 100644
index 000000000..8ed721064
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HostTimers.hpp
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The deadlines the extension host supervisor keeps: each a budget that runs, may be paused and resumed, and
+/// expires once it ran out. Pure: told the time by its caller, so that it is tested with explicit instants.
+
+#include <core/Clock.hpp>
+
+#include <compare>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <vector>
+
+namespace vtextension::wasm::remote::process
+{
+
+/// What names one timer: the helper it is about, and which of that helper's timers it is.
+struct TimerKey
+{
+    uint64_t helper = 0; ///< The supervised helper's key.
+    uint32_t serial = 0; ///< Which of its timers.
+
+    auto operator<=>(TimerKey const&) const = default;
+};
+
+/// Deadlines of one thread (the supervisor's). Not thread-safe; every instant is its caller's.
+///
+/// A timer's budget runs while it is armed and not paused; a paused one keeps what is left of it and never
+/// expires. The table is per supervisor and small, so every query scans it.
+class HostTimers
+{
+  public:
+    /// Arms @p key, replacing a timer armed under it.
+    /// @param key The timer.
+    /// @param now The instant its budget starts running.
+    /// @param budget How long it may run before it expires.
+    void arm(TimerKey key, core::SteadyTimePoint now, core::SteadyDuration budget);
+
+    /// Stops @p key's budget from running, keeping what is left of it; an unknown or paused key is ignored.
+    /// @param key The timer.
+    /// @param now The instant it stops.
+    void pause(TimerKey key, core::SteadyTimePoint now) noexcept;
+
+    /// Lets @p key's budget run again; an unknown or running key is ignored.
+    /// @param key The timer.
+    /// @param now The instant it runs again.
+    void resume(TimerKey key, core::SteadyTimePoint now) noexcept;
+
+    /// Forgets @p key, for good; an unknown key is ignored.
+    void disarm(TimerKey key) noexcept;
+
+    /// Forgets every timer of @p helper.
+    void disarmHelper(uint64_t helper) noexcept;
+
+    /// Removes and returns every running timer whose budget ran out by @p now.
+    /// @return Their keys, in key order.
+    [[nodiscard]] std::vector<TimerKey> expire(core::SteadyTimePoint now);
+
+    /// @return When the earliest running timer expires; nothing if none runs. Paused timers are excluded.
+    [[nodiscard]] std::optional<core::SteadyTimePoint> nextDeadline() const noexcept;
+
+    /// @return How many timers are armed, paused ones included.
+    [[nodiscard]] std::size_t armed() const noexcept;
+
+  private:
+    /// One timer: what is left of its budget, and since when that runs; nothing while it is paused.
+    struct Entry
+    {
+        core::SteadyDuration remaining {};
+        std::optional<core::SteadyTimePoint> runningSince;
+    };
+
+    /// @return When @p entry expires; nothing while it is paused.
+    [[nodiscard]] static std::optional<core::SteadyTimePoint> deadlineOf(Entry const& entry) noexcept;
+
+    std::map<TimerKey, Entry> _timers;
+};
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/HostTimers_test.cpp b/src/vtextension/wasm/remote/process/HostTimers_test.cpp
new file mode 100644
index 000000000..c345c3d5a
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HostTimers_test.cpp
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <core/Clock.hpp>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+#include <optional>
+#include <vector>
+
+#include <vtextension/wasm/remote/process/HostTimers.hpp>
+
+using vtextension::wasm::remote::process::HostTimers;
+using vtextension::wasm::remote::process::TimerKey;
+using namespace std::chrono_literals;
+
+namespace
+{
+
+/// An instant every case counts from.
+constexpr auto T0 = core::SteadyTimePoint {} + 1h;
+
+constexpr auto Key = TimerKey { .helper = 7, .serial = 1 };
+
+} // namespace
+
+TEST_CASE("HostTimers.expiresAtTheBudget", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 10ms);
+    CHECK(timers.nextDeadline() == T0 + 10ms);
+    CHECK(timers.expire(T0 + 9ms).empty());
+    CHECK(timers.armed() == 1);
+    CHECK(timers.expire(T0 + 10ms) == std::vector { Key });
+    CHECK(timers.armed() == 0);
+    CHECK(timers.nextDeadline() == std::nullopt);
+}
+
+TEST_CASE("HostTimers.pauseStopsTheClock", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 50ms);
+    timers.pause(Key, T0 + 10ms);
+    CHECK(timers.nextDeadline() == std::nullopt);
+    CHECK(timers.expire(T0 + 1000ms).empty());
+    CHECK(timers.armed() == 1);
+
+    // 40 ms were left when it paused: they run from the resume on.
+    timers.resume(Key, T0 + 1010ms);
+    CHECK(timers.nextDeadline() == T0 + 1050ms);
+    CHECK(timers.expire(T0 + 1049ms).empty());
+    CHECK(timers.expire(T0 + 1050ms) == std::vector { Key });
+}
+
+TEST_CASE("HostTimers.pauseAndResumeAreIdempotent", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 50ms);
+    timers.resume(Key, T0 + 5ms); // running already: ignored
+    timers.pause(Key, T0 + 10ms);
+    timers.pause(Key, T0 + 30ms); // paused already: ignored
+    timers.resume(Key, T0 + 100ms);
+    CHECK(timers.nextDeadline() == T0 + 140ms);
+
+    // Unknown keys are ignored.
+    timers.pause(TimerKey { .helper = 8, .serial = 1 }, T0);
+    timers.resume(TimerKey { .helper = 8, .serial = 1 }, T0);
+    CHECK(timers.armed() == 1);
+}
+
+TEST_CASE("HostTimers.disarmIsFinal", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 10ms);
+    timers.disarm(Key);
+    CHECK(timers.armed() == 0);
+    CHECK(timers.nextDeadline() == std::nullopt);
+    CHECK(timers.expire(T0 + 1h).empty());
+    // Resuming what is gone does not bring it back.
+    timers.resume(Key, T0 + 1h);
+    CHECK(timers.armed() == 0);
+}
+
+TEST_CASE("HostTimers.nextDeadlineIsTheEarliest", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    auto const later = TimerKey { .helper = 1, .serial = 1 };
+    auto const earlier = TimerKey { .helper = 2, .serial = 1 };
+    auto const paused = TimerKey { .helper = 3, .serial = 1 };
+    timers.arm(later, T0, 30ms);
+    timers.arm(earlier, T0 + 5ms, 10ms);
+    timers.arm(paused, T0, 1ms);
+    timers.pause(paused, T0);
+    CHECK(timers.nextDeadline() == T0 + 15ms);
+    CHECK(timers.expire(T0 + 30ms) == std::vector { later, earlier });
+    CHECK(timers.nextDeadline() == std::nullopt);
+    CHECK(timers.armed() == 1);
+}
+
+TEST_CASE("HostTimers.rearmingReplaces", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 10ms);
+    timers.arm(Key, T0 + 5ms, 10ms);
+    CHECK(timers.armed() == 1);
+    CHECK(timers.nextDeadline() == T0 + 15ms);
+}
+
+TEST_CASE("HostTimers.disarmHelperForgetsItsTimersOnly", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(TimerKey { .helper = 1, .serial = 1 }, T0, 10ms);
+    timers.arm(TimerKey { .helper = 1, .serial = 2 }, T0, 10ms);
+    timers.arm(TimerKey { .helper = 2, .serial = 1 }, T0, 20ms);
+    timers.disarmHelper(1);
+    CHECK(timers.armed() == 1);
+    CHECK(timers.nextDeadline() == T0 + 20ms);
+}
