+
+/// What an architecture numbers a call it does not have.
+inline constexpr auto NoSystemCall = long { -1 };
+
+/// A system call's numbers.
+struct SystemCallNumbers
+{
+    SystemCall call;       ///< The call.
+    std::string_view name; ///< Its name, as strace prints it.
+    long amd64;            ///< Its number on x86_64; NoSystemCall if it has none there.
+    long aarch64;          ///< Its number on aarch64; NoSystemCall if it has none there.
+};
+
+/// @return Every call's numbers, one row per SystemCall, at its index.
+[[nodiscard]] std::span<SystemCallNumbers const> systemCallNumbers() noexcept;
+
+/// @param call A call.
+/// @param arch An architecture.
+/// @return Its number there; nothing where it has none.
+[[nodiscard]] std::optional<long> systemCallNumber(SystemCall call, AuditArch arch) noexcept;
+
+/// What becomes of a call a row names.
+enum class SystemCallAction : uint8_t
+{
+    Kill,   ///< The process is killed by SIGSYS.
+    Refuse, ///< The call fails with the row's errno, and the process goes on.
+    Allow,  ///< The call is made.
+};
+
+/// How an argument is tested: on `(argument & mask)` against `value`, each 32-bit half the mask covers.
+enum class ArgumentTest : uint8_t
+{
+    Equals,           ///< `(argument & mask) == value`.
+    NotEquals,        ///< `(argument & mask) != value`.
+    AllClear,         ///< `(argument & mask) == 0`; value unused.
+    AllSet,           ///< `(argument & mask) == mask`; value unused.
+    EqualsControl,    ///< `(argument & mask) ==` the control channel's descriptor; value unused.
+    EqualsOwnProcess, ///< `(argument & mask) ==` the process's own id; value unused.
+};
+
+/// A test a call's argument must pass for its row to decide; a call failing any of its row's is killed.
+struct ArgumentCheck
+{
+    uint8_t index;     ///< Which argument, 0 to 5.
+    ArgumentTest test; ///< How it is tested.
+    uint64_t mask;     ///< Which of its bits are tested.
+    uint64_t value;    ///< What they are compared with, where the test compares with a value.
+};
+
+/// What becomes of one system call, and why.
+struct SystemCallRow
+{
+    long number;                           ///< The call's number on the architecture the rows are for.
+    std::span<ArgumentCheck const> checks; ///< What its arguments must pass; all of them.
+    SystemCallAction action;               ///< What becomes of it when they pass.
+    int error;                             ///< The errno a `Refuse` fails it with; 0 otherwise.
+    std::string_view reason;               ///< Why, for whoever reads the table.
+};
+
+/// @param arch The architecture the rows are numbered for.
+/// @return What every build allows or refuses, most frequent first.
+[[nodiscard]] std::vector<SystemCallRow> releaseRows(AuditArch arch);
+
+/// @param arch The architecture the rows are numbered for.
+/// @return What an engine that compiles its modules to native code needs beyond the release rows.
+[[nodiscard]] std::vector<SystemCallRow> compiledRows(AuditArch arch);
+
+/// @param arch The architecture the rows are numbered for.
+/// @return What an engine that interprets its modules needs beyond the release rows.
+[[nodiscard]] std::vector<SystemCallRow> interpretedRows(AuditArch arch);
+
+/// @param arch The architecture the rows are numbered for.
+/// @return What a sanitizer's runtime needs beyond them.
+[[nodiscard]] std::vector<SystemCallRow> sanitizerRows(AuditArch arch);
+
+/// @param arch The architecture the rows are numbered for.
+/// @return What writing coverage counters needs beyond them.
+[[nodiscard]] std::vector<SystemCallRow> coverageRows(AuditArch arch);
+
+/// @param code How the host's engine runs a module's code.
+/// @param instrumentation How the build is instrumented.
+/// @param arch The architecture the rows are numbered for.
+/// @return The rows such a host locks down with: releaseRows(), then the set @p code names, then the set
+///         @p instrumentation names; a row of a later set replaces an earlier row of the same call, and its
+///         other rows follow.
+[[nodiscard]] std::vector<SystemCallRow> rowsFor(GuestCode code,
+                                                 BuildInstrumentation instrumentation,
+                                                 AuditArch arch);
+
+/// @param code How the host's engine runs a module's code.
+/// @param arch The architecture the rows are numbered for.
+/// @return The rows a host of this build locks down with: rowsFor(@p code, ThisBuildInstrumentation).
+[[nodiscard]] std::vector<SystemCallRow> buildRows(GuestCode code, AuditArch arch);
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/linux/testing/BpfEvaluator.hpp b/src/vtextension/wasm/host/linux/testing/BpfEvaluator.hpp
new file mode 100644
index 000000000..60bd2b932
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/testing/BpfEvaluator.hpp
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// Test-only: runs a classic BPF program over a `seccomp_data`, as the kernel runs a seccomp filter, so that
+/// what a filter decides for a call is checked without installing it -- and without the process it would
+/// kill. Knows the instructions SeccompFilter.hpp assembles, and the kernel's other conditional jumps.
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <optional>
+#include <span>
+
+#include <linux/filter.h>
+#include <linux/seccomp.h>
+#include <vtextension/wasm/host/linux/SystemCallRows.hpp>
+
+namespace vtextension::wasm::host::testing
+{
+
+/// A system call as a filter sees it.
+struct SystemCallUse
+{
+    AuditArch arch = AuditArch::Amd64;      ///< The architecture it was made on.
+    long number = 0;                        ///< Its number there.
+    std::array<uint64_t, 6> arguments = {}; ///< Its arguments.
+};
+
+/// @return What @p program returns for @p use; nothing if it runs off its end or meets an instruction this
+///         evaluator does not know.
+[[nodiscard]] inline std::optional<uint32_t> evaluateFilter(std::span<sock_filter const> program,
+                                                            SystemCallUse const& use)
+{
+    auto data = seccomp_data {};
+    data.nr = static_cast<int>(use.number);
+    data.arch = static_cast<uint32_t>(use.arch);
+    std::ranges::copy(use.arguments, std::begin(data.args));
+    auto bytes = std::array<std::byte, sizeof(seccomp_data)> {};
+    std::memcpy(bytes.data(), &data, sizeof(data));
+
+    auto accumulator = uint32_t { 0 };
+    auto counter = std::size_t { 0 };
+    while (counter < program.size())
+    {
+        auto const& instruction = program[counter];
+        counter += 1;
+        auto const branch = [&](bool taken) {
+            counter += taken ? instruction.jt : instruction.jf;
+        };
+        switch (instruction.code)
+        {
+            case BPF_LD | BPF_W | BPF_ABS:
+                if (instruction.k + sizeof(uint32_t) > bytes.size())
+                    return std::nullopt;
+                std::memcpy(&accumulator, bytes.data() + instruction.k, sizeof(uint32_t));
+                break;
+            case BPF_ALU | BPF_AND | BPF_K: accumulator &= instruction.k; break;
+            case BPF_JMP | BPF_JA: counter += instruction.k; break;
+            case BPF_JMP | BPF_JEQ | BPF_K: branch(accumulator == instruction.k); break;
+            case BPF_JMP | BPF_JGE | BPF_K: branch(accumulator >= instruction.k); break;
+            case BPF_JMP | BPF_JGT | BPF_K: branch(accumulator > instruction.k); break;
+            case BPF_JMP | BPF_JSET | BPF_K: branch((accumulator & instruction.k) != 0); break;
+            case BPF_RET | BPF_K: return instruction.k;
+            default: return std::nullopt;
+        }
+    }
+    return std::nullopt;
+}
+
+/// What a filter's return value decides.
+struct FilterVerdict
+{
+    SystemCallAction action; ///< What becomes of the call.
+    int error = 0;           ///< The errno of a `Refuse`.
+
+    bool operator==(FilterVerdict const&) const = default;
+};
+
+/// @return What @p value, a seccomp return value, decides; `Kill` for anything but an errno or an allow.
+[[nodiscard]] inline FilterVerdict verdictOf(uint32_t value) noexcept
+{
+    if (value == SECCOMP_RET_ALLOW)
+        return FilterVerdict { .action = SystemCallAction::Allow };
+    if ((value & SECCOMP_RET_ACTION_FULL) == SECCOMP_RET_ERRNO)
+        return FilterVerdict { .action = SystemCallAction::Refuse,
+                               .error = static_cast<int>(value & SECCOMP_RET_DATA) };
+    return FilterVerdict { .action = SystemCallAction::Kill };
+}
+
+} // namespace vtextension::wasm::host::testing
diff --git a/src/vtextension/wasm/host/macos/SandboxProfile.hpp b/src/vtextension/wasm/host/macos/SandboxProfile.hpp
new file mode 100644
index 000000000..b003b4530
--- /dev/null
+++ b/src/vtextension/wasm/host/macos/SandboxProfile.hpp
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host's sandbox profile on macOS, in Seatbelt's profile language (SBPL), and the parameters
+/// it reads. Std-only, so that every system's tests read the text the host applies on macOS.
+///
+/// Deny by default; what is allowed is what the locked-down host still does that Seatbelt mediates:
+/// - mapping the guest memory objects Contour created and granted it, and asking their size, by the prefix
+///   their names carry (SharedObjectName.hpp): their data, and their metadata (fstat(), which XNU checks as
+///   such). Never creating, truncating or unlinking one: Contour makes every object.
+/// - signalling itself, as a runtime that raises a signal does;
+/// - reading the CPU feature sysctls (hw.optional.), kept defensively: the code generator reads them as it
+///   creates its first engine, which priming a thread does before the lockdown, and caches what it read. A
+///   read after the lockdown would only come from a library that does not cache; remove the rule once a
+///   green macOS run shows its deny log never asks for it.
+///
+/// Nothing else: no network, no Mach service lookup, no file read or write, no new process, no exec.
+
+#include <array>
+#include <cstddef>
+#include <string_view>
+
+#include <vtextension/wasm/remote/transport/SharedObjectName.hpp>
+
+namespace vtextension::wasm::host
+{
+
+/// A parameter the profile reads as `(param "<name>")`: C strings, as the C API takes them.
+struct ProfileParameter
+{
+    char const* name;  ///< Its name.
+    char const* value; ///< Its value.
+};
+
+/// Every parameter the profile reads.
+inline constexpr auto ProfileParameters = std::array {
+    ProfileParameter { .name = "SHM_PREFIX", .value = remote::transport::SharedObjectNamePrefix },
+};
+
+/// The profile: deny by default, and only what the locked-down host does.
+inline constexpr auto SandboxProfile = std::string_view { R"sbpl((version 1)
+(deny default)
+
+; Guest memory: objects Contour created and granted, mapped (data) and fstat()ed (metadata). Never created.
+(allow ipc-posix-shm-read-data ipc-posix-shm-read-metadata ipc-posix-shm-write-data
+    (ipc-posix-name-prefix (param "SHM_PREFIX")))
+
+; A runtime that raises a signal raises it on itself.
+(allow signal (target self))
+
+; The CPU features the code generator reads: read and cached before the lockdown; kept in case a library
+; reads them again later. To be removed once a green run shows no denial needs it.
+(allow sysctl-read
+    (sysctl-name-prefix "hw.optional."))
+)sbpl" };
+
+/// @return ProfileParameters as sandbox_init_with_parameters() takes them: name, value, name, value, …,
+///         then a null pointer.
+[[nodiscard]] constexpr auto profileParameterList() noexcept
+{
+    auto list = std::array<char const*, (2 * ProfileParameters.size()) + 1> {};
+    auto next = std::size_t { 0 };
+    for (auto const& parameter: ProfileParameters)
+    {
+        list[next++] = parameter.name;
+        list[next++] = parameter.value;
+    }
+    list[next] = nullptr;
+    return list;
+}
+
+} // namespace vtextension::wasm::host
