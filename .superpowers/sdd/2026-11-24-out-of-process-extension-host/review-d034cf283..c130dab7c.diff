+        return refusedBy("GetSystemDirectoryW", ::GetLastError());
+    directory.resize(length);
+    auto const program = directory + L"\\cmd.exe";
+    auto commandLine = std::wstring { L"cmd.exe /c exit 0" };
+    auto startup = STARTUPINFOW {};
