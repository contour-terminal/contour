+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/wamr/WamrEngine.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string_view>
