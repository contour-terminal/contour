+
+#include <vtextension/wasm/wamr/WamrThreadEnv.hpp>
+
+namespace vtextension::wasm::wamr
+{
+
+namespace
+{
+    /// The thread environment prepareThread() entered on the calling thread: kept until the thread ends,
+    /// whose exit ends it there. WAMR's state is the process's, so one per thread serves every engine.
+    thread_local std::optional<ThreadEnv> preparedThread;
+
+    /// The text of each WamrEngineError.
+    struct ErrorText
+    {
+        WamrEngineError error;
+        std::string_view text;
+    };
+
+    constexpr auto ErrorTexts = std::array {
+        ErrorText { WamrEngineError::CompilesNativeCode,
+                    "its engine was built to compile code at run time, which this extension host's sandbox "
+                    "forbids; it needs one that interprets" },
+        ErrorText { WamrEngineError::RuntimeUnavailable, "its engine could not be initialized" },
+        ErrorText { WamrEngineError::NullDeviceUnavailable, "the null device could not be opened" },
+    };
+
+    /// A WAMR backend holding WAMR's runtime up for as long as it lives.
+    class WamrEngine final: public host::IHostedEngine
+    {
+        struct PrivateTag
+        {
+        };
+
+      public:
+        /// Takes a hold on WAMR's runtime for the engine.
+        /// @param backend The backend it is a facade over.
+        /// @return The engine; `RuntimeUnavailable` if WAMR could not initialize.
+        /// @param devices The devices the backend keeps open: its shared null device.
+        [[nodiscard]] static std::expected<std::unique_ptr<WamrEngine>, ExtensionError> create(
+            std::unique_ptr<IWasmBackend> backend, std::vector<remote::transport::NativeHandle> devices)
+        {
+            if (auto acquired = acquireRuntime(); !acquired)
+                return std::unexpected(acquired.error());
+            try
+            {
+                return std::make_unique<WamrEngine>(PrivateTag {}, std::move(backend), std::move(devices));
+            }
+            catch (...)
+            {
+                releaseRuntime();
+                throw;
+            }
+        }
+
+        /// Use create(); public only so that std::make_unique can reach it. Takes over the hold create()
+        /// took.
+        WamrEngine(PrivateTag /*unused*/,
+                   std::unique_ptr<IWasmBackend> backend,
+                   std::vector<remote::transport::NativeHandle> devices) noexcept:
+            _backend { std::move(backend) }, _devices { std::move(devices) }
+        {
+        }
+
+        WamrEngine(WamrEngine const&) = delete;
+        WamrEngine(WamrEngine&&) = delete;
+        WamrEngine& operator=(WamrEngine const&) = delete;
+        WamrEngine& operator=(WamrEngine&&) = delete;
+
+        /// Releases the engine's hold on the runtime, after the backend.
+        ~WamrEngine() override
+        {
+            _backend.reset();
+            releaseRuntime();
+        }
+
+        [[nodiscard]] std::expected<std::shared_ptr<IWasmRuntime>, ExtensionError> createRuntime(
+            RuntimeLimits limits, std::span<HostFunction const> hostFunctions) override
+        {
+            return _backend->createRuntime(limits, hostFunctions);
+        }
+
+        [[nodiscard]] std::expected<std::unique_ptr<IThreadGuard>, ExtensionError> enterThread() override
+        {
+            return _backend->enterThread();
+        }
+
+        [[nodiscard]] bool isCurrentThreadPrepared() const override
+        {
+            return _backend->isCurrentThreadPrepared();
+        }
+
+        [[nodiscard]] uint64_t runtimeGeneration() const noexcept override
+        {
+            return _backend->runtimeGeneration();
+        }
+
+        [[nodiscard]] BackendCapabilities capabilities() const noexcept override
+        {
+            return _backend->capabilities();
+        }
+
+        [[nodiscard]] remote::proto::MemoryMode memoryMode() const noexcept override
+        {
+            return remote::proto::MemoryMode::Copy;
+        }
+
+        [[nodiscard]] uint64_t memoryGuardBytes() const noexcept override { return 0; }
+
+        /// The build's WAMR has the interpreter alone: no JIT and no AOT code
+        /// (cmake/ContourThirdParties.cmake).
+        [[nodiscard]] host::GuestCode guestCode() const noexcept override
+        {
+            return host::GuestCode::Interpreted;
+        }
+
+        /// The null device its runtimes bind their guests' standard streams to, opened as it was made.
+        [[nodiscard]] std::vector<remote::transport::NativeHandle> heldDevices() const override
+        {
+            return _devices;
+        }
+
+        /// Enters WAMR's thread environment on the calling thread, unless it holds one of the running
+        /// runtime already. The interpreter installs no signal handler, so this is all a thread needs.
+        [[nodiscard]] std::expected<void, ExtensionError> prepareThread() override
+        {
+            if (preparedThread && preparedThread->generation() == wamr::runtimeGeneration())
+                return {};
+            preparedThread.reset();
+            return ThreadEnv::enter().transform(
+                [](ThreadEnv entered) { preparedThread.emplace(std::move(entered)); });
+        }
+
+      private:
+        std::unique_ptr<IWasmBackend> _backend;
+        std::vector<remote::transport::NativeHandle> _devices;
+    };
+
+    /// @return @p handle, a raw handle as a null device opener returns it, as the transport names one.
+    [[nodiscard]] remote::transport::NativeHandle nativeHandleOf(int64_t handle) noexcept
+    {
+#ifdef _WIN32
+        return reinterpret_cast<remote::transport::NativeHandle>(static_cast<intptr_t>(handle));
+#else
+        return static_cast<remote::transport::NativeHandle>(handle);
+#endif
+    }
+} // namespace
+
+NativeCompilation linkedNativeCompilation() noexcept
+{
+    auto const compiles =
+        std::ranges::any_of(std::array { Mode_Fast_JIT, Mode_LLVM_JIT, Mode_Multi_Tier_JIT },
+                            &wasm_runtime_is_running_mode_supported);
+    return compiles ? NativeCompilation::Present : NativeCompilation::Absent;
+}
+
+std::string_view wamrEngineErrorText(WamrEngineError error) noexcept
+{
+    auto const row = std::ranges::find(ErrorTexts, error, &ErrorText::error);
+    return row != ErrorTexts.end() ? row->text : std::string_view { "the engine could not be made" };
+}
+
+std::expected<std::unique_ptr<host::IHostedEngine>, WamrEngineError> makeWamrEngine(
+    WamrEngineConfig const& config)
+{
+    // Checked before anything is opened: an engine that could compile would hold, or need, executable memory
+    // that its host's sandbox, made for an interpreter, refuses.
+    if (config.nativeCompilation() != NativeCompilation::Absent)
+        return std::unexpected(WamrEngineError::CompilesNativeCode);
+    auto devices = std::vector<remote::transport::NativeHandle> {};
+    return NullDevice::openShared(config.openNullDevice)
+        .transform_error([](ExtensionError) { return WamrEngineError::NullDeviceUnavailable; })
+        .transform([&devices](NullDevice nullDevice) {
+            if (auto const handle = nullDevice.sharedHandle())
+                devices.push_back(nativeHandleOf(*handle));
+            return makeWamrBackend(WamrConfig { .nullDevice = std::move(nullDevice) });
+        })
+        .and_then([&devices](std::unique_ptr<IWasmBackend> backend) {
+            return WamrEngine::create(std::move(backend), std::move(devices))
+                .transform([](std::unique_ptr<WamrEngine> engine) -> std::unique_ptr<host::IHostedEngine> {
+                    return engine;
+                })
+                .transform_error([](ExtensionError) { return WamrEngineError::RuntimeUnavailable; });
+        });
+}
+
+} // namespace vtextension::wasm::wamr
diff --git a/src/vtextension/wasm/wamr/WamrEngine.hpp b/src/vtextension/wasm/wamr/WamrEngine.hpp
new file mode 100644
index 000000000..97a76266a
--- /dev/null
+++ b/src/vtextension/wasm/wamr/WamrEngine.hpp
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The WAMR engine an extension host process drives (host::IHostedEngine): the WAMR backend, interpreting its
+// modules, set up for a host that locks itself down once its threads are prepared.
+#pragma once
+
+#include <cstdint>
+#include <expected>
+#include <functional>
+#include <memory>
+#include <string_view>
+
+#include <vtextension/wasm/host/IHostedEngine.hpp>
+#include <vtextension/wasm/wamr/WamrBackend.hpp>
+
+namespace vtextension::wasm::wamr
+{
+
+/// Whether a WAMR can compile guest code to native code.
+enum class NativeCompilation : uint8_t
+{
+    Absent,  ///< It interprets only.
+    Present, ///< It has a JIT running mode: Fast JIT, LLVM JIT, or both tiered.
+};
+
+/// @return Whether the WAMR this process links has a JIT running mode.
+[[nodiscard]] NativeCompilation linkedNativeCompilation() noexcept;
+
+/// Why no WAMR engine was made.
+enum class WamrEngineError : uint8_t
+{
+    CompilesNativeCode,    ///< The WAMR can compile to native code, which the engine claims never to run.
+    RuntimeUnavailable,    ///< WAMR could not initialize.
+    NullDeviceUnavailable, ///< The null device could not be opened.
+};
+
+/// @param error Why no engine was made.
+/// @return The reason, user-readable: it names the extension host's engine, never the runtime.
+[[nodiscard]] std::string_view wamrEngineErrorText(WamrEngineError error) noexcept;
+
+/// How a WAMR engine is made.
+struct WamrEngineConfig
+{
+    /// Opens the null device, once.
+    NullDeviceOpener openNullDevice = systemNullDeviceOpener();
+    /// Says whether the linked WAMR compiles to native code.
+    std::function<NativeCompilation()> nativeCompilation = &linkedNativeCompilation;
+};
+
+/// Creates the WAMR engine of an extension host process.
+///
+/// Everything it needs of the system it takes here, before the host locks itself down: one null device,
+/// which every runtime it creates shares, and a hold on WAMR's process-wide runtime for as long as it lives,
+/// so that its threads can be prepared before any runtime exists. Its instances' memory is copied to the
+/// parent (MemoryMode::Copy), as WAMR places a linear memory where it chooses, and it needs no guard
+/// (memoryGuardBytes() is 0). It interprets (GuestCode::Interpreted), and so refuses a WAMR that could
+/// compile. prepareThread() enters WAMR's thread environment on the calling thread, which keeps it until it
+/// ends.
+/// @param config How it is made.
+/// @return The engine; why none was made otherwise.
+[[nodiscard]] std::expected<std::unique_ptr<host::IHostedEngine>, WamrEngineError> makeWamrEngine(
+    WamrEngineConfig const& config = {});
+
+} // namespace vtextension::wasm::wamr
diff --git a/src/vtextension/wasm/wamr/WamrEngine_test.cpp b/src/vtextension/wasm/wamr/WamrEngine_test.cpp
new file mode 100644
index 000000000..2aa2ac680
--- /dev/null
+++ b/src/vtextension/wasm/wamr/WamrEngine_test.cpp
@@ -0,0 +1,163 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The WAMR engine an extension host process drives: how it shares memory, the one null device its runtimes
+// share, and how it prepares a thread.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <memory>
+#include <optional>
+#include <thread>
+#include <vector>
+
+#ifdef __linux__
+    #include <filesystem>
+#endif
+
+#include <vtextension/wasm/WasmRuntime.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/testing/BackendContract.hpp>
+#include <vtextension/wasm/wamr/WamrBackend.hpp>
+#include <vtextension/wasm/wamr/WamrEngine.hpp>
+#include <vtextension/wasm/wamr/WamrThreadEnv.hpp>
+
+namespace contract = vtextension::wasm::testing::contract;
+using vtextension::wasm::IWasmRuntime;
+using vtextension::wasm::host::GuestCode;
+using vtextension::wasm::remote::proto::MemoryMode;
+using vtextension::wasm::wamr::linkedNativeCompilation;
+using vtextension::wasm::wamr::makeWamrEngine;
+using vtextension::wasm::wamr::NativeCompilation;
+using vtextension::wasm::wamr::NullDeviceOpener;
+using vtextension::wasm::wamr::systemNullDeviceOpener;
+using vtextension::wasm::wamr::ThreadEnv;
+using vtextension::wasm::wamr::WamrEngineConfig;
+using vtextension::wasm::wamr::WamrEngineError;
+using vtextension::wasm::wamr::wamrEngineErrorText;
+
+namespace
+{
+
+/// @return An opener of the system's null device that counts its calls in @p opened.
+[[nodiscard]] NullDeviceOpener countingOpener(std::size_t& opened)
+{
+    return [&opened, open = systemNullDeviceOpener()] {
+        ++opened;
+        return open();
+    };
+}
+
+/// @return How many descriptors this process holds open; nothing where the system does not say.
+[[nodiscard]] std::optional<std::ptrdiff_t> openDescriptors()
+{
+#ifdef __linux__
+    auto const entries = std::filesystem::directory_iterator { "/proc/self/fd" };
+    return std::distance(std::filesystem::begin(entries), std::filesystem::end(entries));
+#else
+    return std::nullopt;
+#endif
+}
+
+} // namespace
+
+TEST_CASE("WamrEngine.copiesMemory", "[vtextension][wamr]")
+{
+    auto const made = makeWamrEngine();
+    REQUIRE(made.has_value());
+    auto const& engine = *made;
+    CHECK(engine->memoryMode() == MemoryMode::Copy);
+    CHECK(engine->memoryGuardBytes() == 0);
+    CHECK(engine->guestCode() == GuestCode::Interpreted);
+}
+
+TEST_CASE("WamrEngine.runtimesShareOneNullDevice", "[vtextension][wamr]")
+{
+    auto const before = openDescriptors();
+    auto opened = std::size_t { 0 };
+    {
+        auto const made = makeWamrEngine(WamrEngineConfig { .openNullDevice = countingOpener(opened) });
+        REQUIRE(made.has_value());
+        auto const& engine = *made;
+        CHECK(opened == 1);
+        auto const afterEngine = openDescriptors();
+
+        // Three runtimes, each instantiating a module that imports WASI, which binds the device: none opens
+        // another, so a host that can no longer open one still runs them.
+        auto runtimes = std::vector<std::shared_ptr<IWasmRuntime>> {};
+        auto context = contract::RecordingHostContext {};
+        for ([[maybe_unused]] auto const index: { 0, 1, 2 })
+        {
+            auto const& runtime = runtimes.emplace_back(contract::createRuntime(*engine));
+            auto const module = contract::load(*runtime, contract::DescribedModule);
+            CHECK(module->instantiate(context).has_value());
+        }
+        CHECK(opened == 1);
+        CHECK(openDescriptors() == afterEngine);
+    }
+    // ... and it is closed with the engine and the last runtime.
+    CHECK(openDescriptors() == before);
+}
+
+TEST_CASE("WamrEngine.holdsTheNullDeviceItOpened", "[vtextension][wamr]")
+{
+    // The one device the engine keeps is the one a sandbox that limits descriptor by descriptor must leave
+    // it, and it is what the opener returned.
+    auto opened = std::optional<int64_t> {};
+    auto const made =
+        makeWamrEngine(WamrEngineConfig { .openNullDevice = [&opened, open = systemNullDeviceOpener()] {
+            opened = open();
+            return opened;
+        } });
+    REQUIRE(made.has_value());
+    REQUIRE(opened.has_value());
+    auto const held = (*made)->heldDevices();
+    REQUIRE(held.size() == 1);
+#ifndef _WIN32
+    CHECK(held.front() == static_cast<int>(*opened));
+#endif
+}
+
+TEST_CASE("WamrEngine.prepareThreadIsIdempotent", "[vtextension][wamr]")
+{
+    auto const made = makeWamrEngine();
+    REQUIRE(made.has_value());
+    auto const& engine = *made;
+    // Before any runtime exists, as a host prepares its threads before it locks itself down: on a thread
+    // that did not bring the runtime up, and on the one that did.
+    auto prepared = std::vector<bool> {};
+    auto worker = std::thread { [&] {
+        for ([[maybe_unused]] auto const index: { 0, 1 })
+        {
+            auto const result = engine->prepareThread();
+            prepared.push_back(result.has_value() && engine->isCurrentThreadPrepared());
+        }
+        prepared.push_back(ThreadEnv::preparedGeneration() == engine->runtimeGeneration());
+    } };
+    worker.join();
+    CHECK(prepared == std::vector { true, true, true });
+    CHECK(engine->prepareThread().has_value());
+    CHECK(engine->prepareThread().has_value());
+    CHECK(engine->isCurrentThreadPrepared());
+}
+
+TEST_CASE("WamrEngine.refusesAWamrThatCompiles", "[vtextension][wamr]")
+{
+    // The build's WAMR interprets only; one that could compile is refused before anything is opened, as its
+    // host's sandbox would otherwise kill it, or leave its code cache executable.
+    CHECK(linkedNativeCompilation() == NativeCompilation::Absent);
+    auto opened = std::size_t { 0 };
+    // Counts without opening anything: refused first, it must not be called at all.
+    auto const made =
+        makeWamrEngine(WamrEngineConfig { .openNullDevice =
+                                              [&opened] {
+                                                  ++opened;
+                                                  return std::optional<int64_t> {};
+                                              },
+                                          .nativeCompilation = [] { return NativeCompilation::Present; } });
+    REQUIRE_FALSE(made.has_value());
+    CHECK(made.error() == WamrEngineError::CompilesNativeCode);
+    CHECK(opened == 0);
+    CHECK_FALSE(wamrEngineErrorText(made.error()).empty());
+}
