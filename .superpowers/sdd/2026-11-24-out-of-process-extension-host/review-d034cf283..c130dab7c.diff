index 000000000..9f297d723
--- /dev/null
+++ b/src/vtextension/wasm/host/Sandbox_test.cpp
@@ -0,0 +1,340 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The sandbox seam: a system without a sandbox runs the host unsandboxed, and a step that failed is phrased
+// from the one table both ends share.
+#include <catch2/catch_message.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <set>
+#include <span>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <vtextension/wasm/host/DescriptorRights.hpp>
+#include <vtextension/wasm/host/HostBootstrap.hpp>
+#include <vtextension/wasm/host/Sandbox.hpp>
+#include <vtextension/wasm/host/macos/SandboxProfile.hpp>
+#include <vtextension/wasm/remote/proto/LockdownSteps.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/remote/transport/SharedObjectName.hpp>
+
+using vtextension::wasm::host::ConfinementFailure;
+using vtextension::wasm::host::confinementFailureText;
+using vtextension::wasm::host::DescriptorRight;
+using vtextension::wasm::host::DescriptorRole;
+using vtextension::wasm::host::descriptorRoleRights;
+using vtextension::wasm::host::GuestCode;
+using vtextension::wasm::host::makeSystemSandbox;
+using vtextension::wasm::host::NullSandbox;
+using vtextension::wasm::host::PlatformSandbox;
+using vtextension::wasm::host::profileParameterList;
+using vtextension::wasm::host::ProfileParameters;
+using vtextension::wasm::host::rightsOf;
+using vtextension::wasm::host::SandboxDescriptors;
+using vtextension::wasm::host::SandboxProfile;
+using vtextension::wasm::host::systemErrorText;
+using vtextension::wasm::host::ThisPlatformSandbox;
+
+namespace proto = vtextension::wasm::remote::proto;
+
+TEST_CASE("Sandbox.nullSandboxTakesBothStepsUnsandboxed", "[vtextension][host]")
+{
+    auto sandbox = NullSandbox {};
+    CHECK(sandbox.restrictBeforeThreads().has_value());
+    CHECK(sandbox.lockDown().has_value());
+    CHECK(sandbox.lockdownState() == proto::LockdownState::Unsandboxed);
+}
+
+TEST_CASE("Sandbox.systemWithoutOneRunsUnsandboxed", "[vtextension][host]")
+{
+    // A system without a sandbox makes the null one, which confines nothing. So does Windows' for a process
+    // its parent started in no AppContainer, as this test process is: it verifies, finds none, and confines
+    // nothing. Where the sandbox confines on its own, it would confine this very process: the probe proves it
+    // in a child of its own (SandboxProbe_test.cpp).
+    if constexpr (ThisPlatformSandbox != PlatformSandbox::None
+                  && ThisPlatformSandbox != PlatformSandbox::Windows)
+        SKIP("this system has a sandbox");
+    auto const sandbox = makeSystemSandbox(SandboxDescriptors { .control = {} }, GuestCode::Interpreted);
+    REQUIRE(sandbox != nullptr);
+    CHECK(sandbox->restrictBeforeThreads().has_value());
+    CHECK(sandbox->lockDown().has_value());
+    CHECK(sandbox->lockdownState() == proto::LockdownState::Unsandboxed);
+}
+
+TEST_CASE("Sandbox.failureSaysTheStepAndWhatTheSystemSaid", "[vtextension][host]")
+{
+    // The error code is read, not printed as a bare number: the line carries the system's word on it.
+    auto const failure = ConfinementFailure { .step = proto::LockdownStep::SystemCalls, .code = 1 };
+    auto const text = confinementFailureText(failure);
+    INFO(text);
+    CHECK(text
+          == std::string { proto::lockdownStepText(proto::LockdownStep::SystemCalls) } + ": "
+                 + systemErrorText(1));
+    CHECK_FALSE(systemErrorText(1).empty());
+}
+
+TEST_CASE("Sandbox.rightsTableCoversEveryRole", "[vtextension][host]")
+{
+    // One row per role, at its index, up to the last; each names what its role is used for, once each.
+    auto const rows = descriptorRoleRights();
+    REQUIRE(rows.size() == std::to_underlying(DescriptorRole::StopSender) + std::size_t { 1 });
+    for (auto const index: std::views::iota(std::size_t { 0 }, rows.size()))
+    {
+        auto const& row = rows[index];
+        INFO("role " << index);
+        auto const roleIndex = std::size_t { std::to_underlying(row.role) };
+        CHECK(roleIndex == index);
+        CHECK_FALSE(row.rights.empty());
+        CHECK(std::set<DescriptorRight>(row.rights.begin(), row.rights.end()).size() == row.rights.size());
+        CHECK(std::ranges::equal(rightsOf(row.role), row.rights));
+    }
+
+    // What the host does with each after the lockdown: it talks over its channels and waits on its wake end,
+    // and never writes to the page nor reads its standard error. The engine's device takes what a guest's
+    // stdio does: writes, seeks, and its flags.
+    auto const has = [](DescriptorRole role, DescriptorRight right) {
+        return std::ranges::find(rightsOf(role), right) != rightsOf(role).end();
+    };
+    for (auto const role: { DescriptorRole::Control, DescriptorRole::Lane })
+        for (auto const right: { DescriptorRight::Receive, DescriptorRight::Send, DescriptorRight::Event })
+            CHECK(has(role, right));
+    CHECK(has(DescriptorRole::Wake, DescriptorRight::Event));
+    CHECK_FALSE(has(DescriptorRole::Page, DescriptorRight::Write));
+    CHECK_FALSE(has(DescriptorRole::StandardError, DescriptorRight::Read));
+    for (auto const right: { DescriptorRight::Write, DescriptorRight::Seek, DescriptorRight::GetStatusFlags })
+        CHECK(has(DescriptorRole::EngineDevice, right));
+    // Standard input and output are only asked what they are; the stop pipe is waited on at one end and
+    // written to at the other.
+    CHECK(std::ranges::equal(rightsOf(DescriptorRole::IdleStream), std::array { DescriptorRight::Fstat }));
+    CHECK(has(DescriptorRole::StopReceiver, DescriptorRight::Event));
+    CHECK_FALSE(has(DescriptorRole::StopReceiver, DescriptorRight::Write));
+    CHECK(std::ranges::equal(rightsOf(DescriptorRole::StopSender), std::array { DescriptorRight::Write }));
+}
+
+namespace
+{
+
+/// One top-level form of a profile: `(<head> <body>)`.
+struct ProfileForm
+{
+    std::string head; ///< The word the form starts with, after any space.
+    std::string body; ///< What follows the head, up to the form's closing parenthesis, comments removed.
+};
+
+/// @return The top-level forms of @p profile, in order: `;` comments removed, except inside a string
+///         literal; nothing if it is not one form after another -- unbalanced parentheses, an unterminated
+///         string, or text outside every form.
+[[nodiscard]] std::optional<std::vector<ProfileForm>> topLevelFormsOf(std::string_view profile)
+{
+    /// Where the reading is within the text.
+    enum class Lexeme : uint8_t
+    {
+        Code,    ///< Outside any string or comment.
+        String,  ///< Inside a string literal.
+        Escaped, ///< Right after a backslash inside a string literal.
+        Comment, ///< From a `;` outside a string to the end of its line.
+    };
+    constexpr auto Space = std::string_view { " \t\n" };
+    constexpr auto Delimiters = std::string_view { " \t\n()\";" };
+    auto forms = std::vector<ProfileForm> {};
+    auto depth = std::size_t { 0 };
+    auto lexeme = Lexeme::Code;
+    auto text = std::string {}; // The current form's text after its opening parenthesis.
+    for (auto const c: profile)
+    {
+        switch (lexeme)
+        {
+            case Lexeme::Comment:
+                if (c == '\n')
+                    lexeme = Lexeme::Code;
+                continue;
+            case Lexeme::Escaped:
+                lexeme = Lexeme::String;
+                text += c;
+                continue;
+            case Lexeme::String:
+                if (c == '\\')
+                    lexeme = Lexeme::Escaped;
+                else if (c == '"')
+                    lexeme = Lexeme::Code;
+                text += c;
+                continue;
+            case Lexeme::Code: break;
+        }
+        if (c == ';')
+        {
+            lexeme = Lexeme::Comment;
+            continue;
+        }
+        if (depth == 0)
+        {
+            if (c == '(')
+                ++depth;
+            else if (!Space.contains(c))
+                return std::nullopt;
+            continue;
+        }
+        if (c == ')' && --depth == 0)
+        {
+            auto const view = std::string_view { text };
+            auto const head = std::min(view.find_first_not_of(Space), view.size());
+            auto const end = std::min(view.find_first_of(Delimiters, head), view.size());
+            forms.push_back(ProfileForm { .head = std::string { view.substr(head, end - head) },
+                                          .body = std::string { view.substr(end) } });
+            text.clear();
+            continue;
+        }
+        if (c == '(')
+            ++depth;
+        else if (c == '"')
+            lexeme = Lexeme::String;
+        text += c;
+    }
+    if (depth != 0 || lexeme == Lexeme::String || lexeme == Lexeme::Escaped)
+        return std::nullopt;
+    return forms;
+}
+
+/// @return The operation names of every form of @p forms whose head is @p action, in order, once per form
+///         that names them: the words after the head, up to the form's first filter or its end.
+[[nodiscard]] std::vector<std::string> operationsOf(std::span<ProfileForm const> forms,
+                                                    std::string_view action)
+{
+    constexpr auto Space = std::string_view { " \t\n" };
+    constexpr auto Delimiters = std::string_view { " \t\n()" };
+    auto operations = std::vector<std::string> {};
+    for (auto const& form: forms | std::views::filter([&](auto const& form) { return form.head == action; }))
+    {
+        auto rest = std::string_view { form.body };
+        while (true)
+        {
+            auto const word = rest.find_first_not_of(Space);
+            if (word == std::string_view::npos || rest[word] == '(' || rest[word] == ')')
+                break;
+            rest.remove_prefix(word);
+            auto const end = std::min(rest.find_first_of(Delimiters), rest.size());
+            operations.emplace_back(rest.substr(0, end));
+            rest.remove_prefix(end);
+        }
+    }
+    return operations;
+}
+
+/// @return The operation names of every `(<action> …)` form of @p profile (operationsOf()); nothing if the
+///         profile does not parse.
+[[nodiscard]] std::optional<std::vector<std::string>> operationsOf(std::string_view profile,
+                                                                   std::string_view action)
+{
+    auto const forms = topLevelFormsOf(profile);
+    if (!forms)
+        return std::nullopt;
+    return operationsOf(*forms, action);
+}
+
+/// Every head a top-level form of the profile may have: what deny-by-default and its exceptions take. Any
+/// other -- `import`, `define`, `if` -- would add rules this test cannot read.
+constexpr auto AllowedFormHeads = std::array<std::string_view, 3> { "version", "deny", "allow" };
+
+/// Every operation the profile allows, each in exactly one form: what the locked-down host still does that
+/// Seatbelt mediates (SandboxProfile.hpp says why each).
+constexpr auto AllowedOperations = std::array<std::string_view, 5> {
+    "ipc-posix-shm-read-data",
+    "ipc-posix-shm-read-metadata",
+    "ipc-posix-shm-write-data",
+    "signal",
+    "sysctl-read",
+};
+
+} // namespace
+
+TEST_CASE("Sandbox.profileHasNoNetworkOrMachLookup", "[vtextension][host]")
+{
+    // macOS's profile, read on every system. It denies by default, and allows exactly the operations of
+    // AllowedOperations, each named in full in one form: no wildcard can widen a rule, and an operation the
+    // table does not hold -- network, Mach lookup, files, processes, IOKit -- cannot be allowed by accident.
+    auto const forms = topLevelFormsOf(SandboxProfile);
+    REQUIRE(forms.has_value());
+    for (auto const& form: *forms)
+    {
+        INFO("form head: " << form.head);
+        CHECK(std::ranges::contains(AllowedFormHeads, std::string_view { form.head }));
+    }
+    CHECK(SandboxProfile.starts_with("(version 1)\n(deny default)\n"));
+    CHECK(std::ranges::equal(operationsOf(*forms, "deny"), std::array { std::string_view { "default" } }));
+    CHECK_FALSE(SandboxProfile.contains('*'));
+
+    auto allowed = operationsOf(*forms, "allow");
+    std::ranges::sort(allowed);
+    auto expected = AllowedOperations;
+    std::ranges::sort(expected);
+    auto listed = std::string {};
+    for (auto const& operation: allowed)
+        listed += operation + ' ';
+    INFO("allowed: " << listed);
+    CHECK(std::ranges::equal(allowed, expected));
+
+    // Each rule's filter: shared memory only by the prefix Contour names its objects with, read from a
+    // parameter; signals only to itself; sysctls only the CPU feature names.
+    CHECK(SandboxProfile.contains("(ipc-posix-name-prefix (param \"SHM_PREFIX\"))"));
+    CHECK(SandboxProfile.contains("(allow signal (target self))"));
+    CHECK(SandboxProfile.contains("(sysctl-name-prefix \"hw.optional.\")"));
+}
+
+TEST_CASE("Sandbox.profileParserSeesWhatAWildcardWouldHide", "[vtextension][host]")
+{
+    // The reading above, on profiles it must refuse: a second form, a wildcard, an operation not in the
+    // table, a head spaced from its parenthesis, a comment sign inside a string, a head not in the table.
+    using Operations = std::optional<std::vector<std::string>>;
+    CHECK(operationsOf("(allow file* (subpath \"/\"))\n(allow mach-lookup)", "allow")
+          == Operations { { "file*", "mach-lookup" } });
+    CHECK(operationsOf("(allow signal)\n(allow signal (target self))", "allow")
+          == Operations { { "signal", "signal" } });
+    CHECK(operationsOf("(allowed x)", "allow") == Operations { std::vector<std::string> {} });
+    CHECK(operationsOf("( allow\tfile-read*)", "allow") == Operations { { "file-read*" } });
+    CHECK(operationsOf("(allow a (literal \"x;y\"))\n(allow b)", "allow") == Operations { { "a", "b" } });
+    CHECK(operationsOf("(allow a) ; (allow b)\n", "allow") == Operations { { "a" } });
+    auto const imported = topLevelFormsOf("(version 1)\n(import \"system.sb\")");
+    REQUIRE(imported.has_value());
+    CHECK_FALSE(std::ranges::all_of(*imported, [](auto const& form) {
+        return std::ranges::contains(AllowedFormHeads, std::string_view { form.head });
+    }));
+    // Not one form after another: nothing is read at all.
+    CHECK_FALSE(topLevelFormsOf("(allow a").has_value());
+    CHECK_FALSE(topLevelFormsOf("(allow a (literal \"x)").has_value());
+    CHECK_FALSE(topLevelFormsOf("allow a").has_value());
+}
+
+TEST_CASE("Sandbox.profileParametersAreWhatTheProfileReads", "[vtextension][host]")
+{
+    // Every parameter the profile reads is passed, and the shared memory prefix is the one every object's
+    // name starts with.
+    for (auto const& parameter: ProfileParameters)
+    {
+        INFO(parameter.name);
+        CHECK(SandboxProfile.contains(std::string { "(param \"" } + std::string { parameter.name } + "\")"));
+    }
+    auto const prefix = std::ranges::find(ProfileParameters,
+                                          std::string_view { "SHM_PREFIX" },
+                                          &vtextension::wasm::host::ProfileParameter::name);
+    REQUIRE(prefix != ProfileParameters.end());
+    CHECK(vtextension::wasm::remote::transport::sharedObjectName(42, 1).starts_with(prefix->value));
+
+    // As the C API takes them: name, value, ..., then a null pointer.
+    constexpr auto List = profileParameterList();
+    REQUIRE(List.size() == (2 * ProfileParameters.size()) + 1);
+    for (auto const index: std::views::iota(std::size_t { 0 }, ProfileParameters.size()))
+    {
+        CHECK(std::string_view { List[2 * index] } == ProfileParameters[index].name);
+        CHECK(std::string_view { List[(2 * index) + 1] } == ProfileParameters[index].value);
+    }
+    CHECK(List.back() == nullptr);
+}
diff --git a/src/vtextension/wasm/host/Sandbox_win32.cpp b/src/vtextension/wasm/host/Sandbox_win32.cpp
new file mode 100644
index 000000000..c5e647502
--- /dev/null
+++ b/src/vtextension/wasm/host/Sandbox_win32.cpp
@@ -0,0 +1,158 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The extension host's sandbox on Windows. A process enters an AppContainer only as it is created, so Contour
+// starts the host in one (ProcessIsolation::AppContainer, remote/process/AppContainer_win32.hpp) with no
+// capabilities, no child process and the kill-on-close job; what is left to the host is to verify it and to
+// add what a process may only set on itself. Its lockdown asks its token whether it runs in an AppContainer:
+// if not -- a test composition under wine, which stubs AppContainers, or a parent that did not isolate it --
+// it runs `Unsandboxed`, and says so, which a parent requiring a lockdown refuses. If so, it turns on the
+// mitigations of MitigationRows and checks that it runs in a job; any of that failing fails the lockdown,
+// and only all of it passing makes it `LockedDown`.
+//
+// Before any thread there is nothing to take: the container and the job are the parent's, and the mitigations
+// reach the whole process whenever they are set. The dynamic code policy stays off: the engine compiles a
+// module's code and makes it executable.
+#include <array>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <utility>
+
+#include <vtextension/wasm/host/Sandbox.hpp>
+
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+
+namespace vtextension::wasm::host
+{
+
+namespace
+{
+    /// One mitigation the host turns on itself: its policy, and the flags it is set to. Each policy's
+    /// structure is a union of one DWORD of flags with the bit fields that name them.
+    struct MitigationRow
+    {
+        PROCESS_MITIGATION_POLICY policy; ///< Which policy.
+        DWORD (*flags)() noexcept;        ///< Its flags, set through the bit fields' names.
+    };
+
+    static_assert(sizeof(PROCESS_MITIGATION_EXTENSION_POINT_DISABLE_POLICY) == sizeof(DWORD));
+    static_assert(sizeof(PROCESS_MITIGATION_IMAGE_LOAD_POLICY) == sizeof(DWORD));
+    static_assert(sizeof(PROCESS_MITIGATION_STRICT_HANDLE_CHECK_POLICY) == sizeof(DWORD));
+
+    /// The mitigations: no legacy extension point loads a DLL into it (AppInit DLLs, Winsock LSPs, shims), no
+    /// image loads from a remote share or with a low mandatory label, and a use of an invalid handle raises
+    /// an exception rather than fail quietly -- for good.
+    constexpr auto MitigationRows = std::array {
+        MitigationRow { .policy = ProcessExtensionPointDisablePolicy,
+                        .flags =
+                            []() noexcept {
+                                auto policy = PROCESS_MITIGATION_EXTENSION_POINT_DISABLE_POLICY {};
+                                policy.DisableExtensionPoints = 1;
+                                return policy.Flags;
+                            } },
+        MitigationRow { .policy = ProcessImageLoadPolicy,
+                        .flags =
+                            []() noexcept {
+                                auto policy = PROCESS_MITIGATION_IMAGE_LOAD_POLICY {};
+                                policy.NoRemoteImages = 1;
+                                policy.NoLowMandatoryLabelImages = 1;
+                                return policy.Flags;
+                            } },
+        MitigationRow { .policy = ProcessStrictHandleCheckPolicy,
+                        .flags =
+                            []() noexcept {
+                                auto policy = PROCESS_MITIGATION_STRICT_HANDLE_CHECK_POLICY {};
+                                policy.RaiseExceptionOnInvalidHandleReference = 1;
+                                policy.HandleExceptionsPermanentlyEnabled = 1;
+                                return policy.Flags;
+                            } },
+    };
+
+    /// What the host's token says of its container.
+    enum class TokenContainer : uint8_t
+    {
+        None,         ///< An ordinary token: it was started in no AppContainer.
+        AppContainer, ///< An AppContainer's.
+    };
+
+    /// @return The HRESULT of this thread's last error.
+    [[nodiscard]] int lastErrorCode() noexcept
+    {
+        return static_cast<int>(HRESULT_FROM_WIN32(::GetLastError()));
+    }
+
+    /// @return What this process's token says of its container; the HRESULT of why it could not be asked.
+    [[nodiscard]] std::expected<TokenContainer, int> tokenContainer() noexcept
+    {
+        auto isAppContainer = DWORD { 0 };
+        auto length = DWORD { 0 };
+        if (!::GetTokenInformation(::GetCurrentProcessToken(),
+                                   TokenIsAppContainer,
+                                   &isAppContainer,
+                                   sizeof(isAppContainer),
+                                   &length))
+            return std::unexpected(lastErrorCode());
+        return isAppContainer != 0 ? TokenContainer::AppContainer : TokenContainer::None;
+    }
+
+    /// @return A failure of @p step with @p code.
+    [[nodiscard]] std::unexpected<ConfinementFailure> failed(remote::proto::LockdownStep step,
+                                                             int code) noexcept
+    {
+        return std::unexpected(ConfinementFailure { .step = step, .code = code });
+    }
+
+    class WindowsSandbox final: public ISandbox
+    {
+      public:
+        [[nodiscard]] std::expected<void, ConfinementFailure> restrictBeforeThreads() override { return {}; }
+
+        [[nodiscard]] std::expected<void, ConfinementFailure> lockDown() override
+        {
+            using remote::proto::LockdownStep;
+            auto const container = tokenContainer();
+            if (!container)
+                return failed(LockdownStep::Container, container.error());
+            if (*container == TokenContainer::None)
+                return {};
+            for (auto const& row: MitigationRows)
+            {
+                auto flags = row.flags();
+                if (!::SetProcessMitigationPolicy(row.policy, &flags, sizeof(flags)))
+                    return failed(LockdownStep::Mitigations, lastErrorCode());
+            }
+            auto inJob = BOOL { FALSE };
+            if (!::IsProcessInJob(::GetCurrentProcess(), nullptr, &inJob))
+                return failed(LockdownStep::Container, lastErrorCode());
+            if (!inJob)
+                return failed(LockdownStep::Container,
+                              static_cast<int>(HRESULT_FROM_WIN32(ERROR_PROCESS_NOT_IN_JOB)));
+            _state = remote::proto::LockdownState::LockedDown;
+            return {};
+        }
+
+        /// @return `LockedDown` once lockDown() verified the container and set every mitigation;
+        ///         `Unsandboxed` before, and when the host runs in no container.
+        [[nodiscard]] remote::proto::LockdownState lockdownState() const noexcept override { return _state; }
+
+      private:
+        remote::proto::LockdownState _state = remote::proto::LockdownState::Unsandboxed;
+    };
+} // namespace
+
+DescriptorLimit limitOf([[maybe_unused]] HeldDescriptor descriptor)
+{
+    // The container confines what the host may open, not what each handle it holds may be used for.
+    return DescriptorLimit::Unlimited;
+}
+
+std::unique_ptr<ISandbox> makeSystemSandbox([[maybe_unused]] SandboxDescriptors descriptors,
+                                            [[maybe_unused]] GuestCode code)
+{
+    // The container names no handle: it leaves the inherited ones as they are, and refuses the host any new
+    // one it is not granted. How the engine runs code changes nothing (above).
+    return std::make_unique<WindowsSandbox>();
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/SanitizerOptions.cpp b/src/vtextension/wasm/host/SanitizerOptions.cpp
new file mode 100644
index 000000000..bba769b33
--- /dev/null
+++ b/src/vtextension/wasm/host/SanitizerOptions.cpp
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// What a sanitizer build's sandboxed process defaults its sanitizer to, whatever environment it was started
+// with: no leak check at exit. LeakSanitizer stops the world through a cloned tracer (clone, ptrace, wait4),
+// which the extension host's system call filter kills, so every exit would end in SIGSYS. Leaks are the
+// in-process HostServer tests' to find. The runtime asks for these at start; the environment's
+// ASAN_OPTIONS/LSAN_OPTIONS still override them.
+//
+// Linked as objects into each executable that locks itself down, as a static library member defining them
+// would never be pulled in over the runtime's own weak defaults. Compiled into Linux builds only: it serves
+// the Linux filter, and its assembler labels are ELF names (Mach-O's would carry a leading underscore).
+#include <vtextension/wasm/BuildInstrumentation.hpp>
+
+#if CONTOUR_BUILD_INSTRUMENTATION == 2
+// The runtime looks them up by their C names, which an assembler label gives these, so that the C++ names
+// follow the project's.
+extern "C"
+{
+    /// @return AddressSanitizer's default options for this process.
+    [[gnu::used]] char const* asanDefaultOptions() __asm__("__asan_default_options");
+    /// @return LeakSanitizer's default options for this process.
+    [[gnu::used]] char const* lsanDefaultOptions() __asm__("__lsan_default_options");
+}
+
+char const* asanDefaultOptions()
+{
+    return "detect_leaks=0";
+}
+
+char const* lsanDefaultOptions()
+{
+    return "detect_leaks=0";
+}
+#endif
diff --git a/src/vtextension/wasm/host/linux/Landlock.cpp b/src/vtextension/wasm/host/linux/Landlock.cpp
new file mode 100644
index 000000000..cb8d72b9e
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/Landlock.cpp
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/host/linux/Landlock.hpp>
+
+#include <sys/syscall.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <ranges>
+
+#include <unistd.h>
+
+#include <vtextension/wasm/host/linux/SystemCallRows.hpp>
+
+namespace vtextension::wasm::host
+{
+
+namespace
+{
+    // File system rights, by the ABI that added them (LANDLOCK_ACCESS_FS_*).
+    constexpr auto FirstFsRights = uint64_t { 0b1'1111'1111'1111 }; // EXECUTE … MAKE_SYM
+    constexpr auto Refer = uint64_t { 0b10'0000'0000'0000 };
+    constexpr auto IoctlDevice = uint64_t { 0b1000'0000'0000'0000 };
+    constexpr auto ResolveUnix = uint64_t { 0b1'0000'0000'0000'0000 };
+    // Network rights (LANDLOCK_ACCESS_NET_*).
+    constexpr auto BindTcp = uint64_t { 0b0001 };
+    constexpr auto ConnectTcp = uint64_t { 0b0010 };
+    constexpr auto BindUdp = uint64_t { 0b0100 };
+    constexpr auto ConnectSendUdp = uint64_t { 0b1000 };
+    // Scopes (LANDLOCK_SCOPE_*).
+    constexpr auto AbstractUnixSocket = uint64_t { 0b01 };
+    constexpr auto Signal = uint64_t { 0b10 };
+    // landlock_restrict_self() flags (LANDLOCK_RESTRICT_SELF_*).
+    constexpr auto ThreadSync = uint32_t { 0b1000 };
+    // landlock_create_ruleset()'s flag asking for the ABI version.
+    constexpr auto RulesetVersion = uint32_t { 0b0001 };
+    // landlock_add_rule()'s rule type of a directory and what lies beneath it.
+    constexpr auto RulePathBeneath = 1;
+
+    constexpr auto Abi2Fs = FirstFsRights | Refer;
+    constexpr auto Abi3Fs = Abi2Fs | LandlockTruncate;
+    constexpr auto Abi5Fs = Abi3Fs | IoctlDevice;
+    constexpr auto Abi9Fs = Abi5Fs | ResolveUnix;
+    constexpr auto TcpRights = BindTcp | ConnectTcp;
+    constexpr auto AllNetRights = TcpRights | BindUdp | ConnectSendUdp;
+    constexpr auto AllScopes = AbstractUnixSocket | Signal;
+
+    // Each ABI as the kernel's Documentation/userspace-api/landlock.rst lists what it added.
+    constexpr auto AbiTable = std::array {
+        LandlockAbiRow {
+            .abi = 1, .fsRights = FirstFsRights, .netRights = 0, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow { .abi = 2, .fsRights = Abi2Fs, .netRights = 0, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow { .abi = 3, .fsRights = Abi3Fs, .netRights = 0, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow {
+            .abi = 4, .fsRights = Abi3Fs, .netRights = TcpRights, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow {
+            .abi = 5, .fsRights = Abi5Fs, .netRights = TcpRights, .scopes = 0, .restrictFlags = 0 },
+        LandlockAbiRow {
+            .abi = 6, .fsRights = Abi5Fs, .netRights = TcpRights, .scopes = AllScopes, .restrictFlags = 0 },
+        LandlockAbiRow {
+            .abi = 7, .fsRights = Abi5Fs, .netRights = TcpRights, .scopes = AllScopes, .restrictFlags = 0 },
+        LandlockAbiRow { .abi = 8,
+                         .fsRights = Abi5Fs,
+                         .netRights = TcpRights,
+                         .scopes = AllScopes,
+                         .restrictFlags = ThreadSync },
+        LandlockAbiRow { .abi = 9,
+                         .fsRights = Abi9Fs,
+                         .netRights = TcpRights,
+                         .scopes = AllScopes,
+                         .restrictFlags = ThreadSync },
+        LandlockAbiRow { .abi = 10,
+                         .fsRights = Abi9Fs,
+                         .netRights = AllNetRights,
+                         .scopes = AllScopes,
+                         .restrictFlags = ThreadSync },
+    };
+
+    /// What landlock_add_rule() is given for a LANDLOCK_RULE_PATH_BENEATH rule, laid out as the kernel's.
+    struct [[gnu::packed]] PathBeneathAttr
+    {
+        uint64_t allowedAccess;
+        int32_t parentFd;
+    };
+
+    /// @return @p result, a raw system call's, as the result or `-errno`.
+    [[nodiscard]] long resultOrError(long result) noexcept
+    {
+        return result < 0 ? -errno : result;
+    }
+
+    /// @return The number of @p call here.
+    [[nodiscard]] long numberOf(SystemCall call) noexcept
+    {
+        return systemCallNumber(call, ThisAuditArch).value_or(NoSystemCall);
+    }
+
+    [[nodiscard]] bool isUnavailable(long error) noexcept
+    {
+        return error == -ENOSYS || error == -EOPNOTSUPP;
+    }
+
+    [[nodiscard]] ConfinementFailure fileSystemFailure(long error) noexcept
+    {
+        return ConfinementFailure { .step = remote::proto::LockdownStep::FileSystem,
+                                    .code = static_cast<int>(-error) };
+    }
+    /// Enforces @p abi's ruleset, granting @p allowed beneath it.
+    /// @return `Restricted`, or `Unavailable` where the ruleset cannot be made; the `-errno` of any other
+    ///         failure.
+    [[nodiscard]] std::expected<LandlockOutcome, long> enforceAbi(LandlockAbiRow const& abi,
+                                                                  std::span<PathBeneathRule const> allowed,
+                                                                  LandlockSystem const& system)
+    {
+        auto const attr = LandlockRulesetAttr { .handledAccessFs = abi.fsRights,
+                                                .handledAccessNet = abi.netRights,
+                                                .scoped = abi.scopes };
+        auto const ruleset = system.createRuleset(&attr, sizeof(attr), 0);
+        if (isUnavailable(ruleset))
+            return LandlockOutcome::Unavailable;
+        if (ruleset < 0)
+            return std::unexpected(ruleset);
+        auto const descriptor = static_cast<int>(ruleset);
+        auto const enforced = [&]() -> std::expected<LandlockOutcome, long> {
+            for (auto const& rule: allowed)
+            {
+                auto const granted = PathBeneathRule { .parent = rule.parent,
+                                                       .allowedAccess = rule.allowedAccess & abi.fsRights };
+                if (auto const added = system.addPathBeneathRule(descriptor, granted); added < 0)
+                    return std::unexpected(added);
+            }
+            if (auto const restricted = system.restrictSelf(descriptor, abi.restrictFlags); restricted < 0)
+                return std::unexpected(restricted);
+            return LandlockOutcome::Restricted;
+        }();
+        system.closeRuleset(descriptor);
+        return enforced;
+    }
+} // namespace
+
+std::span<LandlockAbiRow const> landlockAbis() noexcept
+{
+    return AbiTable;
+}
+
+LandlockSystem systemLandlock() noexcept
+{
+    return LandlockSystem {
+        .createRuleset =
+            [](LandlockRulesetAttr const* attr, std::size_t size, uint32_t flags) noexcept {
+                return resultOrError(
+                    ::syscall(numberOf(SystemCall::LandlockCreateRuleset), attr, size, flags));
+            },
+        .addPathBeneathRule =
+            [](int ruleset, PathBeneathRule rule) noexcept {
+                auto const attr =
+                    PathBeneathAttr { .allowedAccess = rule.allowedAccess, .parentFd = rule.parent };
+                return resultOrError(
+                    ::syscall(numberOf(SystemCall::LandlockAddRule), ruleset, RulePathBeneath, &attr, 0U));
+            },
+        .restrictSelf =
+            [](int ruleset, uint32_t flags) noexcept {
+                return resultOrError(::syscall(numberOf(SystemCall::LandlockRestrictSelf), ruleset, flags));
+            },
+        .closeRuleset = [](int ruleset) noexcept { ::close(ruleset); },
+    };
+}
+
+std::expected<LandlockOutcome, ConfinementFailure> restrictFileSystem(
+    std::span<PathBeneathRule const> allowed, LandlockSystem const& system)
+{
+    auto const version = system.createRuleset(nullptr, 0, RulesetVersion);
+    if (isUnavailable(version))
+        return LandlockOutcome::Unavailable;
+    if (version < 0)
+        return std::unexpected(fileSystemFailure(version));
+    // The best ABI both know: the kernel's, or our newest if the kernel's is newer still. Should the kernel
+    // refuse what our row claims for its ABI (EINVAL: a right, scope or flag it does not know), the row
+    // before it is tried, down to the first: a wrong row of ours costs that ABI's additions, not every
+    // extension.
+    auto refused = false;
+    for (auto const& abi: AbiTable | std::views::reverse)
+    {
+        if (abi.abi > version)
+            continue;
+        auto const enforced = enforceAbi(abi, allowed, system);
+        if (enforced || enforced.error() != -EINVAL)
+            return enforced.transform_error(&fileSystemFailure);
+        refused = true;
+    }
+    if (refused)
+        return std::unexpected(fileSystemFailure(-EINVAL));
+    return LandlockOutcome::Unavailable;
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/linux/Landlock.hpp b/src/vtextension/wasm/host/linux/Landlock.hpp
new file mode 100644
index 000000000..c599bb915
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/Landlock.hpp
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host's file system restriction on Linux: a Landlock ruleset that handles every right the
+/// kernel's ABI knows and grants none (but an instrumented build's own), enforced on every thread where the
+/// ABI can, and on every thread started later in any case.
+///
+/// The ABI's rights and flags are our own constants, ABI by ABI: the headers a build sees may be older than
+/// the kernel it runs on. A kernel without Landlock, or one whose Landlock is off, is no failure: the system
+/// call filter confines the host alone there.
+
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <span>
+
+#include <vtextension/wasm/host/Sandbox.hpp>
+
+namespace vtextension::wasm::host
+{
+
+/// What one Landlock ABI handles, cumulatively.
+struct LandlockAbiRow
+{
+    int abi;                ///< The ABI version, as landlock_create_ruleset() reports it.
+    uint64_t fsRights;      ///< Every file system right it knows (LANDLOCK_ACCESS_FS_*).
+    uint64_t netRights;     ///< Every network right it knows (LANDLOCK_ACCESS_NET_*).
+    uint64_t scopes;        ///< Every scope it knows (LANDLOCK_SCOPE_*).
+    uint32_t restrictFlags; ///< What landlock_restrict_self() is passed: TSYNC where it has it.
+};
+
+/// @return One row per ABI version from 1, in order.
+[[nodiscard]] std::span<LandlockAbiRow const> landlockAbis() noexcept;
+
+// Landlock's file system rights an instrumented build grants itself: our values of LANDLOCK_ACCESS_FS_*.
+inline constexpr auto LandlockReadFile = uint64_t { 0b0100 };           ///< LANDLOCK_ACCESS_FS_READ_FILE.
+inline constexpr auto LandlockWriteFile = uint64_t { 0b0010 };          ///< LANDLOCK_ACCESS_FS_WRITE_FILE.
+inline constexpr auto LandlockReadDirectory = uint64_t { 0b1000 };      ///< LANDLOCK_ACCESS_FS_READ_DIR.
+inline constexpr auto LandlockMakeRegular = uint64_t { 0b1'0000'0000 }; ///< LANDLOCK_ACCESS_FS_MAKE_REG.
+inline constexpr auto LandlockTruncate = uint64_t { 0b100'0000'0000'0000 }; ///< LANDLOCK_ACCESS_FS_TRUNCATE.
+
+/// What landlock_create_ruleset() is given: the fields every ABI up to the scopes knows.
+struct LandlockRulesetAttr
+{
+    uint64_t handledAccessFs;  ///< The file system rights handled: denied unless a rule grants them.
+    uint64_t handledAccessNet; ///< The network rights handled.
+    uint64_t scoped;           ///< The scopes restricted.
+};
+
+/// A directory beneath which some rights are granted.
+struct PathBeneathRule
+{
+    int parent;             ///< The directory, opened O_PATH; the caller's to close.
+    uint64_t allowedAccess; ///< What is granted beneath it; reduced to what the ABI handles.
+};
+
+/// The Landlock system calls, injectable. Each returns what the system call returns, or `-errno` on failure.
+struct LandlockSystem
+{
+    /// landlock_create_ruleset(); with a null attribute, size 0 and flag VERSION, the ABI version.
+    long (*createRuleset)(LandlockRulesetAttr const* attr, std::size_t size, uint32_t flags) noexcept;
+    /// landlock_add_rule() of a LANDLOCK_RULE_PATH_BENEATH rule.
+    long (*addPathBeneathRule)(int ruleset, PathBeneathRule rule) noexcept;
+    /// landlock_restrict_self().
+    long (*restrictSelf)(int ruleset, uint32_t flags) noexcept;
+    /// Closes a ruleset's descriptor.
+    void (*closeRuleset)(int ruleset) noexcept;
+};
+
+/// @return The kernel's Landlock system calls.
+[[nodiscard]] LandlockSystem systemLandlock() noexcept;
+
+/// Whether the file system was restricted.
+enum class LandlockOutcome : uint8_t
+{
+    Unavailable, ///< The kernel has no Landlock, or it is off: nothing was restricted, and nothing failed.
+    Restricted,  ///< Every right the best ABI knows is handled, and the threads it reaches restricted.
+};
+
+/// Restricts the calling thread -- every thread, where the ABI has TSYNC -- and the threads it starts later
+/// to the rights @p allowed grants, under the best ABI both the kernel and landlockAbis() know. The thread
+/// must have no_new_privs set.
+/// @param allowed What is granted, beneath which directories.
+/// @param system The system calls.
+/// @return `Restricted`, or `Unavailable` where the kernel has no Landlock (`ENOSYS`) or has it off
+///         (`EOPNOTSUPP`); `FileSystem` with the errno on any other failure.
+[[nodiscard]] std::expected<LandlockOutcome, ConfinementFailure> restrictFileSystem(
+    std::span<PathBeneathRule const> allowed, LandlockSystem const& system);
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/linux/Landlock_test.cpp b/src/vtextension/wasm/host/linux/Landlock_test.cpp
new file mode 100644
index 000000000..b3631ecdd
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/Landlock_test.cpp
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The file system restriction against a fake kernel: which ABI it uses, what it hands the kernel, and which
+// of the kernel's answers are failures.
+#include <catch2/catch_test_macros.hpp>
+
+#include <cerrno>
+#include <cstdint>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <utility>
+#include <vector>
+
+#include <linux/landlock.h>
+#include <vtextension/wasm/host/linux/Landlock.hpp>
+
+using namespace vtextension::wasm::host;
+using vtextension::wasm::remote::proto::LockdownStep;
+
+namespace
+{
+
+/// What the fake system calls answer: an ABI or a descriptor, or `-errno`.
+struct Answers
+{
+    long version = 0;    ///< The version query.
+    long created = 0;    ///< Creating the ruleset.
+    long restricted = 0; ///< Restricting.
+    /// The file system rights it does not know: a ruleset handling any of them is refused with EINVAL.
+    uint64_t unknownFsRights = 0;
+    /// Likewise its unknown network rights.
+    uint64_t unknownNetRights = 0;
+    /// Likewise its unknown flags of landlock_restrict_self().
+    uint32_t unknownRestrictFlags = 0;
+};
+
+/// The kernel the fake system calls answer as, and what they were asked. One case at a time.
+struct FakeKernel
+{
+    Answers answers;                         ///< What they answer.
+    std::optional<LandlockRulesetAttr> attr; ///< What the ruleset was created with.
+    std::vector<PathBeneathRule> rules;      ///< What was added.
+    std::optional<uint32_t> restrictFlags;   ///< What restricting was passed.
+    std::vector<int> closed;                 ///< What was closed.
+    int attempts = 0;                        ///< How many rulesets it was asked to create.
+};
+
+/// @return The fake kernel the fake system calls answer as: they are plain functions, which capture nothing.
+[[nodiscard]] FakeKernel& kernel()
+{
+    static auto instance = FakeKernel {};
+    return instance;
+}
+
+constexpr auto Ruleset = 42;
+
+[[nodiscard]] LandlockSystem fakeSystem(Answers answers)
+{
+    kernel() = FakeKernel {
+        .answers = answers, .attr = {}, .rules = {}, .restrictFlags = {}, .closed = {}, .attempts = 0
+    };
+    return LandlockSystem {
+        .createRuleset =
+            [](LandlockRulesetAttr const* attr, std::size_t size, uint32_t flags) noexcept -> long {
+            if (attr == nullptr)
+                return size == 0 && flags == 1 ? kernel().answers.version : -EINVAL;
+            kernel().attr = *attr;
+            kernel().attempts += 1;
+            if ((attr->handledAccessFs & kernel().answers.unknownFsRights) != 0
+                || (attr->handledAccessNet & kernel().answers.unknownNetRights) != 0)
+                return -EINVAL;
+            return kernel().answers.created;
+        },
+        .addPathBeneathRule = [](int ruleset, PathBeneathRule rule) noexcept -> long {
+            if (ruleset != Ruleset)
+                return -EBADF;
+            kernel().rules.push_back(rule);
+            return 0;
+        },
+        .restrictSelf = [](int ruleset, uint32_t flags) noexcept -> long {
+            if (ruleset != Ruleset)
+                return -EBADF;
+            kernel().restrictFlags = flags;
+            if ((flags & kernel().answers.unknownRestrictFlags) != 0)
+                return -EINVAL;
+            return kernel().answers.restricted;
+        },
+        .closeRuleset = [](int ruleset) noexcept { kernel().closed.push_back(ruleset); },
+    };
+}
+
+[[nodiscard]] LandlockAbiRow const& abiRow(int abi)
+{
+    return landlockAbis()[static_cast<std::size_t>(abi - 1)];
+}
+
+} // namespace
+
+TEST_CASE("Landlock.abiTableIsMonotonic", "[vtextension][sandbox]")
+{
+    auto const abis = landlockAbis();
+    REQUIRE_FALSE(abis.empty());
+    CHECK(abis.front().abi == 1);
+    for (auto const index: std::views::iota(std::size_t { 1 }, abis.size()))
+    {
+        auto const& before = abis[index - 1];
+        auto const& row = abis[index];
+        INFO("ABI " << row.abi);
+        CHECK(row.abi == before.abi + 1);
+        // Each ABI knows all its predecessor knew.
+        CHECK((row.fsRights & before.fsRights) == before.fsRights);
+        CHECK((row.netRights & before.netRights) == before.netRights);
+        CHECK((row.scopes & before.scopes) == before.scopes);
+        CHECK((row.restrictFlags & before.restrictFlags) == before.restrictFlags);
+    }
+    // Network rights from 4, scopes from 6, TSYNC from 8.
+    CHECK(abiRow(3).netRights == 0);
+    CHECK(abiRow(4).netRights != 0);
+    CHECK(abiRow(5).scopes == 0);
+    CHECK(abiRow(6).scopes != 0);
+    CHECK(abiRow(7).restrictFlags == 0);
+    CHECK(abiRow(8).restrictFlags != 0);
+}
+
+TEST_CASE("Landlock.usesTheBestAbiTheKernelHas", "[vtextension][sandbox]")
+{
+    auto const directory =
+        PathBeneathRule { .parent = 5, .allowedAccess = LandlockReadFile | LandlockTruncate };
+
+    SECTION("ABI 3: no network rights, no scopes, no TSYNC")
+    {
+        auto const restricted = restrictFileSystem(std::span { &directory, 1 },
+                                                   fakeSystem(Answers { .version = 3, .created = Ruleset }));
+        REQUIRE(restricted == LandlockOutcome::Restricted);
+        REQUIRE(kernel().attr.has_value());
+        CHECK(kernel().attr->handledAccessFs == abiRow(3).fsRights);
+        CHECK(kernel().attr->handledAccessNet == 0);
+        CHECK(kernel().attr->scoped == 0);
+        CHECK(kernel().restrictFlags == 0U);
+        REQUIRE(kernel().rules.size() == 1);
+        CHECK(kernel().rules.front().parent == 5);
+        CHECK(kernel().rules.front().allowedAccess == (LandlockReadFile | LandlockTruncate));
+    }
+    SECTION("ABI 2 grants no right it does not handle")
+    {
+        REQUIRE(restrictFileSystem(std::span { &directory, 1 },
+                                   fakeSystem(Answers { .version = 2, .created = Ruleset }))
+                == LandlockOutcome::Restricted);
+        REQUIRE(kernel().rules.size() == 1);
+        CHECK(kernel().rules.front().allowedAccess == LandlockReadFile);
+    }
+    SECTION("ABI 8 and later: TSYNC; a kernel newer than the table gets the table's best")
+    {
+        for (auto const version: { 8L, 10L, 99L })
+        {
+            REQUIRE(restrictFileSystem({}, fakeSystem(Answers { .version = version, .created = Ruleset }))
+                    == LandlockOutcome::Restricted);
+            auto const& best = version > landlockAbis().back().abi ? landlockAbis().back()
+                                                                   : abiRow(static_cast<int>(version));
+            REQUIRE(kernel().attr.has_value());
+            CHECK(kernel().attr->handledAccessFs == best.fsRights);
+            CHECK(kernel().attr->handledAccessNet == best.netRights);
+            CHECK(kernel().attr->scoped == best.scopes);
+            CHECK(kernel().restrictFlags == best.restrictFlags);
+            CHECK((best.restrictFlags & 0b1000U) != 0);
+            CHECK(kernel().closed == std::vector<int> { Ruleset });
+        }
+    }
+}
+
+TEST_CASE("Landlock.unavailableIsNotAFailure", "[vtextension][sandbox]")
+{
+    for (auto const error: { ENOSYS, EOPNOTSUPP })
+    {
+        INFO(error);
+        // Asked of the version, or of the ruleset.
+        CHECK(restrictFileSystem({}, fakeSystem(Answers { .version = -error }))
+              == LandlockOutcome::Unavailable);
+        CHECK(kernel().closed.empty());
+        CHECK(restrictFileSystem({}, fakeSystem(Answers { .version = 6, .created = -error }))
+              == LandlockOutcome::Unavailable);
+        CHECK_FALSE(kernel().restrictFlags.has_value());
+    }
+}
+
+TEST_CASE("Landlock.otherErrorsAreFailures", "[vtextension][sandbox]")
+{
+    // Restricting without no_new_privs.
+    auto const restricted = restrictFileSystem(
+        {}, fakeSystem(Answers { .version = 10, .created = Ruleset, .restricted = -EPERM }));
+    REQUIRE_FALSE(restricted.has_value());
+    CHECK(restricted.error() == ConfinementFailure { .step = LockdownStep::FileSystem, .code = EPERM });
+    CHECK(kernel().closed == std::vector<int> { Ruleset });
+
+    // Anything else the version query or the ruleset's creation says.
+    CHECK(restrictFileSystem({}, fakeSystem(Answers { .version = -EFAULT })).error()
+          == ConfinementFailure { .step = LockdownStep::FileSystem, .code = EFAULT });
+    CHECK(restrictFileSystem({}, fakeSystem(Answers { .version = 4, .created = -ENOMEM })).error()
+          == ConfinementFailure { .step = LockdownStep::FileSystem, .code = ENOMEM });
+}
+
+TEST_CASE("Landlock.aKernelRefusingAnAbiRowFallsBackToTheOneBefore", "[vtextension][sandbox]")
+{
+    // A kernel that says ABI 10 but refuses the UDP rights row 10 adds: restricted at row 9.
+    auto const udp = abiRow(10).netRights & ~abiRow(9).netRights;
+    REQUIRE(udp != 0);
+    REQUIRE(restrictFileSystem(
+                {}, fakeSystem(Answers { .version = 10, .created = Ruleset, .unknownNetRights = udp }))
+            == LandlockOutcome::Restricted);
+    REQUIRE(kernel().attr.has_value());
+    CHECK(kernel().attr->handledAccessFs == abiRow(9).fsRights);
+    CHECK(kernel().attr->handledAccessNet == abiRow(9).netRights);
+    CHECK(kernel().restrictFlags == abiRow(9).restrictFlags);
+    CHECK(kernel().attempts == 2);
+
+    // One that refuses TSYNC at restricting: restricted at row 7, every ruleset made closed again.
+    auto const threadSync = abiRow(8).restrictFlags;
+    REQUIRE(
+        restrictFileSystem(
+            {}, fakeSystem(Answers { .version = 10, .created = Ruleset, .unknownRestrictFlags = threadSync }))
+        == LandlockOutcome::Restricted);
+    CHECK(kernel().attr->handledAccessFs == abiRow(7).fsRights);
+    CHECK(kernel().restrictFlags == 0U);
+    CHECK(kernel().closed.size() == 4);
+
+    // One that refuses even the first row's rights fails, after trying every row it could have.
+    auto const refusedEverywhere = restrictFileSystem(
+        {}, fakeSystem(Answers { .version = 5, .created = Ruleset, .unknownFsRights = abiRow(1).fsRights }));
+    REQUIRE_FALSE(refusedEverywhere.has_value());
+    CHECK(refusedEverywhere.error()
+          == ConfinementFailure { .step = LockdownStep::FileSystem, .code = EINVAL });
+    CHECK(kernel().attempts == 5);
+
+    // Any other error is no reason to try an older row.
+    REQUIRE_FALSE(
+        restrictFileSystem({}, fakeSystem(Answers { .version = 10, .created = -ENOMEM })).has_value());
+    CHECK(kernel().attempts == 1);
+}
+
+TEST_CASE("Landlock.abiTableAgreesWithTheSystemHeaders", "[vtextension][sandbox]")
+{
+    // Where this build's headers name a constant, our table's value is the kernel's: each ABI's additions.
+    auto const added = [](auto LandlockAbiRow::* field, int abi) {
+        return abiRow(abi).*field & ~(abi > 1 ? abiRow(abi - 1).*field : decltype(abiRow(abi).*field) {});
+    };
+#ifdef LANDLOCK_ACCESS_FS_MAKE_SYM
+    CHECK(added(&LandlockAbiRow::fsRights, 1) == ((LANDLOCK_ACCESS_FS_MAKE_SYM << 1U) - 1U));
+#endif
+#ifdef LANDLOCK_ACCESS_FS_REFER
+    CHECK(added(&LandlockAbiRow::fsRights, 2) == LANDLOCK_ACCESS_FS_REFER);
+#endif
+#ifdef LANDLOCK_ACCESS_FS_TRUNCATE
+    CHECK(added(&LandlockAbiRow::fsRights, 3) == LANDLOCK_ACCESS_FS_TRUNCATE);
+    CHECK(LandlockTruncate == LANDLOCK_ACCESS_FS_TRUNCATE);
+#endif
+#ifdef LANDLOCK_ACCESS_NET_BIND_TCP
+    CHECK(added(&LandlockAbiRow::netRights, 4)
+          == (LANDLOCK_ACCESS_NET_BIND_TCP | LANDLOCK_ACCESS_NET_CONNECT_TCP));
+#endif
+#ifdef LANDLOCK_ACCESS_FS_IOCTL_DEV
+    CHECK(added(&LandlockAbiRow::fsRights, 5) == LANDLOCK_ACCESS_FS_IOCTL_DEV);
+#endif
+#ifdef LANDLOCK_SCOPE_SIGNAL
+    CHECK(added(&LandlockAbiRow::scopes, 6) == (LANDLOCK_SCOPE_ABSTRACT_UNIX_SOCKET | LANDLOCK_SCOPE_SIGNAL));
+#endif
+#ifdef LANDLOCK_RESTRICT_SELF_TSYNC
+    CHECK(added(&LandlockAbiRow::restrictFlags, 8) == LANDLOCK_RESTRICT_SELF_TSYNC);
+#endif
+#ifdef LANDLOCK_ACCESS_FS_RESOLVE_UNIX
+    CHECK(added(&LandlockAbiRow::fsRights, 9) == LANDLOCK_ACCESS_FS_RESOLVE_UNIX);
+#endif
+#ifdef LANDLOCK_ACCESS_NET_BIND_UDP
+    CHECK(added(&LandlockAbiRow::netRights, 10)
+          == (LANDLOCK_ACCESS_NET_BIND_UDP | LANDLOCK_ACCESS_NET_CONNECT_SEND_UDP));
+#endif
+    CHECK(LandlockReadFile == LANDLOCK_ACCESS_FS_READ_FILE);
+    CHECK(LandlockWriteFile == LANDLOCK_ACCESS_FS_WRITE_FILE);
+    CHECK(LandlockReadDirectory == LANDLOCK_ACCESS_FS_READ_DIR);
+    CHECK(LandlockMakeRegular == LANDLOCK_ACCESS_FS_MAKE_REG);
+}
diff --git a/src/vtextension/wasm/host/linux/SeccompFilter.cpp b/src/vtextension/wasm/host/linux/SeccompFilter.cpp
new file mode 100644
index 000000000..fdbd7ba47
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/SeccompFilter.cpp
@@ -0,0 +1,280 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/host/linux/SeccompFilter.hpp>
+
+#include <sys/syscall.h>
+
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <limits>
+#include <optional>
+#include <ranges>
+#include <type_traits>
+#include <utility>
+
+#include <unistd.h>
+
+#include <linux/bpf_common.h>
+#include <linux/seccomp.h>
+
+namespace vtextension::wasm::host
+{
+
+namespace
+{
+    /// The bit x86_64 sets in the number of an x32 call, which must not reach the rows.
+    constexpr auto X32SystemCallBit = uint32_t { 0x4000'0000 };
+
+    /// The most errno a seccomp return carries.
+    constexpr auto MaxErrno = 4095;
+
+    /// The most a conditional jump skips.
+    constexpr auto MaxJump = std::size_t { std::numeric_limits<uint8_t>::max() };
+
+    /// Where `seccomp_data`'s fields are, for an absolute load.
+    constexpr auto NumberOffset = uint32_t { offsetof(seccomp_data, nr) };
+    constexpr auto ArchOffset = uint32_t { offsetof(seccomp_data, arch) };
+    constexpr auto ArgumentsOffset = uint32_t { offsetof(seccomp_data, args) };
+
+    /// The words a 64-bit argument is loaded as: little-endian on both architectures.
+    enum class Half : uint8_t
+    {
+        Low,
+        High,
+    };
+
+    /// @return The offset of @p half of argument @p index.
+    constexpr uint32_t offsetOf(uint8_t index, Half half) noexcept
+    {
+        return ArgumentsOffset + (uint32_t { index } * sizeof(uint64_t))
+               + (half == Half::High ? sizeof(uint32_t) : 0);
+    }
+
+    /// @return The 32 bits of @p value that @p half names.
+    constexpr uint32_t halfOf(uint64_t value, Half half) noexcept
+    {
+        return static_cast<uint32_t>(half == Half::High ? value >> 32U : value);
+    }
+
+    constexpr sock_filter statement(uint16_t code, uint32_t operand) noexcept
+    {
+        return sock_filter { .code = code, .jt = 0, .jf = 0, .k = operand };
+    }
+
+    constexpr sock_filter jump(uint16_t code, uint32_t operand, uint8_t whenTrue, uint8_t whenFalse) noexcept
+    {
+        return sock_filter { .code = code, .jt = whenTrue, .jf = whenFalse, .k = operand };
+    }
+
+    constexpr auto LoadWord = uint16_t { BPF_LD | BPF_W | BPF_ABS };
+    constexpr auto AndConstant = uint16_t { BPF_ALU | BPF_AND | BPF_K };
+    constexpr auto JumpIfEqual = uint16_t { BPF_JMP | BPF_JEQ | BPF_K };
+    constexpr auto JumpIfAtLeast = uint16_t { BPF_JMP | BPF_JGE | BPF_K };
+    constexpr auto Return = uint16_t { BPF_RET | BPF_K };
+
+    /// When a comparison passes.
+    enum class Sense : uint8_t
+    {
+        Equal,     ///< When the masked argument equals the value.
+        Different, ///< When it differs from it.
+    };
+
+    /// A check, as the program tests it: its masked argument against a value.
+    struct Comparison
+    {
+        uint8_t index;
+        uint64_t mask;
+        uint64_t value;
+        Sense sense;
+    };
+
+    /// The branches of a conditional jump.
+    enum class Branch : uint8_t
+    {
+        WhenFalse,
+        WhenTrue,
+    };
+
+    /// @return @p check as a comparison, the descriptors and process filled in.
+    [[nodiscard]] Comparison comparisonOf(ArgumentCheck const& check,
+                                          SandboxDescriptors const& descriptors,
+                                          int ownProcess) noexcept
+    {
+        auto const fixed = [&](uint64_t value) {
+            return Comparison {
+                .index = check.index, .mask = check.mask, .value = value, .sense = Sense::Equal
+            };
+        };
+        switch (check.test)
+        {
+            case ArgumentTest::Equals: return fixed(check.value & check.mask);
+            case ArgumentTest::NotEquals:
+                return Comparison { .index = check.index,
+                                    .mask = check.mask,
+                                    .value = check.value & check.mask,
+                                    .sense = Sense::Different };
+            case ArgumentTest::AllClear: return fixed(0);
+            case ArgumentTest::AllSet: return fixed(check.mask);
+            case ArgumentTest::EqualsControl:
+                return fixed(static_cast<uint64_t>(static_cast<uint32_t>(descriptors.control)) & check.mask);
+            case ArgumentTest::EqualsOwnProcess:
+                return fixed(static_cast<uint64_t>(static_cast<uint32_t>(ownProcess)) & check.mask);
+        }
+        return fixed(check.value);
+    }
+
+    /// A row's body as it is assembled: its instructions, and the jumps to patch once their targets are
+    /// known.
+    class RowBody
+    {
+      public:
+        /// Appends the test of @p comparison; failing it jumps to the row's failure return.
+        void compare(Comparison const& comparison)
+        {
+            auto halves = std::vector<Half> {};
+            for (auto const half: { Half::Low, Half::High })
+                if (halfOf(comparison.mask, half) != 0)
+                    halves.push_back(half);
+            auto passes = std::vector<std::size_t> {};
+            for (auto const position: std::views::iota(std::size_t { 0 }, halves.size()))
+            {
+                auto const half = halves[position];
+                auto const isLast = position + 1 == halves.size();
+                _program.push_back(statement(LoadWord, offsetOf(comparison.index, half)));
+                if (halfOf(comparison.mask, half) != std::numeric_limits<uint32_t>::max())
+                    _program.push_back(statement(AndConstant, halfOf(comparison.mask, half)));
+                _program.push_back(jump(JumpIfEqual, halfOf(comparison.value, half), 0, 0));
+                auto const at = _program.size() - 1;
+                if (comparison.sense == Sense::Equal)
+                    _fails.push_back(Patch { .at = at, .branch = Branch::WhenFalse });
+                else if (isLast)
+                    _fails.push_back(Patch { .at = at, .branch = Branch::WhenTrue });
+                else
+                    passes.push_back(at); // this half differs: the whole differs
+            }
+            for (auto const at: passes)
+                _program.at(at).jf = static_cast<uint8_t>(_program.size() - (at + 1));
+        }
+
+        /// Ends the body with @p decision, and the return its failed checks jump to.
+        /// @param decision What the row decides when its checks pass.
+        /// @param failed What it decides when one fails: the filter's unlisted action.
+        /// @return The body; nothing if a jump would exceed what an instruction reaches.
+        [[nodiscard]] std::optional<std::vector<sock_filter>> finish(uint32_t decision, uint32_t failed) &&
+        {
+            _program.push_back(statement(Return, decision));
+            if (_fails.empty())
+                return std::move(_program);
+            _program.push_back(statement(Return, failed));
+            auto const fail = _program.size() - 1;
+            for (auto const& patch: _fails)
+            {
+                auto const distance = fail - (patch.at + 1);
+                if (distance > MaxJump)
+                    return std::nullopt;
+                (patch.branch == Branch::WhenTrue ? _program.at(patch.at).jt : _program.at(patch.at).jf) =
+                    static_cast<uint8_t>(distance);
+            }
+            return std::move(_program);
+        }
+
+      private:
+        struct Patch
+        {
+            std::size_t at;
+            Branch branch; ///< Which branch of the jump at `at` goes to the failure return.
+        };
+        std::vector<sock_filter> _program;
+        std::vector<Patch> _fails;
+    };
+
+    [[nodiscard]] ConfinementFailure assemblyFailure(int error) noexcept
+    {
+        return ConfinementFailure { .step = remote::proto::LockdownStep::SystemCalls, .code = error };
+    }
+} // namespace
+
+uint32_t seccompReturnOf(SystemCallAction action, int error) noexcept
+{
+    switch (action)
+    {
+        case SystemCallAction::Kill: return SECCOMP_RET_KILL_PROCESS;
+        case SystemCallAction::Refuse:
+            return SECCOMP_RET_ERRNO | (static_cast<uint32_t>(error) & SECCOMP_RET_DATA);
+        case SystemCallAction::Allow: return SECCOMP_RET_ALLOW;
+    }
+    return SECCOMP_RET_KILL_PROCESS;
+}
+
+std::expected<std::vector<sock_filter>, ConfinementFailure> assembleFilter(
+    std::span<SystemCallRow const> rows,
+    SandboxDescriptors const& descriptors,
+    int ownProcess,
+    AuditArch arch)
+{
+    return assembleFilter(rows, descriptors, ownProcess, arch, SystemCallAction::Kill);
+}
+
+std::expected<std::vector<sock_filter>, ConfinementFailure> assembleFilter(
+    std::span<SystemCallRow const> rows,
+    SandboxDescriptors const& descriptors,
+    int ownProcess,
+    AuditArch arch,
+    SystemCallAction unlisted)
+{
+    auto program = std::vector<sock_filter> {
+        statement(LoadWord, ArchOffset),
+        jump(JumpIfEqual, std::to_underlying(arch), 1, 0),
+        statement(Return, SECCOMP_RET_KILL_PROCESS),
+        statement(LoadWord, NumberOffset),
+    };
+    if (arch == AuditArch::Amd64)
+    {
+        program.push_back(jump(JumpIfAtLeast, X32SystemCallBit, 0, 1));
+        program.push_back(statement(Return, SECCOMP_RET_KILL_PROCESS));
+    }
+
+    for (auto const& row: rows)
+    {
+        if (row.action == SystemCallAction::Refuse && (row.error <= 0 || row.error > MaxErrno))
+            return std::unexpected(assemblyFailure(EINVAL));
+        auto body = RowBody {};
+        for (auto const& check: row.checks)
+        {
+            if (check.index >= std::extent_v<decltype(seccomp_data::args)>)
+                return std::unexpected(assemblyFailure(EINVAL));
+            body.compare(comparisonOf(check, descriptors, ownProcess));
+        }
+        auto const assembled =
+            std::move(body).finish(seccompReturnOf(row.action, row.error), seccompReturnOf(unlisted, 0));
+        if (!assembled || assembled->size() > MaxJump)
+            return std::unexpected(assemblyFailure(E2BIG));
+        // A row whose number differs is skipped whole; the accumulator still holds the number then, as only a
+        // matching row loads its arguments, and every row that does ends in a return.
+        program.push_back(
+            jump(JumpIfEqual, static_cast<uint32_t>(row.number), 0, static_cast<uint8_t>(assembled->size())));
+        program.insert(program.end(), assembled->begin(), assembled->end());
+    }
+    program.push_back(statement(Return, seccompReturnOf(unlisted, 0)));
+    if (program.size() > BPF_MAXINSNS)
+        return std::unexpected(assemblyFailure(E2BIG));
+    return program;
+}
+
+std::expected<void, ConfinementFailure> installFilter(std::span<sock_filter const> program)
+{
+    // The kernel copies the program, through a pointer it declares mutable.
+    auto copy = std::vector<sock_filter>(program.begin(), program.end());
+    auto const filter = sock_fprog { .len = static_cast<unsigned short>(copy.size()), .filter = copy.data() };
+    auto const result = ::syscall(SYS_seccomp, SECCOMP_SET_MODE_FILTER, SECCOMP_FILTER_FLAG_TSYNC, &filter);
+    if (result == 0)
+        return {};
+    // A positive result names the thread that could not be synchronized: it runs a filter of its own.
+    if (result > 0)
+        return std::unexpected(
+            ConfinementFailure { .step = remote::proto::LockdownStep::ThreadSync, .code = EPERM });
+    return std::unexpected(
+        ConfinementFailure { .step = remote::proto::LockdownStep::SystemCalls, .code = errno });
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/linux/SeccompFilter.hpp b/src/vtextension/wasm/host/linux/SeccompFilter.hpp
new file mode 100644
index 000000000..e804b815c
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/SeccompFilter.hpp
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host's system call filter on Linux: SystemCallRows.hpp's rows, assembled by hand into the
+/// classic BPF program seccomp runs, and installed on every thread at once.
+///
+/// The program checks the architecture first (another one, or an x32 call on x86_64, kills the process),
+/// then tests each row's number in the rows' order; a row whose number matches decides when its argument
+/// checks pass. A call no row names, or one whose row's checks fail, takes the unlisted action: for the
+/// host's own filter, killing the process.
+
+#include <cstdint>
+#include <expected>
+#include <span>
+#include <vector>
+
+#include <linux/filter.h>
+#include <vtextension/wasm/host/Sandbox.hpp>
+#include <vtextension/wasm/host/linux/SystemCallRows.hpp>
+
+namespace vtextension::wasm::host
+{
+
+/// The seccomp return value of @p action.
+/// @param action What becomes of the call.
+/// @param error The errno a `Refuse` fails it with.
+/// @return SECCOMP_RET_KILL_PROCESS, SECCOMP_RET_ERRNO with @p error, or SECCOMP_RET_ALLOW.
+[[nodiscard]] uint32_t seccompReturnOf(SystemCallAction action, int error) noexcept;
+
+/// Assembles @p rows into a program that kills the process for any call they do not name.
+/// @param rows What becomes of each call named, each number at most once.
+/// @param descriptors The descriptors `EqualsControl` compares with.
+/// @param ownProcess The process id `EqualsOwnProcess` compares with.
+/// @param arch The architecture @p rows are numbered for, and the only one the program lets through.
+/// @return The program; `SystemCalls` with `E2BIG` if it exceeds what the kernel runs or a jump reaches,
+///         with `EINVAL` if a check names no argument or a `Refuse` no errno.
+[[nodiscard]] std::expected<std::vector<sock_filter>, ConfinementFailure> assembleFilter(
+    std::span<SystemCallRow const> rows,
+    SandboxDescriptors const& descriptors,
+    int ownProcess,
+    AuditArch arch);
+
+/// assembleFilter(), with the action of a call @p rows do not name given: what an outer sandbox's filter,
+/// which lets through all it does not refuse, is made of. A call whose row's argument checks fail takes
+/// @p unlisted as well, as the row does not apply to it: a row refusing one value of an argument lets every
+/// other value through an allow-by-default filter, rather than killing it.
+/// @param rows What becomes of each call named, each number at most once.
+/// @param descriptors The descriptors `EqualsControl` compares with.
+/// @param ownProcess The process id `EqualsOwnProcess` compares with.
+/// @param arch The architecture @p rows are numbered for, and the only one the program lets through.
+/// @param unlisted What becomes of a call no row names.
+/// @return The program, or why it cannot be assembled.
+[[nodiscard]] std::expected<std::vector<sock_filter>, ConfinementFailure> assembleFilter(
+    std::span<SystemCallRow const> rows,
+    SandboxDescriptors const& descriptors,
+    int ownProcess,
+    AuditArch arch,
+    SystemCallAction unlisted);
+
+/// Installs @p program on every thread of the process (SECCOMP_FILTER_FLAG_TSYNC). The calling thread must
+/// have no_new_privs set; a thread started after it inherits the filter.
+/// @param program An assembled program.
+/// @return Nothing once every thread runs it; `ThreadSync` (code `EPERM`) if a thread could not take it,
+///         which the kernel says when a thread runs a filter of its own; `SystemCalls` with the errno
+///         otherwise.
+[[nodiscard]] std::expected<void, ConfinementFailure> installFilter(std::span<sock_filter const> program);
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/linux/SeccompFilter_test.cpp b/src/vtextension/wasm/host/linux/SeccompFilter_test.cpp
new file mode 100644
index 000000000..97853e577
--- /dev/null
+++ b/src/vtextension/wasm/host/linux/SeccompFilter_test.cpp
@@ -0,0 +1,426 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The extension host's system call filter, run by a BPF evaluator rather than installed: what each call is
+// decided, on both architectures, and that no row set lets through what the sandbox exists to forbid.
+#include <catch2/catch_message.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <sys/mman.h>
+#include <sys/socket.h>
+
+#include <array>
+#include <cerrno>
+#include <cstdint>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <fcntl.h>
+
+#include <vtextension/wasm/host/linux/SeccompFilter.hpp>
+#include <vtextension/wasm/host/linux/SystemCallRows.hpp>
+#include <vtextension/wasm/host/linux/testing/BpfEvaluator.hpp>
+
+using namespace vtextension::wasm::host;
+using vtextension::wasm::BuildInstrumentation;
+using vtextension::wasm::host::testing::evaluateFilter;
+using vtextension::wasm::host::testing::FilterVerdict;
+using vtextension::wasm::host::testing::SystemCallUse;
+using vtextension::wasm::host::testing::verdictOf;
+
+namespace
+{
+
+constexpr auto Control = 7;
+constexpr auto ALane = 8;
+constexpr auto OwnProcess = 4242;
+constexpr auto OtherProcess = 1;
+
+constexpr auto Both = std::array { AuditArch::Amd64, AuditArch::AArch64 };
+
+/// @return The number of @p call on @p arch, which must have it.
+[[nodiscard]] long numberOf(SystemCall call, AuditArch arch)
+{
+    auto const number = systemCallNumber(call, arch);
+    REQUIRE(number.has_value());
+    return *number;
+}
+
+/// @return What the filter of @p instrumentation's rows on @p arch, for an engine running @p code, decides
+///         for @p call with @p arguments.
+[[nodiscard]] FilterVerdict decide(BuildInstrumentation instrumentation,
+                                   AuditArch arch,
+                                   long number,
+                                   std::array<uint64_t, 6> arguments = {},
+                                   AuditArch madeOn = AuditArch::Amd64,
+                                   GuestCode code = GuestCode::Compiled)
+{
+    auto const rows = rowsFor(code, instrumentation, arch);
+    auto const program = assembleFilter(rows, SandboxDescriptors { .control = Control }, OwnProcess, arch);
+    REQUIRE(program.has_value());
+    auto const returned =
+        evaluateFilter(*program, SystemCallUse { .arch = madeOn, .number = number, .arguments = arguments });
+    REQUIRE(returned.has_value());
+    return verdictOf(*returned);
+}
+
+constexpr auto Allowed = FilterVerdict { .action = SystemCallAction::Allow };
+constexpr auto Killed = FilterVerdict { .action = SystemCallAction::Kill };
+
+[[nodiscard]] constexpr FilterVerdict refusedWith(int error)
+{
+    return FilterVerdict { .action = SystemCallAction::Refuse, .error = error };
+}
+
+/// One call, and what the release rows decide for it.
+struct Decision
+{
+    SystemCall call = SystemCall::Read;
+    std::array<uint64_t, 6> arguments = {};
+    FilterVerdict verdict = Killed;
+    char const* what = "";
+};
+
+constexpr auto ReadWrite = uint64_t { PROT_READ | PROT_WRITE };
+constexpr auto Anonymous = uint64_t { MAP_PRIVATE | MAP_ANONYMOUS };
+
+} // namespace
+
+TEST_CASE("SeccompFilter.decidesEachRowAsItsTableSays", "[vtextension][sandbox]")
+{
+    auto const decisions = std::array {
+        Decision { SystemCall::Sendto, {}, Allowed, "send() on a channel" },
+        Decision { SystemCall::Recvfrom, {}, Allowed, "recv() on a channel" },
+        Decision { SystemCall::Futex, {}, Allowed, "a wait" },
+        Decision { SystemCall::Recvmsg, { Control }, Allowed, "recvmsg() on control" },
+        Decision { SystemCall::Recvmsg, { ALane }, Killed, "recvmsg() on a lane" },
+        Decision {
+            SystemCall::Recvmsg, { Control | (uint64_t { 1 } << 32U) }, Allowed, "an int's upper half" },
+        Decision { SystemCall::Sendmsg, { Control }, Killed, "sendmsg(), which carries descriptors" },
+        Decision { SystemCall::Sendmmsg, { Control }, Killed, "sendmmsg()" },
+        Decision { SystemCall::Socket, { AF_INET }, refusedWith(EPERM), "an internet socket" },
+        Decision { SystemCall::Socket, { AF_UNIX }, refusedWith(EPERM), "a unix socket" },
+        Decision { SystemCall::Openat, {}, refusedWith(EACCES), "a file" },
+        Decision { SystemCall::Ioctl, { 2 }, refusedWith(ENOTTY), "a terminal's question" },
+        Decision { SystemCall::Mmap,
+                   { 0, 4096, PROT_WRITE | PROT_EXEC, Anonymous },
+                   Killed,
+                   "writable and executable memory" },
+        Decision {
+            SystemCall::Mmap, { 0, 4096, PROT_READ | PROT_EXEC, Anonymous }, Killed, "executable memory" },
+        Decision { SystemCall::Mmap, { 0, 4096, ReadWrite, Anonymous }, Allowed, "private memory" },
+        Decision { SystemCall::Mmap, { 0, 4096, ReadWrite, MAP_SHARED }, Killed, "shared memory anywhere" },
+        Decision { SystemCall::Mmap,
+                   { 0, 4096, ReadWrite, MAP_SHARED_VALIDATE },
+                   Killed,
+                   "validated shared anywhere" },
+        Decision { SystemCall::Mmap,
+                   { 0x1000, 4096, ReadWrite, MAP_SHARED | MAP_FIXED, 9 },
+                   Allowed,
+                   "shared memory over a reservation" },
+        Decision { SystemCall::Mprotect, { 0x1000, 4096, PROT_WRITE | PROT_EXEC }, Killed, "W+X" },
+        Decision {
+            SystemCall::Mprotect, { 0x1000, 4096, PROT_READ | PROT_EXEC }, Allowed, "code made executable" },
+        Decision { SystemCall::Mprotect, { 0x1000, 4096, ReadWrite }, Allowed, "memory opened" },
+        Decision { SystemCall::Clone, {}, Killed, "a thread or process" },
+        Decision { SystemCall::Clone3, {}, Killed, "a thread or process" },
+        Decision { SystemCall::Execve, {}, Killed, "a program" },
+        Decision { SystemCall::Execveat, {}, Killed, "a program" },
+        Decision { SystemCall::Ptrace, {}, Killed, "tracing" },
+        Decision { SystemCall::Tgkill, { OwnProcess, 1, 6 }, Allowed, "abort()" },
+        Decision { SystemCall::Tgkill, { OtherProcess, 1, 6 }, Killed, "another process's thread" },
+        Decision { SystemCall::Kill, { OtherProcess, 0 }, Killed, "another process" },
+        Decision { SystemCall::RtSigaction, {}, Allowed, "a fault handed on to the default action" },
+        Decision { SystemCall::Writev, { 2 }, Allowed, "the C library's report of heap corruption" },
+    };
+    for (auto const arch: Both)
+    {
+        for (auto const& decision: decisions)
+        {
+            INFO((arch == AuditArch::Amd64 ? "x86_64: " : "aarch64: ") << decision.what);
+            CHECK(
+                decide(
+                    BuildInstrumentation::None, arch, numberOf(decision.call, arch), decision.arguments, arch)
+                == decision.verdict);
+        }
+        // What fork and vfork are, where they exist.
+        for (auto const call: { SystemCall::Fork, SystemCall::Vfork })
+            if (auto const number = systemCallNumber(call, arch))
+                CHECK(decide(BuildInstrumentation::None, arch, *number, {}, arch) == Killed);
+        // The coverage rows open the counter files; a sanitizer's, /proc.
+        CHECK(decide(BuildInstrumentation::Coverage, arch, numberOf(SystemCall::Openat, arch), {}, arch)
+              == Allowed);
+        CHECK(decide(BuildInstrumentation::Sanitizers, arch, numberOf(SystemCall::Openat, arch), {}, arch)
+              == Allowed);
+        // ... and coverage maps them shared, never executable.
+        auto const shared = std::array<uint64_t, 6> { 0, 4096, ReadWrite, MAP_SHARED };
+        CHECK(decide(BuildInstrumentation::Coverage, arch, numberOf(SystemCall::Mmap, arch), shared, arch)
+              == Allowed);
+        auto const executable = std::array<uint64_t, 6> { 0, 4096, PROT_READ | PROT_EXEC, MAP_SHARED };
+        CHECK(decide(BuildInstrumentation::Coverage, arch, numberOf(SystemCall::Mmap, arch), executable, arch)
+              == Killed);
+    }
+
+    // The aarch64 instruction cache is flushed with membarrier; x86_64 needs none.
+    CHECK(decide(BuildInstrumentation::None,
+                 AuditArch::AArch64,
+                 numberOf(SystemCall::Membarrier, AuditArch::AArch64),
+                 {},
+                 AuditArch::AArch64)
+          == Allowed);
+    CHECK(decide(BuildInstrumentation::None,
+                 AuditArch::Amd64,
+                 numberOf(SystemCall::Membarrier, AuditArch::Amd64))
+          == Killed);
+
+    // A foreign architecture, an x32 call and a number no row names.
+    CHECK(decide(BuildInstrumentation::None,
+                 AuditArch::Amd64,
+                 numberOf(SystemCall::Read, AuditArch::Amd64),
+                 {},
+                 AuditArch::AArch64)
+          == Killed);
+    constexpr auto X32Bit = long { 0x4000'0000 };
+    CHECK(decide(BuildInstrumentation::None,
+                 AuditArch::Amd64,
+                 X32Bit | numberOf(SystemCall::Read, AuditArch::Amd64))
+          == Killed);
+    CHECK(decide(BuildInstrumentation::None, AuditArch::Amd64, 4095) == Killed);
+    CHECK(decide(BuildInstrumentation::None, AuditArch::AArch64, 4095, {}, AuditArch::AArch64) == Killed);
+}
+
+TEST_CASE("SeccompFilter.noRowSetAllowsTheForbidden", "[vtextension][sandbox]")
+{
+    constexpr auto Forbidden = std::array {
+        SystemCall::Execve,
+        SystemCall::Execveat,
+        SystemCall::Ptrace,
+        SystemCall::ProcessVmReadv,
+        SystemCall::ProcessVmWritev,
+        SystemCall::Socket,
+        SystemCall::Connect,
+        SystemCall::Bind,
+        SystemCall::Sendmsg,
+        SystemCall::Sendmmsg,
+        SystemCall::Clone,
+        SystemCall::Clone3,
+        SystemCall::Fork,
+        SystemCall::Vfork,
+        SystemCall::Unshare,
+        SystemCall::Setns,
+        SystemCall::Mount,
+        SystemCall::Bpf,
+        SystemCall::PerfEventOpen,
+        SystemCall::Accept,
+        SystemCall::Accept4,
+        SystemCall::Listen,
+        SystemCall::Socketpair,
+        SystemCall::Seccomp,
+    };
+    for (auto const arch: Both)
+        for (auto const& rows: { releaseRows(arch),
+                                 compiledRows(arch),
+                                 interpretedRows(arch),
+                                 sanitizerRows(arch),
+                                 coverageRows(arch) })
+            for (auto const call: Forbidden)
+                if (auto const number = systemCallNumber(call, arch))
+                    for (auto const& row: rows)
+                    {
+                        INFO(systemCallNumbers()[std::to_underlying(call)].name << ": " << row.reason);
+                        CHECK_FALSE((row.number == *number && row.action == SystemCallAction::Allow));
+                    }
+}
+
+TEST_CASE("SeccompFilter.everyRowSaysWhy", "[vtextension][sandbox]")
+{
+    for (auto const arch: Both)
+        for (auto const& rows: { releaseRows(arch),
+                                 compiledRows(arch),
+                                 interpretedRows(arch),
+                                 sanitizerRows(arch),
+                                 coverageRows(arch) })
+        {
+            auto numbers = std::set<long> {};
+            for (auto const& row: rows)
+            {
+                INFO("number " << row.number);
+                CHECK_FALSE(row.reason.empty());
+                CHECK(numbers.insert(row.number).second);
+                CHECK((row.action == SystemCallAction::Refuse) == (row.error != 0));
+            }
+        }
+}
+
+TEST_CASE("SeccompFilter.assemblesForBothArchitectures", "[vtextension][sandbox]")
+{
+    // aarch64 has no open, fork or poll; its rows leave them out, and number the rest its own way.
+    for (auto const call: { SystemCall::Open, SystemCall::Fork, SystemCall::Poll })
+    {
+        CHECK(systemCallNumber(call, AuditArch::Amd64).has_value());
+        CHECK_FALSE(systemCallNumber(call, AuditArch::AArch64).has_value());
+    }
+    CHECK(systemCallNumber(SystemCall::Read, AuditArch::Amd64) == 0);
+    CHECK(systemCallNumber(SystemCall::Read, AuditArch::AArch64) == 63);
+    for (auto const arch: Both)
+        for (auto const code: { GuestCode::Interpreted, GuestCode::Compiled })
+            for (auto const instrumentation: { BuildInstrumentation::None,
+                                               BuildInstrumentation::Coverage,
+                                               BuildInstrumentation::Sanitizers })
+            {
+                auto const rows = rowsFor(code, instrumentation, arch);
+                auto const program =
+                    assembleFilter(rows, SandboxDescriptors { .control = Control }, OwnProcess, arch);
+                REQUIRE(program.has_value());
+                CHECK(program->size() <= BPF_MAXINSNS);
+                // Every row is reached: each number decides as its row says, arguments aside.
+                for (auto const& row: rows)
+                    if (row.checks.empty())
+                    {
+                        auto const returned =
+                            evaluateFilter(*program, SystemCallUse { .arch = arch, .number = row.number });
+                        REQUIRE(returned.has_value());
+                        CHECK(*returned == seccompReturnOf(row.action, row.error));
+                    }
+            }
+    // A Refuse without an errno, or a check of a seventh argument, is no program.
+    auto const noErrno = std::array { SystemCallRow {
+        .number = 0, .checks = {}, .action = SystemCallAction::Refuse, .error = 0, .reason = "none" } };
+    CHECK(assembleFilter(noErrno, SandboxDescriptors { .control = Control }, OwnProcess, AuditArch::Amd64)
+              .error()
+          == ConfinementFailure { .step = vtextension::wasm::remote::proto::LockdownStep::SystemCalls,
+                                  .code = EINVAL });
+    constexpr auto Seventh =
+        std::array { ArgumentCheck { .index = 6, .test = ArgumentTest::Equals, .mask = 1, .value = 1 } };
+    auto const seventh = std::array { SystemCallRow {
+        .number = 0, .checks = Seventh, .action = SystemCallAction::Allow, .error = 0, .reason = "none" } };
+    CHECK_FALSE(
+        assembleFilter(seventh, SandboxDescriptors { .control = Control }, OwnProcess, AuditArch::Amd64)
+            .has_value());
+}
+
+TEST_CASE("SeccompFilter.checksBothHalvesOfAWideArgument", "[vtextension][sandbox]")
+{
+    // A 64-bit test: the high half decides as much as the low one, both ways.
+    constexpr auto Wide = uint64_t { 0x0000'0001'0000'0002 };
+    constexpr auto EqualsWide = std::array { ArgumentCheck {
+        .index = 1, .test = ArgumentTest::Equals, .mask = ~uint64_t { 0 }, .value = Wide } };
+    constexpr auto DiffersFromWide = std::array { ArgumentCheck {
+        .index = 1, .test = ArgumentTest::NotEquals, .mask = ~uint64_t { 0 }, .value = Wide } };
+    for (auto const& [checks, whenEqual, whenNot]:
+         { std::tuple { std::span<ArgumentCheck const> { EqualsWide }, Allowed, Killed },
+           std::tuple { std::span<ArgumentCheck const> { DiffersFromWide }, Killed, Allowed } })
+    {
+        auto const rows = std::array { SystemCallRow { .number = 0,
+                                                       .checks = checks,
+                                                       .action = SystemCallAction::Allow,
+                                                       .error = 0,
+                                                       .reason = "wide" } };
+        auto const program =
+            assembleFilter(rows, SandboxDescriptors { .control = Control }, OwnProcess, AuditArch::Amd64);
+        REQUIRE(program.has_value());
+        for (auto const& [argument, expected]: { std::pair { Wide, whenEqual },
+                                                 std::pair { Wide & 0xFFFF'FFFF, whenNot },
+                                                 std::pair { Wide & ~uint64_t { 0xFFFF'FFFF }, whenNot },
+                                                 std::pair { uint64_t { 0 }, whenNot } })
+        {
+            INFO(argument);
+            auto const returned = evaluateFilter(
+                *program,
+                SystemCallUse { .arch = AuditArch::Amd64, .number = 0, .arguments = { 0, argument } });
+            REQUIRE(returned.has_value());
+            CHECK(verdictOf(*returned) == expected);
+        }
+    }
+}
+
+TEST_CASE("SeccompFilter.failedChecksTakeTheUnlistedAction", "[vtextension][sandbox]")
+{
+    // An outer sandbox refusing one value of an argument lets every other value through, as a call no row
+    // names; the host's own filter, which kills what it does not name, kills a failed check as well.
+    constexpr auto Refused = uint64_t { 83 };
+    constexpr auto OneValue = std::array {
+        ArgumentCheck { .index = 2, .test = ArgumentTest::Equals, .mask = 0xFFFF'FFFF, .value = Refused },
+    };
+    auto const rows = std::array { SystemCallRow { .number = 54,
+                                                   .checks = OneValue,
+                                                   .action = SystemCallAction::Refuse,
+                                                   .error = EPERM,
+                                                   .reason = "one option" } };
+    for (auto const unlisted: { SystemCallAction::Allow, SystemCallAction::Kill })
+    {
+        auto const program = assembleFilter(
+            rows, SandboxDescriptors { .control = Control }, OwnProcess, AuditArch::Amd64, unlisted);
+        REQUIRE(program.has_value());
+        auto const verdictFor = [&](long number, uint64_t option) {
+            auto const returned = evaluateFilter(
+                *program,
+                SystemCallUse { .arch = AuditArch::Amd64, .number = number, .arguments = { 0, 0, option } });
+            REQUIRE(returned.has_value());
+            return verdictOf(*returned);
+        };
+        auto const otherwise = FilterVerdict { .action = unlisted };
+        CHECK(verdictFor(54, Refused) == refusedWith(EPERM));
+        CHECK(verdictFor(54, Refused + 1) == otherwise);
+        CHECK(verdictFor(55, Refused) == otherwise);
+    }
+}
+
+TEST_CASE("SeccompFilter.anInterpreterMakesNothingExecutable", "[vtextension][sandbox]")
+{
+    // An engine that compiles makes its code executable once written; one that interprets never does, and
+    // asks only what the rows of its own allow.
+    constexpr auto Executable = uint64_t { PROT_READ | PROT_EXEC };
+    struct Expectation
+    {
+        SystemCall call {};
+        std::array<uint64_t, 6> arguments {};
+        FilterVerdict compiled;
+        FilterVerdict interpreted;
+        char const* what = nullptr;
+    };
+    auto const expectations = std::array {
+        Expectation {
+            SystemCall::Mprotect, { 0x1000, 4096, Executable }, Allowed, Killed, "code made executable" },
+        Expectation { SystemCall::Mprotect, { 0x1000, 4096, PROT_WRITE | PROT_EXEC }, Killed, Killed, "W+X" },
+        Expectation { SystemCall::Mprotect, { 0x1000, 4096, ReadWrite }, Allowed, Allowed, "memory opened" },
+        Expectation {
+            SystemCall::Mmap, { 0, 4096, Executable, Anonymous }, Killed, Killed, "executable memory" },
+        Expectation { SystemCall::Fcntl, { 12, F_GETFL }, Killed, Allowed, "a descriptor's flags asked" },
+        Expectation {
+            SystemCall::Fcntl, { 12, F_SETFL, O_NONBLOCK }, Killed, Killed, "a descriptor's flags set" },
+        Expectation { SystemCall::Fcntl, { 12, F_DUPFD, 0 }, Killed, Killed, "a descriptor duplicated" },
+        Expectation { SystemCall::Lseek, { 12, 0, SEEK_SET }, Killed, Allowed, "a seek" },
+        Expectation {
+            SystemCall::SchedGetaffinity, { 0, 128 }, Killed, refusedWith(ENOSYS), "a thread's CPUs asked" },
+    };
+    for (auto const arch: Both)
+        for (auto const& expectation: expectations)
+        {
+            INFO((arch == AuditArch::Amd64 ? "x86_64: " : "aarch64: ") << expectation.what);
+            auto const number = numberOf(expectation.call, arch);
+            CHECK(decide(BuildInstrumentation::None,
+                         arch,
+                         number,
+                         expectation.arguments,
+                         arch,
+                         GuestCode::Compiled)
+                  == expectation.compiled);
+            CHECK(decide(BuildInstrumentation::None,
+                         arch,
+                         number,
+                         expectation.arguments,
+                         arch,
+                         GuestCode::Interpreted)
+                  == expectation.interpreted);
+        }
+    // aarch64 flushes instruction caches only for code it wrote.
+    auto const membarrier = numberOf(SystemCall::Membarrier, AuditArch::AArch64);
+    CHECK(decide(BuildInstrumentation::None,
+                 AuditArch::AArch64,
+                 membarrier,
+                 {},
+                 AuditArch::AArch64,
+                 GuestCode::Interpreted)
+          == Killed);
+}
