+TEST_CASE("AppContainer.programFilesGrantIsSeen", "[vtextension][appcontainer]")
+{
+    // What a directory under `Program Files` inherits for ALL APPLICATION PACKAGES -- `(I)(RX)` for itself
+    // and
+    // `(I)(OI)(CI)(IO)(GR,GE)` for what it holds -- is a grant already: nothing is written, which an
+    // installation this user does not own could not take. Built in memory and read through the API, as not
+    // every system computes inheritance on creation (wine does not). Either entry alone is not enough.
+    struct Row
+    {
+        std::string_view name;
+        std::vector<PackageEntry> entries;
+        std::size_t writes; ///< 0: seen as granted; 1: a grant is written.
+    };
+    constexpr auto Itself = PackageEntry { .flags = INHERITED_ACE, .mask = FILE_GENERIC_READ | FILE_EXECUTE };
+    constexpr auto ItsFiles =
+        PackageEntry { .flags = INHERITED_ACE | OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE | INHERIT_ONLY_ACE,
+                       .mask = GENERIC_READ | GENERIC_EXECUTE };
+    auto const rows = std::array {
+        Row { .name = "both", .entries = { Itself, ItsFiles }, .writes = 0 },
+        Row { .name = "itself only", .entries = { Itself }, .writes = 1 },
+        Row { .name = "its files only", .entries = { ItsFiles }, .writes = 1 },
+    };
+    for (auto const& row: rows)
+    {
+        INFO(row.name);
+        auto dacl = std::make_shared<BuiltDacl>(row.entries);
+        auto const writes = std::make_shared<std::size_t>(0);
+        auto api = apiThatMustNotWrite(writes);
+        api.readDacl = [dacl](PCWSTR /*path*/, PACL* read, PSECURITY_DESCRIPTOR* descriptor) {
+            *read = dacl->acl();
+            *descriptor = nullptr;
+            return DWORD { ERROR_SUCCESS };
+        };
+        CHECK(process::ensurePackagesCanExecute(std::filesystem::temp_directory_path(), api).has_value()
+              == (row.writes == 0));
+        CHECK(*writes == row.writes);
+    }
+}
+
+namespace
+{
+
+/// What the probe reported, by key.
+using ProbeReport = std::vector<std::string>;
+
+/// Starts the probe in @p isolation, asked to open @p profileFile and connect to 127.0.0.1:@p port, and reads
+/// its report; fails the case, saying how the launch failed or how the probe ended, if there is none.
+/// @return The report.
+[[nodiscard]] ProbeReport probeReportIn(ProcessIsolation isolation,
+                                        std::filesystem::path const& profileFile,
+                                        uint16_t port)
+{
+    auto standardError = process::testing::CapturedStandardError::create();
+    REQUIRE(standardError.has_value());
+    auto probe = process::testing::launchHelper(
+        process::makeSystemProcessLauncher(),
+        process::testing::HelperLaunch {
+            .executable = VTEXTENSION_PROBE_PATH,
+            .leading = { "--contained" },
+            .trailing =
+                [&](std::span<vtextension::wasm::remote::transport::NativeHandle const> /*handles*/) {
+                    auto const utf8 = profileFile.u8string();
+                    return std::vector<std::string> { std::format("--profile-file={}",
+                                                                  std::string { utf8.begin(), utf8.end() }),
+                                                      std::format("--port={}", port) };
+                },
+            .environment = process::defaultHelperEnvironment(),
+            .standardError = standardError->handle(),
+            .isolation = isolation });
+    INFO("launch: " << (probe ? std::string { "started" }
+                              : std::string { process::launchErrorText(probe.error()) }));
+    REQUIRE(probe.has_value());
+    auto report = process::testing::readReport(probe->control);
+    if (!report)
+        FAIL("no report: " << process::testing::endOf(
+                 *probe->launcher, *probe->process, [&] { return standardError->text(); }));
+    for (auto const& line: *report)
+        UNSCOPED_INFO(line);
+    probe->closeControl();
+    process::testing::checkEndedCleanly(
+        *probe->launcher, *probe->process, [&] { return standardError->text(); });
+    return *std::move(report);
+}
+
+/// @return The value of @p key in @p report; empty if it has none.
+[[nodiscard]] std::string valueOf(ProbeReport const& report, std::string_view key)
+{
+    auto const prefix = std::string { key } + '=';
+    auto const line =
+        std::ranges::find_if(report, [&](auto const& entry) { return entry.starts_with(prefix); });
+    return line == report.end() ? std::string {} : line->substr(prefix.size());
+}
+
+/// What a loopback connection from an AppContainer without a network capability may fail with. Windows
+/// documents only that the Windows Filtering Platform's default block filter drops it, not the error a
+/// caller sees: WSAEACCES (10013) where the connect is refused at authorization, WSAECONNREFUSED (10061),
+/// which is what UWP apps are widely reported to see (0x8007274D), WSAETIMEDOUT (10060) where the packet is
+/// dropped silently, and WSAENETUNREACH (10051) or WSAEHOSTUNREACH (10065) where no route is offered. Each is
+/// the container's refusal: the listener accepts every connection, and the uncontained run proves it.
+constexpr auto ContainedConnectRefusals = std::array<std::string_view, 5> { "refused:connect:10013",
+                                                                            "refused:connect:10061",
+                                                                            "refused:connect:10060",
+                                                                            "refused:connect:10051",
+                                                                            "refused:connect:10065" };
+
+} // namespace
+
+TEST_CASE("Sandbox.windowsHelperRunsContained", "[vtextension][appcontainer]")
+{
+    // A file of the user's, and a loopback port that listens: both open to the probe uncontained, both shut
+    // to it contained, as is starting a process -- refused by the container's child process policy
+    // (ERROR_ACCESS_DENIED), not only by the job's process count (ERROR_NOT_ENOUGH_QUOTA, 1816).
+    auto const directory = ScratchDirectory { "contained-probe" };
+    auto const profileFile = directory.path / "secret.txt";
+    std::ofstream { profileFile } << "not the extension host's\n";
+    auto const listener = LoopbackListener {};
+    REQUIRE(listener.port().has_value());
+
+    {
+        INFO("uncontained");
+        auto const report = probeReportIn(ProcessIsolation::None, profileFile, *listener.port());
+        CHECK(valueOf(report, "container") == "no");
+        CHECK(valueOf(report, "profile-file") == "ok");
+        CHECK(valueOf(report, "connect") == "ok");
+        // Under wine the job's process count is not held: what it says is only recorded.
+        if (!process::testing::runsOnWine())
+            CHECK(valueOf(report, "spawn") == "refused:CreateProcessW:1816");
+    }
+
+    if (process::testing::runsOnWine())
+    {
+        // What wine made of the contained launch, for the record; nothing it does proves a container.
+        auto const probe = process::testing::launchHelper(
+            process::makeSystemProcessLauncher(),
+            process::testing::HelperLaunch { .executable = VTEXTENSION_PROBE_PATH,
+                                             .leading = { "--contained" },
+                                             .environment = process::defaultHelperEnvironment(),
+                                             .isolation = ProcessIsolation::AppContainer });
+        auto const outcome = probe ? std::string { "it started" }
+                                   : std::format("it failed: {}", process::launchErrorText(probe.error()));
+        SKIP(std::format("wine stubs AppContainers; the contained launch was asked for and {}", outcome));
+    }
+    INFO("contained");
+    auto const report = probeReportIn(ProcessIsolation::AppContainer, profileFile, *listener.port());
+    CHECK(valueOf(report, "container") == "yes");
+    CHECK(valueOf(report, "profile-file") == "refused:CreateFileW:5");
+    auto const connect = valueOf(report, "connect");
+    INFO("connect=" << connect);
+    CHECK(std::ranges::contains(ContainedConnectRefusals, std::string_view { connect }));
+    CHECK(valueOf(report, "spawn") == "refused:CreateProcessW:5");
+}
+#endif
diff --git a/src/vtextension/wasm/remote/process/AppContainer_win32.cpp b/src/vtextension/wasm/remote/process/AppContainer_win32.cpp
new file mode 100644
index 000000000..1d79321b3
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/AppContainer_win32.cpp
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The extension host's AppContainer: its profile, and the read and execute access every AppContainer needs
+// on the helper's directory. The design follows Chromium's sandbox/win (app_container_base.cc), which also
+// creates or derives one named profile and grants ALL APPLICATION PACKAGES on the files a contained process
+// must load.
+#include <vtextension/wasm/remote/process/AppContainer_win32.hpp>
+
+#include <algorithm>
+#include <cstdint>
+#include <expected>
+#include <filesystem>
+#include <format>
+#include <functional>
+#include <memory>
+#include <ranges>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include <AclAPI.h>
+#include <sddl.h>
+#include <userenv.h>
+
+namespace vtextension::wasm::remote::process
+{
+
+namespace
+{
+    /// Frees what the system allocated with LocalAlloc().
+    struct LocalMemoryFree
+    {
+        void operator()(void* memory) const noexcept { ::LocalFree(memory); }
+    };
+    using LocalMemory = std::unique_ptr<void, LocalMemoryFree>;
+
+    /// What every AppContainer needs on the helper's directory, and on each file in it: read and execute, as
+    /// FILE_GENERIC_READ | FILE_GENERIC_EXECUTE (`RX`) spells it -- FILE_EXECUTE the one right the second
+    /// adds.
+    constexpr auto ReadAndExecute = DWORD { FILE_GENERIC_READ | FILE_EXECUTE };
+
+    /// How the generic rights of a file's ACE map to its specific ones.
+    constexpr auto FileRightsMapping =
+        GENERIC_MAPPING { FILE_GENERIC_READ, FILE_GENERIC_WRITE, FILE_GENERIC_EXECUTE, FILE_ALL_ACCESS };
+
+    /// What a directory's DACL entries let a SID read and execute: the directory itself, the files it gives
+    /// its entries to, or both. A bitmask: the entries of one DACL add up.
+    enum class Coverage : uint8_t
+    {
+        None = 0b00,      ///< Neither.
+        Directory = 0b01, ///< The directory itself.
+        Files = 0b10,     ///< The files created in it.
+        Both = 0b11,      ///< Both.
+    };
+
+    [[nodiscard]] constexpr Coverage operator|(Coverage a, Coverage b) noexcept
+    {
+        return static_cast<Coverage>(std::to_underlying(a) | std::to_underlying(b));
+    }
+
+    /// @return What @p ace, an entry of a directory's DACL, lets @p sid read and execute.
+    [[nodiscard]] Coverage coverageOf(ACE_HEADER const& ace, PSID sid) noexcept
+    {
+        if (ace.AceType != ACCESS_ALLOWED_ACE_TYPE)
+            return Coverage::None;
+        auto const& allowed = reinterpret_cast<ACCESS_ALLOWED_ACE const&>(ace);
+        if (!::EqualSid(const_cast<DWORD*>(&allowed.SidStart), sid))
+            return Coverage::None;
+        auto mask = allowed.Mask;
+        auto mapping = FileRightsMapping;
+        ::MapGenericMask(&mask, &mapping);
+        if ((mask & ReadAndExecute) != ReadAndExecute)
+            return Coverage::None;
+        auto coverage = Coverage::None;
+        if ((ace.AceFlags & INHERIT_ONLY_ACE) == 0)
+            coverage = coverage | Coverage::Directory;
+        if ((ace.AceFlags & OBJECT_INHERIT_ACE) != 0)
+            coverage = coverage | Coverage::Files;
+        return coverage;
+    }
+
+    /// @return Whether @p dacl lets @p sid read and execute the directory and the files in it: a null DACL
+    ///         lets everyone do anything.
+    [[nodiscard]] bool grantsReadAndExecute(PACL dacl, PSID sid) noexcept
+    {
+        if (dacl == nullptr)
+            return true;
+        auto coverage = Coverage::None;
+        for (auto const index: std::views::iota(DWORD { 0 }, DWORD { dacl->AceCount }))
+        {
+            void* ace = nullptr;
+            if (::GetAce(dacl, index, &ace))
+                coverage = coverage | coverageOf(*static_cast<ACE_HEADER const*>(ace), sid);
+        }
+        return coverage == Coverage::Both;
+    }
+
+    /// @return The SID of ALL APPLICATION PACKAGES; nothing if the system cannot spell it.
+    [[nodiscard]] LocalMemory allApplicationPackages() noexcept
+    {
+        PSID sid = nullptr;
+        if (!::ConvertStringSidToSidW(std::wstring { AllApplicationPackagesSid }.c_str(), &sid))
+            return LocalMemory {};
+        return LocalMemory { sid };
+    }
+
+    /// @return Why a DACL could not be read or written, as a launch failure: `NotGranted` where this user
+    ///         may not change it.
+    [[nodiscard]] LaunchError daclErrorOf(DWORD error) noexcept
+    {
+        return error == ERROR_ACCESS_DENIED ? LaunchError::NotGranted : LaunchError::Io;
+    }
+
+    /// @return @p path in UTF-8, as every line Contour logs is; path::string() would spell it in the ANSI
+    ///         code page, and throw where that has no spelling.
+    [[nodiscard]] std::string utf8Of(std::filesystem::path const& path)
+    {
+        auto const utf8 = path.u8string();
+        return std::string { utf8.begin(), utf8.end() };
+    }
+} // namespace
+
+AppContainerApi systemAppContainerApi()
+{
+    return AppContainerApi {
+        .createProfile =
+            [](PCWSTR name, PCWSTR displayName, PCWSTR description, PSID* sid) {
+                return ::CreateAppContainerProfile(name, displayName, description, nullptr, 0, sid);
+            },
+        .deriveSid = [](PCWSTR name,
+                        PSID* sid) { return ::DeriveAppContainerSidFromAppContainerName(name, sid); },
+        .readDacl =
+            [](PCWSTR path, PACL* dacl, PSECURITY_DESCRIPTOR* descriptor) {
+                return ::GetNamedSecurityInfoW(path,
+                                               SE_FILE_OBJECT,
+                                               DACL_SECURITY_INFORMATION,
+                                               nullptr,
+                                               nullptr,
+                                               dacl,
+                                               nullptr,
+                                               descriptor);
+            },
+        .writeDacl =
+            [](PCWSTR path, PACL dacl) {
+                return ::SetNamedSecurityInfoW(const_cast<PWSTR>(path),
+                                               SE_FILE_OBJECT,
+                                               DACL_SECURITY_INFORMATION,
+                                               nullptr,
+                                               nullptr,
+                                               dacl,
+                                               nullptr);
+            },
+    };
+}
+
+std::expected<OwnedSid, LaunchError> ensureAppContainer(AppContainerApi const& api)
+{
+    auto const name = std::wstring { AppContainerName };
+    PSID sid = nullptr;
+    auto result = api.createProfile(
+        name.c_str(), L"Contour extension host", L"Runs Contour's status-line extensions.", &sid);
+    if (result == HRESULT_FROM_WIN32(ERROR_ALREADY_EXISTS))
+        result = api.deriveSid(name.c_str(), &sid);
+    if (FAILED(result) || sid == nullptr)
+        return std::unexpected(LaunchError::Unsupported);
+    return OwnedSid { sid };
+}
+
+std::expected<void, LaunchError> ensurePackagesCanExecute(std::filesystem::path const& directory,
+                                                          AppContainerApi const& api)
+{
+    auto const packages = allApplicationPackages();
+    if (!packages)
+        return std::unexpected(LaunchError::Io);
+    PACL dacl = nullptr;
+    PSECURITY_DESCRIPTOR descriptor = nullptr;
+    if (auto const error = api.readDacl(directory.c_str(), &dacl, &descriptor); error != ERROR_SUCCESS)
+        return std::unexpected(daclErrorOf(error));
+    auto const ownedDescriptor = LocalMemory { descriptor };
+    if (grantsReadAndExecute(dacl, packages.get()))
+        return {};
+
+    // One entry for the directory and the files directly in it -- the helper and the libraries beside it --
+    // and for nothing beneath: no propagation, so a subdirectory holds not even an inherit-only copy for its
+    // own files. Nothing a contained process loads lives deeper.
+    auto access = EXPLICIT_ACCESS_W {};
+    access.grfAccessPermissions = ReadAndExecute;
+    access.grfAccessMode = GRANT_ACCESS;
+    access.grfInheritance = OBJECT_INHERIT_ACE | NO_PROPAGATE_INHERIT_ACE;
+    access.Trustee.TrusteeForm = TRUSTEE_IS_SID;
+    access.Trustee.TrusteeType = TRUSTEE_IS_WELL_KNOWN_GROUP;
+    access.Trustee.ptstrName = static_cast<LPWSTR>(packages.get());
+    PACL granted = nullptr;
+    if (auto const error = ::SetEntriesInAclW(1, &access, dacl, &granted); error != ERROR_SUCCESS)
+        return std::unexpected(LaunchError::Io);
+    auto const ownedGranted = LocalMemory { granted };
+    if (auto const error = api.writeDacl(directory.c_str(), granted); error != ERROR_SUCCESS)
+        return std::unexpected(daclErrorOf(error));
+    return {};
+}
+
+AppContainerProvision::AppContainerProvision(AppContainerApi api,
+                                             std::function<void(std::string_view line)> diagnostics):
+    _api { std::move(api) }, _diagnostics { std::move(diagnostics) }
+{
+}
+
+std::expected<PSID, LaunchError> AppContainerProvision::prepare(std::filesystem::path const& directory)
+{
+    if (!_sid)
+    {
+        auto sid = ensureAppContainer(_api);
+        if (!sid)
+            return std::unexpected(sid.error());
+        _sid = *std::move(sid);
+    }
+    if (!std::ranges::contains(_grantedDirectories, directory))
+    {
+        if (auto const granted = ensurePackagesCanExecute(directory, _api); !granted)
+        {
+            if (granted.error() == LaunchError::NotGranted)
+                _diagnostics(
+                    std::format("The extension host in {} cannot run contained: Windows app containers "
+                                "may not read and execute that directory, and this user may not "
+                                "grant it. The installer must grant ALL APPLICATION PACKAGES ({}) "
+                                "read and execute access there.",
+                                utf8Of(directory),
+                                utf8Of(std::filesystem::path { AllApplicationPackagesSid })));
+            return std::unexpected(granted.error());
+        }
+        _grantedDirectories.push_back(directory);
+    }
+    return _sid->get();
+}
+
+} // namespace vtextension::wasm::remote::process
