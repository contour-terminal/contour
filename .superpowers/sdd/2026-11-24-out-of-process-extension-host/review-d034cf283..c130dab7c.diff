+    Expectation { .op = "ptrace-traceme", .fate = Fate::Unasserted },
+    Expectation { .op = "spawn-thread", .fate = Fate::Unasserted },
+    Expectation { .op = "protect-writable-executable", .fate = Fate::Unasserted },
