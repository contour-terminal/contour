diff --git a/src/vtextension/wasm/host/Sandbox.hpp b/src/vtextension/wasm/host/Sandbox.hpp
new file mode 100644
index 000000000..532912827
--- /dev/null
+++ b/src/vtextension/wasm/host/Sandbox.hpp
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host's sandbox, as the host process drives it: two steps at two points of its start, the
+/// first before it starts any thread, the second once every thread it runs was started and prepared.
+///
+/// What is set per thread and inherited by the threads started after it (Linux no_new_privs and Landlock,
+/// FreeBSD PROC_NO_NEW_PRIVS) is the first step's. What would forbid what preparing a thread still does, or
+/// must reach threads that run already (a system call filter synchronized across threads, capability mode, a
+/// sandbox profile), is the second's. Each system's sandbox is made by makeSystemSandbox(); a system without
+/// one runs the host unsandboxed (NullSandbox), and says so in its Hello.
+
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include <vtextension/wasm/host/DescriptorRights.hpp>
+#include <vtextension/wasm/host/GuestCode.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+
+#ifndef CONTOUR_PLATFORM_SANDBOX
+    #error "CONTOUR_PLATFORM_SANDBOX is set by linking vtextension_host."
+#endif
+
+namespace vtextension::wasm::host
+{
+
+/// Which system's sandbox makeSystemSandbox() makes in this build.
+enum class PlatformSandbox : uint8_t
+{
+    None,    ///< None: the host runs unsandboxed.
+    Linux,   ///< no_new_privs, Landlock and a seccomp filter.
+    FreeBSD, ///< Capsicum.
+    MacOS,   ///< A Seatbelt profile.
+    Windows, ///< An AppContainer, verified by the host.
+};
+
+/// This build's sandbox, as the build chose its source (CONTOUR_PLATFORM_SANDBOX, a public definition of
+/// vtextension_host): a host of this build says `LockedDown` unless it is `None`.
+inline constexpr auto ThisPlatformSandbox = PlatformSandbox { CONTOUR_PLATFORM_SANDBOX };
+
+/// A step of the host's confinement that failed, and how.
+struct ConfinementFailure
+{
+    remote::proto::LockdownStep step; ///< The step; never `None`.
+    /// What the system said of it: errno on POSIX, an HRESULT on Windows.
+    int code;
+
+    bool operator==(ConfinementFailure const&) const = default;
+};
+
+/// @param failure A step that failed.
+/// @return What failed and why, user-readable: the step's text (lockdownSteps()), then the system's word on
+///         the error.
+[[nodiscard]] std::string confinementFailureText(ConfinementFailure const& failure);
+
+/// A handle the host keeps using once it is locked down, beside its control channel, and what for.
+struct HeldDescriptor
+{
+    DescriptorRole role;                    ///< What it is used for: what a sandbox may leave it.
+    remote::transport::NativeHandle handle; ///< The handle.
+
+    bool operator==(HeldDescriptor const&) const = default;
+};
+
+/// What a sandbox confines the host to: the handles it keeps using once it is locked down.
+struct SandboxDescriptors
+{
+    remote::transport::NativeHandle control; ///< The control channel's helper end, adopted by the host.
+    /// Every other handle it keeps using, each with its role: what a sandbox that limits handle by handle
+    /// (FreeBSD's) limits. A handle the host holds and that is not here keeps every right it has.
+    std::vector<HeldDescriptor> held = {};
+};
+
+/// How far the system limits what a descriptor may be used for.
+enum class DescriptorLimit : uint8_t
+{
+    Unlimited, ///< Not at all: everywhere the sandbox does not limit descriptor by descriptor.
+    AsItsRole, ///< To its role's rights (rightsOf()), of the fcntls that need a right to F_GETFL where they
+               ///< include it, and to no ioctl.
+    Otherwise, ///< To something else, or the system would not say.
+};
+
+/// @param descriptor A descriptor this process holds, with its role.
+/// @return How far the system limits it: what proves a sandbox limited it as its role says. Defined per
+///         system; `Unlimited` where the sandbox limits no descriptor.
+[[nodiscard]] DescriptorLimit limitOf(HeldDescriptor descriptor);
+
+/// The host's sandbox. Each step is taken once, in order; a step that failed leaves the other to be taken
+/// all the same, so that a host is as confined as the system lets it be.
+class ISandbox
+{
+  public:
+    ISandbox() = default;
+    ISandbox(ISandbox const&) = delete;
+    ISandbox(ISandbox&&) = delete;
+    ISandbox& operator=(ISandbox const&) = delete;
+    ISandbox& operator=(ISandbox&&) = delete;
+    virtual ~ISandbox() = default;
+
+    /// Restricts what every thread started from now on inherits: on the main thread, while it is the only
+    /// one.
+    /// @return Nothing once restricted; the first step that failed otherwise.
+    [[nodiscard]] virtual std::expected<void, ConfinementFailure> restrictBeforeThreads() = 0;
+
+    /// Locks the host down, once every thread it runs was started and prepared (IHostedEngine::
+    /// prepareThread()) and its resources were capped: nothing it does from then on may need more.
+    /// @return Nothing once locked down; the first step that failed otherwise.
+    [[nodiscard]] virtual std::expected<void, ConfinementFailure> lockDown() = 0;
+
+    /// @return How far the host is confined once both steps were taken without a failure: what its Hello
+    ///         states then. `Unsandboxed` where the system has no sandbox, `LockedDown` where it has one --
+    ///         on Windows only where the parent started the host in its AppContainer, which lockDown() asks.
+    [[nodiscard]] virtual remote::proto::LockdownState lockdownState() const noexcept = 0;
+};
+
+/// The sandbox of a system that has none: both steps do nothing, and the host runs `Unsandboxed`.
+class NullSandbox final: public ISandbox
+{
+  public:
+    [[nodiscard]] std::expected<void, ConfinementFailure> restrictBeforeThreads() override { return {}; }
+    [[nodiscard]] std::expected<void, ConfinementFailure> lockDown() override { return {}; }
+    [[nodiscard]] remote::proto::LockdownState lockdownState() const noexcept override
+    {
+        return remote::proto::LockdownState::Unsandboxed;
+    }
+};
+
+/// Makes this system's sandbox for a host that keeps using @p descriptors and runs @p code. Defined per
+/// system: where there is no sandbox yet (Sandbox_none.cpp), a NullSandbox.
+/// @param descriptors The handles the host keeps using.
+/// @param code How its engine runs a module's code: whether it still makes memory executable.
+/// @return The sandbox; never null.
+[[nodiscard]] std::unique_ptr<ISandbox> makeSystemSandbox(SandboxDescriptors descriptors, GuestCode code);
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/Sandbox_freebsd.cpp b/src/vtextension/wasm/host/Sandbox_freebsd.cpp
new file mode 100644
index 000000000..100e6cd0e
--- /dev/null
+++ b/src/vtextension/wasm/host/Sandbox_freebsd.cpp
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The extension host's sandbox on FreeBSD. Before any thread: PROC_NO_NEW_PRIVS, where the system has it
+// (FreeBSD 14 and later). Once every thread was started and prepared: each descriptor the host keeps is
+// limited to what its role uses it for (DescriptorRights.hpp), and then the process enters capability mode,
+// which every thread takes on at its next system call: no file system, no network address, no other process.
+//
+// Capsicum cannot keep a socket that may send from sending descriptors over it (SCM_RIGHTS); what the host
+// attaches, Contour's end discards.
+#include <sys/capsicum.h>
+#include <sys/procctl.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <utility>
+
+#include <unistd.h>
+
+#include <vtextension/wasm/host/DescriptorRights.hpp>
+#include <vtextension/wasm/host/Sandbox.hpp>
+
+namespace vtextension::wasm::host
+{
+
+namespace
+{
+    /// A right in Capsicum's words.
+    struct CapabilityRight
+    {
+        DescriptorRight right; ///< The right.
+        uint64_t capability;   ///< The CAP_… right it is (rights(4)).
+    };
+
+    /// Every DescriptorRight, at its enumerator's index. GetStatusFlags is CAP_FCNTL, narrowed to F_GETFL by
+    /// cap_fcntls_limit() (CommandsFor).
+    constexpr auto CapabilityRights = std::array {
+        CapabilityRight { .right = DescriptorRight::Read, .capability = CAP_READ },
+        CapabilityRight { .right = DescriptorRight::Write, .capability = CAP_WRITE },
+        CapabilityRight { .right = DescriptorRight::Receive, .capability = CAP_RECV },
+        CapabilityRight { .right = DescriptorRight::Send, .capability = CAP_SEND },
+        CapabilityRight { .right = DescriptorRight::Event, .capability = CAP_EVENT },
+        CapabilityRight { .right = DescriptorRight::Shutdown, .capability = CAP_SHUTDOWN },
+        CapabilityRight { .right = DescriptorRight::Fstat, .capability = CAP_FSTAT },
+        CapabilityRight { .right = DescriptorRight::MapRead, .capability = CAP_MMAP_R },
+        CapabilityRight { .right = DescriptorRight::Seek, .capability = CAP_SEEK },
+        CapabilityRight { .right = DescriptorRight::GetStatusFlags, .capability = CAP_FCNTL },
+    };
+
+    static_assert(std::ranges::all_of(std::views::iota(std::size_t { 0 }, CapabilityRights.size()),
+                                      [](std::size_t index) {
+                                          return std::size_t {
+                                              std::to_underlying(CapabilityRights[index].right)
+                                          } == index;
+                                      }),
+                  "CapabilityRights lists every DescriptorRight at its own index");
+    static_assert(CapabilityRights.back().right == DescriptorRight::GetStatusFlags,
+                  "CapabilityRights ends at the last DescriptorRight");
+
+    /// The fcntl(2) commands that need CAP_FCNTL a descriptor with GetStatusFlags may still issue.
+    constexpr auto StatusFlagCommands = uint32_t { CAP_FCNTL_GETFL };
+
+    /// @return Nothing if @p result is 0; @p step with errno otherwise.
+    [[nodiscard]] std::expected<void, ConfinementFailure> stepOf(int result, remote::proto::LockdownStep step)
+    {
+        if (result != 0)
+            return std::unexpected(ConfinementFailure { .step = step, .code = errno });
+        return {};
+    }
+
+    /// @return The Capsicum rights of @p role.
+    [[nodiscard]] cap_rights_t capabilitiesOf(DescriptorRole role)
+    {
+        auto capabilities = cap_rights_t {};
+        cap_rights_init(&capabilities);
+        for (auto const right: rightsOf(role))
+            cap_rights_set(&capabilities, CapabilityRights[std::to_underlying(right)].capability);
+        return capabilities;
+    }
+
+    /// @return The fcntl commands needing CAP_FCNTL that @p role may issue: F_GETFL where it has
+    ///         GetStatusFlags, none otherwise (cap_rights_limit() clears them without CAP_FCNTL).
+    [[nodiscard]] uint32_t fcntlsOf(DescriptorRole role)
+    {
+        auto const rights = rightsOf(role);
+        return std::ranges::find(rights, DescriptorRight::GetStatusFlags) != rights.end() ? StatusFlagCommands
+                                                                                          : uint32_t { 0 };
+    }
+
+    /// Limits @p descriptor to what its role uses it for: its rights, and of the fcntl commands only F_GETFL.
+    /// No ioctl is left, as no role has CAP_IOCTL.
+    [[nodiscard]] std::expected<void, ConfinementFailure> limit(HeldDescriptor descriptor)
+    {
+        auto const capabilities = capabilitiesOf(descriptor.role);
+        auto const limited = stepOf(::cap_rights_limit(descriptor.handle, &capabilities),
+                                    remote::proto::LockdownStep::DescriptorRights);
+        auto const fcntls = fcntlsOf(descriptor.role);
+        if (!limited || fcntls == 0)
+            return limited;
+        return stepOf(::cap_fcntls_limit(descriptor.handle, fcntls),
+                      remote::proto::LockdownStep::DescriptorRights);
+    }
+
+    class FreeBsdSandbox final: public ISandbox
+    {
+      public:
+        explicit FreeBsdSandbox(SandboxDescriptors descriptors): _descriptors { std::move(descriptors) } {}
+
+        [[nodiscard]] std::expected<void, ConfinementFailure> restrictBeforeThreads() override
+        {
+#ifdef PROC_NO_NEW_PRIVS_CTL
+            // Per process, and kept across fork: set once, it reaches every thread.
+            auto enable = PROC_NO_NEW_PRIVS_ENABLE;
+            return stepOf(::procctl(P_PID, 0, PROC_NO_NEW_PRIVS_CTL, &enable),
+                          remote::proto::LockdownStep::NoNewPrivileges);
+#else
+            // Older than FreeBSD 14: capability mode refuses execve(2) all the same.
+            return {};
+#endif
+        }
+
+        [[nodiscard]] std::expected<void, ConfinementFailure> lockDown() override
+        {
+            // Every descriptor is limited, and capability mode entered, even past a step that failed; the
+            // first that failed is the one stated. Limiting comes first: cap_rights_limit() works in
+            // capability mode too, but a descriptor left unlimited would keep every right it was opened with.
+            auto first = std::optional<ConfinementFailure> {};
+            auto const note = [&first](std::expected<void, ConfinementFailure> const& step) {
+                if (!step && !first)
+                    first = step.error();
+            };
+            note(limit(HeldDescriptor { .role = DescriptorRole::Control, .handle = _descriptors.control }));
+            for (auto const& descriptor: _descriptors.held)
+                note(limit(descriptor));
+            note(stepOf(::cap_enter(), remote::proto::LockdownStep::Capabilities));
+            if (first)
+                return std::unexpected(*first);
+            return {};
+        }
+
+        [[nodiscard]] remote::proto::LockdownState lockdownState() const noexcept override
+        {
+            return remote::proto::LockdownState::LockedDown;
+        }
+
+      private:
+        SandboxDescriptors _descriptors;
+    };
+} // namespace
+
+DescriptorLimit limitOf(HeldDescriptor descriptor)
+{
+    auto held = cap_rights_t {};
+    if (cap_rights_get(descriptor.handle, &held) != 0)
+        return DescriptorLimit::Otherwise;
+    auto every = cap_rights_t {};
+    CAP_ALL(&every);
+    if (::cap_rights_contains(&held, &every))
+        return DescriptorLimit::Unlimited;
+    auto const wanted = capabilitiesOf(descriptor.role);
+    auto fcntls = uint32_t {};
+    auto const asItsRole = ::cap_rights_contains(&held, &wanted) && ::cap_rights_contains(&wanted, &held)
+                           && ::cap_fcntls_get(descriptor.handle, &fcntls) == 0
+                           && fcntls == fcntlsOf(descriptor.role)
+                           && ::cap_ioctls_get(descriptor.handle, nullptr, 0) == 0;
+    return asItsRole ? DescriptorLimit::AsItsRole : DescriptorLimit::Otherwise;
+}
+
+std::unique_ptr<ISandbox> makeSystemSandbox(SandboxDescriptors descriptors, [[maybe_unused]] GuestCode code)
+{
+    // Capability mode leaves memory protection alone, so how the engine runs code changes nothing here.
+    return std::make_unique<FreeBsdSandbox>(std::move(descriptors));
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/Sandbox_linux.cpp b/src/vtextension/wasm/host/Sandbox_linux.cpp
new file mode 100644
index 000000000..35c6f70cd
--- /dev/null
+++ b/src/vtextension/wasm/host/Sandbox_linux.cpp
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The extension host's sandbox on Linux. Before any thread: no_new_privs, then Landlock, which every thread
+// started later inherits (and, where the ABI has TSYNC, every thread already running too). Once every thread
+// was started and prepared: the system call filter, installed on every thread at once.
+#include <sys/prctl.h>
+
+#include <array>
+#include <cerrno>
+#include <expected>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <vtextension/wasm/BuildInstrumentation.hpp>
+#include <vtextension/wasm/host/HostProcess.hpp>
+#include <vtextension/wasm/host/Sandbox.hpp>
+#include <vtextension/wasm/host/linux/Landlock.hpp>
+#include <vtextension/wasm/host/linux/SeccompFilter.hpp>
+#include <vtextension/wasm/host/linux/SystemCallRows.hpp>
+
+namespace vtextension::wasm::host
+{
+
+namespace
+{
+    /// A directory an instrumented build's host may still reach once it gave up the file system.
+    struct InstrumentationDirectory
+    {
+        BuildInstrumentation build; ///< The build that needs it.
+        char const* path;           ///< The directory.
+        uint64_t rights;            ///< What it may do beneath it.
+    };
+
+    /// Every directory an instrumented build keeps: a sanitizer reads its process's maps for a report (it
+    /// names modules and offsets, unsymbolized), and a coverage build writes its counters into the build
+    /// tree. `/proc/self` resolves to `/proc/<pid>` as it is opened, so the rule covers the host's own
+    /// entries and no other process's.
+    constexpr auto InstrumentationDirectories = std::array {
+        InstrumentationDirectory { .build = BuildInstrumentation::Sanitizers,
+                                   .path = "/proc/self",
+                                   .rights = LandlockReadFile | LandlockReadDirectory },
+#ifdef CONTOUR_COVERAGE_OBJECT_ROOT
+        InstrumentationDirectory { .build = BuildInstrumentation::Coverage,
+                                   .path = CONTOUR_COVERAGE_OBJECT_ROOT,
+                                   .rights = LandlockReadFile | LandlockWriteFile | LandlockReadDirectory
+                                             | LandlockMakeRegular | LandlockTruncate },
+#endif
+    };
+
+    /// The directories of InstrumentationDirectories this build keeps, opened: closed with it.
+    class KeptDirectories
+    {
+      public:
+        KeptDirectories() = default;
+        KeptDirectories(KeptDirectories const&) = delete;
+        KeptDirectories(KeptDirectories&&) = delete;
+        KeptDirectories& operator=(KeptDirectories const&) = delete;
+        KeptDirectories& operator=(KeptDirectories&&) = delete;
+        ~KeptDirectories()
+        {
+            for (auto const& rule: _rules)
+                ::close(rule.parent);
+        }
+
+        /// Opens each directory this build keeps.
+        /// @return Nothing once all are open; the errno of the first that is not.
+        [[nodiscard]] std::expected<void, int> open()
+        {
+            for (auto const& directory: InstrumentationDirectories)
+            {
+                if (directory.build != ThisBuildInstrumentation)
+                    continue;
+                auto const descriptor = ::open(directory.path, O_PATH | O_DIRECTORY | O_CLOEXEC);
+                if (descriptor < 0)
+                    return std::unexpected(errno);
+                _rules.push_back(PathBeneathRule { .parent = descriptor, .allowedAccess = directory.rights });
+            }
+            return {};
+        }
+
+        /// @return What Landlock is to grant beneath them.
+        [[nodiscard]] std::span<PathBeneathRule const> rules() const noexcept { return _rules; }
+
+      private:
+        std::vector<PathBeneathRule> _rules;
+    };
+
+    /// What the host is told when Landlock is unavailable: it runs confined by its system call filter alone.
+    constexpr auto LandlockUnavailable = std::string_view {
+        "the file system restriction is unavailable on this system; system calls are restricted"
+    };
+
+    class LinuxSandbox final: public ISandbox
+    {
+      public:
+        LinuxSandbox(SandboxDescriptors descriptors,
+                     GuestCode code,
+                     LandlockSystem landlock,
+                     std::function<void(std::string_view)> tell):
+            _descriptors { std::move(descriptors) },
+            _code { code },
+            _landlock { landlock },
+            _tell { std::move(tell) }
+        {
+        }
+
+        [[nodiscard]] std::expected<void, ConfinementFailure> restrictBeforeThreads() override
+        {
+            // Every step runs; the first that failed is the one stated.
+            auto first = std::optional<ConfinementFailure> {};
+            if (::prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0)
+                first = ConfinementFailure { .step = remote::proto::LockdownStep::NoNewPrivileges,
+                                             .code = errno };
+
+            auto kept = KeptDirectories {};
+            auto const restricted =
+                kept.open()
+                    .transform_error([](int error) {
+                        return ConfinementFailure { .step = remote::proto::LockdownStep::FileSystem,
+                                                    .code = error };
+                    })
+                    .and_then([&] { return restrictFileSystem(kept.rules(), _landlock); });
+            if (restricted == LandlockOutcome::Unavailable)
+                _tell(LandlockUnavailable);
+            if (!restricted && !first)
+                first = restricted.error();
+            if (first)
+                return std::unexpected(*first);
+            return {};
+        }
+
+        [[nodiscard]] std::expected<void, ConfinementFailure> lockDown() override
+        {
+            auto const rows = buildRows(_code, ThisAuditArch);
+            return assembleFilter(rows, _descriptors, ::getpid(), ThisAuditArch)
+                .and_then([](std::vector<sock_filter> const& program) { return installFilter(program); });
+        }
+
+        [[nodiscard]] remote::proto::LockdownState lockdownState() const noexcept override
+        {
+            return remote::proto::LockdownState::LockedDown;
+        }
+
+      private:
+        SandboxDescriptors _descriptors;
+        GuestCode _code;
+        LandlockSystem _landlock;
+        std::function<void(std::string_view)> _tell;
+    };
+} // namespace
+
+DescriptorLimit limitOf([[maybe_unused]] HeldDescriptor descriptor)
+{
+    // Its sandbox confines system calls, not what each descriptor may be used for.
+    return DescriptorLimit::Unlimited;
+}
+
+std::unique_ptr<ISandbox> makeSystemSandbox(SandboxDescriptors descriptors, GuestCode code)
+{
+    return std::make_unique<LinuxSandbox>(
+        std::move(descriptors), code, systemLandlock(), &tellOnStandardError);
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/Sandbox_macos.cpp b/src/vtextension/wasm/host/Sandbox_macos.cpp
new file mode 100644
index 000000000..9c96a6041
--- /dev/null
+++ b/src/vtextension/wasm/host/Sandbox_macos.cpp
@@ -0,0 +1,105 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The extension host's sandbox on macOS: a Seatbelt profile, deny by default (macos/SandboxProfile.hpp),
+// applied once every thread was started and prepared. It is the process's, so it reaches every thread at
+// once. Before any thread there is nothing to take: macOS has no no_new_privs, and the profile refuses fork
+// and exec outright. Nor does a parent-death binding remain: macOS has none, and bindToParent() only checks
+// that the parent is still there (HostBootstrap.hpp).
+//
+// The profile looks up no Mach service, and the engine needs none: Wasmtime's Mach exception port is off
+// (wasmtime_config_macos_use_mach_ports_set(false), wasmtime/WasmtimeEngine.cpp), so its traps arrive as
+// signals and no handler thread of its own runs. Whether the engine makes compiled code executable is the
+// hardened runtime's to allow, through the extension host's one entitlement
+// (support/macOS/contour-extension-host.entitlements), not the profile's.
+#include <cerrno>
+#include <cstdint>
+#include <expected>
+#include <memory>
+#include <string>
+#include <utility>
+
+#include <vtextension/wasm/host/HostProcess.hpp>
+#include <vtextension/wasm/host/Sandbox.hpp>
+#include <vtextension/wasm/host/macos/SandboxProfile.hpp>
+
+// libsystem_sandbox's, declared as Chromium declares them (sandbox/mac/seatbelt.cc) rather than through
+// <sandbox.h>: that header declares no sandbox_init_with_parameters() at all, and sandbox_free_error()
+// deprecated, which -Werror refuses. Mach-O C names carry a leading underscore; the labels name them so, so
+// that the C++ names follow the project's.
+extern "C"
+{
+    /// Applies the profile @p profile, reading its parameters from @p parameters, to this process.
+    /// @return 0 once applied; -1 otherwise, with what is wrong in @p errorbuf.
+    int sandboxInitWithParameters(char const* profile,
+                                  uint64_t flags,
+                                  char const* const parameters[],
+                                  char** errorbuf) __asm__("_sandbox_init_with_parameters");
+    /// Frees what sandboxInitWithParameters() wrote to its errorbuf.
+    void sandboxFreeError(char* errorbuf) __asm__("_sandbox_free_error");
+}
+
+namespace vtextension::wasm::host
+{
+
+namespace
+{
+    /// The flags the profile is applied with: none, as it is profile text rather than a named profile.
+    constexpr auto ProfileTextFlags = uint64_t { 0 };
+
+    class MacSandbox final: public ISandbox
+    {
+      public:
+        /// Takes the profile in as the C string the library reads, so that locking down allocates nothing.
+        /// @param descriptors What the host keeps using.
+        explicit MacSandbox(SandboxDescriptors descriptors):
+            _descriptors { std::move(descriptors) }, _profile { SandboxProfile }
+        {
+        }
+
+        [[nodiscard]] std::expected<void, ConfinementFailure> restrictBeforeThreads() override { return {}; }
+
+        [[nodiscard]] std::expected<void, ConfinementFailure> lockDown() override
+        {
+            constexpr auto Parameters = profileParameterList();
+            char* errorbuf = nullptr;
+            errno = 0;
+            if (sandboxInitWithParameters(_profile.c_str(), ProfileTextFlags, Parameters.data(), &errorbuf)
+                == 0)
+                return {};
+            // The library says why in words, not always in errno: a profile it cannot compile sets none.
+            auto const code = errno != 0 ? errno : EINVAL;
+            if (errorbuf)
+            {
+                tellOnStandardError(std::string { "sandbox profile: " } + errorbuf);
+                sandboxFreeError(errorbuf);
+            }
+            return std::unexpected(
+                ConfinementFailure { .step = remote::proto::LockdownStep::Profile, .code = code });
+        }
+
+        [[nodiscard]] remote::proto::LockdownState lockdownState() const noexcept override
+        {
+            return remote::proto::LockdownState::LockedDown;
+        }
+
+      private:
+        /// What the host keeps using. The profile names no descriptor: it leaves these as they are, and
+        /// refuses the host any new one.
+        SandboxDescriptors _descriptors;
+        std::string _profile; ///< SandboxProfile.
+    };
+} // namespace
+
+DescriptorLimit limitOf([[maybe_unused]] HeldDescriptor descriptor)
+{
+    // Its profile confines operations, not what each descriptor may be used for.
+    return DescriptorLimit::Unlimited;
+}
+
+std::unique_ptr<ISandbox> makeSystemSandbox(SandboxDescriptors descriptors, [[maybe_unused]] GuestCode code)
+{
+    // How the engine runs code changes nothing here (above).
+    return std::make_unique<MacSandbox>(std::move(descriptors));
+}
+
+} // namespace vtextension::wasm::host
