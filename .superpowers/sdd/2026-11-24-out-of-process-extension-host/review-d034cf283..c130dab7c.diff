new file mode 100644
index 000000000..fc55e25c3
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/AppContainer_win32.hpp
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// Windows only: the AppContainer the extension host is started in (ProcessIsolation::AppContainer). Its
+/// profile, `Contour.ExtensionHost`, has no capabilities: no network, no user files, no registry beyond what
+/// every AppContainer reads. A container reads only what grants `ALL APPLICATION PACKAGES` (S-1-15-2-1) or
+/// its own SID, so the helper's directory must grant the first read and execute access before the helper can
+/// start.
+///
+/// Both are ensured by the launcher, once per launcher -- one per supervisor, on its thread -- through an API
+/// table (AppContainerApi), so that what the system answers can be faked in a test.
+
+#include <expected>
+#include <filesystem>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+
+namespace vtextension::wasm::remote::process
+{
+
+/// The name of the extension host's AppContainer profile.
+inline constexpr auto AppContainerName = std::wstring_view { L"Contour.ExtensionHost" };
+
+/// The SID of `ALL APPLICATION PACKAGES`, which every AppContainer's token carries.
+inline constexpr auto AllApplicationPackagesSid = std::wstring_view { L"S-1-15-2-1" };
+
+/// Frees a SID that userenv returned, as its functions say: with FreeSid().
+struct SidFree
+{
+    void operator()(void* sid) const noexcept { ::FreeSid(sid); }
+};
+
+/// A SID that userenv returned.
+using OwnedSid = std::unique_ptr<void, SidFree>;
+
+/// The userenv and advapi functions the container is ensured through, one per thing the system is asked.
+struct AppContainerApi
+{
+    /// CreateAppContainerProfile() with no capabilities: the profile @p name, and its SID in @p sid.
+    std::function<HRESULT(PCWSTR name, PCWSTR displayName, PCWSTR description, PSID* sid)> createProfile;
+    /// DeriveAppContainerSidFromAppContainerName(): the SID of the existing profile @p name.
+    std::function<HRESULT(PCWSTR name, PSID* sid)> deriveSid;
+    /// GetNamedSecurityInfoW() of a file's DACL: the list in @p dacl, owned by @p descriptor (LocalFree()).
+    std::function<DWORD(PCWSTR path, PACL* dacl, PSECURITY_DESCRIPTOR* descriptor)> readDacl;
+    /// SetNamedSecurityInfoW() of a file's DACL, which propagates its inheritable entries to the children.
+    std::function<DWORD(PCWSTR path, PACL dacl)> writeDacl;
+};
+
+/// @return The system's functions.
+[[nodiscard]] AppContainerApi systemAppContainerApi();
+
+/// Creates the extension host's profile (AppContainerName), with no capabilities, or finds it already there.
+/// @param api What the system is asked through.
+/// @return Its SID; `Unsupported` if the system neither created nor had it.
+[[nodiscard]] std::expected<OwnedSid, LaunchError> ensureAppContainer(AppContainerApi const& api);
+
+/// Lets every AppContainer read and execute @p directory and the files in it, unless its DACL lets them
+/// already -- whether by an entry of its own or an inherited one, as `Program Files` does. What it adds
+/// reaches the files directly in @p directory, and nothing beneath it.
+/// @param directory The helper's directory.
+/// @param api What the system is asked through.
+/// @return Nothing once they may; `NotGranted` if this user may not change the DACL (an installation it does
+///         not own, whose installer must grant it), `Io` if the system refused otherwise.
+[[nodiscard]] std::expected<void, LaunchError> ensurePackagesCanExecute(
+    std::filesystem::path const& directory, AppContainerApi const& api);
+
+/// What a launcher starts contained processes with: the profile, ensured on first use, and each executable
+/// directory's grant, ensured once. Used by one thread at a time (the supervisor's).
+class AppContainerProvision
+{
+  public:
+    /// @param api What the system is asked through.
+    /// @param diagnostics Where a grant this user may not make is said, with the directory and the fix:
+    ///        Contour's error log.
+    AppContainerProvision(AppContainerApi api, std::function<void(std::string_view line)> diagnostics);
+
+    /// Ensures the profile, once, and that executables in @p directory may run in it, once per directory.
+    /// @param directory The directory of the executable about to be started.
+    /// @return The container's SID, owned by this provision; why it cannot be used.
+    [[nodiscard]] std::expected<PSID, LaunchError> prepare(std::filesystem::path const& directory);
+
+  private:
+    AppContainerApi _api;
+    std::function<void(std::string_view line)> _diagnostics;
+    std::optional<OwnedSid> _sid;                           ///< Once ensured.
+    std::vector<std::filesystem::path> _grantedDirectories; ///< Each directory ensured.
+};
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/HostComposition.cpp b/src/vtextension/wasm/remote/process/HostComposition.cpp
new file mode 100644
index 000000000..5195d0ca2
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HostComposition.cpp
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/process/HostComposition.hpp>
+
+#include <core/Clock.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <expected>
+#include <filesystem>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+#include <vtextension/ExtensionError.hpp>
+#include <vtextension/wasm/remote/process/ProcessHostConnector.hpp>
+
+namespace vtextension::wasm::remote::process
+{
+
+namespace
+{
+    /// A reason a supervisor could not start, and why no host serves when it cannot.
+    struct SupervisorRefusalRow
+    {
+        SupervisorError error;       ///< Why it could not start.
+        remote::HostRefusal refusal; ///< What is logged for it.
+    };
+
+    constexpr auto SupervisorRefusals = std::array {
+        // The launcher made no set to wait on: on Linux, a kernel without pidfds.
+        SupervisorRefusalRow { .error = SupervisorError::WaitSetUnavailable,
+                               .refusal = remote::HostRefusal::Unsupported },
+        SupervisorRefusalRow { .error = SupervisorError::ThreadUnavailable,
+                               .refusal = remote::HostRefusal::OutOfResources },
+    };
+
+    /// @return Why no host serves when a supervisor fails to start for @p error.
+    [[nodiscard]] constexpr remote::HostRefusal refusalOf(SupervisorError error) noexcept
+    {
+        auto const row = std::ranges::find(SupervisorRefusals, error, &SupervisorRefusalRow::error);
+        return row != SupervisorRefusals.end() ? row->refusal : remote::HostRefusal::LaunchRefused;
+    }
+
+    /// The connector of a composition that cannot start a host: every connect() fails `HostUnavailable`
+    /// without launching anything, and the first says why.
+    class UnavailableHostConnector final: public remote::IHostConnector
+    {
+      public:
+        /// @param refusal Why no host can be started.
+        /// @param refusals Where that is logged, once.
+        UnavailableHostConnector(remote::HostRefusal refusal, remote::HostRefusalLog::Writer refusals):
+            _refusal { refusal }, _refusals { std::move(refusals) }
+        {
+        }
+
+        [[nodiscard]] std::expected<remote::HostConnection, ExtensionError> connect() override
+        {
+            _refusals.refused(_refusal);
+            return std::unexpected(ExtensionError::HostUnavailable);
+        }
+
+        /// Never called: no host of it ever reached a handshake.
+        void refused(remote::HostRefusal /*refusal*/) override {}
+
+      private:
+        remote::HostRefusal _refusal;
+        remote::HostRefusalLog _refusals;
+    };
+
+    /// A supervisor, or why no host can be started.
+    using StartedSupervisor = std::expected<std::unique_ptr<ExtensionHostSupervisor>, remote::HostRefusal>;
+
+    /// @return The supervisor @p config asks for, unless there is no helper to supervise.
+    [[nodiscard]] StartedSupervisor startSupervisor(HostCompositionConfig const& config)
+    {
+        if (!config.helper)
+            return std::unexpected(remote::HostRefusal::HelperNotFound);
+        return ExtensionHostSupervisor::start(SupervisorConfig { .launcher = config.launcher,
+                                                                 .clock = config.clock,
+                                                                 .teardownGrace = config.teardownGrace })
+            .transform_error(&refusalOf);
+    }
+
+    /// @return The connector starting @p config's helper through @p supervisor; one that starts none, and
+    ///         says why, if there is no supervisor.
+    [[nodiscard]] std::unique_ptr<remote::IHostConnector> connectorOver(StartedSupervisor const& supervisor,
+                                                                        HostCompositionConfig const& config)
+    {
+        if (!supervisor)
+            return std::make_unique<UnavailableHostConnector>(supervisor.error(), config.refusals);
+        return std::make_unique<ProcessHostConnector>((*supervisor)->mailbox(),
+                                                      ProcessHostConfig {
+                                                          .helper = *config.helper,
+                                                          .environment = defaultHelperEnvironment(),
+                                                          .extraArguments = {},
+                                                          .caps = {},
+                                                          .standardError = defaultHelperStandardError(),
+                                                          .isolation = ProcessIsolation::AppContainer,
+                                                      },
+                                                      config.refusals);
+    }
+} // namespace
+
+std::shared_ptr<HostComposition> HostComposition::create(HostCompositionConfig const& config)
+{
+    auto supervisor = startSupervisor(config);
+    auto connector = connectorOver(supervisor, config);
+    return std::make_shared<HostComposition>(
+        Passkey {}, config.teardownGrace, std::move(supervisor).value_or(nullptr), std::move(connector));
+}
+
+HostComposition::HostComposition(Passkey,
+                                 std::chrono::milliseconds teardownGrace,
+                                 std::unique_ptr<ExtensionHostSupervisor> supervisor,
+                                 std::unique_ptr<remote::IHostConnector> connector):
+    _teardownGrace { teardownGrace },
+    _kind { makeRemoteKindState() },
+    _supervisor { std::move(supervisor) },
+    _connector { std::move(connector) }
+{
+}
+
+HostComposition::~HostComposition() = default;
+
+std::unique_ptr<IWasmBackend> HostComposition::backend(BackendConfig config)
+{
+    if (!config.connector)
+        // Shares the composition's ownership: the composition lives while anything can still connect.
+        config.connector = std::shared_ptr<remote::IHostConnector> { shared_from_this(), _connector.get() };
+    return makeRemoteBackend(_kind, std::move(config));
+}
+
+std::shared_ptr<HostComposition> sharedHostComposition(std::filesystem::path helper,
+                                                       LockdownRequirement lockdown,
+                                                       remote::HostRefusalLog::Writer refusals)
+{
+    // The composition of this process for each lockdown requirement while a backend holds it, and the helper
+    // it was made for: a refusal one requirement keeps for good -- a host running unconfined -- must not stop
+    // the backends of the other. One slot each, as a process finds its one helper beside itself, the same
+    // path every time. Weak, so that a composition, and its supervisor's thread, end with the last backend
+    // rather than at exit.
+    struct Slot
+    {
+        std::filesystem::path helper;
+        std::weak_ptr<HostComposition> composition;
+    };
+    static auto mutex = std::mutex {};
+    static auto slots = std::array<Slot, std::size_t { std::to_underlying(LastLockdownRequirement) } + 1> {};
+
+    auto const lock = std::scoped_lock { mutex };
+    auto& slot = slots.at(std::to_underlying(lockdown));
+    if (auto composition = slot.composition.lock(); composition && slot.helper == helper)
+        return composition;
+    auto composition = HostComposition::create(HostCompositionConfig {
+        .launcher = makeSystemProcessLauncher(),
+        .clock = &core::defaultSteadyClock(),
+        .helper = helper,
+        .refusals = std::move(refusals),
+        .teardownGrace = teardownGraceFor(ThisBuildInstrumentation),
+    });
+    slot.helper = std::move(helper);
+    slot.composition = composition;
+    return composition;
+}
+
+std::unique_ptr<IWasmBackend> makeProcessBackend(
+    BackendConfig config,
+    std::expected<std::filesystem::path, HelperLocationError> helper,
+    remote::HostRefusalLog::Writer refusals)
+{
+    if (helper)
+        return sharedHostComposition(*std::move(helper), config.lockdown, std::move(refusals))
+            ->backend(std::move(config));
+    // No helper to start: every load fails `HostUnavailable`, and the first says why.
+    return HostComposition::create(HostCompositionConfig {
+                                       .launcher = makeSystemProcessLauncher(),
+                                       .clock = &core::defaultSteadyClock(),
+                                       .helper = std::move(helper),
+                                       .refusals = std::move(refusals),
+                                       .teardownGrace = teardownGraceFor(ThisBuildInstrumentation),
+                                   })
+        ->backend(std::move(config));
+}
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/HostComposition.hpp b/src/vtextension/wasm/remote/process/HostComposition.hpp
new file mode 100644
index 000000000..0a09fc9c3
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HostComposition.hpp
@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// How a hosting process -- Contour, `contour daemon`, bench-headless -- runs its extensions in extension
+/// host processes: one supervisor over the system's launcher, one kind every remote backend shares, and one
+/// connector starting the helper. The composition lives as long as the last backend made from it, or anything
+/// of theirs that still reaches a host: it ends with them, not with the process.
+
+#include <core/Clock.hpp>
+
+#include <chrono>
+#include <expected>
+#include <filesystem>
+#include <memory>
+
+#include <vtextension/wasm/BackendConfig.hpp>
+#include <vtextension/wasm/BuildInstrumentation.hpp>
+#include <vtextension/wasm/WasmRuntime.hpp>
+#include <vtextension/wasm/remote/HostConnector.hpp>
+#include <vtextension/wasm/remote/HostRefusals.hpp>
+#include <vtextension/wasm/remote/RemoteBackend.hpp>
+#include <vtextension/wasm/remote/process/ExtensionHostSupervisor.hpp>
+#include <vtextension/wasm/remote/process/HelperLocation.hpp>
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+namespace vtextension::wasm::remote::process
+{
+
+/// @param instrumentation How a build is instrumented.
+/// @return How long a helper that was let go may take to exit on its own in such a build, before it is
+///         killed: long enough for a sanitizer's or coverage's report to be written where there is one; no
+///         time at all where there is none, as such a helper has nothing to finish.
+[[nodiscard]] constexpr std::chrono::milliseconds teardownGraceFor(
+    BuildInstrumentation instrumentation) noexcept
+{
+    switch (instrumentation)
+    {
+        case BuildInstrumentation::None: return std::chrono::milliseconds { 0 };
+        case BuildInstrumentation::Coverage:
+        case BuildInstrumentation::Sanitizers: return std::chrono::milliseconds { 2000 };
+    }
+    return std::chrono::milliseconds { 0 };
+}
+
+/// How a hosting process composes its extension hosts.
+struct HostCompositionConfig
+{
+    /// What starts and waits for the helpers: makeSystemProcessLauncher() in Contour.
+    std::shared_ptr<IProcessLauncher> launcher;
+    core::IClock* clock = nullptr; ///< What the supervisor times by; non-null, outlives the composition.
+    /// The extension host executable; or why it was not found, in which case no helper is ever started and
+    /// every load fails `HostUnavailable`.
+    std::expected<std::filesystem::path, HelperLocationError> helper;
+    /// Where why no host serves is logged: errorLogWriter() in Contour.
+    remote::HostRefusalLog::Writer refusals;
+    /// How long a helper let go may take to exit on its own: as this build is instrumented.
+    std::chrono::milliseconds teardownGrace = teardownGraceFor(ThisBuildInstrumentation);
+};
+
+/// A supervisor over the configured launcher, the kind every backend made from it shares, and the connector
+/// that starts the helper through the supervisor.
+class HostComposition: public std::enable_shared_from_this<HostComposition>
+{
+    struct Passkey
+    {
+        explicit Passkey() = default;
+    };
+
+  public:
+    /// Starts the supervisor, unless there is no helper to supervise. A supervisor that cannot start leaves
+    /// every load failing `HostUnavailable`, and says why, once.
+    /// @param config Its launcher, clock, helper, log and teardown grace.
+    /// @return The composition.
+    [[nodiscard]] static std::shared_ptr<HostComposition> create(HostCompositionConfig const& config);
+
+    /// Use create(). Public for std::make_shared only.
+    HostComposition(Passkey,
+                    std::chrono::milliseconds teardownGrace,
+                    std::unique_ptr<ExtensionHostSupervisor> supervisor,
+                    std::unique_ptr<remote::IHostConnector> connector);
+
+    HostComposition(HostComposition const&) = delete;
+    HostComposition(HostComposition&&) = delete;
+    HostComposition& operator=(HostComposition const&) = delete;
+    HostComposition& operator=(HostComposition&&) = delete;
+    ~HostComposition();
+
+    /// Creates a remote backend of this composition's kind, which holds the composition for as long as it,
+    /// or anything of it, may start a host.
+    /// @param config Its budgets and lockdown requirement; a connector it names is used instead of the
+    ///        composition's, which it otherwise is given.
+    /// @return The backend.
+    [[nodiscard]] std::unique_ptr<IWasmBackend> backend(BackendConfig config);
+
+    /// Test hook.
+    /// @return The supervisor; null where none runs, as there is no helper or it could not start.
+    [[nodiscard]] ExtensionHostSupervisor const* supervisor() const noexcept { return _supervisor.get(); }
+
+    /// Test hook.
+    /// @return How long a helper let go may take to exit on its own.
+    [[nodiscard]] std::chrono::milliseconds teardownGrace() const noexcept { return _teardownGrace; }
+
+  private:
+    std::chrono::milliseconds _teardownGrace;
+    std::shared_ptr<RemoteKindState> _kind;
+    std::unique_ptr<ExtensionHostSupervisor> _supervisor;
+    std::unique_ptr<remote::IHostConnector> _connector;
+};
+
+/// The composition every default backend of this process with the same lockdown requirement shares while one
+/// lives: the one made for @p helper before, if a backend still holds it; a new one, over the system's
+/// launcher and clock, otherwise. One per requirement, so that a refusal kept for good under one -- a host
+/// running unconfined -- does not stop the backends of the other. It caches one helper path per requirement:
+/// a process finds its one helper beside itself, at the same path every time. Thread-safe.
+/// @param helper The extension host executable; an absolute path.
+/// @param lockdown Which hosts its backends drive (BackendConfig::lockdown).
+/// @param refusals Where a new composition logs why no host serves; one shared already keeps its own.
+/// @return The composition.
+[[nodiscard]] std::shared_ptr<HostComposition> sharedHostComposition(std::filesystem::path helper,
+                                                                     LockdownRequirement lockdown,
+                                                                     remote::HostRefusalLog::Writer refusals);
+
+/// The default backend of a program running its extensions out of process: the remote backend over the
+/// shared composition (sharedHostComposition()) of @p helper; with no helper found, one that fails every load
+/// `HostUnavailable` without starting anything, and says why once.
+/// @param config Its budgets and lockdown requirement; a connector it names is used instead of the
+///        composition's.
+/// @param helper The extension host executable; or why it was not found.
+/// @param refusals Where why no host serves is logged: errorLogWriter() in Contour.
+/// @return The backend.
+[[nodiscard]] std::unique_ptr<IWasmBackend> makeProcessBackend(
+    BackendConfig config,
+    std::expected<std::filesystem::path, HelperLocationError> helper,
+    remote::HostRefusalLog::Writer refusals);
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/HostComposition_test.cpp b/src/vtextension/wasm/remote/process/HostComposition_test.cpp
