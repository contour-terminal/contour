+
+namespace
+{
+    /// Every way the host process ends. Its codes stay clear of 1 (a generic failure), 23 (LeakSanitizer)
+    /// and 66 (AddressSanitizer, ThreadSanitizer), so that a sanitizer's report cannot pass for one of them.
+    constexpr auto ExitTable = std::array {
+        HostProcessExitRow {
+            .exit = HostProcessExit::Served, .code = 0, .text = "Contour ended the connection" },
+        HostProcessExitRow { .exit = HostProcessExit::BadArguments,
+                             .code = 70,
+                             .text = "its command line is not what it takes: Contour starts it, not a user" },
+        HostProcessExitRow { .exit = HostProcessExit::HandlesUnusable,
+                             .code = 71,
+                             .text = "the channels it was started with cannot be used" },
+        HostProcessExitRow { .exit = HostProcessExit::ParentGone,
+                             .code = 72,
+                             .text = "the Contour process that started it is gone" },
+        HostProcessExitRow { .exit = HostProcessExit::EngineUnavailable,
+                             .code = 73,
+                             .text = "no extension runtime can be created" },
+        HostProcessExitRow { .exit = HostProcessExit::ProtocolViolation,
+                             .code = 74,
+                             .text = "Contour sent what the protocol does not allow" },
+        HostProcessExitRow { .exit = HostProcessExit::ExecutorUnavailable,
+                             .code = 75,
+                             .text = "a thread to run extensions on cannot be started" },
+    };
+
+    /// @return @p exit's row.
+    [[nodiscard]] HostProcessExitRow const& rowOf(HostProcessExit exit) noexcept
+    {
+        // Every enumerator has its row, at its own index.
+        return ExitTable[static_cast<std::size_t>(exit)];
+    }
+
+    static_assert(std::ranges::all_of(std::views::iota(std::size_t { 0 }, ExitTable.size()),
+                                      [](std::size_t index) {
+                                          return static_cast<std::size_t>(ExitTable[index].exit) == index;
+                                      }),
+                  "ExitTable lists every HostProcessExit at its own index");
+
+    /// Writes `contour-extension-host: <text>` to stderr. Never throws: a failed write is no reason to end
+    /// otherwise than the exit table says.
+    void tell(std::string_view text) noexcept
+    {
+        constexpr auto Prefix = std::string_view { "contour-extension-host: " };
+        std::ignore = std::fwrite(Prefix.data(), 1, Prefix.size(), stderr);
+        std::ignore = std::fwrite(text.data(), 1, text.size(), stderr);
+        std::ignore = std::fputc('\n', stderr);
+    }
+
+    /// Writes why the host ends to stderr, unless it served.
+    /// @return @p exit's code.
+    [[nodiscard]] int endWith(HostProcessExit exit) noexcept
+    {
+        auto const& row = rowOf(exit);
+        if (exit != HostProcessExit::Served)
+            tell(row.text);
+        return row.code;
+    }
+} // namespace
+
+std::span<HostProcessExitRow const> hostProcessExits() noexcept
+{
+    return ExitTable;
+}
+
+int exitCodeOf(HostProcessExit exit) noexcept
+{
+    return rowOf(exit).code;
+}
+
+HostProcessExit hostProcessExitOf(ServerExit exit) noexcept
+{
+    switch (exit)
+    {
+        case ServerExit::PeerClosed:
+        case ServerExit::Stopped: return HostProcessExit::Served;
+        case ServerExit::ProtocolViolation: return HostProcessExit::ProtocolViolation;
+        case ServerExit::ExecutorUnavailable: return HostProcessExit::ExecutorUnavailable;
+    }
+    return HostProcessExit::ProtocolViolation;
+}
+
+std::expected<HostEndpoints, HostProcessExit> adoptEndpoints(transport::HelperArguments const& arguments)
+{
+    auto const unusable = [](auto) {
+        return HostProcessExit::HandlesUnusable;
+    };
+    auto control = transport::Channel::adopt(arguments.control);
+    if (!control)
+        return std::unexpected(HostProcessExit::HandlesUnusable);
+    auto lanes = std::vector<transport::Channel> {};
+    lanes.reserve(arguments.lanes.size());
+    for (auto const handle: arguments.lanes)
+    {
+        auto lane = transport::Channel::adopt(handle);
+        if (!lane)
+            return std::unexpected(HostProcessExit::HandlesUnusable);
+        lanes.push_back(*std::move(lane));
+    }
+    return transport::ControlPage::adopt(arguments.controlPage)
+        .transform_error(unusable)
+        .and_then([&](transport::ControlPage page) {
+            return transport::WakeReceiver::adopt(arguments.wake)
+                .transform_error(unusable)
+                .transform([&](transport::WakeReceiver wake) {
+                    return HostEndpoints { .control = *std::move(control),
+                                           .lanes = std::move(lanes),
+                                           .controlPage = std::move(page),
+                                           .wake = std::move(wake) };
+                });
+        });
+}
+
+HostProcess::HostProcess(IHostedEngine& engine, HostEndpoints endpoints, HostServerConfig config):
+    _controlPage { std::move(endpoints.controlPage) },
+    _wake { std::move(endpoints.wake) },
+    _server { engine, std::move(endpoints.lanes), std::move(endpoints.control), [&] {
+                 config.isInterruptRaised = [page = &_controlPage](uint32_t slot) {
+                     return page->isRaised(slot);
+                 };
+                 return std::move(config);
+             }() }
+{
+}
+
+ServerExit HostProcess::run()
+{
+    // Listening before the server confines the host, which may forbid new threads from then on; stopped and
+    // joined once the server is done.
+    auto const listener =
+        InterruptListener::start(_controlPage, _wake, [this](uint32_t slot) { _server.interruptSlot(slot); });
+    if (!listener)
+        return ServerExit::ExecutorUnavailable;
+    return _server.run();
+}
+
+void HostProcess::stop() noexcept
+{
+    _server.stop();
+}
+
+HostConfinement systemConfinement()
+{
+    return HostConfinement {
+        .bindToParent = &bindToParent,
+        .confine =
+            [](uint64_t dataBytes) {
+                if constexpr (BuildCapPolicy == CapPolicy::Skip)
+                    tell("resource caps are off in this build");
+                return capResources(dataBytes, BuildCapPolicy);
+            },
+    };
+}
+
+int runExtensionHost(std::span<std::string_view const> arguments,
+                     EngineFactory const& engines,
+                     HostConfinement const& confinement)
+{
+    auto const parsed = transport::parseHelperArguments(arguments);
+    if (!parsed)
+        return endWith(HostProcessExit::BadArguments);
+    // First, so that the host never outlives Contour, whatever happens next.
+    if (!confinement.bindToParent(parsed->parentProcessId))
+        return endWith(HostProcessExit::ParentGone);
+    auto endpoints = adoptEndpoints(*parsed);
+    if (!endpoints)
+        return endWith(endpoints.error());
+    // Declared before the host, so that every object the host made of it goes first.
+    auto const engine = engines();
+    if (!engine)
+        return endWith(HostProcessExit::EngineUnavailable);
+    auto config = HostServerConfig {};
+    config.confine = [&confinement, dataBytes = parsed->dataBytes] {
+        return confinement.confine(dataBytes);
+    };
+    auto host = HostProcess { *engine, *std::move(endpoints), std::move(config) };
+    return endWith(hostProcessExitOf(host.run()));
+}
+
+int runExtensionHost(std::span<std::string_view const> arguments, EngineFactory const& engines)
+{
+    return runExtensionHost(arguments, engines, systemConfinement());
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/HostProcess.hpp b/src/vtextension/wasm/host/HostProcess.hpp
new file mode 100644
index 000000000..93ddbfdba
--- /dev/null
+++ b/src/vtextension/wasm/host/HostProcess.hpp
@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host process: the endpoints it inherited from Contour, the server it runs over them, and the
+/// way it ends, as one exit code per reason.
+
+#include <cstdint>
+#include <expected>
+#include <functional>
+#include <memory>
+#include <span>
+#include <string_view>
+#include <vector>
+
+#include <vtextension/wasm/host/HostBootstrap.hpp>
+#include <vtextension/wasm/host/HostServer.hpp>
+#include <vtextension/wasm/host/IHostedEngine.hpp>
+#include <vtextension/wasm/remote/proto/Pdu.hpp>
+#include <vtextension/wasm/remote/transport/Channel.hpp>
+#include <vtextension/wasm/remote/transport/ControlPage.hpp>
+#include <vtextension/wasm/remote/transport/HelperArguments.hpp>
+#include <vtextension/wasm/remote/transport/WakeSignal.hpp>
+
+namespace vtextension::wasm::host
+{
+
+/// How the extension host process ended.
+enum class HostProcessExit : uint8_t
+{
+    Served,              ///< It served until Contour closed the connection, or it was stopped.
+    BadArguments,        ///< Its command line is not what it takes.
+    HandlesUnusable,     ///< A handle it was told of cannot be adopted.
+    ParentGone,          ///< It could not bind itself to its parent, or that one ended already.
+    EngineUnavailable,   ///< No engine could be created.
+    ProtocolViolation,   ///< Contour sent what the protocol does not allow.
+    ExecutorUnavailable, ///< A lane's thread could not be started.
+};
+
+/// One way the host process ends.
+struct HostProcessExitRow
+{
+    HostProcessExit exit;  ///< The reason.
+    int code;              ///< Its exit code: 0, or 70 and up -- never 1, 23 or 66, which sanitizers use.
+    std::string_view text; ///< What it writes to stderr on the way out; user-readable, naming no engine.
+};
+
+/// @return Every way the host process ends, one row each.
+[[nodiscard]] std::span<HostProcessExitRow const> hostProcessExits() noexcept;
+
+/// @param exit How the host ended.
+/// @return Its exit code.
+[[nodiscard]] int exitCodeOf(HostProcessExit exit) noexcept;
+
+/// @param exit Why the server stopped serving.
+/// @return How the host process ends because of it: `Served` once Contour closed it or it was stopped.
+[[nodiscard]] HostProcessExit hostProcessExitOf(ServerExit exit) noexcept;
+
+/// The helper's ends of everything Contour handed it.
+struct HostEndpoints
+{
+    remote::transport::Channel control;            ///< The control channel.
+    std::vector<remote::transport::Channel> lanes; ///< MaxLaneChannels lanes.
+    remote::transport::ControlPage controlPage;    ///< The interrupt page, read-only.
+    remote::transport::WakeReceiver wake;          ///< The wake signal's receiving end.
+};
+
+/// Takes ownership of every handle @p arguments name.
+/// @param arguments The parsed command line.
+/// @return The endpoints; `HandlesUnusable` if any handle cannot be adopted.
+[[nodiscard]] std::expected<HostEndpoints, HostProcessExit> adoptEndpoints(
+    remote::transport::HelperArguments const& arguments);
+
+/// A host's whole serving side over its endpoints: the server, and the listener that hands it the interrupts
+/// raised on the page.
+class HostProcess
+{
+  public:
+    /// @param engine What runtimes are created on; must outlive the host.
+    /// @param endpoints What it serves over.
+    /// @param config How its server runs; whether a slot is raised is the page's to say.
+    HostProcess(IHostedEngine& engine, HostEndpoints endpoints, HostServerConfig config);
+
+    /// Starts listening for interrupts, serves until Contour closes the connection, it violates the protocol,
+    /// or stop() is called; then releases every engine object, and stops listening. Called once.
+    /// @return Why it stopped serving; `ExecutorUnavailable` if the listener's thread could not be started,
+    ///         nothing being served then.
+    [[nodiscard]] ServerExit run();
+
+    /// Thread-safe, idempotent: ends run().
+    void stop() noexcept;
+
+  private:
+    remote::transport::ControlPage
+        _controlPage; ///< Where Contour raises an instance's interrupt; held while it serves.
+    remote::transport::WakeReceiver _wake; ///< What tells it to look at the page; held while it serves.
+    HostServer _server;
+};
+
+/// What the host process does to itself, as the operating system does it (systemConfinement()) or, in a test
+/// that runs the host in its own process, as a double does it.
+struct HostConfinement
+{
+    /// Binds the process to the parent it is given, as bindToParent() does.
+    std::function<std::expected<void, BootstrapError>(int64_t parentProcessId)> bindToParent;
+    /// Caps its resources once its threads run, to the data bytes it is given, as capResources() does.
+    /// @return What Hello states.
+    std::function<remote::proto::LockdownState(uint64_t dataBytes)> confine;
+};
+
+/// @return bindToParent() and capResources() under BuildCapPolicy, which under `Skip` says so once on stderr.
+[[nodiscard]] HostConfinement systemConfinement();
+
+/// The executable's body: parse, bind to the parent, adopt, make the engine, serve. Every exit but `Served`
+/// writes one line, `contour-extension-host: <text>`, to stderr.
+/// @param arguments The command line after the program's name.
+/// @param engines Makes the engine; called only once everything before it succeeded.
+/// @param confinement How it binds to its parent and caps itself.
+/// @return The exit code.
+[[nodiscard]] int runExtensionHost(std::span<std::string_view const> arguments,
+                                   EngineFactory const& engines,
+                                   HostConfinement const& confinement);
+
+/// runExtensionHost() with systemConfinement(): what the executable runs.
+/// @param arguments The command line after the program's name.
+/// @param engines Makes the engine.
+/// @return The exit code.
+[[nodiscard]] int runExtensionHost(std::span<std::string_view const> arguments, EngineFactory const& engines);
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/HostProcess_test.cpp b/src/vtextension/wasm/host/HostProcess_test.cpp
