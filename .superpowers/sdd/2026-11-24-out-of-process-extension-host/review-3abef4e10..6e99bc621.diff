+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/host/HostProcess.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <expected>
+#include <ranges>
