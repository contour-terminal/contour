index 000000000..caedffb6e
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HelperLocation_test.cpp
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <catch2/catch_test_macros.hpp>
+
+#include <expected>
+#include <filesystem>
+#include <set>
+#include <string>
+#include <vector>
+
+#include <vtextension/wasm/remote/process/HelperLocation.hpp>
+
+using std::filesystem::path;
+using vtextension::wasm::remote::process::ExtensionHostName;
+using vtextension::wasm::remote::process::HelperLocationError;
+using vtextension::wasm::remote::process::locateExtensionHost;
+
+namespace
+{
+
+/// One lookup: where the program runs, which paths are executables, and what is found.
+struct LocationCase
+{
+    std::string name;
+    path self;
+    std::set<path> executables;
+    std::expected<path, HelperLocationError> found;
+};
+
+/// @return The cases of this platform's layout.
+[[nodiscard]] std::vector<LocationCase> locationCases()
+{
+    auto const none = std::unexpected(HelperLocationError::NotFound);
+#ifdef _WIN32
+    auto const installed = path { "C:\\Contour\\bin\\contour-extension-host.exe" };
+    return {
+        { .name = "beside",
+          .self = "C:\\Contour\\bin\\contour.exe",
+          .executables = { installed },
+          .found = installed },
+        { .name = "none", .self = "C:\\Contour\\bin\\contour.exe", .executables = {}, .found = none },
+    };
+#elifdef __APPLE__
+    auto const helpers = path { "/Applications/Contour.app/Contents/Helpers" } / ExtensionHostName;
+    auto const beside = path { "/Applications/Contour.app/Contents/MacOS" } / ExtensionHostName;
+    auto const self = path { "/Applications/Contour.app/Contents/MacOS/contour" };
+    return {
+        { .name = "bundle", .self = self, .executables = { helpers, beside }, .found = helpers },
+        { .name = "beside", .self = self, .executables = { beside }, .found = beside },
+        { .name = "none", .self = self, .executables = {}, .found = none },
+    };
+#else
+    auto const libexec =
+        (path { "/usr/bin" } / CONTOUR_EXTENSION_HOST_RELATIVE_DIR / ExtensionHostName).lexically_normal();
+    auto const beside = path { "/usr/bin" } / ExtensionHostName;
+    return {
+        { .name = "libexec",
+          .self = "/usr/bin/contour",
+          .executables = { libexec, beside },
+          .found = libexec },
+        { .name = "beside", .self = "/usr/bin/contour", .executables = { beside }, .found = beside },
+        { .name = "none", .self = "/usr/bin/contour", .executables = {}, .found = none },
+    };
+#endif
+}
+
+} // namespace
+
+TEST_CASE("HelperLocation.candidatesInOrder", "[vtextension]")
+{
+    for (auto const& row: locationCases())
+    {
+        INFO(row.name);
+        auto const isExecutable = [&row](path const& candidate) {
+            return row.executables.contains(candidate.lexically_normal());
+        };
+        CHECK(locateExtensionHost(row.self, isExecutable) == row.found);
+    }
+}
+
+#if !defined(_WIN32) && !defined(__APPLE__)
+TEST_CASE("HelperLocation.libexecIsNotBesideTheBinaries", "[vtextension]")
+{
+    // The relative directory the install computed leads out of bin/, into the private executables' directory.
+    CHECK(path { CONTOUR_EXTENSION_HOST_RELATIVE_DIR }.filename() == "contour");
+    CHECK(path { CONTOUR_EXTENSION_HOST_RELATIVE_DIR }.is_relative());
+}
+#endif
diff --git a/src/vtextension/wasm/remote/process/HostTimers.cpp b/src/vtextension/wasm/remote/process/HostTimers.cpp
new file mode 100644
index 000000000..f60346039
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HostTimers.cpp
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/process/HostTimers.hpp>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <vector>
+
+namespace vtextension::wasm::remote::process
+{
+
+void HostTimers::arm(TimerKey key, core::SteadyTimePoint now, core::SteadyDuration budget)
+{
+    _timers.insert_or_assign(key, Entry { .remaining = budget, .runningSince = now });
+}
+
+void HostTimers::pause(TimerKey key, core::SteadyTimePoint now) noexcept
+{
+    auto const timer = _timers.find(key);
+    if (timer == _timers.end() || !timer->second.runningSince)
+        return;
+    auto& entry = timer->second;
+    entry.remaining = std::max(core::SteadyDuration {}, entry.remaining - (now - *entry.runningSince));
+    entry.runningSince = std::nullopt;
+}
+
+void HostTimers::resume(TimerKey key, core::SteadyTimePoint now) noexcept
+{
+    auto const timer = _timers.find(key);
+    if (timer == _timers.end() || timer->second.runningSince)
+        return;
+    timer->second.runningSince = now;
+}
+
+void HostTimers::disarm(TimerKey key) noexcept
+{
+    _timers.erase(key);
+}
+
+void HostTimers::disarmHelper(uint64_t helper) noexcept
+{
+    std::erase_if(_timers, [helper](auto const& timer) { return timer.first.helper == helper; });
+}
+
+std::vector<TimerKey> HostTimers::expire(core::SteadyTimePoint now)
+{
+    auto expired = std::vector<TimerKey> {};
+    std::erase_if(_timers, [&](auto const& timer) {
+        auto const deadline = deadlineOf(timer.second);
+        if (!deadline || *deadline > now)
+            return false;
+        expired.push_back(timer.first);
+        return true;
+    });
+    return expired;
+}
+
+std::optional<core::SteadyTimePoint> HostTimers::nextDeadline() const noexcept
+{
+    auto earliest = std::optional<core::SteadyTimePoint> {};
+    for (auto const& [key, entry]: _timers)
+        if (auto const deadline = deadlineOf(entry); deadline && (!earliest || *deadline < *earliest))
+            earliest = deadline;
+    return earliest;
+}
+
+std::size_t HostTimers::armed() const noexcept
+{
+    return _timers.size();
+}
+
+std::optional<core::SteadyTimePoint> HostTimers::deadlineOf(Entry const& entry) noexcept
+{
+    if (!entry.runningSince)
+        return std::nullopt;
+    return *entry.runningSince + entry.remaining;
+}
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/HostTimers.hpp b/src/vtextension/wasm/remote/process/HostTimers.hpp
new file mode 100644
index 000000000..8ed721064
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HostTimers.hpp
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The deadlines the extension host supervisor keeps: each a budget that runs, may be paused and resumed, and
+/// expires once it ran out. Pure: told the time by its caller, so that it is tested with explicit instants.
+
+#include <core/Clock.hpp>
+
+#include <compare>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <vector>
+
+namespace vtextension::wasm::remote::process
+{
+
+/// What names one timer: the helper it is about, and which of that helper's timers it is.
+struct TimerKey
+{
+    uint64_t helper = 0; ///< The supervised helper's key.
+    uint32_t serial = 0; ///< Which of its timers.
+
+    auto operator<=>(TimerKey const&) const = default;
+};
+
+/// Deadlines of one thread (the supervisor's). Not thread-safe; every instant is its caller's.
+///
+/// A timer's budget runs while it is armed and not paused; a paused one keeps what is left of it and never
+/// expires. The table is per supervisor and small, so every query scans it.
+class HostTimers
+{
+  public:
+    /// Arms @p key, replacing a timer armed under it.
+    /// @param key The timer.
+    /// @param now The instant its budget starts running.
+    /// @param budget How long it may run before it expires.
+    void arm(TimerKey key, core::SteadyTimePoint now, core::SteadyDuration budget);
+
+    /// Stops @p key's budget from running, keeping what is left of it; an unknown or paused key is ignored.
+    /// @param key The timer.
+    /// @param now The instant it stops.
+    void pause(TimerKey key, core::SteadyTimePoint now) noexcept;
+
+    /// Lets @p key's budget run again; an unknown or running key is ignored.
+    /// @param key The timer.
+    /// @param now The instant it runs again.
+    void resume(TimerKey key, core::SteadyTimePoint now) noexcept;
+
+    /// Forgets @p key, for good; an unknown key is ignored.
+    void disarm(TimerKey key) noexcept;
+
+    /// Forgets every timer of @p helper.
+    void disarmHelper(uint64_t helper) noexcept;
+
+    /// Removes and returns every running timer whose budget ran out by @p now.
+    /// @return Their keys, in key order.
+    [[nodiscard]] std::vector<TimerKey> expire(core::SteadyTimePoint now);
+
+    /// @return When the earliest running timer expires; nothing if none runs. Paused timers are excluded.
+    [[nodiscard]] std::optional<core::SteadyTimePoint> nextDeadline() const noexcept;
+
+    /// @return How many timers are armed, paused ones included.
+    [[nodiscard]] std::size_t armed() const noexcept;
+
+  private:
+    /// One timer: what is left of its budget, and since when that runs; nothing while it is paused.
+    struct Entry
+    {
+        core::SteadyDuration remaining {};
+        std::optional<core::SteadyTimePoint> runningSince;
+    };
+
+    /// @return When @p entry expires; nothing while it is paused.
+    [[nodiscard]] static std::optional<core::SteadyTimePoint> deadlineOf(Entry const& entry) noexcept;
+
+    std::map<TimerKey, Entry> _timers;
+};
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/HostTimers_test.cpp b/src/vtextension/wasm/remote/process/HostTimers_test.cpp
new file mode 100644
index 000000000..c345c3d5a
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/HostTimers_test.cpp
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <core/Clock.hpp>
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+#include <optional>
+#include <vector>
+
+#include <vtextension/wasm/remote/process/HostTimers.hpp>
+
+using vtextension::wasm::remote::process::HostTimers;
+using vtextension::wasm::remote::process::TimerKey;
+using namespace std::chrono_literals;
+
+namespace
+{
+
+/// An instant every case counts from.
+constexpr auto T0 = core::SteadyTimePoint {} + 1h;
+
+constexpr auto Key = TimerKey { .helper = 7, .serial = 1 };
+
+} // namespace
+
+TEST_CASE("HostTimers.expiresAtTheBudget", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 10ms);
+    CHECK(timers.nextDeadline() == T0 + 10ms);
+    CHECK(timers.expire(T0 + 9ms).empty());
+    CHECK(timers.armed() == 1);
+    CHECK(timers.expire(T0 + 10ms) == std::vector { Key });
+    CHECK(timers.armed() == 0);
+    CHECK(timers.nextDeadline() == std::nullopt);
+}
+
+TEST_CASE("HostTimers.pauseStopsTheClock", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 50ms);
+    timers.pause(Key, T0 + 10ms);
+    CHECK(timers.nextDeadline() == std::nullopt);
+    CHECK(timers.expire(T0 + 1000ms).empty());
+    CHECK(timers.armed() == 1);
+
+    // 40 ms were left when it paused: they run from the resume on.
+    timers.resume(Key, T0 + 1010ms);
+    CHECK(timers.nextDeadline() == T0 + 1050ms);
+    CHECK(timers.expire(T0 + 1049ms).empty());
+    CHECK(timers.expire(T0 + 1050ms) == std::vector { Key });
+}
+
+TEST_CASE("HostTimers.pauseAndResumeAreIdempotent", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 50ms);
+    timers.resume(Key, T0 + 5ms); // running already: ignored
+    timers.pause(Key, T0 + 10ms);
+    timers.pause(Key, T0 + 30ms); // paused already: ignored
+    timers.resume(Key, T0 + 100ms);
+    CHECK(timers.nextDeadline() == T0 + 140ms);
+
+    // Unknown keys are ignored.
+    timers.pause(TimerKey { .helper = 8, .serial = 1 }, T0);
+    timers.resume(TimerKey { .helper = 8, .serial = 1 }, T0);
+    CHECK(timers.armed() == 1);
+}
+
+TEST_CASE("HostTimers.disarmIsFinal", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 10ms);
+    timers.disarm(Key);
+    CHECK(timers.armed() == 0);
+    CHECK(timers.nextDeadline() == std::nullopt);
+    CHECK(timers.expire(T0 + 1h).empty());
+    // Resuming what is gone does not bring it back.
+    timers.resume(Key, T0 + 1h);
+    CHECK(timers.armed() == 0);
+}
+
+TEST_CASE("HostTimers.nextDeadlineIsTheEarliest", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    auto const later = TimerKey { .helper = 1, .serial = 1 };
+    auto const earlier = TimerKey { .helper = 2, .serial = 1 };
+    auto const paused = TimerKey { .helper = 3, .serial = 1 };
+    timers.arm(later, T0, 30ms);
+    timers.arm(earlier, T0 + 5ms, 10ms);
+    timers.arm(paused, T0, 1ms);
+    timers.pause(paused, T0);
+    CHECK(timers.nextDeadline() == T0 + 15ms);
+    CHECK(timers.expire(T0 + 30ms) == std::vector { later, earlier });
+    CHECK(timers.nextDeadline() == std::nullopt);
+    CHECK(timers.armed() == 1);
+}
+
+TEST_CASE("HostTimers.rearmingReplaces", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(Key, T0, 10ms);
+    timers.arm(Key, T0 + 5ms, 10ms);
+    CHECK(timers.armed() == 1);
+    CHECK(timers.nextDeadline() == T0 + 15ms);
+}
+
+TEST_CASE("HostTimers.disarmHelperForgetsItsTimersOnly", "[vtextension]")
+{
+    auto timers = HostTimers {};
+    timers.arm(TimerKey { .helper = 1, .serial = 1 }, T0, 10ms);
+    timers.arm(TimerKey { .helper = 1, .serial = 2 }, T0, 10ms);
+    timers.arm(TimerKey { .helper = 2, .serial = 1 }, T0, 20ms);
+    timers.disarmHelper(1);
+    CHECK(timers.armed() == 1);
+    CHECK(timers.nextDeadline() == T0 + 20ms);
+}
diff --git a/src/vtextension/wasm/remote/process/PosixLaunch.cpp b/src/vtextension/wasm/remote/process/PosixLaunch.cpp
new file mode 100644
index 000000000..904805895
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/PosixLaunch.cpp
@@ -0,0 +1,257 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/remote/process/PosixLaunch.hpp>
+
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <format>
+#include <iterator>
+#include <limits>
+#include <map>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+
+namespace vtextension::wasm::remote::process::posix
+{
+
+UniqueFd& UniqueFd::operator=(UniqueFd&& other) noexcept
+{
+    if (this != &other)
+    {
+        if (_descriptor != -1)
+            ::close(_descriptor);
+        _descriptor = std::exchange(other._descriptor, -1);
+    }
+    return *this;
+}
+
+UniqueFd::~UniqueFd()
+{
+    if (_descriptor != -1)
+        ::close(_descriptor);
+}
+
+namespace
+{
+    /// @return Pointers to @p strings' characters, null-terminated, as exec takes them.
+    [[nodiscard]] std::vector<char*> pointersInto(std::vector<std::string>& strings)
+    {
+        auto pointers = std::vector<char*> {};
+        pointers.reserve(strings.size() + 1);
+        for (auto& text: strings)
+            pointers.push_back(text.data());
+        pointers.push_back(nullptr);
+        return pointers;
+    }
+} // namespace
+
+std::vector<char*> PreparedLaunch::argv()
+{
+    return pointersInto(arguments);
+}
+
+std::vector<char*> PreparedLaunch::envp()
+{
+    return pointersInto(environment);
+}
+
+std::expected<PreparedLaunch, LaunchError> prepareLaunch(LaunchSpec const& spec)
+{
+    auto prepared = PreparedLaunch { .executable = spec.executable.string(),
+                                     .arguments = {},
+                                     .environment = {},
+                                     .parked = {},
+                                     .nullDevice = {},
+                                     .standardError = {} };
+    // posix_spawn() reports a failed exec too, but pdfork()'s child can only exit: the check up front gives
+    // every platform the same NotFound.
+    if (::access(prepared.executable.c_str(), X_OK) == -1)
+        return std::unexpected(LaunchError::NotFound);
+
+    // Parked at or above the first descriptor the child does not inherit, so that the child's dup2() onto 3,
+    // 4, … overwrites none of the descriptors still to be moved.
+    auto const childEnd = FirstChildDescriptor + static_cast<int>(spec.inherited.size());
+    for (auto const descriptor: spec.inherited)
+    {
+        auto const parked = ::fcntl(descriptor, F_DUPFD_CLOEXEC, childEnd);
+        if (parked == -1)
+            return std::unexpected(launchErrorOf(errno));
+        prepared.parked.emplace_back(parked);
+    }
+    if (spec.standardError)
+    {
+        prepared.standardError = UniqueFd { ::fcntl(*spec.standardError, F_DUPFD_CLOEXEC, childEnd) };
+        if (prepared.standardError.get() == -1)
+            return std::unexpected(launchErrorOf(errno));
+    }
+    prepared.nullDevice = UniqueFd { ::open("/dev/null", O_RDWR | O_CLOEXEC) };
+    if (prepared.nullDevice.get() == -1)
+        return std::unexpected(launchErrorOf(errno));
+
+    auto childHandles = std::vector<transport::NativeHandle> {};
+    for (auto const index: std::views::iota(FirstChildDescriptor, childEnd))
+        childHandles.push_back(index);
+    prepared.arguments.push_back(prepared.executable);
+    if (spec.arguments)
+        std::ranges::move(spec.arguments(childHandles), std::back_inserter(prepared.arguments));
+    for (auto const& [name, value]: spec.environment)
+        prepared.environment.push_back(std::format("{}={}", name, value));
+    return prepared;
+}
+
+LaunchError launchErrorOf(int error) noexcept
+{
+    switch (error)
+    {
+        case ENOENT:
+        case EACCES:
+        case ENOEXEC:
+        case ENOTDIR: return LaunchError::NotFound;
+        case ENOMEM:
+        case EAGAIN:
+        case EMFILE:
+        case ENFILE: return LaunchError::Resources;
+        case ENOSYS: return LaunchError::Unsupported;
+        default: return LaunchError::Io;
+    }
+}
+
+ExitStatus exitStatusOfWait(int status) noexcept
+{
+    if (WIFSIGNALED(status))
+        return ExitStatus { .kind = ExitKind::Signalled, .value = WTERMSIG(status) };
+    return ExitStatus { .kind = ExitKind::Exited, .value = WEXITSTATUS(status) };
+}
+
+#ifndef __APPLE__
+namespace
+{
+    /// Polls process descriptors and a wake pipe.
+    class PollExitWaitSet final: public IExitWaitSet
+    {
+      public:
+        PollExitWaitSet(core::IClock& clock, UniqueFd wakeRead, UniqueFd wakeWrite) noexcept:
+            _clock { &clock }, _wakeRead { std::move(wakeRead) }, _wakeWrite { std::move(wakeWrite) }
+        {
+        }
+
+        [[nodiscard]] std::expected<void, LaunchError> watch(uint64_t key,
+                                                             IProcessHandle const& process) override
+        {
+            _watched.insert_or_assign(key, process.waitable());
+            return {};
+        }
+
+        void unwatch(uint64_t key) noexcept override { _watched.erase(key); }
+
+        [[nodiscard]] std::expected<std::vector<uint64_t>, LaunchError> wait(
+            std::optional<core::SteadyTimePoint> deadline) override
+        {
+            auto descriptors = std::vector<pollfd> {};
+            descriptors.reserve(_watched.size() + 1);
+            descriptors.push_back(pollfd { .fd = _wakeRead.get(), .events = POLLIN, .revents = 0 });
+            for (auto const& [key, descriptor]: _watched)
+                descriptors.push_back(pollfd { .fd = descriptor, .events = POLLIN, .revents = 0 });
+
+            while (true)
+            {
+                auto const ready = ::poll(descriptors.data(), descriptors.size(), timeoutOf(deadline));
+                if (ready == -1 && errno == EINTR)
+                    continue;
+                if (ready == -1)
+                    return std::unexpected(launchErrorOf(errno));
+                if (ready == 0)
+                    return std::vector<uint64_t> {};
+                break;
+            }
+            // A descriptor closed while watched: its number may name anything by now.
+            if (std::ranges::any_of(descriptors,
+                                    [](pollfd const& polled) { return (polled.revents & POLLNVAL) != 0; }))
+                return std::unexpected(LaunchError::Io);
+            if (descriptors.front().revents != 0)
+                drainWakes();
+            // A process descriptor polls readable (Linux) or hung up (FreeBSD) once its process exited.
+            auto ended = std::vector<uint64_t> {};
+            for (auto const& [watch, descriptor]:
+                 std::views::zip(_watched, std::span { descriptors }.subspan(1)))
+                if (descriptor.revents != 0)
+                    ended.push_back(watch.first);
+            return ended;
+        }
+
+        void wake() noexcept override
+        {
+            auto const wake = uint8_t { 1 };
+            // A full pipe holds a wake already.
+            while (::write(_wakeWrite.get(), &wake, sizeof(wake)) == -1 && errno == EINTR)
+            {
+            }
+        }
+
+      private:
+        /// @return poll()'s timeout until @p deadline: -1 for none, never less than 0, rounded up to the next
+        ///         millisecond so that a wait never ends before its deadline.
+        [[nodiscard]] int timeoutOf(std::optional<core::SteadyTimePoint> deadline) const noexcept
+        {
+            if (!deadline)
+                return -1;
+            auto const remaining = std::chrono::ceil<std::chrono::milliseconds>(*deadline - _clock->now());
+            constexpr auto Longest = std::chrono::milliseconds { std::numeric_limits<int>::max() };
+            return static_cast<int>(std::clamp(remaining, std::chrono::milliseconds { 0 }, Longest).count());
+        }
+
+        /// Takes every byte queued on the wake pipe.
+        void drainWakes() noexcept
+        {
+            auto buffer = std::array<uint8_t, 64> {};
+            while (true)
+            {
+                auto const received = ::read(_wakeRead.get(), buffer.data(), buffer.size());
+                if (received > 0 || (received == -1 && errno == EINTR))
+                    continue;
+                return;
+            }
+        }
+
+        core::IClock* _clock;
+        UniqueFd _wakeRead;
+        UniqueFd _wakeWrite;
+        std::map<uint64_t, int> _watched; ///< Each key's process descriptor, owned by its handle.
+    };
+} // namespace
+
+std::expected<std::unique_ptr<IExitWaitSet>, LaunchError> makePollExitWaitSet(core::IClock& clock)
+{
+    auto ends = std::array<int, 2> { -1, -1 };
+    if (::pipe2(ends.data(), O_CLOEXEC | O_NONBLOCK) == -1)
+        return std::unexpected(launchErrorOf(errno));
+    return std::make_unique<PollExitWaitSet>(clock, UniqueFd { ends[0] }, UniqueFd { ends[1] });
+}
+#endif
+
+} // namespace vtextension::wasm::remote::process::posix
+
+namespace vtextension::wasm::remote::process
+{
+
+ProcessId currentProcessId() noexcept
+{
+    return static_cast<ProcessId>(::getpid());
+}
+
+} // namespace vtextension::wasm::remote::process
diff --git a/src/vtextension/wasm/remote/process/PosixLaunch.hpp b/src/vtextension/wasm/remote/process/PosixLaunch.hpp
new file mode 100644
index 000000000..285511d04
--- /dev/null
+++ b/src/vtextension/wasm/remote/process/PosixLaunch.hpp
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// What the POSIX launchers share: a launch prepared before anything is spawned -- the executable checked,
+/// the command line and environment as C strings, the inherited descriptors parked above the numbers the
+/// child gives them -- the mapping of errno and wait statuses, and the poll-based exit wait set of the
+/// systems whose processes are descriptors (Linux pidfds, FreeBSD process descriptors).
+
+#include <sys/types.h>
+
+#include <cstddef>
+#include <expected>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <spawn.h>
+
+#include <vtextension/wasm/remote/process/ProcessLauncher.hpp>
+
+namespace vtextension::wasm::remote::process::posix
+{
+
+/// The descriptor the first inherited handle is in the child; the i-th is this plus i.
+inline constexpr int FirstChildDescriptor = 3;
+
+/// An open descriptor, closed when destroyed. Move-only.
+class UniqueFd
+{
+  public:
+    UniqueFd() noexcept = default;
+    explicit UniqueFd(int descriptor) noexcept: _descriptor { descriptor } {}
+    UniqueFd(UniqueFd&& other) noexcept: _descriptor { std::exchange(other._descriptor, -1) } {}
+    UniqueFd& operator=(UniqueFd&& other) noexcept;
+    UniqueFd(UniqueFd const&) = delete;
+    UniqueFd& operator=(UniqueFd const&) = delete;
+    ~UniqueFd();
+
+    /// @return The descriptor; -1 if none.
+    [[nodiscard]] int get() const noexcept { return _descriptor; }
+
+  private:
+    int _descriptor = -1;
+};
+
+/// Owns a posix_spawn() object of type T, initialized by Init and destroyed by Destroy, and the first error
+/// of its initialization and of every change made to it since.
+template <typename T, int (*Init)(T*), int (*Destroy)(T*)>
+class SpawnObject
+{
+  public:
+    SpawnObject() noexcept: _initError { Init(&_object) }, _error { _initError } {}
+    SpawnObject(SpawnObject const&) = delete;
+    SpawnObject(SpawnObject&&) = delete;
+    SpawnObject& operator=(SpawnObject const&) = delete;
+    SpawnObject& operator=(SpawnObject&&) = delete;
+    ~SpawnObject()
+    {
+        if (_initError == 0)
+            Destroy(&_object);
+    }
+
+    /// @return The first error: of the initialization, or of a change since; 0 for none.
+    [[nodiscard]] int error() const noexcept { return _error; }
+
+    /// Records @p result, a change's return value, unless an error is recorded already.
+    void check(int result) noexcept
+    {
+        if (_error == 0)
+            _error = result;
+    }
+
+    /// @return The object, for the calls that change or use it.
+    [[nodiscard]] T* get() noexcept { return &_object; }
+
+  private:
+    T _object {};
+    int _initError;
+    int _error;
+};
+
+/// Owns initialized file actions.
+using FileActions = SpawnObject<posix_spawn_file_actions_t,
+                                &::posix_spawn_file_actions_init,
+                                &::posix_spawn_file_actions_destroy>;
+
+/// Owns initialized spawn attributes.
+using SpawnAttributes = SpawnObject<posix_spawnattr_t, &::posix_spawnattr_init, &::posix_spawnattr_destroy>;
+
+/// A launch prepared for the system call that spawns it.
+struct PreparedLaunch
+{
+    std::string executable;               ///< The program's path.
+    std::vector<std::string> arguments;   ///< argv, the program's path first.
+    std::vector<std::string> environment; ///< envp, each `NAME=value`.
+    std::vector<UniqueFd> parked; ///< The inherited descriptors' close-on-exec copies, all at or above
+                                  ///< childEnd(): dup2() onto 3, 4, … cannot overwrite one of them.
+    UniqueFd nullDevice;          ///< /dev/null, read-write and close-on-exec: stdin and stdout.
+    /// The stderr the spec names, parked as the inherited ones are; -1 to keep this process's own.
+    UniqueFd standardError;
+
+    /// @return The first descriptor beyond those the child inherits: what it closes from.
+    [[nodiscard]] int childEnd() const noexcept
+    {
+        return FirstChildDescriptor + static_cast<int>(parked.size());
+    }
+
+    /// @return argv for exec: pointers into arguments, null-terminated. Valid while this is unchanged.
+    [[nodiscard]] std::vector<char*> argv();
+
+    /// @return envp for exec: pointers into environment, null-terminated. Valid while this is unchanged.
+    [[nodiscard]] std::vector<char*> envp();
+};
+
+/// Checks @p spec's executable, parks its inherited descriptors and builds its command line and environment.
+/// @return The prepared launch; `NotFound` if the executable cannot be executed, or why a descriptor could
+/// not
+///         be duplicated.
+[[nodiscard]] std::expected<PreparedLaunch, LaunchError> prepareLaunch(LaunchSpec const& spec);
+
+/// @return Why a call that set @p error failed to start or watch a process.
+[[nodiscard]] LaunchError launchErrorOf(int error) noexcept;
+
+/// @return How a process ended, from the status waitpid() reported.
+[[nodiscard]] ExitStatus exitStatusOfWait(int status) noexcept;
+
+#ifndef __APPLE__
+/// A wait set that polls process descriptors, which become readable (Linux) or hang up (FreeBSD) when their
+/// process exits, beside a pipe its wake() writes to. Not on macOS, whose processes are no descriptors.
+/// @param clock What deadlines are measured by.
+/// @return The set; or why its wake descriptor could not be made.
+[[nodiscard]] std::expected<std::unique_ptr<IExitWaitSet>, LaunchError> makePollExitWaitSet(
+    core::IClock& clock);
+#endif
+
+} // namespace vtextension::wasm::remote::process::posix
diff --git a/src/vtextension/wasm/remote/process/ProcessHostConnector.cpp b/src/vtextension/wasm/remote/process/ProcessHostConnector.cpp
new file mode 100644
index 000000000..f88c8f604
