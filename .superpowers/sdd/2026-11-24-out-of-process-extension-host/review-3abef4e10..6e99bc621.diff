diff --git a/src/vtextension/wasm/host/InterruptListener.cpp b/src/vtextension/wasm/host/InterruptListener.cpp
new file mode 100644
index 000000000..f51910839
--- /dev/null
+++ b/src/vtextension/wasm/host/InterruptListener.cpp
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <vtextension/wasm/host/InterruptListener.hpp>
+
+#include <cstdint>
+#include <expected>
+#include <functional>
+#include <ranges>
+#include <system_error>
+#include <utility>
+
+namespace vtextension::wasm::host
+{
+
+namespace transport = remote::transport;
+
+namespace
+{
+    /// Waits for wakes until the receiver is stopped or its sender is gone; after each, hands every slot
+    /// raised on @p page to @p interruptSlot. A wake is taken before the page is scanned, so that a slot
+    /// raised after the scan began comes with a wake of its own, which the next wait returns.
+    void listen(transport::ControlPage const& page,
+                transport::WakeReceiver& wake,
+                std::function<void(uint32_t)> const& interruptSlot) noexcept
+    {
+        while (wake.wait() == transport::WakeWait::Woken)
+            for (auto const slot: std::views::iota(uint32_t { 0 }, transport::InterruptSlotCount))
+                if (page.isRaised(slot))
+                    interruptSlot(slot);
+    }
+} // namespace
+
+std::expected<InterruptListener, std::error_code> InterruptListener::start(
+    transport::ControlPage const& page,
+    transport::WakeReceiver& wake,
+    std::function<void(uint32_t slot)> interruptSlot)
+{
+    return ExecutorThread::start(InterruptListenerStackBytes,
+                                 [&page, &wake, interruptSlot = std::move(interruptSlot)] {
+                                     listen(page, wake, interruptSlot);
+                                 })
+        .transform([&](ExecutorThread thread) { return InterruptListener { wake, std::move(thread) }; });
+}
+
+InterruptListener::InterruptListener(transport::WakeReceiver& wake, ExecutorThread thread) noexcept:
+    _wake { &wake }, _thread { std::move(thread) }
+{
+}
+
+InterruptListener::InterruptListener(InterruptListener&& other) noexcept:
+    _wake { std::exchange(other._wake, nullptr) }, _thread { std::move(other._thread) }
+{
+}
+
+InterruptListener& InterruptListener::operator=(InterruptListener&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _wake = std::exchange(other._wake, nullptr);
+        _thread = std::move(other._thread);
+    }
+    return *this;
+}
+
+InterruptListener::~InterruptListener()
+{
+    release();
+}
+
+void InterruptListener::release() noexcept
+{
+    if (auto* const wake = std::exchange(_wake, nullptr))
+    {
+        wake->stop();
+        _thread.join();
+    }
+}
+
+} // namespace vtextension::wasm::host
diff --git a/src/vtextension/wasm/host/InterruptListener.hpp b/src/vtextension/wasm/host/InterruptListener.hpp
new file mode 100644
index 000000000..ebb960857
--- /dev/null
+++ b/src/vtextension/wasm/host/InterruptListener.hpp
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// The extension host's ear for interrupts: a thread of its own that waits on the wake signal and, on every
+/// wake, scans the interrupt page and hands each raised slot on -- to the server, which interrupts the
+/// instance holding it. Not the control thread, which waits on the control channel.
+
+#include <cstdint>
+#include <expected>
+#include <functional>
+#include <system_error>
+
+#include <vtextension/wasm/host/ExecutorThread.hpp>
+#include <vtextension/wasm/remote/transport/ControlPage.hpp>
+#include <vtextension/wasm/remote/transport/WakeSignal.hpp>
+
+namespace vtextension::wasm::host
+{
+
+/// The stack the listener's thread runs on: it scans a page and calls a function, nothing deeper.
+inline constexpr std::size_t InterruptListenerStackBytes = std::size_t { 256 } * 1024;
+
+/// Listens for interrupts until it is destroyed. Move-only.
+class InterruptListener
+{
+  public:
+    /// Starts listening on a thread of its own.
+    /// @param page The interrupt page; outlives the listener.
+    /// @param wake The wake signal's receiving end; outlives the listener, and is stopped by its destruction.
+    /// @param interruptSlot Called with every slot raised, on every wake; on the listener's thread.
+    /// @return The listener; why its thread could not be started.
+    [[nodiscard]] static std::expected<InterruptListener, std::error_code> start(
+        remote::transport::ControlPage const& page,
+        remote::transport::WakeReceiver& wake,
+        std::function<void(uint32_t slot)> interruptSlot);
+
+    InterruptListener(InterruptListener&& other) noexcept;
+    InterruptListener& operator=(InterruptListener&& other) noexcept;
+    InterruptListener(InterruptListener const&) = delete;
+    InterruptListener& operator=(InterruptListener const&) = delete;
+
+    /// Stops the wake signal's receiver, and joins the thread.
+    ~InterruptListener();
+
+  private:
+    InterruptListener(remote::transport::WakeReceiver& wake, ExecutorThread thread) noexcept;
+
+    /// Stops and joins, unless moved from.
+    void release() noexcept;
+
+    remote::transport::WakeReceiver* _wake; ///< Null once moved from.
+    ExecutorThread _thread;
+};
+
+} // namespace vtextension::wasm::host
