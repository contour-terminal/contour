+TEST_CASE("Helper.saysHelloOverInheritedChannels", "[vtextension]")
+{
+    auto helper = launchHelper(process::makeSystemProcessLauncher(), helperLaunch());
+    REQUIRE(helper.has_value());
+    auto control = receiveHello(*helper);
