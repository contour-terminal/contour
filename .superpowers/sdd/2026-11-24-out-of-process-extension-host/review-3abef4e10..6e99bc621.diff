+++ b/src/vtextension/wasm/remote/transport/WakeSignal_posix.cpp
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The wake signal on POSIX: a Unix-domain stream socket pair, one byte per wake. The sender's end is
+// non-blocking and its sends carry MSG_NOSIGNAL (macOS: SO_NOSIGPIPE), so a full buffer or a gone receiver
+// costs the parent neither a block nor a SIGPIPE -- a pipe would raise SIGPIPE, and the parent installs no
+// handler. The receiver polls its end beside a pipe of its own that stop() writes to.
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <array>
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <utility>
+
+#include <fcntl.h>
+#include <poll.h>
+#include <unistd.h>
+
+#include <vtextension/wasm/remote/transport/WakeSignal.hpp>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+#ifdef MSG_NOSIGNAL
+    /// Never blocks, and fails a send to a gone peer with EPIPE instead of raising SIGPIPE.
+    constexpr auto SendFlags = MSG_DONTWAIT | MSG_NOSIGNAL;
+#else
+    // macOS has no MSG_NOSIGNAL; the sender's socket carries SO_NOSIGPIPE instead.
+    constexpr auto SendFlags = MSG_DONTWAIT;
+#endif
+
+    /// Closes @p descriptor if it is open.
+    void closeDescriptor(int descriptor) noexcept
+    {
+        if (descriptor != -1)
+            ::close(descriptor);
+    }
+
+    /// Adds @p flags to @p descriptor's file status flags.
+    [[nodiscard]] std::expected<void, ChannelError> addStatusFlags(int descriptor, int flags) noexcept
+    {
+        auto const current = ::fcntl(descriptor, F_GETFL);
+        if (current == -1 || ::fcntl(descriptor, F_SETFL, current | flags) == -1)
+            return std::unexpected(ChannelError::Io);
+        return {};
+    }
+
+    /// Makes @p descriptor close-on-exec.
+    [[nodiscard]] std::expected<void, ChannelError> setCloseOnExec(int descriptor) noexcept
+    {
+        if (::fcntl(descriptor, F_SETFD, FD_CLOEXEC) == -1)
+            return std::unexpected(ChannelError::Io);
+        return {};
+    }
+
+    /// @return A pipe whose ends are close-on-exec and non-blocking, read end first.
+    [[nodiscard]] std::expected<std::array<int, 2>, ChannelError> makeStopPipe() noexcept
+    {
+        auto ends = std::array<int, 2> { -1, -1 };
+#ifdef __APPLE__
+        if (::pipe(ends.data()) == -1)
+            return std::unexpected(ChannelError::Io);
+        for (auto const end: ends)
+            if (!setCloseOnExec(end) || !addStatusFlags(end, O_NONBLOCK))
+            {
+                closeDescriptor(ends[0]);
+                closeDescriptor(ends[1]);
+                return std::unexpected(ChannelError::Io);
+            }
+#else
+        if (::pipe2(ends.data(), O_CLOEXEC | O_NONBLOCK) == -1)
+            return std::unexpected(ChannelError::Io);
+#endif
+        return ends;
+    }
+
+    /// Makes a receiver's end what wait() needs: close-on-exec, and non-blocking so that it drains.
+    [[nodiscard]] std::expected<void, ChannelError> configureReceiver(int descriptor) noexcept
+    {
+        return setCloseOnExec(descriptor).and_then([&] { return addStatusFlags(descriptor, O_NONBLOCK); });
+    }
+
+    /// Makes a sender's end non-blocking, and on macOS SIGPIPE-free.
+    [[nodiscard]] std::expected<void, ChannelError> configureSender(int descriptor) noexcept
+    {
+#ifdef SO_NOSIGPIPE
+        auto const enable = 1;
+        if (::setsockopt(descriptor, SOL_SOCKET, SO_NOSIGPIPE, &enable, sizeof(enable)) == -1)
+            return std::unexpected(ChannelError::Io);
+#endif
+        return setCloseOnExec(descriptor).and_then([&] { return addStatusFlags(descriptor, O_NONBLOCK); });
+    }
+
+    /// What draining a receiver's socket found.
+    enum class Drained : uint8_t
+    {
+        Nothing,     ///< No byte, and the stream goes on.
+        EndOfStream, ///< The sender is gone, and nothing was queued.
+        Wakes,       ///< At least one wake was taken.
+    };
+
+    /// Takes every byte queued on @p descriptor.
+    [[nodiscard]] Drained drain(int descriptor) noexcept
+    {
+        auto buffer = std::array<uint8_t, 256> {};
+        auto drained = Drained::Nothing;
+        while (true)
+        {
+            auto const received = ::recv(descriptor, buffer.data(), buffer.size(), MSG_DONTWAIT);
+            if (received > 0)
+                drained = Drained::Wakes;
+            else if (received == -1 && errno == EINTR)
+                continue;
+            else if (received == -1 && (errno == EAGAIN || errno == EWOULDBLOCK))
+                return drained;
+            else
+                // End of stream, or a failure that ends it as surely.
+                return drained == Drained::Wakes ? drained : Drained::EndOfStream;
+        }
+    }
+} // namespace
+
+WakeSender::WakeSender(NativeHandle handle) noexcept: _handle { handle }
+{
+}
+
+WakeSender::WakeSender(WakeSender&& other) noexcept: _handle { std::exchange(other._handle, -1) }
+{
+}
+
+WakeSender& WakeSender::operator=(WakeSender&& other) noexcept
+{
+    if (this != &other)
+    {
+        closeDescriptor(_handle);
+        _handle = std::exchange(other._handle, -1);
+    }
+    return *this;
+}
+
+WakeSender::~WakeSender()
+{
+    closeDescriptor(_handle);
+}
+
+WakeResult WakeSender::signal() const noexcept
+{
+    auto const wake = uint8_t { 1 };
+    while (true)
+    {
+        if (::send(_handle, &wake, sizeof(wake), SendFlags) == 1)
+            return WakeResult::Sent;
+        if (errno == EINTR)
+            continue;
+        if (errno == EAGAIN || errno == EWOULDBLOCK)
+            return WakeResult::Pending;
+        // The receiver is gone (EPIPE, ECONNRESET): nobody is left to wake, and its exit is seen elsewhere.
+        return WakeResult::Sent;
+    }
+}
+
+NativeHandle WakeSender::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+WakeReceiver::WakeReceiver(NativeHandle handle, int stopRead, int stopWrite) noexcept:
+    _handle { handle }, _stopRead { stopRead }, _stopWrite { stopWrite }
+{
+}
+
+std::expected<WakeReceiver, ChannelError> WakeReceiver::adopt(NativeHandle handle)
+{
+    struct stat status {};
+    if (::fstat(handle, &status) == -1 || !S_ISSOCK(status.st_mode))
+        return std::unexpected(ChannelError::Io);
+    return configureReceiver(handle).and_then(makeStopPipe).transform([&](std::array<int, 2> stop) {
+        return WakeReceiver { handle, stop[0], stop[1] };
+    });
+}
+
+WakeReceiver::WakeReceiver(WakeReceiver&& other) noexcept:
+    _handle { std::exchange(other._handle, -1) },
+    _stopRead { std::exchange(other._stopRead, -1) },
+    _stopWrite { std::exchange(other._stopWrite, -1) }
+{
+}
+
+WakeReceiver& WakeReceiver::operator=(WakeReceiver&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _handle = std::exchange(other._handle, -1);
+        _stopRead = std::exchange(other._stopRead, -1);
+        _stopWrite = std::exchange(other._stopWrite, -1);
+    }
+    return *this;
+}
+
+WakeReceiver::~WakeReceiver()
+{
+    release();
+}
+
+void WakeReceiver::release() noexcept
+{
+    closeDescriptor(_handle);
+    closeDescriptor(_stopRead);
+    closeDescriptor(_stopWrite);
+    _handle = -1;
+    _stopRead = -1;
+    _stopWrite = -1;
+}
+
+WakeWait WakeReceiver::wait() noexcept
+{
+    while (true)
+    {
+        auto descriptors = std::array { pollfd { .fd = _stopRead, .events = POLLIN, .revents = 0 },
+                                        pollfd { .fd = _handle, .events = POLLIN, .revents = 0 } };
+        if (::poll(descriptors.data(), descriptors.size(), -1) == -1)
+        {
+            if (errno == EINTR)
+                continue;
+            // Nothing can be waited on any more: as good as a gone sender.
+            return WakeWait::PeerGone;
+        }
+        // The stop pipe is never drained: once stopped, every wait returns at once.
+        if (descriptors[0].revents != 0)
+            return WakeWait::Stopped;
+        if (descriptors[1].revents == 0)
+            continue;
+        switch (drain(_handle))
+        {
+            case Drained::Wakes: return WakeWait::Woken;
+            case Drained::EndOfStream: return WakeWait::PeerGone;
+            case Drained::Nothing: break;
+        }
+    }
+}
+
+void WakeReceiver::stop() const noexcept
+{
+    auto const stop = uint8_t { 1 };
+    // A full pipe is a stopped receiver already.
+    while (::write(_stopWrite, &stop, sizeof(stop)) == -1 && errno == EINTR)
+    {
+    }
+}
+
+NativeHandle WakeReceiver::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+std::expected<WakePair, ChannelError> makeWakePair()
+{
+    auto ends = std::array<int, 2> { -1, -1 };
+#ifdef SOCK_CLOEXEC
+    constexpr auto SocketType = SOCK_STREAM | SOCK_CLOEXEC;
+#else
+    constexpr auto SocketType = SOCK_STREAM;
+#endif
+    if (::socketpair(AF_UNIX, SocketType, 0, ends.data()) == -1)
+        return std::unexpected(ChannelError::Io);
+    // Owned from here on, so that every failure below closes both.
+    auto sender = WakeSender { ends[0] };
+    auto const stop = makeStopPipe();
+    if (!stop)
+    {
+        closeDescriptor(ends[1]);
+        return std::unexpected(stop.error());
+    }
+    auto receiver = WakeReceiver { ends[1], (*stop)[0], (*stop)[1] };
+    return configureSender(sender.nativeHandle())
+        .and_then([&] { return configureReceiver(receiver.nativeHandle()); })
+        .transform([&] { return WakePair { .parent = std::move(sender), .helper = std::move(receiver) }; });
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/WakeSignal_test.cpp b/src/vtextension/wasm/remote/transport/WakeSignal_test.cpp
new file mode 100644
index 000000000..9d7b927f3
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/WakeSignal_test.cpp
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The wake signal Contour sends its extension host process when it raised an interrupt flag: it wakes a
+// waiting receiver, never blocks the sender, ends a wait on stop() or when the sender is gone, and never ends
+// the sender's process when the receiver is gone.
+#include <catch2/catch_test_macros.hpp>
+
+#include <chrono>
+#include <cstddef>
+#include <future>
+#include <ranges>
+#include <thread>
+#include <tuple>
+#include <utility>
+
+#include <vtextension/wasm/remote/transport/WakeSignal.hpp>
+
+#ifdef _WIN32
+    #define WIN32_LEAN_AND_MEAN
+    #include <Windows.h>
+#else
+    #include <csignal>
+
+    #include <fcntl.h>
+#endif
+
+using vtextension::wasm::remote::transport::makeWakePair;
+using vtextension::wasm::remote::transport::WakeResult;
+using vtextension::wasm::remote::transport::WakeWait;
+
+TEST_CASE("WakeSignal.endsAreNotInherited", "[vtextension]")
+{
+    auto const pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    for (auto const handle: { pair->parent.nativeHandle(), pair->helper.nativeHandle() })
+    {
+#ifdef _WIN32
+        auto flags = DWORD { 0 };
+        REQUIRE(::GetHandleInformation(handle, &flags));
+        CHECK((flags & HANDLE_FLAG_INHERIT) == 0);
+#else
+        auto const flags = ::fcntl(handle, F_GETFD);
+        REQUIRE(flags != -1);
+        CHECK((flags & FD_CLOEXEC) != 0);
+#endif
+    }
+}
+
+TEST_CASE("WakeSignal.signalWakesTheReceiver", "[vtextension]")
+{
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    auto result = std::promise<WakeWait> {};
+    auto woken = result.get_future();
+    auto waiter = std::jthread { [&] { result.set_value(pair->helper.wait()); } };
+    std::this_thread::sleep_for(std::chrono::milliseconds { 20 });
+    CHECK(pair->parent.signal() == WakeResult::Sent);
+    CHECK(woken.get() == WakeWait::Woken);
+}
+
+TEST_CASE("WakeSignal.signalNeverBlocks", "[vtextension]")
+{
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+
+    constexpr auto Signals = 100'000;
+    struct Counts
+    {
+        WakeResult first = WakeResult::Pending;
+        std::size_t pending = 0;
+    };
+    // Nobody waits: a sender that blocked on a full buffer would never return.
+    auto signalled = std::async(std::launch::async, [&] {
+        auto counts = Counts { .first = pair->parent.signal() };
+        for ([[maybe_unused]] auto const i: std::views::iota(1, Signals))
+            if (pair->parent.signal() == WakeResult::Pending)
+                ++counts.pending;
+        return counts;
+    });
+    REQUIRE(signalled.wait_for(std::chrono::seconds { 5 }) == std::future_status::ready);
+    auto const counts = signalled.get();
+    CHECK(counts.first == WakeResult::Sent);
+    CHECK(counts.pending > 0);
+
+    // One wait takes every queued wake; the next one finds none and waits until stopped.
+    CHECK(pair->helper.wait() == WakeWait::Woken);
+    auto next = std::async(std::launch::async, [&] { return pair->helper.wait(); });
+    CHECK(next.wait_for(std::chrono::milliseconds { 50 }) == std::future_status::timeout);
+    pair->helper.stop();
+    CHECK(next.get() == WakeWait::Stopped);
+}
+
+TEST_CASE("WakeSignal.stopEndsAWait", "[vtextension]")
+{
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    auto result = std::promise<WakeWait> {};
+    auto stopped = result.get_future();
+    auto waiter = std::jthread { [&] { result.set_value(pair->helper.wait()); } };
+    std::this_thread::sleep_for(std::chrono::milliseconds { 20 });
+    pair->helper.stop();
+    CHECK(stopped.get() == WakeWait::Stopped);
+    // Stopped for good, even with a wake queued.
+    CHECK(pair->parent.signal() == WakeResult::Sent);
+    CHECK(pair->helper.wait() == WakeWait::Stopped);
+}
+
+#ifndef _WIN32
+TEST_CASE("WakeSignal.senderGoneIsPeerGone", "[vtextension]")
+{
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    {
+        auto const sender = std::move(pair->parent);
+    }
+    CHECK(pair->helper.wait() == WakeWait::PeerGone);
+}
+
+TEST_CASE("WakeSignal.signalToAGoneReceiverKeepsSigpipeAway", "[vtextension]")
+{
+    struct sigaction before {};
+    struct sigaction byDefault {};
+    byDefault.sa_handler = SIG_DFL;
+    REQUIRE(::sigaction(SIGPIPE, &byDefault, &before) == 0);
+
+    auto pair = makeWakePair();
+    REQUIRE(pair.has_value());
+    {
+        auto const receiver = std::move(pair->helper);
+    }
+    // At SIG_DFL, a SIGPIPE would end this process here.
+    std::ignore = pair->parent.signal();
+    std::ignore = pair->parent.signal();
+    SUCCEED("the process lives");
+
+    REQUIRE(::sigaction(SIGPIPE, &before, nullptr) == 0);
+}
+#endif
diff --git a/src/vtextension/wasm/remote/transport/WakeSignal_win32.cpp b/src/vtextension/wasm/remote/transport/WakeSignal_win32.cpp
new file mode 100644
index 000000000..e896322ef
--- /dev/null
+++ b/src/vtextension/wasm/remote/transport/WakeSignal_win32.cpp
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The wake signal on Windows: a manual-reset event, which SetEvent() sets without ever blocking. Manual, not
+// auto-reset, so that the sender can tell a wake already queued (the event is set) from one it queues: the
+// receiver resets it once its wait returned, and before its caller scans the page, so that a flag raised
+// before a signal() that found the event set is still seen by that scan. The receiver waits on it beside a
+// stop event of its own. A gone sender cannot be told on Windows; the job ends a helper whose parent is gone.
+#include <array>
+#include <cstdint>
+#include <expected>
+#include <utility>
+
+#include <vtextension/wasm/remote/transport/WakeSignal.hpp>
+
+#define WIN32_LEAN_AND_MEAN
+#include <Windows.h>
+
+namespace vtextension::wasm::remote::transport
+{
+
+namespace
+{
+    /// Closes @p handle if it is open.
+    void closeHandle(HANDLE handle) noexcept
+    {
+        if (handle != nullptr)
+            ::CloseHandle(handle);
+    }
+
+    /// @return A new, unset, uninheritable manual-reset event; null if the system refused.
+    [[nodiscard]] HANDLE makeEvent() noexcept
+    {
+        return ::CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    }
+} // namespace
+
+WakeSender::WakeSender(NativeHandle handle) noexcept: _handle { handle }
+{
+}
+
+WakeSender::WakeSender(WakeSender&& other) noexcept: _handle { std::exchange(other._handle, nullptr) }
+{
+}
+
+WakeSender& WakeSender::operator=(WakeSender&& other) noexcept
+{
+    if (this != &other)
+    {
+        closeHandle(_handle);
+        _handle = std::exchange(other._handle, nullptr);
+    }
+    return *this;
+}
+
+WakeSender::~WakeSender()
+{
+    closeHandle(_handle);
+}
+
+WakeResult WakeSender::signal() const noexcept
+{
+    if (::WaitForSingleObject(_handle, 0) == WAIT_OBJECT_0)
+        return WakeResult::Pending;
+    ::SetEvent(_handle);
+    return WakeResult::Sent;
+}
+
+NativeHandle WakeSender::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+WakeReceiver::WakeReceiver(NativeHandle handle, void* stopEvent) noexcept:
+    _handle { handle }, _stopEvent { stopEvent }
+{
+}
+
+std::expected<WakeReceiver, ChannelError> WakeReceiver::adopt(NativeHandle handle)
+{
+    // Waiting with a zero timeout tells an event (or any waitable object) from a handle that is not open.
+    if (handle == nullptr || ::WaitForSingleObject(handle, 0) == WAIT_FAILED)
+        return std::unexpected(ChannelError::Io);
+    if (!::SetHandleInformation(handle, HANDLE_FLAG_INHERIT, 0))
+        return std::unexpected(ChannelError::Io);
+    auto* const stop = makeEvent();
+    if (stop == nullptr)
+        return std::unexpected(ChannelError::Io);
+    return WakeReceiver { handle, stop };
+}
+
+WakeReceiver::WakeReceiver(WakeReceiver&& other) noexcept:
+    _handle { std::exchange(other._handle, nullptr) }, _stopEvent { std::exchange(other._stopEvent, nullptr) }
+{
+}
+
+WakeReceiver& WakeReceiver::operator=(WakeReceiver&& other) noexcept
+{
+    if (this != &other)
+    {
+        release();
+        _handle = std::exchange(other._handle, nullptr);
+        _stopEvent = std::exchange(other._stopEvent, nullptr);
+    }
+    return *this;
+}
+
+WakeReceiver::~WakeReceiver()
+{
+    release();
+}
+
+void WakeReceiver::release() noexcept
+{
+    closeHandle(_handle);
+    closeHandle(_stopEvent);
+    _handle = nullptr;
+    _stopEvent = nullptr;
+}
+
+WakeWait WakeReceiver::wait() noexcept
+{
+    // The stop event first: WaitForMultipleObjects reports the lowest index signalled, so a stop wins.
+    auto const handles = std::array<HANDLE, 2> { _stopEvent, _handle };
+    switch (::WaitForMultipleObjects(static_cast<DWORD>(handles.size()), handles.data(), FALSE, INFINITE))
+    {
+        case WAIT_OBJECT_0: return WakeWait::Stopped;
+        case WAIT_OBJECT_0 + 1: ::ResetEvent(_handle); return WakeWait::Woken;
+        default: return WakeWait::PeerGone;
+    }
+}
+
+void WakeReceiver::stop() const noexcept
+{
+    ::SetEvent(_stopEvent);
+}
+
+NativeHandle WakeReceiver::nativeHandle() const noexcept
+{
+    return _handle;
+}
+
+std::expected<WakePair, ChannelError> makeWakePair()
+{
+    auto* const wake = makeEvent();
+    if (wake == nullptr)
+        return std::unexpected(ChannelError::Io);
+    auto* receiverEnd = HANDLE { nullptr };
+    if (!::DuplicateHandle(::GetCurrentProcess(),
+                           wake,
+                           ::GetCurrentProcess(),
+                           &receiverEnd,
+                           0,
+                           FALSE,
+                           DUPLICATE_SAME_ACCESS))
+    {
+        ::CloseHandle(wake);
+        return std::unexpected(ChannelError::Io);
+    }
+    auto sender = WakeSender { wake };
+    auto* const stop = makeEvent();
+    if (stop == nullptr)
+    {
+        ::CloseHandle(receiverEnd);
+        return std::unexpected(ChannelError::Io);
+    }
+    return WakePair { .parent = std::move(sender), .helper = WakeReceiver { receiverEnd, stop } };
+}
+
+} // namespace vtextension::wasm::remote::transport
diff --git a/src/vtextension/wasm/remote/transport/testing/HandleCopies.hpp b/src/vtextension/wasm/remote/transport/testing/HandleCopies.hpp
new file mode 100644
index 000000000..8fcfcf83f
