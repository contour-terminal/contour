+        std::fputs("RemoteBackend.releasedSlotIsLowered: the interrupted call did not return\n", stderr);
+        std::abort();
+    }
+    CHECK(spun.get() == std::expected<void, CallFailure> { std::unexpected(CallFailure::Interrupted) });
