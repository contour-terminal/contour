+TEST_CASE("Helper.exitsOnBadArguments", "[vtextension]")
+{
+    auto helper = launchHelper(process::makeSystemProcessLauncher(), helperLaunch({ "--bogus=1" }));
+    REQUIRE(helper.has_value());
+    CHECK(awaitReap(*helper->launcher, *helper->process)
