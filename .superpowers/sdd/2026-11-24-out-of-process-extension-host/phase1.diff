+// SPDX-License-Identifier: Apache-2.0
+//
+// The Wasmtime backend: the backend contract every runtime must meet, and what is Wasmtime's alone,
+// the features it enables unless told otherwise, checked with its C API directly.
+#include <catch2/catch_message.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <format>
+#include <future>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <string>
+#include <string_view>
+#include <thread>
+#include <utility>
+#include <vector>
+
+#include <wasmtime.h>
+
+#ifndef _WIN32
+    #include <csignal>
+#endif
+
+#include <vtextension/ExtensionError.hpp>
+#include <vtextension/wasm/EngineFeatures.hpp>
+#include <vtextension/wasm/testing/BackendContract.hpp>
+#include <vtextension/wasm/testing/FeatureModules.hpp>
+#include <vtextension/wasm/testing/RenderMeasurement.hpp>
+#include <vtextension/wasm/wasmtime/WasmtimeBackend.hpp>
+#include <vtextension/wasm/wasmtime/WasmtimeHandles.hpp>
+#include <vtextension/wasm/wasmtime/WasmtimeRuntime.hpp>
+
+using vtextension::ExtensionError;
+using vtextension::wasm::FeatureState;
+using vtextension::wasm::IWasmBackend;
+using vtextension::wasm::MemoryGrowthReporting;
+using vtextension::wasm::RuntimeLimits;
+using vtextension::wasm::wasmtime::KindState;
+using vtextension::wasm::wasmtime::makeKindState;
+using vtextension::wasm::wasmtime::makeWasmtimeBackend;
+using vtextension::wasm::wasmtime::TrapMode;
+using vtextension::wasm::wasmtime::WasmtimeConfig;
+
+namespace
+{
+
+/// Makes the backend under test, for the contract suite.
+struct WasmtimeTraits
+{
+    /// @return A Wasmtime backend of the one kind state this test binary shares, as a process would.
+    [[nodiscard]] static std::unique_ptr<IWasmBackend> make()
+    {
+        return makeWasmtimeBackend(kind(), WasmtimeConfig { .trapMode = TrapMode::Software });
+    }
+
+    /// @return The one kind state this test binary shares.
+    [[nodiscard]] static std::shared_ptr<KindState> const& kind()
+    {
+        static auto const state = makeKindState();
+        return state;
+    }
+};
+
+/// @return Whether an engine left at Wasmtime's feature defaults compiles @p bytes. Its traps are checked
+///         in software all the same: an engine with signal-based traps would install Wasmtime's handlers
+///         for the rest of this process, over the sanitizer's, and blind the signal-handler case.
+[[nodiscard]] bool defaultEngineAccepts(std::span<std::uint8_t const> bytes)
+{
+    namespace detail = vtextension::wasm::wasmtime::detail;
+    auto* const config = wasm_config_new();
+    wasmtime_config_signals_based_traps_set(config, false);
+    wasmtime_config_macos_use_mach_ports_set(config, false);
+    // Compiled on this thread, as the backend's engines compile: Wasmtime's compilation threads
+    // synchronize in Rust no sanitizer sees. What the engine accepts does not depend on it.
+    wasmtime_config_parallel_compilation_set(config, false);
+    auto const engine = detail::EngineHandle { wasm_engine_new_with_config(config) };
+    REQUIRE(engine);
+    auto* module = static_cast<wasmtime_module_t*>(nullptr);
+    auto const error =
+        detail::ErrorHandle { wasmtime_module_new(engine.get(), bytes.data(), bytes.size(), &module) };
+    auto const owned = detail::ModuleHandle { module };
+    return !error;
+}
+
+/// @return The module the WebAssembly text @p wat assembles to.
+[[nodiscard]] std::vector<std::byte> assemble(std::string_view wat)
+{
+    namespace detail = vtextension::wasm::wasmtime::detail;
+    auto bytes = wasm_byte_vec_t {};
+    auto const error = detail::ErrorHandle { wasmtime_wat2wasm(wat.data(), wat.size(), &bytes) };
+    REQUIRE_FALSE(error);
+    auto const view = std::as_bytes(std::span { bytes.data, bytes.size });
+    auto module = std::vector<std::byte> { view.begin(), view.end() };
+    wasm_byte_vec_delete(&bytes);
+    return module;
+}
+
+/// @return A module importing `arity` `f`, taking @p arity i32s, and exporting `call`, which calls it with
+///         1, 2, ... @p arity.
+[[nodiscard]] std::vector<std::byte> arityModule(uint32_t arity)
+{
+    auto parameters = std::string {};
+    auto arguments = std::string {};
+    for (auto const value: std::views::iota(uint32_t { 1 }, arity + 1))
+    {
+        parameters += " i32";
+        arguments += std::format(" (i32.const {})", value);
+    }
+    return assemble(std::format(R"((module
+  (import "arity" "f" (func $f (param{})))
+  (func (export "call") (call $f{})))
+)",
+                                parameters,
+                                arguments));
+}
+
+/// A host context whose every host function call calls back into its instance first, as the extension
+/// host does to allocate in guest memory, and then fails.
+class ReenteringHostContext final: public vtextension::wasm::IHostContext
+{
+  public:
+    /// The instance to call back into; set once it exists.
+    vtextension::wasm::IWasmInstance* instance = nullptr;
+    /// What the call back into the instance returned.
+    std::optional<std::expected<uint32_t, vtextension::wasm::CallFailure>> reentered;
+
+    [[nodiscard]] std::expected<void, ExtensionError> callHost(
+        std::size_t /*functionIndex*/, std::span<uint32_t const> /*arguments*/) noexcept override
+    {
+        auto argv = std::array<uint32_t, 2> { 2, 3 };
+        auto const add = instance->function("add");
+        reentered = instance->call(*add, argv).transform([&] { return argv[0]; });
+        return std::unexpected(ExtensionError::PermissionDenied);
+    }
+};
+
+/// `count` counts to a million and returns the count; `ping-then-count` calls `ping(0)` first.
+constexpr auto CountingModule = std::string_view { R"((module
+  (import "contract:test/host@0" "ping" (func $ping (param i32)))
+  (func $count (export "count") (result i32) (local $n i32)
+    (loop $again
+      (local.set $n (i32.add (local.get $n) (i32.const 1)))
+      (br_if $again (i32.lt_u (local.get $n) (i32.const 1000000))))
+    (local.get $n))
+  (func (export "ping-then-count") (result i32) (call $ping (i32.const 0)) (call $count)))
+)" };
+
+/// What `count` of CountingModule returns.
+constexpr auto CountedTo = uint32_t { 1'000'000 };
+
+/// A host context whose every host function call interrupts its own instance, calls back into it, and
+/// absorbs the failure, as a host function may when it can do without what it asked for.
+class SelfInterruptingHostContext final: public vtextension::wasm::IHostContext
+{
+  public:
+    /// Names the instance: it is created with this context, so the two are wired after both exist.
+    /// @param instance The instance; outlives every call made through this context.
+    void attach(vtextension::wasm::IWasmInstance& instance) noexcept { _instance = &instance; }
+
+    [[nodiscard]] std::expected<void, ExtensionError> callHost(
+        std::size_t /*functionIndex*/, std::span<uint32_t const> /*arguments*/) noexcept override
+    {
+        _instance->interrupt();
+        if (auto const add = _instance->function("add"))
+        {
+            auto argv = std::array<uint32_t, 2> { 2, 3 };
+            _nested = _instance->call(*add, argv);
+        }
+        return {};
+    }
+
+    /// @return What the call back into the instance returned; nothing before it was made.
+    [[nodiscard]] std::optional<std::expected<void, vtextension::wasm::CallFailure>> const& nested()
+        const noexcept
+    {
+        return _nested;
+    }
+
+  private:
+    vtextension::wasm::IWasmInstance* _instance = nullptr;
+    std::optional<std::expected<void, vtextension::wasm::CallFailure>> _nested;
+};
+
+/// A host context whose every host function call interrupts another instance: from inside a running
+/// call, at a known point of it.
+class InterruptingHostContext final: public vtextension::wasm::IHostContext
+{
+  public:
+    /// @param target The instance every host function call interrupts; outlives the context's use.
+    explicit InterruptingHostContext(vtextension::wasm::IWasmInstance& target) noexcept: _target { &target }
+    {
+    }
+
+    [[nodiscard]] std::expected<void, ExtensionError> callHost(
+        std::size_t /*functionIndex*/, std::span<uint32_t const> /*arguments*/) noexcept override
+    {
+        _target->interrupt();
+        return {};
+    }
+
+  private:
+    vtextension::wasm::IWasmInstance* _target;
+};
+
+} // namespace
+
+CONTOUR_WASM_BACKEND_CONTRACT(WasmtimeTraits)
+
+TEST_CASE("WasmtimeBackend.hostFunctionArities", "[wasmtime]")
+{
+    // A host function takes from none up to MaxHostParameters i32s, each reaching the host in order. One
+    // taking more cannot be provided, and the runtime is refused.
+    namespace contract = vtextension::wasm::testing::contract;
+    using vtextension::wasm::HostFunction;
+    using vtextension::wasm::wasmtime::MaxHostParameters;
+    auto const backend = WasmtimeTraits::make();
+
+    for (auto const arity: { uint32_t { 0 }, uint32_t { 1 }, MaxHostParameters })
+    {
+        INFO("arity " << arity);
+        auto const hostFunctions =
+            std::array { HostFunction { .module = "arity", .name = "f", .parameterCount = arity } };
+        auto const runtime = backend->createRuntime(contract::Limits, hostFunctions);
+        REQUIRE(runtime.has_value());
+        auto const guard = contract::enterThread(*backend);
+        auto const module = (*runtime)->load(arityModule(arity));
+        REQUIRE(module.has_value());
+        auto context = contract::RecordingHostContext {};
+        auto const instance = contract::instantiate(**module, context);
+
+        CHECK(instance->call(contract::functionOf(*instance, "call"), {}).has_value());
+        auto const expected = std::ranges::to<std::vector>(std::views::iota(uint32_t { 1 }, arity + 1));
+        CHECK(context.calls()
+              == std::vector { contract::HostCall {
+                  .functionIndex = 0, .arguments = expected, .thread = std::this_thread::get_id() } });
+    }
+
+    auto const tooMany = std::array { HostFunction {
+        .module = "arity", .name = "f", .parameterCount = MaxHostParameters + 1 } };
+    auto const refused = backend->createRuntime(contract::Limits, tooMany);
+    REQUIRE_FALSE(refused.has_value());
+    CHECK(refused.error() == ExtensionError::RuntimeUnavailable);
+}
+
+TEST_CASE("WasmtimeBackend.hostFunctionCallsBackIn", "[wasmtime]")
+{
+    // A host function calling back into its instance, as the extension host does to allocate in guest
+    // memory, gets its answer from the same store; its own failure after that still fails the outer call
+    // as a host failure.
+    namespace contract = vtextension::wasm::testing::contract;
+    auto const backend = WasmtimeTraits::make();
+    auto const runtime = contract::createRuntime(*backend);
+    auto const guard = contract::enterThread(*backend);
+    auto const module = contract::load(*runtime, contract::InstanceModule);
+    auto context = ReenteringHostContext {};
+    auto const instance = contract::instantiate(*module, context);
+    context.instance = instance.get();
+
+    auto const called = instance->call(contract::functionOf(*instance, "ping-then-store"), {});
+    REQUIRE_FALSE(called.has_value());
+    CHECK(called.error() == vtextension::wasm::CallFailure::HostFailure);
+    CHECK(context.reentered == std::expected<uint32_t, vtextension::wasm::CallFailure> { 5 });
+    CHECK(contract::wordAt(*instance, 0) == 0);
+}
+
+TEST_CASE("WasmtimeBackend.callsWideExports", "[wasmtime]")
+{
+    // An export taking more values than a call passes without allocating still receives every one, in
+    // order: `sum` returns the first of 20 parameters plus twice the second, and so on.
+    namespace contract = vtextension::wasm::testing::contract;
+    constexpr auto Width = uint32_t { 20 };
+    auto parameters = std::string {};
+    auto body = std::string { "(i32.const 0)" };
+    for (auto const index: std::views::iota(uint32_t { 0 }, Width))
+    {
+        parameters += " i32";
+        body = std::format("(i32.add {} (i32.mul (local.get {}) (i32.const {})))", body, index, index + 1);
+    }
+    auto const backend = WasmtimeTraits::make();
+    auto const runtime = contract::createRuntime(*backend);
+    auto const guard = contract::enterThread(*backend);
+    auto const module = runtime->load(assemble(
+        std::format(R"((module (func (export "sum") (param{}) (result i32) {})))", parameters, body)));
+    REQUIRE(module.has_value());
+    auto context = contract::RecordingHostContext {};
+    auto const instance = contract::instantiate(**module, context);
+
+    // Passed 1, 2, ... 20: 1² + 2² + ... + 20², which no other order of them gives.
+    auto argv = std::ranges::to<std::vector>(std::views::iota(uint32_t { 1 }, Width + 1));
+    REQUIRE(instance->call(contract::functionOf(*instance, "sum"), argv).has_value());
+    CHECK(argv[0] == 2870);
+}
+
+TEST_CASE("WasmtimeBackend.refusesWhatWasmtimeEnablesByDefault", "[wasmtime]")
+{
+    // A feature Wasmtime enables unless told otherwise is refused only because the backend switched it
+    // off. Each such module is checked against both: a default engine accepts it, the backend refuses it.
+#ifndef _WIN32
+    struct sigaction before {};
+    sigaction(SIGSEGV, nullptr, &before);
+#endif
+    auto const backend = WasmtimeTraits::make();
+    auto const runtime = vtextension::wasm::testing::contract::createRuntime(*backend);
+    auto enabledByDefault = std::size_t { 0 };
+    for (auto const& [feature, bytes]: vtextension::wasm::testing::FeatureModules)
+    {
+        auto const& row = vtextension::wasm::featureRow(feature);
+        if (row.state != FeatureState::Off || !defaultEngineAccepts(bytes))
+            continue;
+        ++enabledByDefault;
+        INFO("feature: " << row.name);
+        auto const module = std::as_bytes(bytes);
+        auto const loaded = runtime->load({ module.begin(), module.end() });
+        REQUIRE_FALSE(loaded.has_value());
+        CHECK(loaded.error() == ExtensionError::InvalidComponent);
+    }
+    // Wasmtime 48 enables GC, exceptions, 64-bit memories, typed function references, threads, tail
+    // calls, multiple memories, SIMD and relaxed SIMD by default; were none of them, this case checked
+    // nothing.
+    CHECK(enabledByDefault >= 9);
+#ifndef _WIN32
+    // Neither the backend's engines nor the default ones compared against took the process's SIGSEGV.
+    struct sigaction after {};
+    sigaction(SIGSEGV, nullptr, &after);
+    CHECK(after.sa_sigaction == before.sa_sigaction);
+#endif
+}
+
+TEST_CASE("WasmtimeBackend.refusesAZeroStack", "[wasmtime]")
+{
+    // Wasmtime aborts the process on an engine whose stack cap is zero; the backend refuses it first.
+    auto const runtime = WasmtimeTraits::make()->createRuntime(
+        RuntimeLimits { .memoryBytes = vtextension::wasm::testing::contract::Limits.memoryBytes,
+                        .stackBytes = 0 },
+        vtextension::wasm::testing::contract::HostFunctions);
+    REQUIRE_FALSE(runtime.has_value());
+    CHECK(runtime.error() == ExtensionError::RuntimeUnavailable);
+}
+
+TEST_CASE("WasmtimeBackend.leavesMemoryGrowthUnreported", "[wasmtime]")
+{
+    CHECK(WasmtimeTraits::make()->capabilities().memoryGrowth == MemoryGrowthReporting::Unreported);
+}
+
+TEST_CASE("WasmtimeBackend.wasiReadsTheConfiguredEnvironment", "[wasmtime]")
+{
+    namespace contract = vtextension::wasm::testing::contract;
+    // A clock reading 7 seconds past its id, and random bytes that are all 0x5A.
+    auto config = WasmtimeConfig {
+        .trapMode = TrapMode::Software,
+        .wasiEnvironment = {
+            .clock = [](uint32_t clockId) { return 7'000'000'000 + uint64_t { clockId }; },
+            .random = [](std::span<std::byte> bytes) -> std::expected<void, vtextension::wasm::wasi::Errno> {
+                std::ranges::fill(bytes, std::byte { 0x5A });
+                return {};
+            } },
+    };
+    auto const backend = makeWasmtimeBackend(WasmtimeTraits::kind(), std::move(config));
+    auto const runtime = contract::createRuntime(*backend);
+    auto const guard = contract::enterThread(*backend);
+    auto const module = contract::load(*runtime, contract::EveryWasiFunctionModule);
+    auto context = contract::RecordingHostContext {};
+    auto const instance = contract::instantiate(*module, context);
+
+    // Both write at address 64: clock_time_get reads the realtime clock (id 0), random_get fills 16 bytes.
+    auto error = std::array<uint32_t, 1> {};
+    REQUIRE(instance->call(contract::functionOf(*instance, "clock_time_get"), error).has_value());
+    CHECK(error[0] == 0);
+    auto const time = instance->memory(64, 8);
+    REQUIRE(time.has_value());
+    auto nanoseconds = uint64_t { 0 };
+    for (auto const byte: *time | std::views::reverse)
+        nanoseconds = (nanoseconds << 8U) | std::to_integer<uint64_t>(byte);
+    CHECK(nanoseconds == 7'000'000'000);
+
+    REQUIRE(instance->call(contract::functionOf(*instance, "random_get"), error).has_value());
+    CHECK(error[0] == 0);
+    auto const random = instance->memory(64, 16);
+    REQUIRE(random.has_value());
+    CHECK(std::ranges::all_of(*random, [](std::byte byte) { return byte == std::byte { 0x5A }; }));
+}
+
+TEST_CASE("Wasmtime.idleInstanceNeverWakes", "[wasmtime]")
+{
+    // Nothing but an interrupt moves the epoch: a guest running a million loop iterations never reaches
+    // its deadline, and nothing wakes to poll it.
+    namespace contract = vtextension::wasm::testing::contract;
+    auto const& kind = *WasmtimeTraits::kind();
+    auto const backend = WasmtimeTraits::make();
+    auto const runtime = contract::createRuntime(*backend);
+    auto const guard = contract::enterThread(*backend);
+    auto const module = runtime->load(assemble(CountingModule));
+    REQUIRE(module.has_value());
+    auto context = contract::RecordingHostContext {};
+    auto const instance = contract::instantiate(**module, context);
+
+    // Long enough for a ticker, were one moving the epoch, to fire many times over.
+    using namespace std::chrono_literals;
+    constexpr auto RunFor = 100ms;
+    auto const count = contract::functionOf(*instance, "count");
+    auto const before = kind.epochCallbacks();
+    auto const started = std::chrono::steady_clock::now();
+    auto calls = 0;
+    auto counted = true;
+    while (std::chrono::steady_clock::now() - started < RunFor)
+    {
+        auto result = std::array<uint32_t, 1> {};
+        counted = counted && instance->call(count, result).has_value() && result[0] == CountedTo;
+        ++calls;
+    }
+    INFO("calls of a million iterations each: " << calls);
+    CHECK(counted);
+    CHECK(kind.epochCallbacks() == before);
+}
+
+TEST_CASE("Wasmtime.nestedInterruptStopsTheOuterCall", "[wasmtime]")
+{
+    // An interrupt landing during a host function call stops the guest that made it, even when the host
+    // function calls back in, finds that call interrupted, absorbs the failure and returns into a guest
+    // that would spin forever. A regression would hang: the call runs on a thread of its own, and is
+    // released by a second interrupt if it does not end in time.
+    using namespace std::chrono_literals;
+    namespace contract = vtextension::wasm::testing::contract;
+    using vtextension::wasm::CallFailure;
+    auto const backend = WasmtimeTraits::make();
+    auto const runtime = contract::createRuntime(*backend);
+    auto const guard = contract::enterThread(*backend);
+    auto const module = runtime->load(assemble(R"((module
+  (import "contract:test/host@0" "ping" (func $ping (param i32)))
+  (func (export "add") (param i32 i32) (result i32) (i32.add (local.get 0) (local.get 1)))
+  (func (export "ping-then-spin") (call $ping (i32.const 0)) (loop (br 0))))
+)"));
+    REQUIRE(module.has_value());
+    auto context = SelfInterruptingHostContext {};
+    auto const instance = contract::instantiate(**module, context);
+    context.attach(*instance);
+    auto const pingThenSpin = contract::functionOf(*instance, "ping-then-spin");
+
+    auto called = std::async(std::launch::async, [&] {
+        auto const callGuard = backend->enterThread();
+        return instance->call(pingThenSpin, {});
+    });
+    auto const ended = called.wait_for(5s) == std::future_status::ready;
+    if (!ended)
+        instance->interrupt();
+    auto const result = called.get();
+    CHECK(ended);
+    CHECK(context.nested() == std::expected<void, CallFailure> { std::unexpected(CallFailure::Interrupted) });
+    REQUIRE_FALSE(result.has_value());
+    CHECK(result.error() == CallFailure::Interrupted);
+}
+
+TEST_CASE("Wasmtime.interruptLeavesSiblingsRunning", "[wasmtime]")
+{
+    // An interrupt moves the epoch every instance of the runtime shares. One running when it moves wakes
+    // once, finds its own instance not interrupted, and runs on; the interrupted one stays stopped.
+    namespace contract = vtextension::wasm::testing::contract;
+    using vtextension::wasm::CallFailure;
+    auto const& kind = *WasmtimeTraits::kind();
+    auto const backend = WasmtimeTraits::make();
+    auto const runtime = contract::createRuntime(*backend);
+    auto const guard = contract::enterThread(*backend);
+    auto const module = runtime->load(assemble(CountingModule));
+    REQUIRE(module.has_value());
+    auto targetContext = contract::RecordingHostContext {};
+    auto const target = contract::instantiate(**module, targetContext);
+    auto siblingContext = InterruptingHostContext { *target };
+    auto const sibling = contract::instantiate(**module, siblingContext);
+
+    auto const before = kind.epochCallbacks();
+    auto result = std::array<uint32_t, 1> {};
+    REQUIRE(sibling->call(contract::functionOf(*sibling, "ping-then-count"), result).has_value());
+    CHECK(result[0] == CountedTo);
+    CHECK(kind.epochCallbacks() - before == 1);
+
+    auto const stopped = target->call(contract::functionOf(*target, "count"), result);
+    REQUIRE_FALSE(stopped.has_value());
+    CHECK(stopped.error() == CallFailure::Interrupted);
+
+    // The epoch has not moved since: the sibling's next call runs through without waking.
+    REQUIRE(sibling->call(contract::functionOf(*sibling, "count"), result).has_value());
+    CHECK(kind.epochCallbacks() - before == 1);
+}
+
+TEST_CASE("Wasmtime.interruptRacingACallStopsIt", "[wasmtime]")
+{
+    // An interrupt landing at any point of a call's way into the guest stops it: before the call checks
+    // the flag, between that check and the guest's first instruction, or while the guest runs. Each round
+    // releases the interrupt a little later relative to the call than the one before.
+    namespace contract = vtextension::wasm::testing::contract;
+    using vtextension::wasm::CallFailure;
+    auto const backend = WasmtimeTraits::make();
+    auto const runtime = contract::createRuntime(*backend);
+    auto const guard = contract::enterThread(*backend);
+    auto const module = contract::load(*runtime, contract::InstanceModule);
+    auto context = contract::RecordingHostContext {};
+
+    constexpr auto Rounds = 200;
+    auto stopped = 0;
+    for (auto const round: std::views::iota(0, Rounds))
+    {
+        auto const instance = contract::instantiate(*module, context);
+        auto const spin = contract::functionOf(*instance, "spin");
+        auto go = std::atomic<bool> { false };
+        auto interrupter = std::jthread([&] {
+            while (!go.load(std::memory_order_acquire))
+                std::this_thread::yield();
+            // A delay the optimizer cannot drop: an atomic counted up `round * 4` times.
+            auto delay = std::atomic<int> { 0 };
+            std::ranges::for_each(std::views::iota(0, round * 4),
+                                  [&](int) { delay.fetch_add(1, std::memory_order_relaxed); });
+            instance->interrupt();
+        });
+        go.store(true, std::memory_order_release);
+        auto const called = instance->call(spin, {});
+        interrupter.join();
+        if (!called.has_value() && called.error() == CallFailure::Interrupted)
+            ++stopped;
+    }
+    CHECK(stopped == Rounds);
+}
+
+TEST_CASE("Wasmtime.measureRender", "[.measure]")
+{
+    // Reported, not asserted; vtextension_test's twin measures WAMR the same way.
+    auto const backend = WasmtimeTraits::make();
+    vtextension::wasm::testing::measureBundledRender(*backend, "Wasmtime");
+}
diff --git a/src/vtextension/wasm/wasmtime/WasmtimeHandles.hpp b/src/vtextension/wasm/wasmtime/WasmtimeHandles.hpp
new file mode 100644
index 000000000..f53b2c08d
--- /dev/null
+++ b/src/vtextension/wasm/wasmtime/WasmtimeHandles.hpp
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Owning handles on Wasmtime's opaque objects, so that headers need not pull wasmtime.h in.
+#pragma once
+
+#include <memory>
+
+struct wasm_engine_t;
+struct wasm_functype_t;
+struct wasm_trap_t;
+struct wasmtime_error;
+struct wasmtime_linker;
+struct wasmtime_module;
+struct wasmtime_store;
+
+namespace vtextension::wasm::wasmtime::detail
+{
+
+/// Deletes an engine.
+struct EngineDeleter
+{
+    /// Deletes @p engine.
+    void operator()(wasm_engine_t* engine) const noexcept;
+};
+
+/// Deletes a store, and every instance in it.
+struct StoreDeleter
+{
+    /// Deletes @p store.
+    void operator()(wasmtime_store* store) const noexcept;
+};
+
+/// Deletes a compiled module.
+struct ModuleDeleter
+{
+    /// Deletes @p module.
+    void operator()(wasmtime_module* module) const noexcept;
+};
+
+/// Deletes a linker.
+struct LinkerDeleter
+{
+    /// Deletes @p linker.
+    void operator()(wasmtime_linker* linker) const noexcept;
+};
+
+/// Deletes an error.
+struct ErrorDeleter
+{
+    /// Deletes @p error.
+    void operator()(wasmtime_error* error) const noexcept;
+};
+
+/// Deletes a trap.
+struct TrapDeleter
+{
+    /// Deletes @p trap.
+    void operator()(wasm_trap_t* trap) const noexcept;
+};
+
+/// Deletes a function type.
+struct FuncTypeDeleter
+{
+    /// Deletes @p type.
+    void operator()(wasm_functype_t* type) const noexcept;
+};
+
+/// An engine: the compiler and its configuration.
+using EngineHandle = std::unique_ptr<wasm_engine_t, EngineDeleter>;
+
+/// A store: what instances live in.
+using StoreHandle = std::unique_ptr<wasmtime_store, StoreDeleter>;
+
+/// A compiled module.
+using ModuleHandle = std::unique_ptr<wasmtime_module, ModuleDeleter>;
+
+/// A linker: the host functions modules are instantiated against.
+using LinkerHandle = std::unique_ptr<wasmtime_linker, LinkerDeleter>;
+
+/// An error a Wasmtime call returned; null for none.
+using ErrorHandle = std::unique_ptr<wasmtime_error, ErrorDeleter>;
+
+/// A trap.
+using TrapHandle = std::unique_ptr<wasm_trap_t, TrapDeleter>;
+
+/// A function type.
+using FuncTypeHandle = std::unique_ptr<wasm_functype_t, FuncTypeDeleter>;
+
+} // namespace vtextension::wasm::wasmtime::detail
diff --git a/src/vtextension/wasm/wasmtime/WasmtimeInstance.cpp b/src/vtextension/wasm/wasmtime/WasmtimeInstance.cpp
new file mode 100644
index 000000000..441d2bd31
--- /dev/null
+++ b/src/vtextension/wasm/wasmtime/WasmtimeInstance.cpp
@@ -0,0 +1,386 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// The Wasmtime backend's instances: one store each, held to the runtime's limits.
+#include <core/Assert.hpp>
+#include <core/Utils.hpp>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <expected>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <ranges>
+#include <span>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <wasmtime.h>
+
+#include <vtextension/wasm/wasmtime/WasmtimeHandles.hpp>
+#include <vtextension/wasm/wasmtime/WasmtimeRuntime.hpp>
+
+namespace vtextension::wasm::wasmtime
+{
+
+namespace
+{
+    /// The WebAssembly page size, in bytes.
+    constexpr auto PageBytes = uint64_t { 64 } * 1024;
+
+    /// How many values a call passes each way without allocating: the Canonical ABI's limit on flat
+    /// parameters, which every function of the extension world keeps to.
+    constexpr auto InlineValues = std::size_t { 16 };
+
+    /// The values of one direction of a call: @p count of them, in @p inlineValues when they fit, else in
+    /// @p wideValues.
+    /// @return Where the @p count values are.
+    [[nodiscard]] std::span<wasmtime_val_t> valuesFor(std::size_t count,
+                                                      std::array<wasmtime_val_t, InlineValues>& inlineValues,
+                                                      std::vector<wasmtime_val_t>& wideValues)
+    {
+        if (count <= inlineValues.size())
+            return std::span { inlineValues }.first(count);
+        wideValues.resize(count);
+        return wideValues;
+    }
+
+    /// One function export of an instance, looked up once.
+    struct FunctionEntry
+    {
+        std::string name;            ///< The export's name.
+        wasmtime_func_t function {}; ///< Wasmtime's handle on it, in the instance's store.
+        uint32_t parameterCount = 0; ///< How many i32 parameters it takes.
+        uint32_t resultCount = 0;    ///< How many i32 results it returns.
+    };
+
+    /// @return Whether every type of @p types is an i32: the cells IWasmInstance::call() passes.
+    [[nodiscard]] bool allI32(std::span<ValueType const> types) noexcept
+    {
+        return std::ranges::all_of(types, [](ValueType type) { return type == ValueType::I32; });
+    }
+
+    /// How far beyond the current epoch a guest's deadline lies: one tick. Only an interrupt moves the
+    /// epoch, so a guest that is never interrupted never reaches it and nothing ever wakes to poll it;
+    /// one that is reaches it at its next epoch check.
+    constexpr auto DeadlineTicks = uint64_t { 1 };
+
+    /// Sets the deadline of the guest of @p context, before every entry into guest code. A store's
+    /// deadline starts at epoch 0, which the engine's epoch has always reached.
+    void armEpochDeadline(wasmtime_context_t* context) noexcept
+    {
+        wasmtime_context_set_epoch_deadline(context, DeadlineTicks);
+    }
+
+    /// Wasmtime's epoch deadline callback: called on the thread of a running guest whose deadline the
+    /// epoch reached. The epoch is the engine's, shared by every instance of the runtime, so reaching
+    /// the deadline says only that some instance was interrupted: this one's own flag decides.
+    /// Called from Wasmtime's Rust code, which an exception must not unwind through: noexcept.
+    ///
+    /// A known window, accepted: when this callback finds the flag not set and returns, Wasmtime sets the
+    /// new deadline one tick past the epoch *as it reads it then*, after the flag was read. An interrupt()
+    /// of this instance landing between the flag read and that re-read moves the epoch the new deadline is
+    /// then counted from, so the guest is not woken again: the interrupt is lost until another one moves
+    /// the epoch. It cannot be closed from here: the callback only hands back a delta relative to an epoch
+    /// Wasmtime reads after it returns, and neither it nor wasmtime_context_set_epoch_deadline sets an
+    /// absolute deadline or compares the epoch it counts from. It takes two instances sharing an engine
+    /// (another's interrupt woke this guest) and an interrupt landing within a few instructions. The
+    /// in-process Wasmtime backend serves tests; in production the guest runs in a helper process, and the
+    /// supervisor's grace timer kills a helper whose interrupted call does not return.
+    /// @param env The instance's StoreData.
+    /// @return An error ending the call if the instance was interrupted; otherwise null, with the deadline
+    ///         moved one tick past the current epoch.
+    wasmtime_error_t* onEpochDeadline(wasmtime_context_t* /*context*/,
+                                      void* env,
+                                      uint64_t* deadlineTicks,
+                                      wasmtime_update_deadline_kind_t* updateKind) noexcept
+    {
+        auto& data = *static_cast<StoreData*>(env);
+        data.kind.countEpochCallback();
+        // Pairs with the fence in interrupt(): the epoch this guest saw moved after the flag was stored.
+        std::atomic_thread_fence(std::memory_order_acquire);
+        if (data.interrupt.load(std::memory_order_relaxed) == InterruptState::Interrupted)
+            return wasmtime_error_new("interrupted");
+        *deadlineTicks = DeadlineTicks;
+        *updateKind = WASMTIME_UPDATE_DEADLINE_CONTINUE;
+        return nullptr;
+    }
+
+    /// One module instance in its own store.
+    ///
+    /// The store's data is the instance's StoreData: that is how a host function call made from inside the
+    /// instance finds its IHostContext, and how a failing one is told apart from a trap of the guest's.
+    class WasmtimeInstance final: public IWasmInstance
+    {
+        struct PrivateTag
+        {
+        };
+
+      public:
+        /// @see WasmtimeModule::instantiate
+        [[nodiscard]] static std::expected<std::unique_ptr<IWasmInstance>, ExtensionError> create(
+            std::shared_ptr<WasmtimeModule const> owner,
+            WasmtimeRuntime const& runtime,
+            wasmtime_module_t const* module,
+            std::span<ExportDescription const> exports,
+            uint32_t largestInitialPages,
+            IHostContext& context);
+
+        /// Use create(); public only so that std::make_unique can reach it.
+        WasmtimeInstance(PrivateTag,
+                         std::shared_ptr<WasmtimeModule const> owner,
+                         std::unique_ptr<StoreData> data,
+                         detail::StoreHandle store,
+                         std::vector<FunctionEntry> functions,
+                         std::optional<wasmtime_memory_t> memory,
+                         wasm_engine_t const* engine) noexcept:
+            _owner { std::move(owner) },
+            _data { std::move(data) },
+            _store { std::move(store) },
+            _functions { std::move(functions) },
+            _memory { memory },
+            _engine { engine }
+        {
+        }
+
+        ~WasmtimeInstance() override = default;
+        WasmtimeInstance(WasmtimeInstance const&) = delete;
+        WasmtimeInstance(WasmtimeInstance&&) = delete;
+        WasmtimeInstance& operator=(WasmtimeInstance const&) = delete;
+        WasmtimeInstance& operator=(WasmtimeInstance&&) = delete;
+
+        /// Only function exports taking and returning nothing but i32s are found: they are what call()
+        /// passes cells to, and every function of the extension world is one.
+        [[nodiscard]] std::optional<ExportFunction> function(std::string_view name) const override
+        {
+            auto const entry = std::ranges::find(_functions, name, &FunctionEntry::name);
+            if (entry == _functions.end())
+                return std::nullopt;
+            return ExportFunction { .index = static_cast<uint32_t>(entry - _functions.begin()) };
+        }
+
+        [[nodiscard]] std::expected<void, CallFailure> call(ExportFunction function,
+                                                            std::span<uint32_t> argv) override
+        {
+            Require(function.index < _functions.size());
+            auto const& entry = _functions[function.index];
+            Require(argv.size() >= std::max(entry.parameterCount, entry.resultCount));
+
+            // The deadline goes first, the interrupt check after it: an interrupt landing between the two is
+            // seen by the check, and one landing after the check moves the epoch past the deadline, which
+            // stops the guest at its first epoch check. The fence pairs with interrupt()'s: if setting the
+            // deadline read an epoch an interrupt moved, the check sees that interrupt's flag.
+            auto* const context = storeContext();
+            armEpochDeadline(context);
+            std::atomic_thread_fence(std::memory_order_acquire);
+            // The interrupt is sticky: once requested, no call enters the guest again.
+            if (_data->interrupt.load(std::memory_order_relaxed) == InterruptState::Interrupted)
+                return interrupted(context);
+
+            // A host function may call back into the instance (to allocate in guest memory): what the
+            // outermost call records is kept until it returns.
+            if (_callDepth == 0)
+                _data->hostFailure = std::nullopt;
+
+            auto inlineArguments = std::array<wasmtime_val_t, InlineValues> {};
+            auto wideArguments = std::vector<wasmtime_val_t> {};
+            auto const arguments = valuesFor(entry.parameterCount, inlineArguments, wideArguments);
+            for (auto const [index, argument]: core::views::enumerate(arguments))
+            {
+                argument.kind = WASMTIME_I32;
+                argument.of.i32 = static_cast<int32_t>(argv[static_cast<std::size_t>(index)]);
+            }
+            auto inlineResults = std::array<wasmtime_val_t, InlineValues> {};
+            auto wideResults = std::vector<wasmtime_val_t> {};
+            auto const results = valuesFor(entry.resultCount, inlineResults, wideResults);
+
+            auto* rawTrap = static_cast<wasm_trap_t*>(nullptr);
+            ++_callDepth;
+            auto const error = detail::ErrorHandle { wasmtime_func_call(context,
+                                                                        &entry.function,
+                                                                        arguments.data(),
+                                                                        arguments.size(),
+                                                                        results.data(),
+                                                                        results.size(),
+                                                                        &rawTrap) };
+            --_callDepth;
+            auto const trap = detail::TrapHandle { rawTrap };
+            auto const failed = error || trap ? std::optional { failure() } : std::nullopt;
+            // A nested call reports its host failure through its own result: the host function that made
+            // it decides what becomes of it, and the call it is nested in must not report it again.
+            if (_callDepth > 0)
+                _data->hostFailure = std::nullopt;
+            if (failed == CallFailure::Interrupted)
+                return interrupted(context);
+            if (failed)
+                return std::unexpected(*failed);
+
+            std::ranges::transform(results, argv.begin(), [](wasmtime_val_t const& result) {
+                return static_cast<uint32_t>(result.of.i32);
+            });
+            return {};
+        }
+
+        [[nodiscard]] std::optional<std::span<std::byte>> memory(uint32_t address, uint32_t size) override
+        {
+            if (size == 0)
+                return std::span<std::byte> {};
+            if (!_memory)
+                return std::nullopt;
+            auto* const context = storeContext();
+            auto const bytes = wasmtime_memory_data_size(context, &*_memory);
+            if (uint64_t { address } + size > bytes)
+                return std::nullopt;
+            auto const whole =
+                std::span<std::byte> { reinterpret_cast<std::byte*>(wasmtime_memory_data(context, &*_memory)),
+                                       bytes };
+            return whole.subspan(address, size);
+        }
+
+        /// Wait-free, from any thread, before, during or after a call: stores the flag, then moves the
+        /// engine's epoch past the deadline of every guest of the runtime running now. Each of them wakes
+        /// once (onEpochDeadline); only this instance's stops. One landing just as this instance's guest
+        /// was woken by another instance's interrupt can be missed (the window documented at
+        /// onEpochDeadline); the helper process's supervisor kills a call that then never returns.
+        void interrupt() noexcept override
+        {
+            _data->interrupt.store(InterruptState::Interrupted, std::memory_order_relaxed);
+            // Orders the flag before the epoch increment, for whoever reads the moved epoch.
+            std::atomic_thread_fence(std::memory_order_release);
+            wasmtime_engine_increment_epoch(_engine);
+        }
+
+      private:
+        /// Ends a call as interrupted. A nested call also makes the deadline of the call it is nested in
+        /// due at once: the store has one deadline, which this call set one tick past an epoch the
+        /// interrupt may already have moved, and the host function may absorb this failure and return
+        /// into a guest that would then run on.
+        /// @param context The context the call runs in.
+        /// @return The failure `Interrupted`.
+        [[nodiscard]] std::unexpected<CallFailure> interrupted(wasmtime_context_t* context) const noexcept
+        {
+            if (_callDepth > 0)
+                wasmtime_context_set_epoch_deadline(context, 0);
+            return std::unexpected(CallFailure::Interrupted);
+        }
+
+        /// @return The context the store is reached through: the caller's while a host function call runs,
+        ///         the store's own otherwise.
+        [[nodiscard]] wasmtime_context_t* storeContext() const noexcept
+        {
+            if (_data->callerContext)
+                return _data->callerContext;
+            return wasmtime_store_context(_store.get());
+        }
+
+        /// @return Why the call that just failed did. Decided by what the instance recorded, never by a
+        ///         trap's message: an interrupt ends a call only through onEpochDeadline, which reads the
+        ///         flag this reads.
+        [[nodiscard]] CallFailure failure() const noexcept
+        {
+            if (_data->interrupt.load(std::memory_order_acquire) == InterruptState::Interrupted)
+                return CallFailure::Interrupted;
+            if (_data->hostFailure)
+                return CallFailure::HostFailure;
+            return CallFailure::Trap;
+        }
+
+        std::shared_ptr<WasmtimeModule const> _owner; ///< Declared first: released after the instance.
+        std::unique_ptr<StoreData> _data;             ///< The store's data; outlives the store.
+        detail::StoreHandle _store;
+        std::vector<FunctionEntry> _functions;
+        std::optional<wasmtime_memory_t> _memory; ///< The first memory the instance exports, if any.
+        wasm_engine_t const* _engine;             ///< The runtime's engine, whose epoch interrupt() moves.
+        uint32_t _callDepth = 0;                  ///< Calls running, nested ones included.
+    };
+
+    std::expected<std::unique_ptr<IWasmInstance>, ExtensionError> WasmtimeInstance::create(
+        std::shared_ptr<WasmtimeModule const> owner,
+        WasmtimeRuntime const& runtime,
+        wasmtime_module_t const* module,
+        std::span<ExportDescription const> exports,
+        uint32_t largestInitialPages,
+        IHostContext& context)
+    {
+        // Checked before instantiating, exported memories and others alike: the limiter's refusal would
+        // fail the instantiation as an error indistinguishable from any other.
+        auto const capBytes = runtime.limits().memoryBytes;
+        if (largestInitialPages * PageBytes > capBytes)
+            return std::unexpected(ExtensionError::OutOfMemory);
+
+        auto data = std::make_unique<StoreData>(context, runtime.wasiEnvironment(), runtime.kind());
+        auto store = detail::StoreHandle { wasmtime_store_new(runtime.engine(), data.get(), nullptr) };
+        if (!store)
+            return std::unexpected(ExtensionError::RuntimeUnavailable);
+        // Before anything runs in the store, a start function included: every deadline is one an interrupt
+        // of any instance of the runtime moves the epoch past.
+        wasmtime_store_epoch_deadline_callback(store.get(), &onEpochDeadline, data.get(), nullptr);
+        // Memory grows up to the cap and no further (memory.grow returns -1); one instance and one memory
+        // per store.
+        auto const memoryCap = static_cast<int64_t>(
+            std::min<uint64_t>(capBytes, static_cast<uint64_t>(std::numeric_limits<int64_t>::max())));
+        wasmtime_store_limiter(store.get(), memoryCap, -1, 1, -1, 1);
+
+        auto* const storeContext = wasmtime_store_context(store.get());
+        // A start function runs during instantiation.
+        armEpochDeadline(storeContext);
+        auto instance = wasmtime_instance_t {};
+        auto* rawTrap = static_cast<wasm_trap_t*>(nullptr);
+        auto const error = detail::ErrorHandle { wasmtime_linker_instantiate(
+            runtime.linker(), storeContext, module, &instance, &rawTrap) };
+        auto const trap = detail::TrapHandle { rawTrap };
+        if (error || trap)
+            return std::unexpected(ExtensionError::InvalidComponent);
+
+        auto functions = std::vector<FunctionEntry> {};
+        auto memory = std::optional<wasmtime_memory_t> {};
+        for (auto const& entry: exports)
+        {
+            auto item = wasmtime_extern_t {};
+            if (!wasmtime_instance_export_get(
+                    storeContext, &instance, entry.name.data(), entry.name.size(), &item))
+                continue;
+            // A function or a memory is a plain handle into the store, kept by value; anything else is
+            // not kept, and released.
+            if (item.kind == WASMTIME_EXTERN_FUNC)
+            {
+                if (allI32(entry.signature.parameters) && allI32(entry.signature.results))
+                    functions.push_back(FunctionEntry {
+                        .name = entry.name,
+                        .function = item.of.func,
+                        .parameterCount = static_cast<uint32_t>(entry.signature.parameters.size()),
+                        .resultCount = static_cast<uint32_t>(entry.signature.results.size()) });
+            }
+            else if (item.kind == WASMTIME_EXTERN_MEMORY)
+            {
+                if (!memory)
+                    memory = item.of.memory;
+            }
+            else
+                wasmtime_extern_delete(&item);
+        }
+
+        return std::make_unique<WasmtimeInstance>(PrivateTag {},
+                                                  std::move(owner),
+                                                  std::move(data),
+                                                  std::move(store),
+                                                  std::move(functions),
+                                                  memory,
+                                                  runtime.engine());
+    }
+} // namespace
+
+std::expected<std::unique_ptr<IWasmInstance>, ExtensionError> WasmtimeModule::instantiate(
+    IHostContext& context)
+{
+    // The guest's `_initialize` is never run here: it stays an ordinary export, the caller's to call.
+    return WasmtimeInstance::create(
+        shared_from_this(), *_runtime, _module.get(), _exports, _largestInitialPages, context);
+}
+
+} // namespace vtextension::wasm::wasmtime
