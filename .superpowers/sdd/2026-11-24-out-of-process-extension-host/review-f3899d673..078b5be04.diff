+/// exits, which is harmless.
 void becomeSubreaper()
 {
 #ifdef __linux__
     static auto const isSubreaper = ::prctl(PR_SET_CHILD_SUBREAPER, 1) == 0;
     REQUIRE(isSubreaper);
 #elifdef __FreeBSD__
     static auto const isSubreaper = ::procctl(P_PID, ::getpid(), PROC_REAP_ACQUIRE, nullptr) == 0;
     REQUIRE(isSubreaper);
