diff --git a/cmake/ApplyPatchOnce.cmake b/cmake/ApplyPatchOnce.cmake
new file mode 100644
index 000000000..68279fdf0
--- /dev/null
+++ b/cmake/ApplyPatchOnce.cmake
@@ -0,0 +1,30 @@
+# Applies PATCH_FILE to the source tree in the working directory, once: a tree it is already applied to (a
+# reconfigure, or a populated source cache) is left as it is. Run as the PATCH_COMMAND of a fetched dependency:
+#
+#   ${CMAKE_COMMAND} -D PATCH_EXECUTABLE=<patch> -D PATCH_FILE=<file> -P ApplyPatchOnce.cmake
+#
+# `patch -R --dry-run` succeeds only where the whole patch is in place; otherwise it is applied forward with
+# -N, which refuses rather than reverses a hunk found applied, so that a tree patched halfway fails loudly.
+cmake_minimum_required(VERSION 3.25)
+foreach(_required IN ITEMS PATCH_EXECUTABLE PATCH_FILE)
+    if(NOT ${_required})
+        message(FATAL_ERROR "ApplyPatchOnce.cmake needs -D ${_required}=...")
+    endif()
+endforeach()
+
+execute_process(
+    COMMAND "${PATCH_EXECUTABLE}" -p1 -R --dry-run --silent --input "${PATCH_FILE}"
+    RESULT_VARIABLE _applied
+    OUTPUT_QUIET ERROR_QUIET
+)
+if(_applied EQUAL 0)
+    message(STATUS "Already applied: ${PATCH_FILE}")
+    return()
+endif()
+execute_process(
+    COMMAND "${PATCH_EXECUTABLE}" -p1 -N --forward --input "${PATCH_FILE}"
+    RESULT_VARIABLE _patched
+)
+if(NOT _patched EQUAL 0)
+    message(FATAL_ERROR "Could not apply ${PATCH_FILE}")
+endif()
