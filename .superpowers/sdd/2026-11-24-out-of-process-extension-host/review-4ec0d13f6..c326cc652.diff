+    auto iov = ::iovec { .iov_base = frame->data(), .iov_len = frame->size() };
+    alignas(::cmsghdr) auto control = std::array<std::byte, CMSG_SPACE(sizeof(int) * 3)> {};
+    auto message = ::msghdr {};
+    message.msg_iov = &iov;
+    message.msg_iovlen = 1;
+    if (!objects.empty())
