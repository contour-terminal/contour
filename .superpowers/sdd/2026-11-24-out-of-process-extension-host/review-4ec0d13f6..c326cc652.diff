+    parent.send(0, proto::Call { .instanceId = 1, .exportOrdinal = grow, .argv = { 1 } });
+    CHECK(parent.receive(0) == proto::Pdu { proto::Grow { .instanceId = 1, .bytes = 2 * GuestPage } });
