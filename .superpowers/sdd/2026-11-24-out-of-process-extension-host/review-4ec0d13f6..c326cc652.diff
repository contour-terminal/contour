+class Scribbler
+{
+  public:
+    Scribbler(): _thread { [this](std::stop_token const& stop) { run(stop); } } {}
+    Scribbler(Scribbler const&) = delete;
+    Scribbler(Scribbler&&) = delete;
+    Scribbler& operator=(Scribbler const&) = delete;
+    Scribbler& operator=(Scribbler&&) = delete;
+    ~Scribbler() = default;
