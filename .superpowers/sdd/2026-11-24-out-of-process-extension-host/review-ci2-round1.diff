+/// @return Whether @p a and @p b name one path, as Windows compares them: ignoring case.
+[[nodiscard]] bool isSamePath(std::string_view a, std::string_view b)
+{
+    return std::ranges::equal(a, b, [](char x, char y) {
+        return std::tolower(static_cast<unsigned char>(x)) == std::tolower(static_cast<unsigned char>(y));
+    });
+}
+
+/// Checks what @p report says of the variables that name a container folder: each @p verdict; contained,
+/// none the value this process has for any of them, or its profile directory.
+void checkContainerVariables(ProbeReport const& report, std::string_view verdict)
+{
+    auto const live = core::LiveEnvironment {};
+    auto parentValues = std::vector<std::string> {};
+    for (auto const name: { "LOCALAPPDATA", "TEMP", "TMP", "USERPROFILE" })
+        if (auto value = live.get(name); value && !value->empty())
+            parentValues.emplace_back(*std::move(value));
+    for (auto const& variable: process::ContainerVariables)
+    {
+        INFO(variable.name);
+        CHECK(valueOf(report, std::format("folder-{}", variable.name)) == verdict);
+        auto const value = valueOf(report, std::format("value-{}", variable.name));
+        INFO("value=" << value);
+        for (auto const& parent: parentValues)
+            CHECK_FALSE(isSamePath(value, parent));
+    }
+}
+
