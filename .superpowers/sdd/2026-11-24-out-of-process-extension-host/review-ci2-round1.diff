+    if (!::GetTokenInformation(::GetCurrentProcessToken(),
+                               TokenAppContainerSid,
+                               buffer.data(),
+                               static_cast<DWORD>(buffer.size()),
+                               &length))
+        return std::nullopt;
+    auto const* const information = reinterpret_cast<TOKEN_APPCONTAINER_INFORMATION const*>(buffer.data());
