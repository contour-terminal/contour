+[[nodiscard]] std::optional<std::filesystem::path> ownContainerFolder()
+{
+    auto buffer = std::array<std::byte, SECURITY_MAX_SID_SIZE + sizeof(TOKEN_APPCONTAINER_INFORMATION)> {};
