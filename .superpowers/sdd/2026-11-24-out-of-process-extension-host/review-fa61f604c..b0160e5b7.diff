+    parent.send(0,
+                proto::Call { .instanceId = 1, .exportOrdinal = ordinalOf(loaded, "add"), .argv = { 1, 2 } });
+    CHECK(parent.exitWithinDeadline() == ServerExit::ProtocolViolation);
+    CHECK(parent.lanes.front().receive() == std::unexpected(StreamError::Closed));
