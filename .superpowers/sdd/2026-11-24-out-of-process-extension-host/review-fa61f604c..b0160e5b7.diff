+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+/// @file
+/// What the extension host process runs modules on: a WebAssembly backend, and how it shares an instance's
+/// memory with Contour.
+
+#include <vtextension/wasm/WasmRuntime.hpp>
