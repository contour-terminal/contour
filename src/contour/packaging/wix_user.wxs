<?xml version="1.0" encoding="utf-8"?>
<!-- The components of the per-user installer whose registry root and environment scope differ from the
     per-machine one (wix_machine.wxs). Both files define the same Ids, which scripts/check-wix-patch.py checks,
     so wix_patch.xml refers to them without knowing the scope. One Fragment: referencing one Id links all. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- The folder this product recorded for itself when it was installed (the component below), read back first
         to find where an upgrade goes: the Add/Remove Programs entry that wix_patch.xml falls back to is
         machine-wide even for a per-user product, and shared by every user who installed the same build. -->
    <Property Id="CONTOUR_RECORDED_ROOT">
      <RegistrySearch Id="ContourRecordedRoot" Root="HKCU" Key="Software\Contour\Contour" Name="InstallRoot" Type="raw" Bitness="always64" />
    </Property>
    <!-- The folder a first install proposes; wix_patch.xml's actions then put back what an upgrade found or the
         user gave. After AppSearch, so that it replaces the folder CPack's own search found. -->
    <SetProperty Id="INSTALL_ROOT" Action="ContourRootDefault" Value="[LocalAppDataFolder]Programs\Contour\" After="AppSearch" Sequence="both" Condition="NOT Installed" />
    <!-- The installation folder, written for the search above; in every installation, so the main feature carries it. -->
    <Component Id="ContourInstallRoot" Guid="*" Directory="INSTALL_ROOT">
      <RegistryValue Root="HKCU" Key="Software\Contour\Contour" Name="InstallRoot" Type="string" Value="[INSTALL_ROOT]" KeyPath="yes" />
    </Component>
    <!-- Contour's bin directory at the end of the user's PATH. -->
    <Component Id="ContourPathEnvironment" Guid="*" Directory="INSTALL_ROOT">
      <Environment Id="UpdatePath" Name="PATH" Value="[INSTALL_ROOT]bin" Permanent="no" Part="last" Action="set" System="no" />
      <RegistryValue Root="HKCU" Key="Software\Contour\Contour" Name="PathEnv" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- The Start menu shortcut to Contour itself, a component of our own as the other shortcuts are: CPack's
         (CPACK_PACKAGE_EXECUTABLES) would have the same component Id, GUID and key path in both installers
         for shortcuts in different folders, and uninstalling one would then break the other's. -->
    <Component Id="ContourStartMenuShortcut" Guid="*" Directory="ProgramMenuFolder">
      <Shortcut Id="CM_S_contour_start" Name="Contour Terminal Emulator" Target="[INSTALL_ROOT]bin\contour.exe" WorkingDirectory="INSTALL_ROOT" />
      <RegistryValue Root="HKCU" Key="Software\Contour\Contour" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- The Start menu shortcut "Contour (Connect…)": `contour.exe connect`, which asks where the new window's
         sessions should live (this computer's daemon, this window only, a saved host) before it opens. CPack's
         own shortcuts take no arguments, hence a component of our own, attached to the main feature. -->
    <Component Id="ContourConnectShortcut" Guid="*" Directory="ProgramMenuFolder">
      <Shortcut Id="CM_S_contour_connect" Name="Contour (Connect…)" Description="Choose where a new Contour window's sessions live" Target="[INSTALL_ROOT]bin\contour.exe" Arguments="connect" WorkingDirectory="INSTALL_ROOT" />
      <RegistryValue Root="HKCU" Key="Software\Contour\Contour" Name="ConnectShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- The desktop shortcut, a component of our own so that DESKTOP_SHORTCUT=0 can drop it (CPack's
         CPACK_CREATE_DESKTOP_LINKS puts its shortcut in the file component, out of reach of a feature). -->
    <Component Id="ContourDesktopShortcut" Guid="*" Directory="DesktopFolder">
      <Shortcut Id="CM_S_contour_desktop" Name="Contour Terminal Emulator" Target="[INSTALL_ROOT]bin\contour.exe" WorkingDirectory="INSTALL_ROOT" />
      <RegistryValue Root="HKCU" Key="Software\Contour\Contour" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
