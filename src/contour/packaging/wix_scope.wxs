<?xml version="1.0" encoding="utf-8"?>
<!-- The components of the Windows installer whose registry root and environment scope depend on the install
     scope: one source for both, with ContourScope (perMachine or perUser, defined by `wix build -d`, from the
     scope table in src/contour/CMakeLists.txt) choosing the three things that differ. wix_patch.xml refers to
     what is defined here by Id, without knowing the scope. One Fragment: referencing one Id links all. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?if $(var.ContourScope) = perUser ?>
    <?define Root = "HKCU" ?>
    <?define PathIsSystemWide = "no" ?>
    <?define DefaultFolder = "[LocalAppDataFolder]Programs\Contour\" ?>
  <?else?>
    <?define Root = "HKLM" ?>
    <?define PathIsSystemWide = "yes" ?>
    <?define DefaultFolder = "[ProgramFiles64Folder]Contour\" ?>
  <?endif?>
  <Fragment>
    <!-- The folder this product recorded for itself when it was installed (the component below), read back first
         to find where an upgrade goes: the Add/Remove Programs entry that wix_patch.xml falls back to is
         machine-wide even for a per-user product, and shared by every user who installed the same build. -->
    <Property Id="CONTOUR_RECORDED_ROOT">
      <RegistrySearch Id="ContourRecordedRoot" Root="$(var.Root)" Key="Software\Contour\Contour" Name="InstallRoot" Type="raw" Bitness="always64" />
    </Property>
    <!-- The folder a first install proposes; wix_patch.xml's actions then put back what an upgrade found or the
         user gave. After AppSearch, so that it replaces the folder CPack's own search found. -->
    <SetProperty Id="INSTALL_ROOT" Action="ContourRootDefault" Value="$(var.DefaultFolder)" After="AppSearch" Sequence="both" Condition="NOT Installed" />
    <!-- The installation folder, written for the search above; in every installation, so the main feature carries it. -->
    <Component Id="ContourInstallRoot" Guid="*" Directory="INSTALL_ROOT">
      <RegistryValue Root="$(var.Root)" Key="Software\Contour\Contour" Name="InstallRoot" Type="string" Value="[INSTALL_ROOT]" KeyPath="yes" />
    </Component>
    <!-- Contour's bin directory at the end of the PATH: the machine's for a per-machine install, the user's
         for a per-user one. -->
    <Component Id="ContourPathEnvironment" Guid="*" Directory="INSTALL_ROOT">
      <Environment Id="UpdatePath" Name="PATH" Value="[INSTALL_ROOT]bin" Permanent="no" Part="last" Action="set" System="$(var.PathIsSystemWide)" />
      <RegistryValue Root="$(var.Root)" Key="Software\Contour\Contour" Name="PathEnv" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- The key paths of the shortcuts below are in HKLM for a per-machine install, as a per-machine package's
         components are (the spec, 2.3), although the shortcuts are in the profile-relative Start menu and
         desktop folders: that is correct for the ALL USERS install that package is, and Windows Installer's
         ICE38, ICE43 and ICE57 say otherwise by design. Validating the per-machine package therefore passes
         -sice for exactly those three. -->
    <!-- The Start menu shortcut to Contour itself, a component of our own as the other shortcuts are: CPack's
         (CPACK_PACKAGE_EXECUTABLES) would have the same component Id, GUID and key path in both installers
         for shortcuts in different folders, and uninstalling one would then break the other's. -->
    <Component Id="ContourStartMenuShortcut" Guid="*" Directory="ProgramMenuFolder">
      <Shortcut Id="CM_S_contour_start" Name="Contour Terminal Emulator" Target="[INSTALL_ROOT]bin\contour.exe" WorkingDirectory="INSTALL_ROOT" />
      <RegistryValue Root="$(var.Root)" Key="Software\Contour\Contour" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- The Start menu shortcut "Contour (Connect…)": `contour.exe connect`, which asks where the new window's
         sessions should live (this computer's daemon, this window only, a saved host) before it opens. CPack's
         own shortcuts take no arguments, hence a component of our own, attached to the main feature. -->
    <Component Id="ContourConnectShortcut" Guid="*" Directory="ProgramMenuFolder">
      <Shortcut Id="CM_S_contour_connect" Name="Contour (Connect…)" Description="Choose where a new Contour window's sessions live" Target="[INSTALL_ROOT]bin\contour.exe" Arguments="connect" WorkingDirectory="INSTALL_ROOT" />
      <RegistryValue Root="$(var.Root)" Key="Software\Contour\Contour" Name="ConnectShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <!-- The desktop shortcut, a component of our own so that DESKTOP_SHORTCUT=0 can drop it (CPack's
         CPACK_CREATE_DESKTOP_LINKS puts its shortcut in the file component, out of reach of a feature). -->
    <Component Id="ContourDesktopShortcut" Guid="*" Directory="DesktopFolder">
      <Shortcut Id="CM_S_contour_desktop" Name="Contour Terminal Emulator" Target="[INSTALL_ROOT]bin\contour.exe" WorkingDirectory="INSTALL_ROOT" />
      <RegistryValue Root="$(var.Root)" Key="Software\Contour\Contour" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <?if $(var.ContourScope) = perUser ?>
    <!-- The Programs folder the per-user install folder is in (INSTALL_PREFIX_1, made by CPack from the scope's
         install directory, Programs/Contour): in the user's profile, it needs a RemoveFolder like the folders of
         the installation (ICE64). Removed only where empty, as other per-user applications live there too. Put
         in the main feature from here, since only this fragment is known to exist in a per-user build. -->
    <Component Id="ContourProgramsFolder" Guid="*" Directory="INSTALL_PREFIX_1">
      <RemoveFolder Id="ContourProgramsFolderRemoval" On="uninstall" />
      <RegistryValue Root="$(var.Root)" Key="Software\Contour\Contour" Name="ProgramsFolder" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <FeatureRef Id="ProductFeature">
      <ComponentRef Id="ContourProgramsFolder" />
    </FeatureRef>
    <?endif?>
  </Fragment>
</Wix>
