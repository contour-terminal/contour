<CPackWiXPatch>
  <!-- The components that differ between the per-machine and the per-user installer (the PATH entry, the
       Connect shortcut) live in wix_machine.wxs and wix_user.wxs; this file refers to them by Id only. -->
  <CPackWiXFragment Id="CM_C_contour_path">
    <ComponentRef Id="ContourPathEnvironment" />
  </CPackWiXFragment>
  <!-- CPack accepts each fragment Id once (scripts/check-wix-patch.py checks it), so everything that goes
       into the product element lives in this one fragment. -->
  <CPackWiXFragment Id="#PRODUCT">
    <!-- "Launch Contour" on the installer's last page. -->
    <CustomAction Id="LaunchApplication" Directory="INSTALL_ROOT" ExeCommand="&quot;[INSTALL_ROOT]bin\contour.exe&quot;" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </CPackWiXFragment>
  <CPackWiXFragment Id="#PRODUCTFEATURE">
    <ComponentRef Id="ContourConnectShortcut" />
  </CPackWiXFragment>
</CPackWiXPatch>
