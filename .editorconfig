root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true

[*.md]
indent_size = 2

[*.xml]
indent_size = 2

[.github/**/*.yml]
indent_size = 2

# Recorded data, in vttest's own format, replayed back into it byte for byte.
#
# vttest logs every byte as `"%c "` or `"<%d> "` (put_char, esc.c), so the space before each newline is
# part of the recording rather than a typo, and its log format IS its command-file format. Trimming it
# would edit data this project did not author, and every re-record would put it straight back -- the
# check would fail forever. The screen dumps next door are excluded from the spell check (see
# `_typos.toml`) for the same reason: they are evidence, not source.
#
# `end_of_line` is unset for the same reason and not a different one: vttest prints a literal CR of its
# own (its `not_impl` stub emits "Sorry, test not implemented:\r"), so a couple of these lines really do
# end CRLF while the rest end LF. That mix is what vttest wrote, so it is what the recording says.
[src/vtconformance/test/cmd/*.cmd]
trim_trailing_whitespace = false
end_of_line = unset

# The text a terminal-state golden must restore to: a rendered page, padded to its width with
# spaces, which are as much a part of the recording as the characters.
[src/vtbackend/state/golden/*.txt]
trim_trailing_whitespace = false

# VT payloads carrying a literal ESC (0x1b): a sixel image, and the one header that embeds a sixel
# fixture in a raw string literal. Both are plain ASCII, but a control byte that dense makes
# editorconfig-checker's charset heuristic read them as ISO-8859-1, which it stopped accepting for
# `charset = utf-8` in v4.0.0. The bytes are the test data -- escaping them would mean the fixture
# no longer is what the terminal receives -- so the charset claim is dropped for these two alone.
[test/images/*.sixel]
charset = unset

[src/vtbackend/screen/ScreenTestFixtures.hpp]
charset = unset

# The orchestrator's manifest-v2 conformance corpus pins how a parser reads a manifest's bytes, line ends
# and blanks included: each of these files is evidence of the rule it is named after, and tidying it would
# remove what it tests: a manifest written with CRLF line ends, a carriage return in mid-line, a line that
# begins with a blank, and one that ends with one.
[extensions/orchestrator/contract/manifest-v2/valid/crlf.manifest]
end_of_line = crlf

[extensions/orchestrator/contract/manifest-v2/invalid/stray-cr.manifest]
end_of_line = unset

[extensions/orchestrator/contract/manifest-v2/invalid/indented-line.manifest]
indent_style = unset
indent_size = unset

[extensions/orchestrator/contract/manifest-v2/invalid/trailing-blank.manifest]
trim_trailing_whitespace = false

# `git … -z` output the orchestrator's parsers are tested against: NUL-separated records, replayed byte for
# byte. The NULs make the checker read them as binary, and the last record ends in a NUL, not a newline;
# both are the format, not a typo.
[extensions/orchestrator/core/testdata/git/*.porcelain-z]
charset = unset
end_of_line = unset
insert_final_newline = unset
