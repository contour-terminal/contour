name = orchestrator
version = 2
title = Agents
placement daemon
root worktrees create = config:worktree_root
root repos = config:repos/*/path
read worktrees
arg number = number
arg session = uuid
arg remote = name
arg model = name
arg branch = ref
arg base = ref
arg path = path:worktrees
arg query = text
arg prompt = text
arg board = text
arg settings = text
arg plugin = text
arg source = text
arg page = number
arg format = number
arg record = text
command-env GIT_TERMINAL_PROMPT = 0
command-env GIT_ALLOW_PROTOCOL = https:ssh:git:file
command-env GIT_CONFIG_COUNT = 2
command-env GIT_CONFIG_KEY_0 = core.fsmonitor
command-env GIT_CONFIG_VALUE_0 = false
command-env GIT_CONFIG_KEY_1 = core.hooksPath
command-env GIT_CONFIG_VALUE_1 = /dev/null
command gh-auth short @repos = gh auth status
command gh-default-branch short @repos = gh repo view --json defaultBranchRef
command gh-prs long @repos = gh pr list --author @me --state open --limit 100 --json number,title,url,headRefName,baseRefName,isDraft,isCrossRepository,reviewDecision,statusCheckRollup,closingIssuesReferences --jq [.[]|[.number,.title,.url,.headRefName,.baseRefName,.isDraft,.isCrossRepository,.reviewDecision,[.closingIssuesReferences[]|[.number,.url]],[.statusCheckRollup[]|[.__typename,.name,.context,.status,.conclusion,.state]]]]
command gh-issues long @repos = gh issue list --state open --limit 100 --search {query} --json number,title,url
command git-fetch long @repos = git fetch --quiet {remote}
command git-worktree-add long @repos = git worktree add --detach {path} {base}
command git-worktree-add-branch long @repos = git worktree add --no-track -b {branch} {path} {base}
command git-worktree-list short @repos = git worktree list --porcelain -z
command gh-pr-checkout long @worktrees = gh pr checkout {number} --branch {branch}
command git-common-dir short @worktrees = git rev-parse --path-format=absolute --git-common-dir
command git-status short @worktrees = git status --porcelain --untracked-files=normal --ignore-submodules=none
command git-head-reachable short @worktrees = git for-each-ref --count=1 --contains HEAD refs/heads refs/tags refs/remotes
command git-operation-state short @worktrees = git -c status.displayCommentPrefix=false -c color.status=false status --long
command git-index-flags short @worktrees = git ls-files -v --stage
command git-clean short @worktrees = git clean -f -- STATUS.md
command git-worktree-remove long @worktrees = git worktree remove {path}
command agent-setup-check short @worktrees = contour agent setup --dry-run --json
command claude-plugins short @worktrees = claude plugin list --json
command claude-marketplace-add long @worktrees = claude plugin marketplace add {source}
command claude-plugin-install long @worktrees = claude plugin install {plugin}
command agent-transcript short @worktrees = contour agent transcript --session {session} --cwd {path} --page {page} --format {format} --json
command agent-record short @worktrees = contour agent record --line {record} --format {format}
command agent-stats short @worktrees = contour agent stats --session {session} --cwd {path} --format {format} --json
command-env-for git-common-dir GIT_CONFIG_COUNT = 3
command-env-for git-common-dir GIT_CONFIG_KEY_0 = core.fsmonitor
command-env-for git-common-dir GIT_CONFIG_VALUE_0 = false
command-env-for git-common-dir GIT_CONFIG_KEY_1 = core.hooksPath
command-env-for git-common-dir GIT_CONFIG_VALUE_1 = /dev/null
command-env-for git-common-dir GIT_CONFIG_KEY_2 = core.attributesFile
command-env-for git-common-dir GIT_CONFIG_VALUE_2 = /dev/null
command-env-for git-common-dir GIT_ATTR_SOURCE = 4b825dc642cb6eb9a060e54bf8d69288fbee4904
command-env-for git-common-dir GIT_OPTIONAL_LOCKS = 0
command-env-for git-status GIT_CONFIG_COUNT = 3
command-env-for git-status GIT_CONFIG_KEY_0 = core.fsmonitor
command-env-for git-status GIT_CONFIG_VALUE_0 = false
command-env-for git-status GIT_CONFIG_KEY_1 = core.hooksPath
command-env-for git-status GIT_CONFIG_VALUE_1 = /dev/null
command-env-for git-status GIT_CONFIG_KEY_2 = core.attributesFile
command-env-for git-status GIT_CONFIG_VALUE_2 = /dev/null
command-env-for git-status GIT_ATTR_SOURCE = 4b825dc642cb6eb9a060e54bf8d69288fbee4904
command-env-for git-status GIT_OPTIONAL_LOCKS = 0
command-env-for git-head-reachable GIT_CONFIG_COUNT = 3
command-env-for git-head-reachable GIT_CONFIG_KEY_0 = core.fsmonitor
command-env-for git-head-reachable GIT_CONFIG_VALUE_0 = false
command-env-for git-head-reachable GIT_CONFIG_KEY_1 = core.hooksPath
command-env-for git-head-reachable GIT_CONFIG_VALUE_1 = /dev/null
command-env-for git-head-reachable GIT_CONFIG_KEY_2 = core.attributesFile
command-env-for git-head-reachable GIT_CONFIG_VALUE_2 = /dev/null
command-env-for git-head-reachable GIT_ATTR_SOURCE = 4b825dc642cb6eb9a060e54bf8d69288fbee4904
command-env-for git-head-reachable GIT_OPTIONAL_LOCKS = 0
command-env-for git-operation-state LC_ALL = C
command-env-for git-operation-state GIT_CONFIG_COUNT = 3
command-env-for git-operation-state GIT_CONFIG_KEY_0 = core.fsmonitor
command-env-for git-operation-state GIT_CONFIG_VALUE_0 = false
command-env-for git-operation-state GIT_CONFIG_KEY_1 = core.hooksPath
command-env-for git-operation-state GIT_CONFIG_VALUE_1 = /dev/null
command-env-for git-operation-state GIT_CONFIG_KEY_2 = core.attributesFile
command-env-for git-operation-state GIT_CONFIG_VALUE_2 = /dev/null
command-env-for git-operation-state GIT_ATTR_SOURCE = 4b825dc642cb6eb9a060e54bf8d69288fbee4904
command-env-for git-operation-state GIT_OPTIONAL_LOCKS = 0
command-env-for git-index-flags GIT_CONFIG_COUNT = 3
command-env-for git-index-flags GIT_CONFIG_KEY_0 = core.fsmonitor
command-env-for git-index-flags GIT_CONFIG_VALUE_0 = false
command-env-for git-index-flags GIT_CONFIG_KEY_1 = core.hooksPath
command-env-for git-index-flags GIT_CONFIG_VALUE_1 = /dev/null
command-env-for git-index-flags GIT_CONFIG_KEY_2 = core.attributesFile
command-env-for git-index-flags GIT_CONFIG_VALUE_2 = /dev/null
command-env-for git-index-flags GIT_ATTR_SOURCE = 4b825dc642cb6eb9a060e54bf8d69288fbee4904
command-env-for git-index-flags GIT_OPTIONAL_LOCKS = 0
command-env-for git-clean GIT_CONFIG_COUNT = 3
command-env-for git-clean GIT_CONFIG_KEY_0 = core.fsmonitor
command-env-for git-clean GIT_CONFIG_VALUE_0 = false
command-env-for git-clean GIT_CONFIG_KEY_1 = core.hooksPath
command-env-for git-clean GIT_CONFIG_VALUE_1 = /dev/null
command-env-for git-clean GIT_CONFIG_KEY_2 = core.attributesFile
command-env-for git-clean GIT_CONFIG_VALUE_2 = /dev/null
command-env-for git-clean GIT_ATTR_SOURCE = 4b825dc642cb6eb9a060e54bf8d69288fbee4904
command-env-for git-clean GIT_OPTIONAL_LOCKS = 0
command-env-for git-worktree-remove GIT_CONFIG_COUNT = 3
command-env-for git-worktree-remove GIT_CONFIG_KEY_0 = core.fsmonitor
command-env-for git-worktree-remove GIT_CONFIG_VALUE_0 = false
command-env-for git-worktree-remove GIT_CONFIG_KEY_1 = core.hooksPath
command-env-for git-worktree-remove GIT_CONFIG_VALUE_1 = /dev/null
command-env-for git-worktree-remove GIT_CONFIG_KEY_2 = core.attributesFile
command-env-for git-worktree-remove GIT_CONFIG_VALUE_2 = /dev/null
command-env-for git-worktree-remove GIT_ATTR_SOURCE = 4b825dc642cb6eb9a060e54bf8d69288fbee4904
command-env-for git-worktree-remove GIT_OPTIONAL_LOCKS = 0
pane agent @worktrees = claude --model {model} --session-id {session} --settings {settings} --append-system-prompt {board} {prompt}
pane agent-plain @worktrees = claude --model {model} --session-id {session} --settings {settings} {prompt}
pane-env agent GIT_CONFIG_COUNT = 2
pane-env agent GIT_CONFIG_KEY_0 = push.default
pane-env agent GIT_CONFIG_VALUE_0 = upstream
pane-env agent GIT_CONFIG_KEY_1 = push.autoSetupRemote
pane-env agent GIT_CONFIG_VALUE_1 = true
pane-env agent-plain GIT_CONFIG_COUNT = 2
pane-env agent-plain GIT_CONFIG_KEY_0 = push.default
pane-env agent-plain GIT_CONFIG_VALUE_0 = upstream
pane-env agent-plain GIT_CONFIG_KEY_1 = push.autoSetupRemote
pane-env agent-plain GIT_CONFIG_VALUE_1 = true
pane-input
serve orchestrator
action open = Open Agents
action refresh = Agents: Refresh now
action show-blocked = Agents: Show blocked agent
