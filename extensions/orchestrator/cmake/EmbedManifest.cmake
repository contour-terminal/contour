#
# Run with `cmake -P`: writes OUTPUT, a C++ source holding the manifest MANIFEST_TOOL prints as the module's
# `terminal-extension-manifest` custom section, through module-level assembly (the `section` attribute
# produces nothing for a custom section). The text is escaped for the assembler's `.ascii` string; the
# assembly is a raw string literal, so the C++ compiler takes it unchanged.
foreach(_required IN ITEMS MANIFEST_TOOL OUTPUT)
    if(NOT ${_required})
        message(FATAL_ERROR "EmbedManifest.cmake: ${_required} is not set")
    endif()
endforeach()

execute_process(COMMAND "${MANIFEST_TOOL}" OUTPUT_VARIABLE _manifest RESULT_VARIABLE _result)
if(NOT _result EQUAL 0 OR _manifest STREQUAL "")
    message(FATAL_ERROR "${MANIFEST_TOOL} printed no manifest (${_result})")
endif()

set(_delimiter "manifest")
string(FIND "${_manifest}" ")${_delimiter}\"" _clash)
if(NOT _clash EQUAL -1)
    message(FATAL_ERROR "The manifest holds the raw string's end delimiter )${_delimiter}\"")
endif()

# The assembler's escapes: the backslash first, so that the ones added after it stay single.
string(REPLACE "\\" "\\\\" _escaped "${_manifest}")
string(REPLACE "\"" "\\\"" _escaped "${_escaped}")
string(REPLACE "\t" "\\t" _escaped "${_escaped}")
string(REPLACE "\n" "\\n" _escaped "${_escaped}")

set(_source "// Generated by EmbedManifest.cmake from the orchestrator's declared tables; do not edit.
asm(R\"${_delimiter}(.section \".custom_section.terminal-extension-manifest\",\"\",@
.ascii \"${_escaped}\"
.text
)${_delimiter}\");
")
file(WRITE "${OUTPUT}" "${_source}")
