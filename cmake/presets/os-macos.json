{
    "version": 6,
    "include": [
        "common.json"
    ],
    "configurePresets": [
        {
            "name": "macos-signing",
            "hidden": true,
            "description": "The project's macOS release identity, defined once.",
            "cacheVariables": {
                "CODE_SIGN_CERTIFICATE_ID": "Developer ID Application: Christian Parpart (6T525MU9UR)"
            }
        },
        {
            "name": "appleclang-debug",
            "displayName": "Clang Debug",
            "inherits": [
                "contour-common",
                "macos-signing",
                "debug"
            ],
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "LIBTERMINAL_BUILD_BENCH_HEADLESS": "OFF",
                "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt"
            }
        },
        {
            "name": "appleclang-release",
            "displayName": "Clang Release",
            "inherits": [
                "contour-common",
                "macos-signing",
                "release"
            ],
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "LIBTERMINAL_BUILD_BENCH_HEADLESS": "OFF",
                "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt"
            }
        },
        {
            "name": "macos-package",
            "displayName": "Clang Release (distributable .dmg)",
            "description": "The one configuration that produces a shippable .dmg; CI builds, tests and packages it on master and release tags.",
            "inherits": [
                "contour-common",
                "macos-signing",
                "release",
                "production"
            ],
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CONTOUR_INSTALL_TOOLS": "OFF",
                "LIBTERMINAL_BUILD_BENCH_HEADLESS": "OFF",
                "VTHOST_BUILD_BENCH_LATENCY": "OFF",
                "CONTOUR_MACOS_NOTARIZE": "ON",
                "CONTOUR_MACOS_STAPLE_APP": "ON",
                "CONTOUR_MACOS_NOTARY_PROFILE": "contour-notary",
                "CONTOUR_MACOS_MIN_SUPPORTED": "13.3",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "arm64-osx-contour",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets"
            }
        },
        {
            "name": "macos-ci",
            "displayName": "Clang Release (CI)",
            "description": "macos-package without the production flags, signing and notarization: what a pull request builds and tests",
            "inherits": [
                "contour-common",
                "release"
            ],
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "LIBTERMINAL_BUILD_BENCH_HEADLESS": "OFF",
                "VTHOST_BUILD_BENCH_LATENCY": "OFF",
                "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "arm64-osx-contour",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "appleclang-debug",
            "displayName": "AppleClang - Debug",
            "configurePreset": "appleclang-debug"
        },
        {
            "name": "appleclang-release",
            "displayName": "AppleClang - Release",
            "configurePreset": "appleclang-release"
        },
        {
            "name": "macos-package",
            "displayName": "AppleClang - Release (distributable .dmg)",
            "configurePreset": "macos-package"
        },
        {
            "name": "macos-ci",
            "displayName": "AppleClang - Release (CI)",
            "configurePreset": "macos-ci"
        }
    ],
    "testPresets": [
        {
            "name": "appleclang-debug",
            "configurePreset": "appleclang-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        },
        {
            "name": "macos-package",
            "configurePreset": "macos-package",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true,
                "timeout": 600
            }
        },
        {
            "name": "macos-ci",
            "configurePreset": "macos-ci",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true,
                "timeout": 600
            }
        }
    ],
    "packagePresets": [
        {
            "name": "macos-package",
            "configurePreset": "macos-package",
            "generators": [
                "DragNDrop"
            ]
        }
    ]
}
