{
    "version": 6,
    "configurePresets": [
        {
            "name": "contour-common",
            "hidden": true,
            "description": "Common settings for all configurations",
            "binaryDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": {
                "CONTOUR_INSTALL_TOOLS": "ON",
                "CONTOUR_TESTING": "ON",
                "LIBTERMINAL_BUILD_BENCH_HEADLESS": "ON",
                "LIBUNICODE_TESTING": "OFF",
                "VTHOST_BUILD_BENCH_LATENCY": "ON",
                "PEDANTIC_COMPILER": "ON",
                "PEDANTIC_COMPILER_WERROR": "ON"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "production",
            "hidden": true,
            "description": "The flags the packages are built with: link-time optimization and exploit mitigations for Contour's own code",
            "cacheVariables": {
                "CONTOUR_PRODUCTION_BUILD": "ON"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        }
    ]
}
